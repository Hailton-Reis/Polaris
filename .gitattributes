# A unified diff uses a single mandatory space for an empty context line.
# Keep the artifact bytes stable; actual source whitespace is checked separately.
integration/reader-translation-ux/*.patch text eol=lf -whitespace
integration/document-reader/*.patch text eol=lf -whitespace
integration/document-reader/fixtures/*.pdf binary

# Preserve the exact captured Android boot output, including trailing spaces.
integration/library-consolidation/20261110/guest-install-logcat.txt -whitespace

# Preserve raw compiler/test output without rewriting captured evidence.
integration/sandbox-login/**/*.log -whitespace
integration/backup-safety/**/*.log -whitespace

# Preserve full build/test logs and the original XML report archive.
integration/build-validation/**/*.log -whitespace
integration/build-validation/**/*.zip binary

# Preserve signing recovery build/test logs without rewriting them.
integration/signing-recovery/**/*.log -whitespace

# Preserve numeric sandbox build and regression evidence.
integration/sandbox-numeric/**/*.log -whitespace
integration/sandbox-numeric/**/*.zip binary

# Preserve dynamic preference evidence bytes.
integration/sandbox-dynamic/**/*.log -whitespace
integration/sandbox-dynamic/**/*.zip binary
