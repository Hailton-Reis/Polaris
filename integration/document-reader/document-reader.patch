@@ -0,0 +1,84 @@
+package eu.kanade.tachiyomi.extension.sandbox
+
+import okhttp3.Cookie
+import okhttp3.CookieJar
+import okhttp3.HttpUrl
+import okhttp3.HttpUrl.Companion.toHttpUrl
+
+/** A revocable bridge for one explicitly selected HTTPS origin, never the global browser. */
+internal class BrowserCookieSession(baseUrl: String, private val jar: CookieJar) {
+    val origin =
+        baseUrl.toHttpUrl().also {
+            SandboxNetworkPolicy.requireUrl(it.toString())
+            require(it.isHttps) { "Browser login requires HTTPS" }
+        }
+    private val initial = linkedMapOf<Triple<String, String, String>, Cookie>()
+
+    private fun copyCookie(
+        cookie: Cookie,
+        host: String,
+        expired: Boolean = false,
+        hostOnly: Boolean = true,
+    ): Cookie =
+        Cookie.Builder()
+            .name(cookie.name)
+            .value(cookie.value)
+            .path(cookie.path)
+            .apply {
+                if (hostOnly) hostOnlyDomain(host) else domain(host)
+                if (cookie.persistent || expired) expiresAt(if (expired) 0 else cookie.expiresAt)
+                if (cookie.secure) secure()
+                if (cookie.httpOnly) httpOnly()
+            }
+            .build()
+
+    fun accepts(value: String): Boolean =
+        runCatching {
+                val url = value.toHttpUrl()
+                SandboxNetworkPolicy.requireUrl(value)
+                url.isHttps && url.host == origin.host && url.port == origin.port
+            }
+            .getOrDefault(false)
+
+    fun seed(url: HttpUrl = origin): List<Cookie> {
+        require(accepts(url.toString()))
+        return jar.loadForRequest(url).also { cookies ->
+            cookies.forEach { initial[Triple(it.name, it.domain, it.path)] = it }
+        }
+    }
+
+    /** Preserve attributes using GET_COOKIE_INFO; never infer expiry from a Cookie header. */
+    fun complete(snapshots: Map<String, List<String>>) {
+        check((jar as? RevocableCookieJar)?.isActive() != false) { "Login session revoked" }
+        require(snapshots.size in 1..32 && snapshots.keys.all(::accepts))
+        require(snapshots.values.sumOf { it.size } <= CookieCodec.MAX_COOKIES * 32)
+        val current = linkedMapOf<Triple<String, String, String>, Cookie>()
+        snapshots.forEach { (value, headers) ->
+            val url = value.toHttpUrl()
+            headers.forEach cookie@{ header ->
+                require(header.toByteArray().size <= 8192)
+                // Partitioned browser state cannot be represented by OkHttp's unpartitioned jar.
+                if (header.split(';').drop(1).any { it.trim().equals("Partitioned", true) })
+                    return@cookie
+                val parsed = Cookie.parse(url, header) ?: error("Invalid browser cookie")
+                require(CookieCodec.valid(parsed))
+                // A login for one host never grants a parent-domain session to sibling sources.
+                val cookie = copyCookie(parsed, origin.host)
+                current[Triple(cookie.name, cookie.domain, cookie.path)] = cookie
+            }
+        }
+        require(current.size <= CookieCodec.MAX_COOKIES)
+        require(
+            CookieCodec.encode(current.values).toString().toByteArray().size <=
+                CookieCodec.MAX_BYTES
+        )
+        val removed =
+            initial
+                .filter { (key, _) -> key !in current }
+                .values
+                .map { copyCookie(it, it.domain, expired = true, hostOnly = it.hostOnly) }
+        // A jar issued before clearSession is revoked by CookieBank and ignores this write.
+        jar.saveFromResponse(origin, removed + current.values)
+        check((jar as? RevocableCookieJar)?.isActive() != false) { "Login session revoked" }
+    }
+}
