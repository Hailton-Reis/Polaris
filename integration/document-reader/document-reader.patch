+package eu.kanade.tachiyomi.data.updater
+
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertNull
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+
+class PolarisReleaseVersionTest {
+    @Test
+    fun `semver orders numeric beta counters and stable promotion without downgrades`() {
+        val versions = listOf("0.1.0-alpha", "0.1.0-beta.2", "v0.1.0-beta.10", "0.1.0-rc.1", "0.1.0", "0.2.0", "1.0.0")
+        versions.zipWithNext().forEach { (before, after) ->
+            assertTrue(PolarisReleaseVersion.parse(before)!! < PolarisReleaseVersion.parse(after)!!)
+        }
+        assertTrue(PolarisReleaseVersion.parse("1.9.9")!! < PolarisReleaseVersion.parse("2.0.0")!!)
+    }
+
+    @Test
+    fun `build metadata and optional v prefix do not change precedence`() {
+        assertEquals(PolarisReleaseVersion.parse("v1.2.3+build.4"), PolarisReleaseVersion.parse("1.2.3+build.5"))
+    }
+
+    @Test
+    fun `malformed and overflowing versions are rejected without crashing`() {
+        listOf("r2000", "v1", "1.0", "01.0.0", "1.0.0-beta.01", "1.0.0-", "1.0.0+x..y", "9999999999999999999999.0.0")
+            .forEach { assertNull(PolarisReleaseVersion.parse(it), it) }
+    }
+}
diff --git a/app/src/test/java/eu/kanade/tachiyomi/data/updater/PolarisUpdateClientTest.kt b/app/src/test/java/eu/kanade/tachiyomi/data/updater/PolarisUpdateClientTest.kt
