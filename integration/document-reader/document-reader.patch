+        val repo = mockk<MangaRepository>()
+        coEvery { repo.getLibraryManga() } returns raw
+        val result = GetLibraryManga(repo, query).await().single()
+        assertEquals(60L, result.totalChapters)
+        assertEquals(12L, result.readCount)
+        assertEquals(1L, result.bookmarkCount)
+        assertEquals(listOf(1L, 2L), result.categories)
+        assertEquals(100L, result.lastRead)
+        assertEquals(2, result.editions.size)
+        assertEquals("personal 2", result.editions.last().notes)
