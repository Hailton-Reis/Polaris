+import tachiyomi.presentation.core.screens.LoadingScreen
+
+class PolarisProfileScreen : Screen() {
+    @Composable
+    override fun Content() {
+        val navigator = LocalNavigator.currentOrThrow
+        val model = viewModel<UserProfileViewModel>()
+        val state by model.state.collectAsState()
+        when (val current = state) {
+            UserProfileState.Loading -> LoadingScreen()
+            UserProfileState.Error ->
+                androidx.compose.foundation.layout.Column {
+                    androidx.compose.material3.TextButton(onClick = { navigator.pop() }) {
+                        Text(stringResource(tachiyomi.i18n.MR.strings.action_close))
+                    }
+                    Text(stringResource(MR.strings.polaris_profile_load_error))
+                    androidx.compose.material3.TextButton(onClick = model::loadProfile) {
+                        Text(stringResource(tachiyomi.i18n.MR.strings.action_retry))
+                    }
+                }
+            is UserProfileState.Success ->
+                UserProfileScreen(
+                    navigateUp = { navigator.pop() },
+                    username = current.username,
+                    totalXp = current.totalXp,
+                    totalChaptersRead = current.totalChaptersRead,
+                    totalMangas = current.totalMangas,
+                    equippedTitle = current.equippedTitle,
+                    unlockedTitles = current.unlockedTitles,
+                    avatarUri = current.avatarUri,
+                    bannerUri = current.bannerUri,
+                    onUsernameChanged = model::setUsername,
+                    onTitleSelected = model::setEquippedTitle,
+                    onAvatarSelected = model::setAvatarUri,
+                    onBannerSelected = model::setBannerUri,
+                )
+        }
+    }
+}
