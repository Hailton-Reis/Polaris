+package eu.kanade.tachiyomi.extension.sandbox
+
+import java.net.InetAddress
+import org.junit.jupiter.api.Assertions.*
+import org.junit.jupiter.api.Test
+
+class SandboxNetworkPolicyTest {
+    @Test
+    fun `URLs cannot request files content providers credentials or alternate ports`() {
+        listOf(
+                "file:///data/data/app/database",
+                "content://contacts/1",
+                "https://user:pass@example.org/",
+                "https://example.org:8443/",
+                "http://localhost/",
+                "https://router.lan/",
+                "http://127.0.0.1/",
+                "http://127.1/",
+                "http://2130706433/",
+                "http://10.0.0.1/",
+                "http://[::1]/",
+                "http://[::ffff:127.0.0.1]/",
+                "http://metadata.google.internal/",
+            )
+            .forEach { assertThrows(Exception::class.java) { SandboxNetworkPolicy.requireUrl(it) } }
+        assertEquals(
+            "api.mangadex.org",
+            SandboxNetworkPolicy.requireUrl("https://api.mangadex.org/manga").host,
+        )
+    }
+
+    @Test
+    fun `DNS cannot route public names to local reserved or mixed addresses`() {
+        listOf(
+                "127.0.0.1",
+                "10.0.0.1",
+                "172.16.0.1",
+                "192.168.0.1",
+                "169.254.169.254",
+                "100.64.0.1",
+                "0.0.0.0",
+                "224.0.0.1",
+                "198.18.0.1",
+                "192.0.2.1",
+                "::1",
+                "fc00::1",
+                "fe80::1",
+                "::ffff:127.0.0.1",
+                "2002:0a00:0001::",
+                "2001:db8::1",
+                "64:ff9b::a00:1",
+            )
+            .forEach { assertFalse(SandboxNetworkPolicy.isPublic(InetAddress.getByName(it)), it) }
+        val public = InetAddress.getByName("93.184.216.34")
+        assertTrue(SandboxNetworkPolicy.isPublic(public))
+        assertTrue(SandboxNetworkPolicy.isPublic(InetAddress.getByName("2606:4700:4700::1111")))
+        assertThrows(IllegalArgumentException::class.java) {
+            SandboxNetworkPolicy.requirePublic(listOf(public, InetAddress.getByName("127.0.0.1")))
+        }
+    }
+
+    @Test
+    fun `response input is bounded before parsing or returning extension bytes`() {
+        assertArrayEquals(
+            byteArrayOf(1, 2),
+            ExtensionSandboxProtocol.readBounded(byteArrayOf(1, 2).inputStream(), 2),
+        )
+        assertThrows(IllegalArgumentException::class.java) {
+            ExtensionSandboxProtocol.readBounded(byteArrayOf(1, 2, 3).inputStream(), 2)
+        }
+    }
+
+    @Test
+    fun `deep or oversized JSON is rejected before source metadata parsing`() {
+        val nested = "{\"value\":".repeat(33) + "null" + "}".repeat(33)
+        assertThrows(IllegalArgumentException::class.java) {
+            ExtensionSandboxProtocol.input(nested.toByteArray())
+        }
+        val valid = "{\"value\":\"[braces] {inside a string}\"}"
+        assertNotNull(ExtensionSandboxProtocol.input(valid.toByteArray()))
+    }
+}
