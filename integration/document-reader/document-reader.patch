@@ -0,0 +1,46 @@
+package eu.kanade.translation
+
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import java.util.concurrent.atomic.AtomicLong
+
+/** Wait for cancelled writers before removing files; preserve an explicit user pause. */
+class TranslationDeletionGate(
+    private val running: () -> Boolean,
+    private val pauseAndAwait: suspend () -> Unit,
+    private val restart: () -> Unit,
+) {
+    private val mutex = Mutex()
+    private val pauseRevision = AtomicLong()
+
+    @Volatile private var active = false
+
+    @Volatile private var deferredStart = false
+
+    fun deferStart(): Boolean {
+        if (!active) return false
+        deferredStart = true
+        return true
+    }
+
+    fun userPaused() {
+        pauseRevision.incrementAndGet()
+        deferredStart = false
+    }
+
+    suspend fun remove(action: suspend () -> Unit) = mutex.withLock {
+        active = true
+        val resume = running()
+        val revision = pauseRevision.get()
+        try {
+            pauseAndAwait()
+            action()
+        } finally {
+            active = false
+            if ((resume && revision == pauseRevision.get()) || deferredStart) {
+                deferredStart = false
+                restart()
+            }
+        }
+    }
+}
