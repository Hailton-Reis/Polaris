+++ b/app/src/main/java/eu/kanade/tachiyomi/extension/util/ExtensionSecurityAudit.kt
@@ -0,0 +1,175 @@
+package eu.kanade.tachiyomi.extension.util
+
+import java.io.File
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import java.security.MessageDigest
+import java.util.zip.ZipFile
+
+/** Preventive screening BEFORE class loading. This is not a sandbox or malware certification. */
+internal object ExtensionSecurityAudit {
+    data class Report(val sha256: String?, val findings: List<String>)
+
+    fun approvalKey(packageName: String, report: Report): String? =
+        report.sha256?.takeIf { "UNREADABLE_CODE" !in report.findings }?.let { "$packageName:$it" }
+
+    fun requiresQuarantine(packageName: String, report: Report, approved: Set<String>): Boolean =
+        report.findings.isNotEmpty() &&
+            approvalKey(packageName, report).let { it == null || it !in approved }
+
+    fun inspect(apk: File, permissions: List<String>): Report {
+        var digest: String? = null
+        val findings = linkedSetOf<String>()
+        try {
+            require(apk.length() in 1..MAX_APK_BYTES)
+            val hash = MessageDigest.getInstance("SHA-256")
+            apk.inputStream().buffered().use { input ->
+                val buffer = ByteArray(64 * 1024)
+                while (true) {
+                    val count = input.read(buffer)
+                    if (count < 0) break
+                    hash.update(buffer, 0, count)
+                }
+            }
+            digest = hash.digest().joinToString("") { "%02x".format(it) }
+            if (permissions.any { it in sensitivePermissions }) findings += "PRIVILEGED_PERMISSION"
+            ZipFile(apk).use { zip ->
+                var dexCount = 0
+                var total = 0L
+                var entries = 0
+                val iterator = zip.entries()
+                while (iterator.hasMoreElements()) {
+                    val entry = iterator.nextElement()
+                    require(++entries <= 4096)
+                    if (entry.name.startsWith("lib/") && entry.name.endsWith(".so"))
+                        findings += "NATIVE_CODE"
+                    if (!entry.name.matches(Regex("classes(?:[2-9]|[1-9][0-9]+)?\\.dex"))) continue
+                    dexCount++
+                    require(entry.size in 112..MAX_DEX_BYTES)
+                    total += entry.size
+                    require(total <= MAX_TOTAL_DEX_BYTES)
+                    val bytes =
+                        zip.getInputStream(entry).use { input ->
+                            val out = java.io.ByteArrayOutputStream()
+                            val buffer = ByteArray(16 * 1024)
+                            while (true) {
+                                val count = input.read(buffer)
+                                if (count < 0) break
+                                require(out.size().toLong() + count <= entry.size)
+                                out.write(buffer, 0, count)
+                            }
+                            out.toByteArray()
+                        }
+                    findings += inspectDex(bytes)
+                }
+                require(dexCount > 0)
+            }
+        } catch (_: Exception) {
+            findings += "UNREADABLE_CODE"
+        }
+        return Report(digest, findings.sorted())
+    }
+
+    internal fun inspectDex(data: ByteArray): Set<String> {
+        require(
+            data.size >= 112 && data.copyOfRange(0, 4).contentEquals(byteArrayOf(100, 101, 120, 10))
+        )
+        val dex = ByteBuffer.wrap(data).order(ByteOrder.LITTLE_ENDIAN)
+        fun uint(offset: Int): Int {
+            require(offset >= 0 && offset.toLong() + 4 <= data.size)
+            return dex.getInt(offset).also { require(it >= 0) }
+        }
+        require(uint(32) == data.size && uint(36) >= 112 && uint(40) == 0x12345678)
+        val stringCount = uint(56)
+        val strings = uint(60)
+        val typeCount = uint(64)
+        val types = uint(68)
+        val methodCount = uint(88)
+        val methods = uint(92)
+        fun table(offset: Int, count: Int, stride: Int) {
+            require(count <= 300_000 && offset.toLong() + count.toLong() * stride <= data.size)
+        }
+        table(strings, stringCount, 4)
+        table(types, typeCount, 4)
+        table(methods, methodCount, 8)
+        fun string(index: Int): String {
+            require(index in 0 until stringCount)
+            var offset = uint(strings + index * 4)
+            var header = 0
+            do {
+                require(offset in data.indices && ++header <= 5)
+                val value = data[offset++].toInt() and 255
+            } while (value and 128 != 0)
+            val start = offset
+            while (
+                offset < data.size && data[offset].toInt() != 0 && offset - start <= 2048
+            ) offset++
+            require(offset < data.size && offset - start <= 2048)
+            return data.copyOfRange(start, offset).toString(Charsets.UTF_8)
+        }
+        val typeCache = HashMap<Int, String>()
+        val found = linkedSetOf<String>()
+        repeat(methodCount) { index ->
+            val offset = methods + index * 8
+            val typeIndex = dex.getShort(offset).toInt() and 65535
+            require(typeIndex < typeCount)
+            val owner = typeCache.getOrPut(typeIndex) { string(uint(types + typeIndex * 4)) }
+            val risk =
+                when {
+                    owner in dynamicLoaders -> "DYNAMIC_CODE"
+                    owner == "Ljava/lang/Runtime;" || owner == "Ljava/lang/ProcessBuilder;" -> {
+                        val name = string(uint(offset + 4))
+                        if (name in setOf("exec", "start", "load", "loadLibrary")) "SHELL_EXECUTION"
+                        else null
+                    }
+                    owner == "Ljava/lang/System;" -> {
+                        if (string(uint(offset + 4)) in setOf("load", "loadLibrary")) "NATIVE_CODE"
+                        else null
+                    }
+                    owner == "Landroid/content/ContentResolver;" -> {
+                        if (
+                            string(uint(offset + 4)) in setOf("query", "insert", "delete", "update")
+                        )
+                            "SENSITIVE_PROVIDER"
+                        else null
+                    }
+                    owner.startsWith("Lmihon/app/shizuku/") ||
+                        owner.startsWith("Lrikka/shizuku/") ||
+                        owner.startsWith("Landroid/telephony/") ||
+                        owner.startsWith("Landroid/hardware/camera") ||
+                        owner == "Landroid/media/MediaRecorder;" ||
+                        owner.startsWith("Landroid/content/pm/PackageInstaller") -> "DEVICE_CONTROL"
+                    else -> null
+                }
+            if (risk != null) found += risk
+        }
+        return found
+    }
+
+    private const val MAX_APK_BYTES = 128L * 1024 * 1024
+    private const val MAX_DEX_BYTES = 16L * 1024 * 1024
+    private const val MAX_TOTAL_DEX_BYTES = 32L * 1024 * 1024
+    private val dynamicLoaders =
+        setOf(
+            "Ldalvik/system/DexClassLoader;",
+            "Ldalvik/system/PathClassLoader;",
+            "Ldalvik/system/InMemoryDexClassLoader;",
+        )
+    private val sensitivePermissions =
+        setOf(
+                "READ_CONTACTS",
+                "WRITE_CONTACTS",
+                "READ_SMS",
+                "SEND_SMS",
+                "READ_CALL_LOG",
+                "WRITE_CALL_LOG",
+                "READ_PHONE_STATE",
+                "RECORD_AUDIO",
+                "CAMERA",
+                "REQUEST_INSTALL_PACKAGES",
+                "MANAGE_EXTERNAL_STORAGE",
+                "QUERY_ALL_PACKAGES",
+            )
+            .map { "android.permission.$it" }
+            .toSet()
+}
