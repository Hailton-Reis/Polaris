+package eu.kanade.presentation.theme
+
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.luminance
+import eu.kanade.presentation.theme.colorscheme.*
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+
+class PolarisThemeContrastTest {
+    private fun contrast(a: Color, b: Color): Float {
+        val x = a.luminance()
+        val y = b.luminance()
+        return (maxOf(x, y) + .05f) / (minOf(x, y) + .05f)
+    }
+
+    @Test
+    fun `all new themes keep primary body and container text readable in light dark and AMOLED`() {
+        for (theme in
+            listOf<BaseColorScheme>(
+                PolarisNorthColorScheme,
+                PolarisAuroraColorScheme,
+                PolarisAmberColorScheme,
+            )) {
+            for ((dark, amoled) in listOf(false to false, true to false, true to true)) {
+                val c = theme.getColorScheme(dark, amoled, true)
+                for ((fg, bg) in
+                    listOf(
+                        c.onPrimary to c.primary,
+                        c.onPrimaryContainer to c.primaryContainer,
+                        c.onSecondary to c.secondary,
+                        c.onSecondaryContainer to c.secondaryContainer,
+                        c.onTertiary to c.tertiary,
+                        c.onTertiaryContainer to c.tertiaryContainer,
+                        c.onBackground to c.background,
+                        c.onSurface to c.surface,
+                        c.onSurfaceVariant to c.surfaceVariant,
+                    )) {
+                    assertTrue(
+                        contrast(fg, bg) >= 4.5f,
+                        "${theme.javaClass.simpleName} dark=$dark amoled=$amoled contrast=${contrast(fg,bg)}",
+                    )
+                }
+            }
+        }
+    }
+}
