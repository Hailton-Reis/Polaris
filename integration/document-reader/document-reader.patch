diff --git a/app/src/main/java/eu/kanade/tachiyomi/util/system/DeviceWorkloadPolicy.kt b/app/src/main/java/eu/kanade/tachiyomi/util/system/DeviceWorkloadPolicy.kt
new file mode 100644
index 0000000..d7d35c9
--- /dev/null
+++ b/app/src/main/java/eu/kanade/tachiyomi/util/system/DeviceWorkloadPolicy.kt
@@ -0,0 +1,28 @@
+package eu.kanade.tachiyomi.util.system
+
+import android.app.ActivityManager
+import android.content.Context
+import android.os.Process
+
+/** Resource limits follow the running Android process, never the phone's commercial model. */
+data class DeviceWorkloadPolicy(
+    val imageFetches: Int,
+    val imageDecoders: Int,
+    val librarySources: Int,
+    val imageCacheFraction: Double,
+    val ocrThreads: Int,
+) {
+    companion object {
+        fun choose(is64Bit: Boolean, lowRam: Boolean, memoryClassMb: Int): DeviceWorkloadPolicy =
+            if (!is64Bit || lowRam || memoryClassMb <= 192) {
+                DeviceWorkloadPolicy(2, 1, 2, 0.10, 2)
+            } else {
+                DeviceWorkloadPolicy(8, 3, 5, 0.20, 4)
+            }
+
+        fun current(context: Context): DeviceWorkloadPolicy {
+            val memory = context.getSystemService(Context.ACTIVITY_SERVICE) as ActivityManager
+            return choose(Process.is64Bit(), memory.isLowRamDevice, memory.memoryClass)
+        }
+    }
+}
diff --git a/app/src/main/java/eu/kanade/tachiyomi/util/system/LauncherIconManager.kt b/app/src/main/java/eu/kanade/tachiyomi/util/system/LauncherIconManager.kt
new file mode 100644
