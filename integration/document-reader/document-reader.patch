+import kotlinx.coroutines.test.runTest
+import org.junit.jupiter.api.Assertions.*
+import org.junit.jupiter.api.Test
+import tachiyomi.domain.manga.model.*
+
+class UnifiedWorkSearchTest {
+    private val identity =
+        WorkIdentity(
+            "mangadex:ade0306c-f4b6-4890-9edb-1ddf04df2039",
+            listOf("Solo Leveling Ragnarok", "Upando Sozinho Ragnarok"),
+            listOf("DAUL"),
+            1,
+        )
+
+    private fun hit(source: Long, author: String? = null) =
+        WorkSearchHit(
+            Manga.create()
+                .copy(
+                    id = source,
+                    source = source,
+                    url = "/work",
+                    title = "Solo Leveling Ragnarok",
+                    author = author,
+                ),
+            "Source $source",
+            "en",
+        )
+
+    private fun info(title: String = "Solo Leveling Ragnarok", author: String = "DAUL") =
+        SManga.create().also {
+            it.url = "/work"
+            it.title = title
+            it.author = author
+        }
+
+    private fun provider(source: Long, language: String = "en"): HttpSource =
+        mockk<HttpSource>().also { p ->
+            every { p.id } returns source
+            every { p.name } returns "Source $source"
+            every { p.lang } returns language
+            every { p.getFilterList() } returns FilterList()
+            coEvery { p.getMangaUpdate(any(), any(), true, false) } returns
+                SMangaUpdate(info(), emptyList())
+            coEvery { p.getSearchManga(any(), any(), any()) } returns MangasPage(emptyList(), false)
+        }
+
+    @Test
+    fun `details corroborate duplicate titles and keep wrong author separate`() = runTest {
+        val a = provider(1)
+        val b = provider(2)
+        val c = provider(3)
+        coEvery { c.getMangaUpdate(any(), any(), true, false) } returns
+            SMangaUpdate(info(author = "Different Author"), emptyList())
+        val groups =
+            UnifiedWorkSearch { null }
+                .refine("Solo", listOf(hit(1), hit(2), hit(3)), emptyList(), listOf(a, b, c))
+        assertEquals(2, groups.size)
+        assertEquals(listOf(1, 2), groups.map { it.editions.size }.sorted())
+    }
+
+    @Test
+    fun `localized alias can recover an empty provider and join the confirmed card`() = runTest {
+        val a = provider(1)
+        val pt = provider(2, "pt-BR")
+        coEvery { pt.getSearchManga(1, "Upando Sozinho Ragnarok", any()) } returns
+            MangasPage(listOf(info("Upando Sozinho Ragnarok")), false)
+        coEvery { pt.getMangaUpdate(any(), any(), true, false) } returns
+            SMangaUpdate(info("Upando Sozinho Ragnarok"), emptyList())
+        val groups =
+            UnifiedWorkSearch { identity }
+                .refine(
+                    "Solo Leveling Ragnarok",
+                    listOf(hit(1, "DAUL")),
+                    emptyList(),
+                    listOf(a, pt),
+                )
+        assertEquals(1, groups.size)
+        assertEquals(2L, groups.single().representative.source)
+        assertEquals(2, groups.single().editions.size)
+        coVerify(exactly = 1) { pt.getSearchManga(1, "Upando Sozinho Ragnarok", any()) }
+    }
+
+    @Test
+    fun `metadata network failure retains all native results`() = runTest {
+        val groups =
+            UnifiedWorkSearch { error("offline") }
+                .refine("Solo", listOf(hit(1, "DAUL"), hit(2, "DAUL")), emptyList(), emptyList())
+        assertEquals(1, groups.size)
+        assertEquals(2, groups.single().editions.size)
+    }
+
+    @Test
+    fun `detail timeouts leave unknown editions separate and finish`() = runTest {
+        val providers = listOf(provider(1), provider(2))
+        providers.forEach {
+            coEvery { it.getMangaUpdate(any(), any(), true, false) } coAnswers
+                {
+                    delay(6_000)
+                    SMangaUpdate(info(), emptyList())
+                }
+        }
+        val groups =
+            UnifiedWorkSearch { null }
+                .refine("Solo", listOf(hit(1), hit(2)), emptyList(), providers)
+        assertEquals(2, groups.size)
+        assertTrue(testScheduler.currentTime in 5_000..5_100)
+    }
+
+    @Test
+    fun `cancellation is not converted into a successful empty search`() = runTest {
+        val result = runCatching {
+            UnifiedWorkSearch { throw CancellationException("cancel") }
+                .refine("Solo", listOf(hit(1)), emptyList(), emptyList())
+        }
+        assertTrue(result.exceptionOrNull() is CancellationException)
+    }
+
+    @Test
+    fun `enrichment has a sixteen detail budget and two concurrent requests`() = runTest {
+        var calls = 0
+        var active = 0
+        var maximum = 0
+        val providers =
+            (1L..30L).map { id ->
+                provider(id).also { p ->
+                    coEvery { p.getMangaUpdate(any(), any(), true, false) } coAnswers
+                        {
+                            calls++
+                            active++
+                            maximum = maxOf(maximum, active)
+                            try {
+                                delay(100)
+                                SMangaUpdate(info(), emptyList())
+                            } finally {
+                                active--
+                            }
+                        }
+                }
+            }
+        val groups =
+            UnifiedWorkSearch { null }
+                .refine("Solo", (1L..30L).map { hit(it) }, emptyList(), providers)
+        assertEquals(16, calls)
+        assertEquals(2, maximum)
+        assertEquals(30, groups.sumOf { it.editions.size })
+        assertEquals(15, groups.size)
+    }
+
+    @Test
+    fun `alias discovery tries at most four empty providers and two names each`() = runTest {
+        val providers = (1L..10L).map { provider(it) }
+        val extra = identity.copy(titles = identity.titles + listOf("Third alias", "Fourth alias"))
+        assertTrue(
+            UnifiedWorkSearch { extra }
+                .refine("Solo Leveling Ragnarok", emptyList(), emptyList(), providers)
+                .isEmpty()
+        )
+        providers.take(4).forEach {
+            coVerify(exactly = 2) { it.getSearchManga(any(), any(), any()) }
+        }
+        providers.drop(4).forEach {
+            coVerify(exactly = 0) { it.getSearchManga(any(), any(), any()) }
+        }
+    }
+
+    @Test
+    fun `details for a different title cannot lend its creator to the search hit`() = runTest {
+        val a = provider(1)
+        val b = provider(2)
+        coEvery { b.getMangaUpdate(any(), any(), true, false) } returns
+            SMangaUpdate(info("Unrelated Sequel"), emptyList())
+        val groups =
+            UnifiedWorkSearch { null }
+                .refine("Solo", listOf(hit(1), hit(2)), emptyList(), listOf(a, b))
+        assertEquals(2, groups.size)
+    }
+
+    @Test
+    fun `catalogue query reference has a safe initialized URL and title`() = runTest {
+        var calls = 0
+        UnifiedWorkSearch { reference ->
+                calls++
+                assertEquals("", reference.url)
+                assertEquals("Solo", reference.title)
+                null
+            }
+            .refine("Solo", listOf(hit(1, "DAUL")), emptyList(), listOf(provider(1)))
+        assertEquals(1, calls)
+    }
+
+    @Test
+    fun `metadata requests do not expose Polaris memo to a provider`() = runTest {
+        val a = provider(1)
+        val b = provider(2)
+        val memo =
+            kotlinx.serialization.json.buildJsonObject {
+                put("provider", kotlinx.serialization.json.JsonPrimitive("keep"))
+                put("polaris.work.sources.v1", kotlinx.serialization.json.JsonPrimitive("private"))
+            }
+        coEvery { a.getMangaUpdate(any(), any(), true, false) } coAnswers
+            {
+                assertEquals(setOf("provider"), firstArg<SManga>().memo.keys)
+                SMangaUpdate(info(), emptyList())
+            }
+        val hit = hit(1).let { it.copy(manga = it.manga.copy(memo = memo)) }
+        assertEquals(
+            1,
+            UnifiedWorkSearch { null }
+                .refine("Solo", listOf(hit, hit(2)), emptyList(), listOf(a, b))
+                .size,
+        )
+        assertEquals(2, hit.manga.memo.size)
+    }
+}
