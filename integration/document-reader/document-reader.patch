+package eu.kanade.tachiyomi.ui.documents
+
+import android.content.Intent
+import android.net.Uri
+import android.os.Bundle
+import androidx.activity.ComponentActivity
+import androidx.activity.compose.setContent
+import androidx.activity.enableEdgeToEdge
+import cafe.adriel.voyager.navigator.Navigator
+import eu.kanade.presentation.documents.DocumentsScreen
+import eu.kanade.presentation.theme.TachiyomiTheme
+
+class DocumentOpenActivity : ComponentActivity() {
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        enableEdgeToEdge()
+        val uri = if (intent.action ==
+            Intent.ACTION_SEND
+        ) {
+            intent.getParcelableExtra<Uri>(Intent.EXTRA_STREAM)
+        } else {
+            intent.data
+        }
+        if (uri?.scheme != "content") {
+            finish()
+            return
+        }
+        setContent { TachiyomiTheme { Navigator(DocumentsScreen(uri.toString())) } }
+    }
+}
