+package eu.kanade.translation.translator
+
+import eu.kanade.translation.model.PageTranslation
+import eu.kanade.translation.model.TranslationBlock
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonArray
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.booleanOrNull
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+
+internal data class GeminiComicItem(val pageKey: String, val block: TranslationBlock)
+
+/** Request-local ordering prevents a large chapter from becoming one truncated response. */
+internal fun geminiComicBatches(
+    pages: Map<String, PageTranslation>,
+    maxItems: Int = 16,
+    maxCharacters: Int = 6_000,
+): List<List<GeminiComicItem>> {
+    require(maxItems > 0 && maxCharacters > 0)
+    val result = mutableListOf<List<GeminiComicItem>>()
+    var batch = mutableListOf<GeminiComicItem>()
+    var characters = 0
+    for ((pageKey, page) in pages) {
+        for (block in page.blocks) {
+            if (batch.isNotEmpty() && (batch.size >= maxItems || characters + block.text.length > maxCharacters)) {
+                result += batch
+                batch = mutableListOf()
+                characters = 0
+            }
+            batch += GeminiComicItem(pageKey, block)
+            characters += block.text.length
+        }
+    }
+    if (batch.isNotEmpty()) result += batch
+    return result
+}
+
+internal fun completeGeminiComicResponse(
+    responseBody: String,
+    expectedCounts: Map<String, Int>,
+): Map<String, List<String>> {
+    val root = Json.parseToJsonElement(responseBody).jsonObject
+    val candidate = (root["candidates"] as? JsonArray)?.firstOrNull()?.jsonObject
+        ?: error("Gemini did not return a candidate")
+    check(candidate["finishReason"]?.jsonPrimitive?.content == "STOP") {
+        "Gemini response was interrupted or blocked"
+    }
+    val parts = candidate["content"]?.jsonObject?.get("parts") as? JsonArray
+        ?: error("Gemini did not return text")
+    val responseText = parts.joinToString("") { element ->
+        val part = element.jsonObject
+        if (part["thought"]?.jsonPrimitive?.booleanOrNull == true) {
+            ""
+        } else {
+            part["text"]?.jsonPrimitive?.content.orEmpty()
+        }
+    }.trim().removePrefix("```json").removePrefix("```").removeSuffix("```").trim()
+    val translations = Json.parseToJsonElement(responseText) as? JsonObject
+        ?: error("Gemini response must contain a JSON object")
+    check(translations.keys == expectedCounts.keys) { "Gemini response page keys do not match" }
+    return expectedCounts.mapValues { (key, count) ->
+        val values = translations[key] as? JsonArray ?: error("Gemini omitted a page")
+        check(values.size == count) { "Gemini omitted one or more phrases" }
+        values.map { value ->
+            val text = (value as? JsonPrimitive)?.takeIf { it.isString }?.content?.trim()
+            check(!text.isNullOrEmpty() && text != "NULL") { "Gemini omitted a phrase" }
+            text
+        }
+    }
+}
