@@ -0,0 +1,67 @@
+package tachiyomi.domain.chapter.model
+
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertNotEquals
+import org.junit.jupiter.api.Assertions.assertNotNull
+import org.junit.jupiter.api.Assertions.assertNull
+import org.junit.jupiter.api.Test
+import tachiyomi.domain.manga.model.WorkSource
+import tachiyomi.domain.manga.model.WorkSources
+
+class ChapterOriginTest {
+    private val sourceMemo = JsonObject(mapOf("token" to JsonPrimitive("opaque-provider-state")))
+
+    @Test fun `signed source ids and Unicode URLs survive portable memo roundtrip`() {
+        val origin = ChapterOrigin(-923, "Fonte", "en", "/obra/星", "/capítulo/1", rank = 3, sourceMemo = sourceMemo)
+        assertEquals(origin, ChapterOrigin.from(origin.attach(sourceMemo)))
+        assertEquals(sourceMemo["token"], origin.attach(sourceMemo)["token"])
+        assertNotEquals(ChapterOrigin.storedUrl(-923, "/1"), ChapterOrigin.storedUrl(923, "/1"))
+    }
+
+    @Test fun `invalid origin metadata falls back without interpreting remote URLs`() {
+        assertNull(ChapterOrigin.from(JsonObject(emptyMap())))
+        assertNull(ChapterOrigin.from(JsonObject(mapOf(ChapterOrigin.KEY to JsonPrimitive("bad")))))
+        assertNull(ChapterOrigin.from(ChapterOrigin(1, "x", "en", "", "/1").attach(sourceMemo)))
+    }
+
+    @Test fun `per work pin survives backup memo without local database ids`() {
+        val choice = WorkSource(-4, "Fonte", "en", "/work", "Title", sourceMemo = sourceMemo)
+        val settings = WorkSources(pinned = choice, candidates = listOf(choice), checkedAt = 50)
+        assertEquals(settings, WorkSources.from(settings.attach(sourceMemo)))
+        assertNull(WorkSources.from(JsonObject(emptyMap())).pinned)
+    }
+
+    @Test fun `available edition beats stale retained metadata while downloads remain usable`() {
+        fun edition(
+            id: Long,
+            available: Boolean,
+            rank: Int,
+        ) = Chapter.create().copy(
+            id = id,
+            name = "Chapter 1",
+            url = "/$id",
+            memo = ChapterOrigin(id, "Fonte", "en", "/work", "/$id", rank, available).attach(sourceMemo),
+        )
+        val stale = edition(1, false, 0)
+        val working = edition(2, true, 2)
+        val group = ChapterVersions.groups(listOf(stale, working)).single()
+        assertEquals(2L, group.choose().id)
+        assertEquals(1L, group.choose(downloadedIds = setOf(1)).id)
+        assertEquals(1L, group.choose(currentId = 1).id)
+    }
+
+    @Test fun `fixed source restricts the sequence and switching back preserves every record`() {
+        val a = Chapter.create().copy(id = 1, name = "Chapter 1", url = "/1")
+        val b = a.copy(
+            id = 2,
+            url = ChapterOrigin.storedUrl(20, "/1"),
+            memo = ChapterOrigin(20, "Other", "en", "/work", "/1").attach(sourceMemo),
+        )
+        val all = listOf(a, b)
+        assertEquals(2L, ChapterVersions.sequence(all, 10, 20).single().chapter.id)
+        assertEquals(1L, ChapterVersions.sequence(all, 10, 10).single().chapter.id)
+        assertEquals(2, all.size)
+    }
+}
diff --git a/domain/src/test/java/tachiyomi/domain/chapter/model/ChapterVersionsTest.kt b/domain/src/test/java/tachiyomi/domain/chapter/model/ChapterVersionsTest.kt
new file mode 100644
index 0000000..7a8c5df
--- /dev/null
+++ b/domain/src/test/java/tachiyomi/domain/chapter/model/ChapterVersionsTest.kt
@@ -0,0 +1,125 @@
+package tachiyomi.domain.chapter.model
+
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertNotEquals
+import org.junit.jupiter.api.Test
+
+class ChapterVersionsTest {
+    private fun chapter(id: Long, name: String, number: Double = 0.0, group: String? = null) =
+        Chapter.create().copy(
+            id = id,
+            mangaId = 10,
+            url = "/chapter/$id",
+            name = name,
+            chapterNumber = number,
+            scanlator = group,
+        )
+
+    @Test fun `official and unofficial chapter zero are one logical chapter`() {
+        val chapters = listOf(chapter(1, "Chapter 0 (Unofficial)"), chapter(2, "Chapter 0 (Official)"))
+        assertEquals(1, ChapterVersions.groups(chapters).size)
+        assertEquals(2L, ChapterVersions.select(chapters).single().id)
+    }
+
+    @Test fun `unofficial substring is never treated as an official label`() {
+        assertEquals(
+            2L,
+            ChapterVersions.select(
+                listOf(chapter(1, "Chapter 1", 1.0, "unofficial"), chapter(2, "Chapter 1", 1.0)),
+            ).single().id,
+        )
+    }
+
+    @Test fun `downloaded or started editions win over a cosmetic label`() {
+        val started = chapter(1, "Chapter 0 Unofficial").copy(lastPageRead = 12)
+        val official = chapter(2, "Chapter 0 Official")
+        assertEquals(1L, ChapterVersions.select(listOf(started, official)).single().id)
+        assertEquals(
+            1L,
+            ChapterVersions.select(
+                listOf(started.copy(lastPageRead = 0), official),
+                downloadedIds = setOf(1),
+            ).single().id,
+        )
+    }
+
+    @Test fun `current reading edition is not replaced mid chapter`() {
+        val chapters = listOf(chapter(1, "Chapter 0 Unofficial"), chapter(2, "Chapter 0 Official"))
+        assertEquals(1L, ChapterVersions.select(chapters, currentId = 1).single().id)
+    }
+
+    @Test fun `unknown number sentinel never merges unrelated entries`() {
+        assertEquals(
+            3,
+            ChapterVersions.groups(
+                listOf(
+                    chapter(1, "Notice", -1.0),
+                    chapter(2, "Gallery", -1.0),
+                    chapter(3, "Acknowledgements", Double.NaN),
+                ),
+            ).size,
+        )
+    }
+
+    @Test fun `decimals parts volumes seasons and extras remain distinct`() {
+        val chapters =
+            listOf(
+                chapter(
+                    1,
+                    "Chapter 11.1",
+                    11.1,
+                ),
+                chapter(
+                    2,
+                    "Chapter 11.2",
+                    11.2,
+                ),
+                chapter(
+                    3,
+                    "Chapter 11 Part 1",
+                    11.0,
+                ),
+                chapter(
+                    4,
+                    "Chapter 11 Part 2",
+                    11.0,
+                ),
+                chapter(
+                    5,
+                    "Volume 1 Chapter 11",
+                    11.0,
+                ),
+                chapter(
+                    6,
+                    "Volume 2 Chapter 11",
+                    11.0,
+                ),
+                chapter(
+                    7,
+                    "Season 2 Chapter 11",
+                    11.0,
+                ),
+                chapter(8, "Chapter 11 Side Story", 11.0), chapter(9, "Chapter 11", 11.0),
+            )
+        assertEquals(chapters.size, ChapterVersions.groups(chapters).size)
+        assertNotEquals(
+            ChapterVersions.key(chapter(10, "Chapter 1.0001", 1.0001)),
+            ChapterVersions.key(chapter(11, "Chapter 1.0004", 1.0004)),
+        )
+    }
+
+    @Test fun `read and bookmark state survive choosing a different representative`() {
+        val a = chapter(1, "Chapter 1 Unofficial", 1.0).copy(read = true, bookmark = true)
+        val b = chapter(2, "Chapter 1 Official", 1.0)
+        val group = ChapterVersions.groups(listOf(a, b)).single()
+        assertEquals(true, group.read)
+        assertEquals(true, group.bookmarked)
+        assertEquals(2L, group.choose(currentId = 2).id)
+    }
+
+    @Test fun `edition suffix is hidden without removing meaningful title words`() {
+        assertEquals("Chapter 0", ChapterVersions.displayName(chapter(1, "Chapter 0 (Official)")))
+        assertEquals("Chapter 0", ChapterVersions.displayName(chapter(2, "Chapter 0 Unofficial")))
+        assertEquals("The Official Visit", ChapterVersions.displayName(chapter(3, "The Official Visit", 1.0)))
+    }
+}
