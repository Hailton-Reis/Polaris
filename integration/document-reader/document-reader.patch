+package tachiyomi.domain.chapter.model
+
+import kotlinx.serialization.json.JsonObject
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertNotEquals
+import org.junit.jupiter.api.Assertions.assertNotNull
+import org.junit.jupiter.api.Assertions.assertNull
+import org.junit.jupiter.api.Test
+
+class LogicalChapterCountsTest {
+    private fun chapter(id: Long, title: String) = Chapter.create().copy(id = id, name = title, url = "/$id")
+
+    @Test fun `library counts logical chapters and aggregates read and bookmark flags`() {
+        val all =
+            listOf(
+                chapter(1, "Chapter 0 Official"),
+                chapter(2, "Chapter 0 Unofficial").copy(read = true, bookmark = true),
+                chapter(3, "Chapter 1"),
+            )
+        assertEquals(LogicalChapterCounts(3, 2, 1, 1), LogicalChapterCounts.calculate(all))
+        val unread = all.map { it.copy(read = false, bookmark = false) }
+        assertEquals(LogicalChapterCounts(3, 2, 0, 0), LogicalChapterCounts.calculate(unread))
+    }
+
+    @Test fun `stale counts after a partial restore fall back safely`() {
+        val memo = LogicalChapterCounts(3, 2, 1, 0).attach(JsonObject(emptyMap()))
+        assertNotNull(LogicalChapterCounts.from(memo, 3))
+        assertNull(LogicalChapterCounts.from(memo, 2))
+        assertNull(LogicalChapterCounts.from(LogicalChapterCounts(3, 2, 7, 0).attach(JsonObject(emptyMap())), 3))
+    }
+}
