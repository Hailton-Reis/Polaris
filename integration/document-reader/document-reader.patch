+package eu.kanade.presentation.more.settings.screen.about
+
+/** Local gesture state only; never persisted, transmitted or connected to reader taps. */
+internal class PolarisDedicationTrigger {
+    private var count = 0
+    private var previousTap: Long? = null
+
+    fun tap(nowMillis: Long): Boolean {
+        val previous = previousTap
+        if (previous == null || nowMillis < previous || nowMillis - previous > 1200) count = 0
+        previousTap = nowMillis
+        count++
+        if (count < 7) return false
+        count = 0
+        previousTap = null
+        return true
+    }
+}
