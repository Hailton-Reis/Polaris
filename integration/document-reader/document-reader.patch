+package eu.kanade.translation
+
+import eu.kanade.translation.model.PageTranslation
+import eu.kanade.translation.model.TranslationBlock
+import kotlinx.serialization.decodeFromString
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Test
+
+class TranslationStorageSampleTest {
+    @Test fun `measure actual chapter serialization with authored multilingual text`() {
+        val texts = mapOf(
+            "en" to "The library opens tomorrow. Sora will bring the blue book.",
+            "ja" to "図書館は明日開きます。ソラは青い本を持ってきます。",
+            "zh-CN" to "图书馆明天开放。小空会带来那本蓝色的书。",
+            "zh-TW" to "圖書館明天開放。小空會帶來那本藍色的書。",
+            "ko" to "도서관은 내일 문을 엽니다. 소라는 파란 책을 가져올 것입니다.",
+        )
+        for ((language, source) in texts) {
+            val pages = (1..20).associate { page ->
+                "$page.png" to PageTranslation(
+                    (1..10).map {
+                        TranslationBlock(
+                            source, "A biblioteca abre amanhã. Sora trará o livro azul.",
+                            400f, 200f, 100f, 300f, 24f, 12f, 0f,
+                        )
+                    }.toMutableList(),
+                    1600f,
+                    2400f,
+                )
+            }
+            val json = Json.encodeToString(pages)
+            assertEquals(pages, Json.decodeFromString<Map<String, PageTranslation>>(json))
+            println("POLARIS_STORAGE_SAMPLE language=$language bytes=${json.toByteArray().size} pages=20 blocks=200")
+        }
+    }
