+import eu.kanade.tachiyomi.extension.preparation.store
+import io.mockk.coEvery
+import io.mockk.coVerify
+import io.mockk.every
+import io.mockk.mockk
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.awaitCancellation
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.runCurrent
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import mihon.data.extension.service.ExtensionStoreService
+import mihon.domain.extension.repository.ExtensionStoreRepository
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import tachiyomi.core.common.preference.Preference
+import tachiyomi.domain.manga.interactor.GetFavorites
+import tachiyomi.domain.manga.model.Manga
+
+class SourcePreparationViewModelTest {
+    @Test
+    fun `restored repositories and language preferences do not start downloads or change backup data`() =
+        runTest {
+            val dispatcher = StandardTestDispatcher(testScheduler)
+            Dispatchers.setMain(dispatcher)
+            val owner = ViewModelStore()
+            try {
+                val repos = MutableStateFlow(listOf(store()))
+                val repository = mockk<ExtensionStoreRepository>()
+                every { repository.getAllAsFlow() } returns repos
+                val manager = mockk<ExtensionManager>()
+                val queue =
+                    ExtensionPreparationQueue(
+                        backgroundScope,
+                        { true },
+                        { _, _ -> error("no download authorized") },
+                    )
+                every { manager.preparationQueue } returns queue
+                every { manager.installedExtensionsFlow } returns MutableStateFlow(emptyList())
+                val preference = mockk<Preference<Set<String>>>()
+                every { preference.isSet() } returns true
+                every { preference.get() } returns setOf("ja")
+                val preferences =
+                    mockk<SourcePreferences>().also { preferences ->
+                        every { preferences.pendingRestoredRepositoryTrust } returns
+                            SourcePreferences(
+                                    tachiyomi.core.common.preference.InMemoryPreferenceStore()
+                                )
+                                .pendingRestoredRepositoryTrust
+                    }
+                every { preferences.enabledLanguages } returns preference
+                val adults = mockk<Preference<Boolean>>()
+                every { adults.get() } returns false
+                every { preferences.showNsfwSource } returns adults
+                val vm =
+                    SourcePreparationViewModel(
+                        repository,
+                        mockk(),
+                        mockk(),
+                        manager,
+                        preferences,
+                        dispatcher,
+                    )
+                owner.put("test", vm)
+                runCurrent()
