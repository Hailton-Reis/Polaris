@@ -0,0 +1,31 @@
+package mihon.core.archive
+
+import android.content.Context
+import com.hippo.unifile.UniFile
+import java.io.File
+import java.security.MessageDigest
+import java.util.UUID
+
+object DocumentFiles {
+    @Synchronized
+    fun materialize(context: Context, source: UniFile): DocumentCacheBudget.Lease {
+        val identity = "${source.uri}|${source.length()}|${source.lastModified()}"
+        val key = MessageDigest.getInstance("SHA-256").digest(identity.toByteArray())
+            .joinToString("") { "%02x".format(it) }
+        val directory = File(context.cacheDir, "document-files").apply { mkdirs() }
+        val target = File(directory, key)
+        return DocumentCacheBudget.acquire(context.cacheDir, target) {
+            if (target.isFile && target.length() > 0) return@acquire
+            val temporary = File(directory, ".$key-${UUID.randomUUID()}")
+            try {
+                val size = source.openInputStream().use { input ->
+                    temporary.outputStream().use { output -> DocumentLimits.copy(input, output) }
+                }
+                require(size > 0) { "Empty document" }
+                check(temporary.renameTo(target)) { "Cannot prepare document" }
+            } finally {
+                temporary.delete()
+            }
+        }
+    }
+}
