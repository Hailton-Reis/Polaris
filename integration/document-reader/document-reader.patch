@@ -0,0 +1,180 @@
+package eu.kanade.tachiyomi.extension.sandbox
+
+import android.content.Context
+import eu.kanade.tachiyomi.source.model.*
+import eu.kanade.tachiyomi.source.online.HttpSource
+import java.io.File
+import kotlinx.serialization.json.*
+import okhttp3.Headers
+import okhttp3.MediaType.Companion.toMediaTypeOrNull
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.RequestBody.Companion.toRequestBody
+
+/**
+ * Host proxy containing only DTOs. Extension classes/constructors exist exclusively in the worker.
+ */
+internal class IsolatedHttpSource
+private constructor(private val runtime: Runtime, metadata: JsonObject) : HttpSource() {
+    override val id = metadata.getValue("id").jsonPrimitive.long
+    override val name = metadata.getValue("name").jsonPrimitive.content
+    override val lang = metadata.getValue("lang").jsonPrimitive.content
+    override val baseUrl = metadata.getValue("url").jsonPrimitive.content
+    override val supportsLatest = metadata.getValue("latest").jsonPrimitive.boolean
+
+    init {
+        require(id > 0)
+        SandboxNetworkPolicy.requireUrl(baseUrl)
+    }
+
+    private fun validateManga(manga: SManga): SManga =
+        manga.also { it.thumbnail_url?.let(SandboxNetworkPolicy::requireUrl) }
+
+    override val client: OkHttpClient =
+        SandboxHttpBroker.imageClient(runtime.onViolation, runtime.isQuarantined)
+
+    private suspend fun call(operation: String, arguments: JsonObject = JsonObject(emptyMap())) =
+        runtime.call(id, operation, arguments)
+
+    override suspend fun getPopularManga(page: Int) =
+        listing(call("popular", buildJsonObject { put("page", page) }))
+
+    override suspend fun getLatestUpdates(page: Int) =
+        listing(call("latest", buildJsonObject { put("page", page) }))
+
+    override suspend fun getSearchManga(page: Int, query: String, filters: FilterList) =
+        listing(
+            call(
+                "search",
+                buildJsonObject {
+                    require(filters.isEmpty()) { "Custom filters need a sandbox adapter" }
+                    put("page", page)
+                    put("query", query)
+                },
+            )
+        )
+
+    private fun listing(value: JsonObject) =
+        MangasPage(
+            value.getValue("mangas").jsonArray.map {
+                validateManga(SandboxSourceCodec.manga(it.jsonObject))
+            },
+            value.getValue("next").jsonPrimitive.boolean,
+        )
+
+    override suspend fun getMangaUpdate(
+        manga: SManga,
+        chapters: List<SChapter>,
+        fetchDetails: Boolean,
+        fetchChapters: Boolean,
+    ): SMangaUpdate {
+        val value =
+            call(
+                "update",
+                buildJsonObject {
+                    put("manga", SandboxSourceCodec.manga(manga))
+                    put("chapters", JsonArray(chapters.map(SandboxSourceCodec::chapter)))
+                    put("details", fetchDetails)
+                    put("chaptersRequested", fetchChapters)
+                },
+            )
+        return SMangaUpdate(
+            validateManga(SandboxSourceCodec.manga(value.getValue("manga").jsonObject)),
+            value.getValue("chapters").jsonArray.map { SandboxSourceCodec.chapter(it.jsonObject) },
+        )
+    }
+
+    override suspend fun getPageList(chapter: SChapter): List<Page> =
+        call("pages", buildJsonObject { put("chapter", SandboxSourceCodec.chapter(chapter)) })
+            .getValue("pages")
+            .jsonArray
+            .map {
+                SandboxSourceCodec.page(it.jsonObject).also { page ->
+                    page.imageUrl?.let(SandboxNetworkPolicy::requireUrl)
+                }
+            }
+
+    override suspend fun getImageUrl(page: Page): String =
+        call("imageUrl", buildJsonObject { put("page", SandboxSourceCodec.page(page)) })
+            .getValue("url")
+            .jsonPrimitive
+            .content
+            .also { SandboxNetworkPolicy.requireUrl(it) }
+
+    override fun imageRequest(page: Page): Request =
+        kotlinx.coroutines.runBlocking {
+            val input =
+                call("imageRequest", buildJsonObject { put("page", SandboxSourceCodec.page(page)) })
+            SandboxNetworkPolicy.requireUrl(input.getValue("url").jsonPrimitive.content)
+            val builder = Request.Builder().url(input.getValue("url").jsonPrimitive.content)
+            input.getValue("headers").jsonArray.forEach { pair ->
+                val values = pair.jsonArray
+                builder.addHeader(values[0].jsonPrimitive.content, values[1].jsonPrimitive.content)
+            }
+            val method = input.getValue("method").jsonPrimitive.content
+            require(method in setOf("GET", "HEAD", "POST"))
+            val bytes =
+                java.util.Base64.getDecoder().decode(input.getValue("body").jsonPrimitive.content)
+            require(bytes.size <= SandboxNetworkPolicy.MAX_REQUEST_BYTES)
+            builder
+                .method(
+                    method,
+                    if (method == "POST")
+                        bytes.toRequestBody(
+                            input["type"]?.jsonPrimitive?.content?.toMediaTypeOrNull()
+                        )
+                    else null,
+                )
+                .build()
+        }
+
+    override fun getMangaUrl(manga: SManga) =
+        java.net.URI(baseUrl.trimEnd('/') + "/").resolve(manga.url).toString().also {
+            SandboxNetworkPolicy.requireUrl(it)
+        }
+
+    override fun getChapterUrl(chapter: SChapter) =
+        java.net.URI(baseUrl.trimEnd('/') + "/").resolve(chapter.url).toString().also {
+            SandboxNetworkPolicy.requireUrl(it)
+        }
+
+    override fun headersBuilder(): Headers.Builder =
+        Headers.Builder().add("User-Agent", "Polaris/isolated-extension")
+
+    private class Runtime(
+        val context: Context,
+        val apk: File,
+        val digest: String,
+        val classes: List<String>,
+        val onViolation: (String) -> Unit,
+        val isQuarantined: () -> Boolean,
+    ) {
+        suspend fun call(source: Long, operation: String, arguments: JsonObject): JsonObject {
+            check(!isQuarantined()) { "Extension quarantined" }
+            return ExtensionSandboxSession.withApk(context, apk, digest, classes, onViolation) {
+                it.request(source, operation, arguments)
+            }
+        }
+    }
+
+    companion object {
+        suspend fun load(
+            context: Context,
+            apk: File,
+            digest: String,
+            entryClasses: List<String>,
+            onViolation: (String) -> Unit,
+            isQuarantined: () -> Boolean,
+        ): List<HttpSource> {
+            check(!isQuarantined())
+            val metadata =
+                ExtensionSandboxSession.withApk(context, apk, digest, entryClasses, onViolation) {
+                    it.metadata
+                }
+            val runtime = Runtime(context, apk, digest, entryClasses, onViolation, isQuarantined)
+            return metadata.getValue("sources").jsonArray.map {
+                IsolatedHttpSource(runtime, it.jsonObject)
+            }
+        }
+    }
+}
