+++ b/app/src/main/java/eu/kanade/presentation/more/settings/screen/browse/preparation/SourcePreparationViewModel.kt
@@ -0,0 +1,323 @@
+package eu.kanade.presentation.more.settings.screen.browse.preparation
+
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import eu.kanade.domain.source.service.SourcePreferences
+import eu.kanade.tachiyomi.extension.ExtensionManager
+import eu.kanade.tachiyomi.extension.model.Extension
+import eu.kanade.tachiyomi.extension.preparation.PreparationPlanner
+import eu.kanade.tachiyomi.extension.preparation.PreparationSelection
+import eu.kanade.tachiyomi.extension.preparation.RepositoryIdentity
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CoroutineDispatcher
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.TimeoutCancellationException
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.catch
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withTimeout
+import mihon.data.extension.service.ExtensionStoreService
+import mihon.domain.extension.model.ExtensionStore
+import mihon.domain.extension.repository.ExtensionStoreRepository
+import tachiyomi.domain.manga.interactor.GetFavorites
+import uy.kohesive.injekt.Injekt
+import uy.kohesive.injekt.api.get
+
+internal enum class PreparationError {
+    STORES,
+    REPOSITORY,
+    CATALOG,
+    UNSIGNED,
+    ADULT_DISABLED,
+}
+
+internal data class SourcePreparationState(
+    val loaded: Boolean = false,
+    val stores: List<ExtensionStore> = emptyList(),
+    val selectedRepositories: Set<RepositoryIdentity> = emptySet(),
+    val consent: Boolean = false,
+    val busy: Boolean = false,
+    val error: PreparationError? = null,
+    val pendingStore: ExtensionStore? = null,
+    val available: List<Extension.Available> = emptyList(),
+    val catalogLoaded: Boolean = false,
+    val catalogFailures: List<String> = emptyList(),
+    val librarySources: Set<Long> = emptySet(),
+    val installedVersions: Map<String, Long> = emptyMap(),
+    val sharedPackages: Set<String> = emptySet(),
+    val selection: PreparationSelection = PreparationSelection.LANGUAGES,
+    val languages: Set<String> = setOf("pt-BR", "pt", "en"),
+    val manualPackages: Set<String> = emptySet(),
+    val includeNsfw: Boolean = false,
+) {
+    val plan
+        get() =
+            PreparationPlanner.create(
+                available,
+                selectedRepositories,
+                installedVersions,
+                sharedPackages,
+                selection,
+                languages,
+                librarySources,
+                manualPackages,
+                includeNsfw,
+            )
+}
+
+internal class SourcePreparationViewModel(
+    private val repository: ExtensionStoreRepository = Injekt.get(),
+    private val service: ExtensionStoreService = Injekt.get(),
+    private val favorites: GetFavorites = Injekt.get(),
+    private val extensions: ExtensionManager = Injekt.get(),
+    private val preferences: SourcePreferences = Injekt.get(),
+    private val dispatcher: CoroutineDispatcher = Dispatchers.IO,
+) : ViewModel() {
+    val state =
+        MutableStateFlow(
+            SourcePreparationState(
+                languages =
+                    if (preferences.enabledLanguages.isSet()) {
+                        preferences.enabledLanguages.get()
+                    } else {
+                        preferences.enabledLanguages.get() + setOf("pt-BR", "en")
+                    }
+            )
+        )
+    val queue = extensions.preparationQueue
+    private var operation: Job? = null
+    private var storesJob: Job? = null
+
+    init {
+        reloadStores()
+        viewModelScope.launch {
+            extensions.installedExtensionsFlow.collect { installed ->
+                state.update {
+                    it.copy(
+                        installedVersions =
+                            installed.associate { extension ->
+                                extension.pkgName to extension.versionCode
+                            },
+                        sharedPackages =
+                            installed
+                                .filter { extension -> extension.isShared }
+                                .map { extension -> extension.pkgName }
+                                .toSet(),
+                    )
+                }
+            }
+        }
+    }
+
+    fun reloadStores() {
+        storesJob?.cancel()
+        state.update { it.copy(error = null) }
+        storesJob =
+            viewModelScope.launch(dispatcher) {
+                repository
+                    .getAllAsFlow()
+                    .catch { state.update { it.copy(error = PreparationError.STORES) } }
+                    .collect { stores ->
+                        state.update { old ->
+                            val selected =
+                                old.selectedRepositories.intersect(
+                                    stores.map(RepositoryIdentity::of).toSet()
+                                )
+                            old.copy(
+                                loaded = true,
+                                stores = stores,
+                                selectedRepositories = selected,
+                                catalogLoaded =
+                                    old.catalogLoaded && selected == old.selectedRepositories,
+                                available =
+                                    if (selected == old.selectedRepositories) {
+                                        old.available
+                                    } else {
+                                        emptyList()
+                                    },
+                            )
+                        }
+                    }
+            }
+    }
+
+    fun consent(value: Boolean) {
+        state.update { it.copy(consent = value) }
+    }
+
+    fun selectRepository(identity: RepositoryIdentity) {
+        if (
+            state.value.busy ||
+                queue.state.value.running ||
+                !state.value.consent ||
+                !identity.canVerify
+        ) {
+            return
+        }
+        state.update {
+            it.copy(
+                selectedRepositories = it.selectedRepositories.toggle(identity),
+                available = emptyList(),
+                catalogLoaded = false,
+            )
+        }
+    }
+
+    fun selection(value: PreparationSelection) {
+        state.update { it.copy(selection = value) }
+    }
+
+    fun language(value: String) {
+        state.update { it.copy(languages = it.languages.toggle(value)) }
+    }
+
+    fun allLanguages() {
+        state.update {
+            it.copy(
+                languages =
+                    it.available
+                        .flatMap { extension ->
+                            extension.sources.map { source -> source.lang } + extension.lang
+                        }
+                        .toSet()
+            )
+        }
+    }
+
+    fun manualPackage(value: String) {
+        state.update { it.copy(manualPackages = it.manualPackages.toggle(value)) }
+    }
+
+    fun includeNsfw(value: Boolean) {
+        if (value && !preferences.showNsfwSource.get()) {
+            state.update { it.copy(error = PreparationError.ADULT_DISABLED) }
+            return
+        }
+        state.update { it.copy(includeNsfw = value, error = null) }
+    }
+
+    fun dismissStore() {
+        state.update { it.copy(pendingStore = null) }
+    }
+
+    fun previewRepository(url: String) = operate {
+        check(state.value.consent)
+        check(RepositoryIdentity.isHttps(url.trim()))
+        val store = withTimeout(45_000) { service.fetch(url.trim()).getOrThrow() }
+        if (!RepositoryIdentity.of(store).canVerify) {
+            state.update { it.copy(error = PreparationError.UNSIGNED) }
+        } else {
+            state.update { it.copy(pendingStore = store) }
+        }
+    }
+
+    fun confirmRepository() = operate {
+        check(state.value.consent)
+        val store = requireNotNull(state.value.pendingStore)
+        withTimeout(45_000) { repository.insertVerified(store).getOrThrow() }
+        state.update {
+            it.copy(
+                pendingStore = null,
+                selectedRepositories = it.selectedRepositories + RepositoryIdentity.of(store),
+                catalogLoaded = false,
+                available = emptyList(),
+            )
+        }
+    }
+
+    fun loadCatalog() =
+        operate(PreparationError.CATALOG) {
+            check(state.value.consent)
+            val snapshot = state.value
+            check(snapshot.selectedRepositories.isNotEmpty())
+            val selected =
+                repository.getAll().filter {
+                    RepositoryIdentity.of(it) in snapshot.selectedRepositories
+                }
+            check(selected.size == snapshot.selectedRepositories.size)
+            val all = mutableListOf<Extension.Available>()
+            val failures = mutableListOf<String>()
+            for (store in selected) {
+                try {
+                    all +=
+                        withTimeout(45_000) { service.getExtensions(store).getOrThrow() }
+                            .filter {
+                                RepositoryIdentity.of(it.store) == RepositoryIdentity.of(store)
+                            }
+                } catch (error: kotlinx.coroutines.TimeoutCancellationException) {
+                    failures += store.name
+                } catch (error: CancellationException) {
+                    throw error
+                } catch (_: Exception) {
+                    failures += store.name
+                }
+            }
+            val library = favorites.await().map { it.source }.toSet()
+            state.update {
+                it.copy(
+                    available = all,
+                    catalogLoaded = true,
+                    catalogFailures = failures,
+                    librarySources = library,
+                    selection =
+                        if (library.isEmpty()) {
+                            PreparationSelection.LANGUAGES
+                        } else {
+                            PreparationSelection.LIBRARY
+                        },
+                )
+            }
+        }
+
+    fun prepare() {
+        val snapshot = state.value
+        if (snapshot.busy || !snapshot.catalogLoaded || !snapshot.consent) return
+        val plan = snapshot.plan
+        if (queue.start(plan.extensions, snapshot.consent)) {
+            val reviewed =
+                plan.extensions
+                    .map {
+                        eu.kanade.tachiyomi.extension.util.RestoredRepositoryTrust.identity(
+                            it.store.indexUrl,
+                            it.store.signingKey,
+                        )
+                    }
+                    .toSet()
+            preferences.pendingRestoredRepositoryTrust.set(
+                preferences.pendingRestoredRepositoryTrust.get() - reviewed
+            )
+        }
+    }
+
+    private fun operate(
+        error: PreparationError = PreparationError.REPOSITORY,
+        action: suspend () -> Unit,
+    ) {
+        if (operation?.isCompleted == false || queue.state.value.running || !state.value.loaded) {
+            return
+        }
+        state.update { it.copy(busy = true, error = null) }
+        operation =
+            viewModelScope.launch(dispatcher) {
+                try {
+                    action()
+                } catch (_: TimeoutCancellationException) {
+                    currentCoroutineContext().ensureActive()
+                    state.update { it.copy(error = error) }
+                } catch (cancelled: CancellationException) {
+                    throw cancelled
+                } catch (_: Exception) {
+                    state.update { it.copy(error = error) }
+                } finally {
+                    state.update { it.copy(busy = false) }
+                }
+            }
+    }
+
+    private fun <T> Set<T>.toggle(value: T): Set<T> =
+        if (value in this) this - value else this + value
+}
