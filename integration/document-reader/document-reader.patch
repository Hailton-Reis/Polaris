+            val repository = mockk<ExtensionStoreRepository>()
+            coEvery { repository.getAll() } returns emptyList()
+            val prefs = SourcePreferences(InMemoryPreferenceStore())
+            ExtensionStoreRestorer(mockk<Database>(relaxed = true), repository, prefs)(
+                backupExtensionStoreMapper(store)
+            )
+            coEvery { repository.getAll() } returns listOf(store)
+            assertFalse(
+                TrustExtension(repository, prefs).isTrusted(packageInfo(), listOf(store.signingKey))
+            )
+            prefs.pendingRestoredRepositoryTrust.set(
+                emptySet()
+            ) // Explicit review, as in the preparation guide.
+            assertTrue(
+                TrustExtension(repository, prefs).isTrusted(packageInfo(), listOf(store.signingKey))
+            )
+        }
+
+    @Test
+    fun `a second import cannot launder a previously pending certificate into trusted state`() =
+        runTest {
+            val repository = mockk<ExtensionStoreRepository>()
+            coEvery { repository.getAll() } returns listOf(store)
+            val prefs = SourcePreferences(InMemoryPreferenceStore())
+            val identity = RestoredRepositoryTrust.identity(store.indexUrl, store.signingKey)
+            prefs.pendingRestoredRepositoryTrust.set(setOf(identity))
+            ExtensionStoreRestorer(mockk<Database>(relaxed = true), repository, prefs)(
+                backupExtensionStoreMapper(store)
+            )
+            assertEquals(setOf(identity), prefs.pendingRestoredRepositoryTrust.get())
+            assertFalse(
+                TrustExtension(repository, prefs).isTrusted(packageInfo(), listOf(store.signingKey))
+            )
+        }
+
+    @Test
+    fun `an unchanged repository already reviewed on this device keeps its local trust`() =
+        runTest {
+            val repository = mockk<ExtensionStoreRepository>()
+            coEvery { repository.getAll() } returns listOf(store)
+            val prefs = SourcePreferences(InMemoryPreferenceStore())
+            ExtensionStoreRestorer(mockk<Database>(relaxed = true), repository, prefs)(
+                backupExtensionStoreMapper(store)
+            )
+            assertTrue(prefs.pendingRestoredRepositoryTrust.get().isEmpty())
+            assertTrue(
+                TrustExtension(repository, prefs).isTrusted(packageInfo(), listOf(store.signingKey))
+            )
+        }
