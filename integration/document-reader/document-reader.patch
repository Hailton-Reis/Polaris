+import org.junit.jupiter.api.Test
+
+class TranslationCandidatePolicyTest {
+    @Test
+    fun `preserves meaningful single-character dialogue across scripts`() {
+        listOf("I", "A", "好", "私", "네", "?").forEach {
+            assertTrue(TranslationCandidatePolicy.retainRecognizedText(it))
+        }
+        assertFalse(TranslationCandidatePolicy.retainRecognizedText(" \n\t"))
+    }
+
+    @Test
+    fun `large short dialogue inside a detected balloon is not removed as a sound effect`() {
+        val block = block("NO!", balloon = true)
+        assertFalse(TranslationCandidatePolicy.isLikelySoundEffect(block, 720, 12_000))
+    }
+
+    @Test
+    fun `unboxed short oversized lettering retains existing sound-effect classification`() {
+        assertTrue(TranslationCandidatePolicy.isLikelySoundEffect(block("BOOM", balloon = false), 720, 12_000))
+    }
+
+    @Test
+    fun `normal captions and long dialogue do not become sound effects`() {
+        val long = block("This is an ordinary sentence outside a balloon", balloon = false)
+        assertFalse(TranslationCandidatePolicy.isLikelySoundEffect(long, 720, 12_000))
+        assertFalse(
+            TranslationCandidatePolicy.isLikelySoundEffect(block("Yes", false).copy(symWidth = 12f), 720, 12_000),
