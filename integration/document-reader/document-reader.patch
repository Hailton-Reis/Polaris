+package eu.kanade.translation.presentation
+
+import android.os.Bundle
+import android.widget.FrameLayout
+import androidx.activity.ComponentActivity
+import androidx.compose.foundation.Canvas
+import androidx.compose.foundation.background
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.runtime.CompositionLocalProvider
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.geometry.Offset
+import androidx.compose.ui.geometry.Size
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.nativeCanvas
+import androidx.compose.ui.platform.ComposeView
+import androidx.compose.ui.platform.LocalDensity
+import androidx.compose.ui.platform.ViewCompositionStrategy
+import androidx.compose.ui.text.font.FontFamily
+import androidx.compose.ui.unit.Density
+import eu.kanade.translation.data.TranslationFont
+import eu.kanade.translation.model.TranslationBlock
+import eu.kanade.translation.model.TranslationPageLayout
+import eu.kanade.translation.model.TranslationRegion
+import android.graphics.Paint as AndroidPaint
+
+/** Isolated, non-exported renderer fixture; never used by the reader or production Application. */
+class TranslationSurfaceTestActivity : ComponentActivity() {
+    lateinit var composeView: ComposeView
+        private set
+    lateinit var layouts: List<TranslationRegion>
+        private set
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        val scene = intent.getStringExtra("scene") ?: "caption"
+        val scale = intent.getFloatExtra("scale", 1f)
+        val drawOverlays = intent.getBooleanExtra("overlays", true)
+        val panelScene = scene == "caption" || scene == "pt-caption"
+        val whiteScene = scene == "white" || scene == "pt-white"
+        val typeface = if (scene.startsWith("pt-")) {
+            TranslationFont.ANIME_ACE.readerTypeface()
+        } else {
+            TranslationTypeface(FontFamily.Default)
+        }
+        val whiteText = if (scene == "pt-white") {
+            "AÇÃO E PROTEÇÃO. VOCÊ ESTÁ AQUI, NÃO ESTÁ?"
+        } else {
+            "UM TEXTO DENTRO DO BALÃO BRANCO."
+        }
+        val captionText = if (scene == "pt-caption") {
+            "AÇÃO, CORAÇÃO E PROTEÇÃO. VOCÊ PODE CONTINUAR!"
+        } else {
+            "MINHAS ESTATÍSTICAS E HABILIDADES. PRECISO DE OUTRA COISA."
+        }
+        val blocks = when (scene) {
+            "patch" -> listOf(
+                block(
+                    10f,
+                    10f,
+                    4f,
+                    4f,
+                    "X",
+                ).copy(cleanupRegion = TranslationRegion(10f, 10f, 4f, 4f), backgroundColor = WHITE),
+            )
+            "white", "pt-white" -> listOf(
+                block(55f, 65f, 90f, 36f, whiteText).copy(
+                    cleanupRegion = TranslationRegion(50f, 60f, 100f, 50f),
+                    layoutRegion = TranslationRegion(45f, 48f, 110f, 70f),
+                    backgroundColor = WHITE,
+                    balloonDetected = true,
+                ),
+            )
+            "titles" -> listOf(
+                block(
+                    30f,
+                    40f,
+                    140f,
+                    48f,
+                    "TÍTULO GRANDE EM DUAS LINHAS",
+                ).copy(layoutRegion = TranslationRegion(15f, 30f, 170f, 80f), foregroundColor = RED),
+                block(
+                    50f,
+                    80f,
+                    100f,
+                    22f,
+                    "CAPÍTULO QUARENTA",
+                ).copy(layoutRegion = TranslationRegion(35f, 65f, 130f, 70f), foregroundColor = BLUE),
+            )
+            else -> listOf(
+                block(30f, 50f, 140f, 60f, captionText).copy(
+                    cleanupRegion = TranslationRegion(25f, 45f, 150f, 70f),
+                    layoutRegion = TranslationRegion(10f, 20f, 180f, 120f),
+                    backgroundColor = PANEL,
+                    foregroundColor = WHITE,
+                ),
+            )
+        }
+        layouts = TranslationPageLayout.resolve(blocks, PAGE_SIZE, PAGE_SIZE)
+        composeView = ComposeView(this).apply {
+            layoutParams = FrameLayout.LayoutParams(VIEWPORT_SIZE, VIEWPORT_SIZE)
+            setViewCompositionStrategy(ViewCompositionStrategy.DisposeOnViewTreeLifecycleDestroyed)
+            setContent {
+                CompositionLocalProvider(LocalDensity provides Density(1f)) {
+                    Box(Modifier.fillMaxSize().background(Color(ART))) {
+                        Canvas(Modifier.fillMaxSize()) {
+                            if (panelScene) {
+                                drawRect(
+                                    Color(PANEL),
+                                    Offset(20f * scale, 40f * scale),
+                                    Size(160f * scale, 80f * scale),
+                                )
+                            } else if (whiteScene) {
+                                drawOval(
+                                    Color.White,
+                                    Offset(20f * scale, 25f * scale),
+                                    Size(160f * scale, 120f * scale),
+                                )
+                            }
+                            if (panelScene || whiteScene) {
+                                val paint = AndroidPaint(AndroidPaint.ANTI_ALIAS_FLAG).apply {
+                                    color = if (panelScene) WHITE else BLACK
+                                    textSize = 8f * scale
+                                }
+                                drawContext.canvas.nativeCanvas.drawText(
+                                    "ORIGINAL SOURCE",
+                                    60f * scale,
+                                    82f * scale,
+                                    paint,
+                                )
+                            }
+                        }
+                        if (drawOverlays) {
+                            blocks.forEach { b -> TranslationCleanupBlock(b, scale, PAGE_SIZE, PAGE_SIZE) }
+                            if (scene != "patch") {
+                                blocks.forEachIndexed { index, b ->
+                                    SmartTranslationBlock(
+                                        block = b,
+                                        scaleFactor = scale,
+                                        pageWidth = PAGE_SIZE,
+                                        pageHeight = PAGE_SIZE,
+                                        fontFamily = typeface.family,
+                                        cedillaFontFamily = typeface.cedillaFallback,
+                                        layoutRegion = layouts[index],
+                                    )
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        setContentView(FrameLayout(this).apply { addView(composeView) })
+    }
+
+    private fun block(x: Float, y: Float, width: Float, height: Float, translation: String) = TranslationBlock(
+        text = "Original source", translation = translation, x = x, y = y, width = width, height = height,
+        symWidth = 6f, symHeight = 12f, angle = 0f, geometryVersion = 2,
+    )
+
+    companion object {
+        const val VIEWPORT_SIZE = 480
+        const val PAGE_SIZE = 200f
+        const val PANEL = 0xFF303044.toInt()
+        const val ART = 0xFFA0B5C5.toInt()
+        const val WHITE = -1
+        const val BLACK = 0xFF000000.toInt()
+        const val RED = 0xFFFF0000.toInt()
+        const val BLUE = 0xFF0000FF.toInt()
+    }
+}
