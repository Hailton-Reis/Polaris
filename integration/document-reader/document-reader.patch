--- /dev/null
+++ b/app/src/test/java/eu/kanade/tachiyomi/extension/util/PrivateExtensionFilesTest.kt
@@ -0,0 +1,134 @@
+package eu.kanade.tachiyomi.extension.util
+
+import kotlinx.coroutines.CancellationException
+import org.junit.jupiter.api.AfterEach
+import org.junit.jupiter.api.Assertions.assertArrayEquals
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.assertThrows
+import org.junit.jupiter.api.io.TempDir
+import java.io.File
+import java.io.IOException
+import java.nio.file.Files
+import java.nio.file.attribute.DosFileAttributes
+import java.nio.file.attribute.PosixFilePermission
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.ExecutionException
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+
+class PrivateExtensionFilesTest {
+    @TempDir lateinit var folder: File
+
+    @AfterEach fun unprotectTestFiles() {
+        folder.walk().forEach { it.setWritable(true) }
+    }
+    private val original = "working extension".encodeToByteArray()
+    private val replacement = ByteArray(180_000) { (it % 251).toByte() }
+    private fun target() = File(folder, "source.ext").apply { writeBytes(original) }
+    private fun source() = File(folder, "download.apk").apply { writeBytes(replacement) }
+    private fun noPending() = assertTrue(folder.listFiles()!!.none { it.name.endsWith(".pending") })
+
+    private fun assertReadOnly(file: File) {
+        if (Files.getFileStore(file.toPath()).supportsFileAttributeView("posix")) {
+            assertFalse(PosixFilePermission.OWNER_WRITE in Files.getPosixFilePermissions(file.toPath()))
+        } else {
+            assertTrue(Files.readAttributes(file.toPath(), DosFileAttributes::class.java).isReadOnly)
+        }
+    }
+
+    @Test fun `old bytes remain visible through validation and successful replacement is read only`() {
+        val target = target()
+        PrivateExtensionFiles.replace(source(), target) { staged ->
+            assertArrayEquals(original, target.readBytes())
+            assertArrayEquals(replacement, staged.readBytes())
+            assertEquals(folder, staged.parentFile)
+            assertReadOnly(staged)
+        }
+        assertArrayEquals(replacement, target.readBytes())
+        assertReadOnly(target)
+        noPending()
+    }
+
+    @Test fun `cancelled copy preserves the old file and cleans the staged file`() {
+        val target = target()
+        var checks = 0
+        assertThrows<CancellationException> {
+            PrivateExtensionFiles.replace(source(), target, { if (++checks == 3) throw CancellationException() }) {}
+        }
+        assertArrayEquals(original, target.readBytes())
+        noPending()
+    }
+
+    @Test fun `invalid staged package never replaces the old extension`() {
+        val target = target()
+        assertThrows<IOException> {
+            PrivateExtensionFiles.replace(source(), target) { throw IOException("Signature validation failed") }
+        }
+        assertArrayEquals(original, target.readBytes())
+        noPending()
+    }
+
+    @Test fun `failed atomic move preserves the old destination`() {
+        val target = target()
+        assertThrows<IOException> {
+            PrivateExtensionFiles.replace(source(), target) { staged -> assertTrue(staged.delete()) }
+        }
+        assertArrayEquals(original, target.readBytes())
+        noPending()
+    }
+
+    @Test fun `missing download cannot erase an installed extension`() {
+        val target = target()
+        assertThrows<IllegalArgumentException> {
+            PrivateExtensionFiles.replace(File(folder, "missing.apk"), target) {}
+        }
+        assertArrayEquals(original, target.readBytes())
+        noPending()
+    }
+
+    @Test fun `failed initial installation leaves no loadable target`() {
+        val target = File(folder, "new.ext")
+        assertThrows<IOException> {
+            PrivateExtensionFiles.replace(source(), target) { throw IOException("Invalid package") }
+        }
+        assertFalse(target.exists())
+        noPending()
+    }
+
+    @Test fun `deletion waits for an ongoing replacement and cannot be undone by that copy`() {
+        val executor = Executors.newFixedThreadPool(2)
+        val entered = CountDownLatch(1)
+        val release = CountDownLatch(1)
+        val deletionRequested = CountDownLatch(1)
+        val target = target()
+        val source = source()
+        try {
+            val copy = executor.submit {
+                PrivateExtensionFiles.replace(source, target) {
+                    entered.countDown()
+                    assertTrue(release.await(5, TimeUnit.SECONDS))
+                    throw CancellationException("Uninstall cancelled the in-flight copy")
+                }
+            }
+            assertTrue(entered.await(5, TimeUnit.SECONDS))
+            val deletion = executor.submit<Boolean> {
+                deletionRequested.countDown()
+                PrivateExtensionFiles.delete(target)
+            }
+            assertTrue(deletionRequested.await(5, TimeUnit.SECONDS))
+            assertFalse(deletion.isDone)
+            release.countDown()
+            val error = assertThrows<ExecutionException> { copy.get(5, TimeUnit.SECONDS) }
+            assertTrue(error.cause is CancellationException)
+            assertTrue(deletion.get(5, TimeUnit.SECONDS))
+            assertFalse(target.exists())
+            noPending()
+        } finally {
+            release.countDown()
+            executor.shutdownNow()
+        }
+    }
+}
