+package eu.kanade.translation.presentation
+
+import android.content.Intent
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import androidx.compose.foundation.Canvas
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.runtime.CompositionLocalProvider
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.asImageBitmap
+import androidx.compose.ui.platform.LocalDensity
+import androidx.compose.ui.unit.Density
+import androidx.compose.ui.unit.IntOffset
+import androidx.compose.ui.unit.IntSize
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import androidx.test.platform.app.InstrumentationRegistry
+import eu.kanade.translation.data.TranslationFont
+import eu.kanade.translation.model.TranslationBlock
+import eu.kanade.translation.model.TranslationPageLayout
+import eu.kanade.translation.model.sourceRegion
+import eu.kanade.translation.recognizer.SpeechBubbleAnalyzer
+import org.junit.Assert.assertTrue
+import org.junit.Assume.assumeTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import java.io.File
+
+/** Optional locally supplied original. Portuguese strings exercise typography, not machine translation. */
+@RunWith(AndroidJUnit4::class)
+class PortugueseRealPageTypographyTest {
+    @Test fun drawComicPortugueseOnTheReportedTextOnArtworkCase() {
+        val instrumentation = InstrumentationRegistry.getInstrumentation()
+        val context = instrumentation.targetContext
+        val folder = context.getExternalFilesDir("portuguese-typography-checks")!!
+        val file = File(folder, "stats-original.png")
+        assumeTrue("Supply the original crop locally for this opt-in scene", file.isFile)
+        val original = checkNotNull(BitmapFactory.decodeFile(file.path))
+        val blocks = listOf(
+            block(51f, 258f, 388f, 56f, "MINHAS ESTATÍSTICAS E HABILIDADES..."),
+            block(252f, 558f, 491f, 175f, "PRECISO DE MAIS PROTEÇÃO E FORÇA PARA CONTINUAR?"),
+        )
+        val analyzer = SpeechBubbleAnalyzer(original, 800, 950, blocks.map { it.sourceRegion() })
+        blocks.forEach { block ->
+            val analysis = analyzer.analyze(block)
+            block.cleanupRegion = analysis.cleanupRegion
+            block.layoutRegion = analysis.layoutRegion
+            block.backgroundColor = analysis.backgroundColor
+            block.foregroundColor = analysis.foregroundColor
+            block.balloonDetected = analysis.balloonDetected
+        }
+        val regions = TranslationPageLayout.resolve(blocks, 800f, 950f)
+        val face = TranslationFont.ANIME_ACE.readerTypeface()
+        val activity = instrumentation.startActivitySync(
+            Intent(context, TranslationSurfaceTestActivity::class.java).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK),
+        ) as TranslationSurfaceTestActivity
+        try {
+            instrumentation.runOnMainSync {
+                activity.composeView.setContent {
+                    CompositionLocalProvider(LocalDensity provides Density(1f)) {
+                        Box(Modifier.fillMaxSize()) {
+                            Canvas(Modifier.fillMaxSize()) {
+                                drawImage(
+                                    original.asImageBitmap(),
+                                    srcOffset = IntOffset.Zero,
+                                    srcSize = IntSize(800, 950),
+                                    dstOffset = IntOffset.Zero,
+                                    dstSize = IntSize(400, 475),
+                                )
+                            }
+                            blocks.forEach { TranslationCleanupBlock(it, 0.5f, 800f, 950f) }
+                            blocks.forEachIndexed { index, block ->
+                                SmartTranslationBlock(
+                                    block = block,
+                                    scaleFactor = 0.5f,
+                                    pageWidth = 800f,
+                                    pageHeight = 950f,
+                                    fontFamily = face.family,
+                                    cedillaFontFamily = face.cedillaFallback,
+                                    layoutRegion = regions[index],
+                                )
+                            }
+                        }
+                    }
+                }
+            }
+            instrumentation.waitForIdleSync()
+            instrumentation.runOnMainSync {
+                val result = Bitmap.createBitmap(480, 480, Bitmap.Config.ARGB_8888)
+                activity.composeView.draw(android.graphics.Canvas(result))
+                File(folder, "real-stats-comic-portuguese.png").outputStream().use {
+                    assertTrue(result.compress(Bitmap.CompressFormat.PNG, 100, it))
+                }
+                result.recycle()
+            }
+        } finally {
+            instrumentation.runOnMainSync(activity::finish)
+            instrumentation.waitForIdleSync()
+            original.recycle()
+        }
+    }
+
+    private fun block(x: Float, y: Float, width: Float, height: Float, text: String) = TranslationBlock(
+        text = "Known source paragraph", translation = text, x = x, y = y, width = width, height = height,
+        symWidth = 26f, symHeight = 50f, angle = 0f, geometryVersion = 2,
+    )
+}
