+package eu.kanade.tachiyomi.ui.documents
+
+import okhttp3.HttpUrl.Companion.toHttpUrlOrNull
+import java.net.URLEncoder
+
+/** A user-selected website, opened in the in-app browser; it is not a metadata API. */
+object DocumentWebSearch {
+    const val DEFAULT = "https://scholar.google.com/scholar?q={query}"
+
+    fun url(template: String, query: String): String {
+        require(query.trim().length in 2..300)
+        require(template.length <= 2000 && template.contains("{query}"))
+        val encoded = URLEncoder.encode(query.trim(), "UTF-8").replace("+", "%20")
+        val base = requireNotNull(template.replace("{query}", "polaris").toHttpUrlOrNull())
+        val result = requireNotNull(template.replace("{query}", encoded).toHttpUrlOrNull())
+        require(result.host == base.host && result.username.isEmpty() && result.password.isEmpty())
+        return result.toString()
+    }
+}
