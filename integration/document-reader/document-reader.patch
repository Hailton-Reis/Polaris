+
+/** Actual creator and real gzip/protobuf/files; UniFile adapter simulates document provider failures. */
+class BackupCreatorTransactionTest {
+    @TempDir lateinit var folder: File
+    private val context = mockk<Context>()
+    private val resolver = mockk<ContentResolver>()
+    private val timestamp = mockk<Preference<Long>>(relaxed = true)
+    private val preferences = mockk<BackupPreferences>()
+    private val favorites = mockk<GetFavorites>()
+    private val sourceCreator = mockk<SourcesBackupCreator>()
+    private val preferenceCreator = mockk<PreferenceBackupCreator>()
+    private val options = BackupOptions(
+        libraryEntries = false,
+        categories = false,
+        readEntries = false,
+        appSettings = true,
+        sourceSettings = false,
+        extensionStores = false,
+    )
+    private val events = mutableListOf<String>()
+    private val uriFiles = ConcurrentHashMap<Uri, File>()
+    private val fileUris = ConcurrentHashMap<String, Uri>()
+    private var failWrite = false
+    private var corruptRead = false
+    private var denyRead = false
+    private var failRename = false
+    private var cancelWrite = false
+    private var unknownLength = false
+
+    @BeforeEach fun setup() {
+        mockkStatic("tachiyomi.core.common.i18n.LocalizeKt")
+        every { context.stringResource(any<StringResource>()) } returns "backup-operation-failed"
+        every { context.contentResolver } returns resolver
+        every { resolver.openInputStream(any()) } answers { uriFiles.getValue(firstArg()).inputStream() }
+        every { preferences.lastAutoBackupTimestamp } returns timestamp
+        coEvery { favorites.await() } returns emptyList()
+        every { sourceCreator(any()) } returns emptyList()
+        every { preferenceCreator.createApp(false) } returns listOf(
+            BackupPreference("sample", StringPreferenceValue("ação")),
+        )
+    }
+
+    @AfterEach fun teardown() = unmockkStatic("tachiyomi.core.common.i18n.LocalizeKt")
+
+    private fun uri(file: File): Uri = fileUris.getOrPut(file.path) {
+        mockk<Uri>().also { value ->
+            every { value.toString() } returns file.path
+            uriFiles[value] = file
+        }
+    }
+
+    private fun document(initial: File, created: Boolean = false): UniFile {
+        var file = initial
+        val node = mockk<UniFile>()
+        every { node.uri } answers { uri(file) }
+        every { node.name } answers { file.name }
+        every { node.isDirectory } answers { file.isDirectory }
+        every { node.length() } answers { if (unknownLength) 0 else file.length() }
+        every { node.listFiles() } answers { file.listFiles().orEmpty().map { document(it) }.toTypedArray() }
+        every { node.listFiles(any<FilenameFilter>()) } answers {
+            val filter = firstArg<FilenameFilter>()
+            file.listFiles().orEmpty().filter { filter.accept(node, it.name) }.map { document(it) }.toTypedArray()
+        }
+        every { node.createFile(any()) } answers {
+            val child = File(file, firstArg<String>())
+            check(child.createNewFile())
+            events += "create:${child.name}"
+            document(child, true)
+        }
+        every { node.openOutputStream() } answers {
+            events += "write:${file.name}"
+            if (created && (failWrite || cancelWrite)) {
+                object : OutputStream() {
+                    override fun write(value: Int) {
+                        if (cancelWrite) throw CancellationException("Cancelled")
+                        throw IOException("Disk full")
+                    }
+                }
+            } else {
+                file.outputStream()
+            }
+        }
+        every { node.openInputStream() } answers {
+            events += "read:${file.name}"
+            if (created && denyRead) throw SecurityException("Write-only provider")
+            if (created && corruptRead) ByteArrayInputStream(byteArrayOf(1, 2, 3)) else file.inputStream()
+        }
+        every { node.renameTo(any()) } answers {
+            events += "rename:${file.name}"
+            if (failRename) {
+                false
+            } else {
+                val destination = File(file.parentFile, firstArg<String>())
+                Files.move(file.toPath(), destination.toPath())
+                file = destination
+                true
+            }
+        }
+        every { node.delete() } answers {
+            events += "delete:${file.name}"
+            file.delete()
+        }
+        return node
+    }
+
+    private fun creator(target: UniFile = document(folder), automatic: Boolean = true) = BackupCreator(
+        context, automatic, ProtoBuf, favorites, preferences, mockk<MangaRepository>(),
+        mockk<CategoriesBackupCreator>(), mockk<MangaBackupCreator>(), preferenceCreator,
+        mockk<ExtensionStoresBackupCreator>(), sourceCreator, { target },
+    )
+
+    private fun oldCopies(): Map<String, ByteArray> {
+        val payload = ProtoBuf.encodeToByteArray(Backup.serializer(), Backup(listOf(BackupManga(10, "/old", "Old"))))
+        val bytes = ByteArrayOutputStream().also { buffer ->
+            GZIPOutputStream(buffer).use { it.write(payload) }
+        }.toByteArray()
+        return (0..3).associate { minute ->
+            val name = "${BuildConfig.APPLICATION_ID}_2026-01-01_00-0$minute.tachibk"
+            File(folder, name).writeBytes(bytes)
+            name to bytes
+        }
+    }
+
+    private fun assertPreserved(copies: Map<String, ByteArray>) {
+        copies.forEach { (name, bytes) -> assertArrayEquals(bytes, File(folder, name).readBytes()) }
+        assertEquals(copies.size, folder.listFiles()!!.size)
+        verify(exactly = 0) { timestamp.set(any()) }
+    }
+
+    @Test fun `failed write preserves all four earlier copies and success timestamp`() = runTest {
+        val copies = oldCopies()
+        failWrite = true
+        assertThrows<IOException> { creator().backup(uri(folder), options) }
+        assertPreserved(copies)
+    }
+
+    @Test fun `corrupt read back never prunes copies or records success`() = runTest {
+        val copies = oldCopies()
+        corruptRead = true
+        val error = assertThrows<IOException> { creator().backup(uri(folder), options) }
+        assertTrue(generateSequence<Throwable>(error) { it.cause }.any { it is BackupReadbackMismatch })
+        assertPreserved(copies)
+    }
+
+    @Test fun `write only destination reports verification unavailable and preserves old copies`() = runTest {
+        val copies = oldCopies()
+        denyRead = true
+        val error = assertThrows<IOException> { creator().backup(uri(folder), options) }
+        assertTrue(generateSequence<Throwable>(error) { it.cause }.any { it is BackupReadbackUnavailable })
+        assertPreserved(copies)
+    }
+
+    @Test fun `cancelled creation preserves prior backups and cancellation identity`() = runTest {
+        val copies = oldCopies()
+        cancelWrite = true
+        assertThrows<CancellationException> { creator().backup(uri(folder), options) }
+        assertPreserved(copies)
+    }
+
+    @Test fun `provider refusing final rename cannot trigger retention`() = runTest {
+        val copies = oldCopies()
+        failRename = true
+        assertThrows<IOException> { creator().backup(uri(folder), options) }
+        assertPreserved(copies)
+    }
+
+    @Test fun `only a verified final document allows pruning the oldest copy`() = runTest {
+        val copies = oldCopies()
+        val location = creator().backup(uri(folder), options)
+        assertFalse(location.endsWith(".pending"))
+        val parsed = BackupDecoder(context, ProtoBuf).decode(fileUris.getValue(location))
+        assertEquals("ação", (parsed.backupPreferences.single().value as StringPreferenceValue).value)
+        assertEquals(4, folder.listFiles()!!.size)
+        assertFalse(File(folder, copies.keys.min()).exists())
+        copies.filterKeys { it != copies.keys.min() }.forEach { (name, bytes) ->
+            assertArrayEquals(bytes, File(folder, name).readBytes())
+        }
+        val firstDeletion = events.indexOfFirst { it.startsWith("delete:") }
+        val finalRead = events.indexOf("read:${File(location).name}")
+        assertTrue(finalRead >= 0 && firstDeletion > finalRead)
+        verify(exactly = 1) { timestamp.set(any()) }
+    }
+
+    @Test fun `unreadable old files never displace valid backup copies`() = runTest {
+        oldCopies()
+        val broken = File(folder, "${BuildConfig.APPLICATION_ID}_2026-11-01_00-00.tachibk")
+        broken.writeText("incomplete")
+        creator().backup(uri(folder), options)
+        assertEquals("incomplete", broken.readText())
+        assertEquals(5, folder.listFiles()!!.size)
+    }
+
+    @Test fun `manual export never truncates or deletes a nonempty selected document`() = runTest {
+        val file = File(folder, "selected.tachibk").apply { writeText("precious existing data") }
+        assertThrows<IOException> { creator(document(file), false).backup(uri(file), options) }
+        assertEquals("precious existing data", file.readText())
+        assertTrue(events.none { it.startsWith("write:") || it.startsWith("delete:") })
+    }
+
+    @Test fun `unknown provider length cannot cause an existing document to be overwritten`() = runTest {
+        val file = File(folder, "selected.tachibk").apply { writeText("existing data") }
+        unknownLength = true
+        assertThrows<IOException> { creator(document(file), false).backup(uri(file), options) }
+        assertEquals("existing data", file.readText())
+        assertTrue(events.none { it.startsWith("write:") || it.startsWith("delete:") })
+    }
+
+    @Test fun `backups with same timestamp have distinct names and other app namespaces are unmanaged`() {
+        val first = BackupRetention.filename(BuildConfig.APPLICATION_ID, Date(0))
+        val second = BackupRetention.filename(BuildConfig.APPLICATION_ID, Date(0))
+        assertTrue(first != second)
+        assertTrue(BackupRetention.isManaged(BuildConfig.APPLICATION_ID, first))
+        assertFalse(BackupRetention.isManaged(BuildConfig.APPLICATION_ID, first + ".pending"))
+        val otherNamespace = first.replace(BuildConfig.APPLICATION_ID, BuildConfig.APPLICATION_ID.replace('.', 'X'))
+        assertFalse(BackupRetention.isManaged(BuildConfig.APPLICATION_ID, otherNamespace))
+    }
+
+    @Test fun `two creator instances serialize writing and retain four complete archives`() = runTest {
+        oldCopies()
+        val first = creator()
+        val second = creator()
+        val a = async { first.backup(uri(folder), options) }
+        val b = async { second.backup(uri(folder), options) }
+        val locations = setOf(a.await(), b.await())
+        assertEquals(2, locations.size)
+        assertEquals(4, folder.listFiles()!!.size)
+        assertTrue(folder.listFiles()!!.none { it.name.endsWith(".pending") })
+        verify(exactly = 2) { timestamp.set(any()) }
+    }
+}
