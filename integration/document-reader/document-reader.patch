+package eu.kanade.tachiyomi.data.profile
+
+import dev.icerock.moko.resources.StringResource
+import kotlinx.serialization.Serializable
+import tachiyomi.domain.chapter.model.Chapter
+import tachiyomi.domain.chapter.model.ChapterVersions
+import tachiyomi.i18n.at.ATMR as MR
+
+/** Cosmetic titles only. No reader capability, theme or icon depends on XP. */
+data class PolarisTitle(val unlockLevel: Int, val titleRes: StringResource) {
+    val id: String
+        get() = "level_$unlockLevel"
+}
+
+@Serializable data class ProfileProgress(val xp: Long, val readHighWater: Long)
+
+object PolarisLevelManager {
+    const val MAX_LEVEL = 200
+    const val XP_PER_CHAPTER_READ = 90L
+    const val MAX_XP = 4_950_125L
+    val ALL_TITLES =
+        listOf(
+            PolarisTitle(1, MR.strings.polaris_title_1),
+            PolarisTitle(10, MR.strings.polaris_title_10),
+            PolarisTitle(20, MR.strings.polaris_title_20),
+            PolarisTitle(30, MR.strings.polaris_title_30),
+            PolarisTitle(40, MR.strings.polaris_title_40),
+            PolarisTitle(50, MR.strings.polaris_title_50),
+            PolarisTitle(60, MR.strings.polaris_title_60),
+            PolarisTitle(70, MR.strings.polaris_title_70),
+            PolarisTitle(80, MR.strings.polaris_title_80),
+            PolarisTitle(90, MR.strings.polaris_title_90),
+            PolarisTitle(100, MR.strings.polaris_title_100),
+            PolarisTitle(110, MR.strings.polaris_title_110),
+            PolarisTitle(120, MR.strings.polaris_title_120),
+            PolarisTitle(130, MR.strings.polaris_title_130),
+            PolarisTitle(140, MR.strings.polaris_title_140),
+            PolarisTitle(150, MR.strings.polaris_title_150),
+            PolarisTitle(160, MR.strings.polaris_title_160),
+            PolarisTitle(170, MR.strings.polaris_title_170),
+            PolarisTitle(180, MR.strings.polaris_title_180),
+            PolarisTitle(190, MR.strings.polaris_title_190),
+            PolarisTitle(200, MR.strings.polaris_title_200),
+        )
+    private val legacyTitles =
+        mapOf(
+            "Mortal Comum" to "level_1",
+            "Desperto" to "level_10",
+            "Caçador Novato" to "level_20",
+            "Discípulo Externo" to "level_30",
+            "Explorador do Abismo" to "level_40",
+            "Caçador Rank C" to "level_50",
+            "Especialista Marcial" to "level_60",
+            "Caçador Rank B" to "level_70",
+            "Mestre das Sombras" to "level_80",
+            "Caçador Rank A" to "level_90",
+            "Formação do Núcleo" to "level_100",
+            "Senhor de Domínio" to "level_110",
+            "Caçador Rank S" to "level_120",
+            "Caçador Nacional" to "level_130",
+            "Alma Nascente" to "level_140",
+            "Soberano" to "level_150",
+            "Monarca" to "level_160",
+            "Shinigami" to "level_170",
+            "Imortal" to "level_180",
+            "Deus Marcial" to "level_190",
+            "Izanagi do Submundo" to "level_200",
+        )
+
+    fun calculateLevelFromXp(xp: Long): Int {
+        var level = 1
+        while (level < MAX_LEVEL && xp.coerceAtLeast(0) >= 125L * level * level) level++
+        return level
+    }
+
+    fun getXpRequiredForLevel(level: Int): Long =
+        125L * (level.coerceIn(1, MAX_LEVEL) - 1) * (level.coerceIn(1, MAX_LEVEL) - 1)
+
+    fun getUnlockedTitles(level: Int) = ALL_TITLES.filter { it.unlockLevel <= level }.reversed()
+
+    fun equippedTitle(saved: String?, level: Int): PolarisTitle {
+        val id = legacyTitles[saved] ?: saved
+        val unlocked = getUnlockedTitles(level)
+        return unlocked.firstOrNull { it.id == id } ?: unlocked.firstOrNull() ?: ALL_TITLES.first()
+    }
+
+    fun logicalReadCount(chapters: List<Chapter>): Long =
+        chapters
+            .groupBy { chapter ->
+                val key = ChapterVersions.key(chapter)
+                key to chapter.mangaId.takeIf { key.number == null }
+            }
+            .values
+            .count { versions -> versions.any { it.read } }
+            .toLong()
+
+    fun start(
+        read: Long,
+        legacyRead: Long,
+        legacyDownloads: Long,
+        preserveLegacy: Boolean,
+    ): ProfileProgress =
+        if (preserveLegacy) initialProgress(read, legacyRead, legacyDownloads)
+        else initialProgress(read, read, 0)
+
+    fun initialProgress(read: Long, legacyRead: Long, legacyDownloads: Long): ProfileProgress =
+        ProfileProgress(points(legacyRead) + points(legacyDownloads), read.coerceAtLeast(0))
+            .normalized()
+
+    fun advance(previous: ProfileProgress, read: Long): ProfileProgress {
+        val safe = previous.normalized()
+        val current = read.coerceAtLeast(0)
+        val gained = points((current - safe.readHighWater).coerceAtLeast(0))
+        return ProfileProgress(
+            (safe.xp + gained).coerceAtMost(MAX_XP),
+            maxOf(safe.readHighWater, current),
+        )
+    }
+
+    private fun points(count: Long): Long =
+        count.coerceIn(0, MAX_XP).times(XP_PER_CHAPTER_READ).coerceAtMost(MAX_XP)
+
+    fun ProfileProgress.normalized() =
+        copy(xp = xp.coerceIn(0, MAX_XP), readHighWater = readHighWater.coerceAtLeast(0))
+}
