+@file:Suppress("ktlint:standard:max-line-length")
+
+package eu.kanade.tachiyomi.ui.documents
+
+import kotlinx.coroutines.test.runTest
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.Protocol
+import okhttp3.Response
+import okhttp3.ResponseBody.Companion.toResponseBody
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertNull
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.assertThrows
+import java.io.IOException
+import java.util.Collections
+
+class DocumentSearchTest {
+    private val crossref = """{"message":{"items":[{"title":["Scientific article"],"DOI":"10.1234/a(1)","author":[{"given":"Ana","family":"Silva"}],"URL":"https://doi.org/10.1234/a(1)","link":[{"content-type":"application/pdf","URL":"https://example.invalid/article.pdf"}]}]}}"""
+    private val europe = """{"resultList":{"result":[{"id":"1","source":"MED","title":"Scientific article","doi":"10.1234/a(1)","pmcid":"PMC123","isOpenAccess":"Y","authorString":"Ana Silva"}]}}"""
+
+    @Test
+    fun `doi accepts explicit prefixes and preserves meaningful parentheses`() {
+        for (query in listOf("10.1234/a(1)", "DOI: 10.1234/a(1)", "HTTPS://DOI.ORG/10.1234/a(1)")) {
+            assertEquals("10.1234/a(1)", DocumentSearchParsers.doi(query))
+        }
+        assertNull(DocumentSearchParsers.doi("an article title"))
+    }
+
+    @Test
+    fun `crossref and europepmc results retain their origins and available links`() {
+        val first = DocumentSearchParsers.crossref(crossref, false).single()
+        val second = DocumentSearchParsers.europePmc(europe).single()
+        assertEquals("Ana Silva", first.authors)
+        assertEquals("https://example.invalid/article.pdf", first.documents.single().url)
+        assertEquals("https://europepmc.org/articles/PMC123?pdf=render", second.documents.single().url)
+        assertFalse(first.id == second.id)
+        assertEquals(first.doi, second.doi)
+    }
+
+    @Test
+    fun `book metadata never fabricates a direct full text download`() {
+        val hit = DocumentSearchParsers.openLibrary(
+            """{"docs":[{"key":"/works/OL123W","title":"Book","author_name":["Author"]}]}""",
+        ).single()
+        assertEquals("https://openlibrary.org/works/OL123W", hit.landing)
+        assertTrue(hit.documents.isEmpty())
+        val books = DocumentSearchParsers.gutendex(
+            """{"results":[{"id":12,"title":"Public book","authors":[{"name":"Writer"}],"formats":{"application/epub+zip":"https://example.invalid/book.epub","application/pdf":"file:///private"}}]}""",
+        )
+        assertEquals(1, books.single().documents.size)
+    }
+
+    @Test
+    fun `one provider failure still returns the other provider results`() = runTest {
+        val client = OkHttpClient.Builder().addInterceptor { chain ->
+            if (chain.request().url.host == "api.crossref.org") throw IOException("fixture unavailable")
+            Response.Builder().request(chain.request()).protocol(Protocol.HTTP_1_1).code(200).message("OK")
+                .body(europe.toResponseBody("application/json".toMediaType())).build()
+        }.build()
+        val result = DocumentSearch(client).search("science", DocumentSearchKind.ARTICLES, DocumentSearchField.ANY)
+        assertEquals(listOf("Crossref"), result.errors)
+        assertEquals("Europe PMC", result.hits.single().provider)
+        assertEquals(2, result.providers.size)
+    }
+
+    @Test
+    fun `title author and doi queries are encoded as provider parameters`() = runTest {
+        val requests = Collections.synchronizedList(mutableListOf<okhttp3.Request>())
+        val client = OkHttpClient.Builder().addInterceptor { chain ->
+            requests += chain.request()
+            val body = if (chain.request().url.host ==
+                "api.crossref.org"
+            ) {
+                "{\"message\":{\"items\":[]}}"
+            } else {
+                "{\"resultList\":{\"result\":[]}}"
+            }
+            Response.Builder().request(chain.request()).protocol(Protocol.HTTP_1_1).code(200).message("OK")
+                .body(body.toResponseBody("application/json".toMediaType())).build()
+        }.build()
+        DocumentSearch(client).search("Ada Lovelace", DocumentSearchKind.ARTICLES, DocumentSearchField.AUTHOR)
+        assertEquals(
+            "Ada Lovelace",
+            requests.single {
+                it.url.host == "api.crossref.org"
+            }.url.queryParameter("query.author"),
+        )
+        assertEquals(
+            "AUTH:\"Ada Lovelace\"",
+            requests.single {
+                it.url.host != "api.crossref.org"
+            }.url.queryParameter("query"),
+        )
+    }
+
+    @Test
+    fun `document progress merges memo without overwriting unrelated state`() {
+        val memo = JsonObject(mapOf("bookmark_note" to JsonPrimitive("keep")))
+        val merged = DocumentReadingPosition(3, 8, 24).merge(memo)
+        assertEquals(memo["bookmark_note"], merged["bookmark_note"])
+        assertEquals(DocumentReadingPosition(3, 8, 24), DocumentReadingPosition.from(merged))
+        assertEquals(
+            DocumentReadingPosition(),
+            DocumentReadingPosition.from(JsonObject(mapOf("polaris_document_section" to JsonPrimitive("bad")))),
+        )
+    }
+
+    @Test
+    fun `custom search website encodes input and rejects invalid templates`() {
+        val url = DocumentWebSearch.url("https://example.invalid/search?q={query}", "A & B / science")
+        assertEquals("A & B / science", url.toHttpUrl().queryParameter("q"))
+        assertThrows<IllegalArgumentException> { DocumentWebSearch.url("file:///tmp/{query}", "science") }
+        assertThrows<IllegalArgumentException> { DocumentWebSearch.url("https://example.invalid", "science") }
+        assertThrows<IllegalArgumentException> {
+            DocumentWebSearch.url("https://user:password@example.invalid?q={query}", "science")
+        }
+    }
+
+    @Test
+    fun `doi lookup routes books to scholarly providers and encodes the identifier once`() = runTest {
+        val requests = Collections.synchronizedList(mutableListOf<okhttp3.Request>())
+        val client = OkHttpClient.Builder().addInterceptor { chain ->
+            requests += chain.request()
+            val body = if (chain.request().url.host ==
+                "api.crossref.org"
+            ) {
+                "{\"message\":{}}"
+            } else {
+                "{\"resultList\":{\"result\":[]}}"
+            }
+            Response.Builder().request(chain.request()).protocol(Protocol.HTTP_1_1).code(200).message("OK")
+                .body(body.toResponseBody("application/json".toMediaType())).build()
+        }.build()
+        val result = DocumentSearch(
+            client,
+        ).search("DOI: 10.1234/a(1)", DocumentSearchKind.BOOKS, DocumentSearchField.DOI)
+        assertEquals(listOf("Crossref", "Europe PMC"), result.providers)
+        assertEquals("10.1234/a(1)", requests.single { it.url.host == "api.crossref.org" }.url.pathSegments.last())
+        assertEquals(
+            "DOI:\"10.1234/a(1)\"",
+            requests.single {
+                it.url.host != "api.crossref.org"
+            }.url.queryParameter("query"),
+        )
+    }
+
+    @Test
+    fun `provider metadata cannot create an unbounded result list`() {
+        val items = (1..40).joinToString(",") { "{\"key\":\"/works/OL${it}W\",\"title\":\"Book $it\"}" }
+        assertEquals(20, DocumentSearchParsers.openLibrary("{\"docs\":[$items]}").size)
+    }
+}
