@@ -0,0 +1,86 @@
+package eu.kanade.tachiyomi.extension.sandbox
+
+import android.os.ParcelFileDescriptor
+import java.io.ByteArrayOutputStream
+import java.io.InputStream
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonObject
+
+/** No arbitrary Parcelable, Java serialization, host Context, path or DI object crosses IPC. */
+internal object ExtensionSandboxProtocol {
+    const val DESCRIPTOR = "app.polaris.extension.sandbox.v1"
+    const val OPEN = 1
+    const val REQUEST = 2
+    const val CLOSE = 3
+    const val MAX_INPUT = 256 * 1024
+    const val MAX_OUTPUT = 4 * 1024 * 1024
+    val operations =
+        setOf("popular", "latest", "search", "update", "pages", "imageUrl", "imageRequest")
+
+    fun readBounded(stream: InputStream, limit: Int): ByteArray {
+        val out = ByteArrayOutputStream(minOf(limit, 8192))
+        val block = ByteArray(8192)
+        var total = 0
+        while (true) {
+            val read = stream.read(block, 0, minOf(block.size, limit - total + 1))
+            if (read < 0) break
+            if (read == 0) continue
+            total += read
+            require(total <= limit) { "Sandbox payload exceeds limit" }
+            out.write(block, 0, read)
+        }
+        return out.toByteArray()
+    }
+
+    fun input(bytes: ByteArray): JsonObject = parse(bytes, MAX_INPUT)
+
+    fun parse(bytes: ByteArray, limit: Int): JsonObject {
+        require(bytes.size <= limit) { "Sandbox input exceeds limit" }
+        var depth = 0
+        var quoted = false
+        var escaped = false
+        bytes.forEach { byte ->
+            val char = byte.toInt().toChar()
+            if (quoted) {
+                if (escaped) escaped = false
+                else if (char == '\\') escaped = true else if (char == '"') quoted = false
+            } else
+                when (char) {
+                    '"' -> quoted = true
+                    '{',
+                    '[' -> {
+                        depth++
+                        require(depth <= 32) { "Sandbox JSON nesting too deep" }
+                    }
+                    '}',
+                    ']' -> {
+                        depth--
+                        require(depth >= 0)
+                    }
+                }
+        }
+        require(!quoted && depth == 0)
+        return Json.parseToJsonElement(bytes.decodeToString()) as? JsonObject
+            ?: error("Expected object")
+    }
+
+    fun pipe(bytes: ByteArray): ParcelFileDescriptor {
+        require(bytes.size <= MAX_OUTPUT) { "Sandbox response exceeds limit" }
+        val pipe = ParcelFileDescriptor.createReliablePipe()
+        Thread(
+                {
+                    try {
+                        ParcelFileDescriptor.AutoCloseOutputStream(pipe[1]).use { it.write(bytes) }
+                    } catch (_: Exception) {
+                        runCatching { pipe[1].closeWithError("Response pipe closed") }
+                    }
+                },
+                "polaris-sandbox-reply",
+            )
+            .apply {
+                isDaemon = true
+                start()
+            }
+        return pipe[0]
+    }
+}
