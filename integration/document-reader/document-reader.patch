+package eu.kanade.presentation.manga
+
+import androidx.compose.foundation.layout.*
+import androidx.compose.foundation.rememberScrollState
+import androidx.compose.foundation.verticalScroll
+import androidx.compose.material3.*
+import androidx.compose.runtime.*
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.unit.dp
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import tachiyomi.domain.chapter.interactor.GetLibraryWorkChapters
+import tachiyomi.domain.manga.model.*
+import tachiyomi.domain.manga.repository.LibraryWorkRepository
+import tachiyomi.i18n.at.ATMR as MR
+import tachiyomi.presentation.core.i18n.stringResource
+import uy.kohesive.injekt.Injekt
+import uy.kohesive.injekt.api.get
+
+@Composable
+fun LibraryEditionsDialog(root: Manga, onDismiss: () -> Unit, onOpen: (Manga) -> Unit) {
+    val scope = rememberCoroutineScope()
+    var members by remember { mutableStateOf<List<Manga>>(emptyList()) }
+    var busy by remember { mutableStateOf(false) }
+    var error by remember { mutableStateOf(false) }
+    LaunchedEffect(root.id) {
+        try {
+            members =
+                withContext(Dispatchers.IO) {
+                    Injekt.get<GetLibraryWorkChapters>().members(root.id)
+                }
+        } catch (cancelled: CancellationException) {
+            throw cancelled
+        } catch (_: Exception) {
+            error = true
+        }
+    }
+    AlertDialog(
+        onDismissRequest = { if (!busy) onDismiss() },
+        title = { Text(stringResource(MR.strings.library_work_editions)) },
+        text = {
+            Column(
+                Modifier.verticalScroll(rememberScrollState()),
+                verticalArrangement = Arrangement.spacedBy(8.dp),
+            ) {
+                Text(stringResource(MR.strings.library_work_preserved))
+                members.forEach { member ->
+                    TextButton(onClick = { onOpen(member) }, enabled = !busy) {
+                        val source =
+                            LibraryWork.from(root.memo)
+                                ?.editions
+                                ?.firstOrNull { it.source == member.source && it.url == member.url }
+                                ?.sourceName
+                                .orEmpty()
+                        Text("${member.title} · $source")
+                    }
+                }
+                if (error) Text(stringResource(MR.strings.library_work_separate_failed))
+            }
+        },
+        confirmButton = {
+            TextButton(
+                enabled = !busy && LibraryWork.from(root.memo) != null,
+                onClick = {
+                    busy = true
+                    scope.launch {
+                        val separated =
+                            withContext(Dispatchers.IO) {
+                                try {
+                                    Injekt.get<LibraryWorkRepository>().detach(root.id)
+                                } catch (cancelled: CancellationException) {
+                                    throw cancelled
+                                } catch (_: Exception) {
+                                    false
+                                }
+                            }
+                        busy = false
+                        if (separated) onDismiss() else error = true
+                    }
+                },
+            ) {
+                Text(stringResource(MR.strings.library_work_separate))
+            }
+        },
+        dismissButton = {
+            TextButton(onClick = onDismiss, enabled = !busy) {
+                Text(stringResource(tachiyomi.i18n.MR.strings.action_close))
+            }
+        },
+    )
+}
