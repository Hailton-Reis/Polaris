@@ -0,0 +1,37 @@
+package tachiyomi.domain.chapter.model
+
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.*
+import tachiyomi.domain.manga.model.Manga
+
+/**
+ * Host-derived runtime hint. Never persisted to database or backup and never accepted from a
+ * provider.
+ */
+@Serializable
+data class ChapterStorage(val mangaId: Long, val source: Long, val title: String, val url: String) {
+    fun attach(chapter: Chapter): Chapter =
+        chapter.copy(memo = JsonObject(chapter.memo + (KEY to Json.encodeToJsonElement(this))))
+
+    fun owner(fallback: Manga): Manga =
+        fallback.copy(id = mangaId, source = source, title = title, url = url)
+
+    companion object {
+        const val KEY = "polaris.runtime.chapter.storage"
+
+        fun of(manga: Manga) = ChapterStorage(manga.id, manga.source, manga.title, manga.url)
+
+        fun from(chapter: Chapter): ChapterStorage? =
+            from(chapter.memo)?.takeIf { it.mangaId == chapter.mangaId }
+
+        fun from(memo: JsonObject): ChapterStorage? =
+            runCatching {
+                    Json.decodeFromJsonElement<ChapterStorage>(memo.getValue(KEY)).takeIf {
+                        it.mangaId > 0 && it.title.isNotBlank() && it.url.isNotBlank()
+                    }
+                }
+                .getOrNull()
+
+        fun strip(memo: JsonObject) = JsonObject(memo - KEY)
+    }
+}
diff --git a/domain/src/main/java/tachiyomi/domain/chapter/model/ChapterVersions.kt b/domain/src/main/java/tachiyomi/domain/chapter/model/ChapterVersions.kt
new file mode 100644
index 0000000..358c03e
