+
+object SettingsAppUpdatesScreen : SearchableSettings {
+    @ReadOnlyComposable
+    @Composable
+    override fun getTitleRes() = ATMR.strings.polaris_updates_title
+
+    @Composable
+    override fun getPreferences(): List<Preference> {
+        val preferences = remember { PolarisUpdatePreferences(Injekt.get<PreferenceStore>()) }
+        val (checking, checkUpdates) = rememberPolarisUpdateCheck()
+        val uriHandler = LocalUriHandler.current
+        return listOf(
+            Preference.PreferenceItem.SwitchPreference(
+                preference = preferences.automatic(),
+                title = stringResource(ATMR.strings.polaris_updates_automatic),
+                subtitle = stringResource(ATMR.strings.polaris_updates_automatic_summary),
+                onValueChanged = {
+                    preferences.resetChecks()
+                    true
+                },
+            ),
+            Preference.PreferenceItem.SwitchPreference(
+                preference = preferences.experimental(),
+                title = stringResource(ATMR.strings.polaris_updates_experimental),
+                subtitle = stringResource(ATMR.strings.polaris_updates_experimental_summary),
+                onValueChanged = {
+                    preferences.resetChecks()
+                    true
+                },
+            ),
+            Preference.PreferenceItem.TextPreference(
+                title = stringResource(MR.strings.check_for_updates),
+                subtitle = stringResource(ATMR.strings.polaris_updates_check_hint),
+                enabled = !checking,
+                widget = {
+                    if (checking) CircularProgressIndicator(Modifier.size(28.dp), strokeWidth = 3.dp)
+                },
+                onClick = checkUpdates,
+            ),
+            Preference.PreferenceItem.TextPreference(
+                title = stringResource(ATMR.strings.polaris_about_releases),
+                subtitle = "github.com/Hailton-Reis/Polaris/releases",
+                onClick = { uriHandler.openUri(RELEASE_URL) },
+            ),
+        )
+    }
+}
