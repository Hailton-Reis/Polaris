+package tachiyomi.domain.manga.model
+
+import tachiyomi.domain.chapter.model.ChapterVersions
+
+/** Shared conservative text normalization for discovery and persisted work associations. */
+object WorkIdentityText {
+    fun title(value: String): String =
+        ChapterVersions.normalize(value)
+            .replace(
+                Regex(
+                    "\\s*[\\[(](?:unofficial|official|oficial|manhwa|manhua|manga|webtoon)[\\])]\\s*$"
+                ),
+                "",
+            )
+            .replace(Regex("[^\\p{L}\\p{N}]+"), " ")
+            .trim()
+
+    fun people(vararg values: String?): Set<String> =
+        values
+            .filterNotNull()
+            .flatMap { it.split(Regex("[,;/&]|\\band\\b|\\be\\b")) }
+            .flatMap { person ->
+                listOf(person.replace(Regex("\\([^)]*\\)"), " ")) +
+                    Regex("\\(([^)]*)\\)").findAll(person).map { it.groupValues[1] }.toList()
+            }
+            .map(::title)
+            .filter {
+                it.length >= 2 &&
+                    it !in
+                        setOf(
+                            "unknown",
+                            "desconhecido",
+                            "not available",
+                            "n a",
+                            "n d",
+                            "未知",
+                            "暂无",
+                            "story",
+                            "art",
+                            "author",
+                            "artist",
+                            "adaptation",
+                            "roteiro",
+                            "ilustrador",
+                            "various",
+                            "varios",
+                        )
+            }
+            .toSet()
+}
