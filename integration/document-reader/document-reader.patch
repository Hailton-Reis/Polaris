@@ -0,0 +1,79 @@
+package eu.kanade.tachiyomi.ui.documents
+
+import android.content.Context
+import com.hippo.unifile.UniFile
+import kotlinx.coroutines.ensureActive
+import mihon.core.archive.DocumentCacheBudget
+import tachiyomi.domain.storage.service.StorageManager
+import java.io.File
+import java.nio.file.Files
+import kotlin.coroutines.coroutineContext
+
+data class StorageBytes(val bytes: Long, val partial: Boolean = false)
+data class PolarisStorageSnapshot(
+    val downloads: StorageBytes?,
+    val imports: StorageBytes?,
+    val translations: StorageBytes?,
+    val documentCache: Long,
+    val otherCache: StorageBytes,
+    val internal: StorageBytes,
+    val apks: Long,
+    val nativeLibraries: StorageBytes,
+)
+
+class PolarisStorageUsage(private val context: Context, private val storage: StorageManager) {
+    suspend fun snapshot(): PolarisStorageSnapshot {
+        val managed = DocumentCacheBudget.size(context.cacheDir)
+        val cache = files(context.cacheDir)
+        val codeCache = files(context.codeCacheDir)
+        return PolarisStorageSnapshot(
+            tree(storage.getDownloadsDirectory()),
+            tree(storage.getLocalSourceDirectory()),
+            tree(storage.getTranslationsDirectory()),
+            managed,
+            StorageBytes(
+                (cache.bytes + codeCache.bytes - managed).coerceAtLeast(0),
+                cache.partial || codeCache.partial,
+            ),
+            files(context.dataDir, setOf("cache", "code_cache", "lib")),
+            (listOf(context.applicationInfo.sourceDir) + context.applicationInfo.splitSourceDirs.orEmpty())
+                .distinct().sumOf { File(it).length() },
+            context.applicationInfo.nativeLibraryDir?.let { files(File(it)) } ?: StorageBytes(0),
+        )
+    }
+
+    private suspend fun tree(root: UniFile?): StorageBytes? {
+        root ?: return null
+        val pending = ArrayDeque<UniFile>()
+        pending.add(root)
+        val visited = mutableSetOf<String>()
+        var bytes = 0L
+        val deadline = System.nanoTime() + 10_000_000_000L
+        while (pending.isNotEmpty()) {
+            coroutineContext.ensureActive()
+            if (visited.size >= 20000 || System.nanoTime() > deadline) return StorageBytes(bytes, true)
+            val file = pending.removeFirst()
+            if (!visited.add(file.uri.toString())) continue
+            if (file.isDirectory) {
+                val children = file.listFiles() ?: return StorageBytes(bytes, true)
+                pending.addAll(children)
+            } else {
+                bytes += file.length().coerceAtLeast(0)
+            }
+        }
+        return StorageBytes(bytes)
+    }
+
+    private suspend fun files(root: File, excluded: Set<String> = emptySet()): StorageBytes {
+        var bytes = 0L
+        var count = 0
+        for (file in root.walkTopDown().onEnter {
+            !Files.isSymbolicLink(it.toPath()) && !(it.parentFile == root && it.name in excluded)
+        }) {
+            coroutineContext.ensureActive()
+            if (++count > 20000) return StorageBytes(bytes, true)
+            if (file.isFile && !Files.isSymbolicLink(file.toPath())) bytes += file.length()
+        }
+        return StorageBytes(bytes)
+    }
+}
