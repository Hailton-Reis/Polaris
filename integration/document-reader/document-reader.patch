+package eu.kanade.tachiyomi.source.selection
+
+import eu.kanade.tachiyomi.source.model.SChapter
+import eu.kanade.tachiyomi.source.online.HttpSource
+import java.io.ByteArrayInputStream
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import kotlinx.coroutines.withTimeoutOrNull
+import tachiyomi.core.common.util.system.ImageUtil
+
+/** A bounded sample of page lists AND image bytes, never a claim about every chapter. */
+internal object SourceReadabilityProbe {
+    suspend fun check(provider: HttpSource, chapters: List<SChapter>): Boolean =
+        withContext(Dispatchers.IO) {
+            val samples =
+                listOfNotNull(chapters.firstOrNull(), chapters.lastOrNull()).distinctBy { it.url }
+            samples.isNotEmpty() &&
+                samples.all { chapter ->
+                    try {
+                        withTimeoutOrNull(8_000L) {
+                            val page =
+                                provider.getPageList(chapter).firstOrNull()
+                                    ?: return@withTimeoutOrNull false
+                            if (page.imageUrl.isNullOrBlank())
+                                page.imageUrl = provider.getImageUrl(page)
+                            provider.getImage(page).use { response ->
+                                if (!response.isSuccessful) return@use false
+                                val buffer = ByteArray(32 * 1024)
+                                val stream = response.body.byteStream()
+                                var count = 0
+                                while (count < buffer.size) {
+                                    val read = stream.read(buffer, count, buffer.size - count)
+                                    if (read < 0) break
+                                    if (read == 0) break
+                                    count += read
+                                }
+                                val bytes = buffer.copyOf(count)
+                                ImageUtil.findImageType(ByteArrayInputStream(bytes)) != null
+                            }
+                        } == true
+                    } catch (cancelled: CancellationException) {
+                        throw cancelled
+                    } catch (_: Exception) {
+                        false
+                    }
+                }
+        }
+}
diff --git a/app/src/main/java/eu/kanade/tachiyomi/source/selection/UnifiedWorkSearch.kt b/app/src/main/java/eu/kanade/tachiyomi/source/selection/UnifiedWorkSearch.kt
