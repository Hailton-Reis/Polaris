+package eu.kanade.tachiyomi.extension.preparation
+
+import eu.kanade.tachiyomi.extension.model.Extension
+import mihon.domain.extension.model.ExtensionStore
+import java.net.URI
+
+/** Consent belongs to this plan, never to imported preferences. */
+data class RepositoryIdentity(val indexUrl: String, val signingKey: String) {
+    val canVerify: Boolean
+        get() = signingKey.matches(Regex("[a-fA-F0-9]{64}")) && isHttps(indexUrl)
+
+    companion object {
+        fun isHttps(url: String): Boolean =
+            runCatching {
+                val uri = URI(url)
+                uri.scheme.equals("https", true) &&
+                    uri.host != null &&
+                    uri.userInfo == null &&
+                    uri.fragment == null
+            }
+                .getOrDefault(false)
+
+        fun of(store: ExtensionStore) = RepositoryIdentity(store.indexUrl, store.signingKey)
+    }
+}
+
+object ExtensionLibraryCompatibility {
+    val supportedVersions = setOf(1.4, 1.6)
+}
+
+enum class PreparationSelection {
+    LIBRARY,
+    LANGUAGES,
+    MANUAL,
+}
+
+data class PreparationPlan(
+    val extensions: List<Extension.Available>,
+    val conflicts: Set<String>,
+    val missingSourceIds: Set<Long>,
+    val unsupportedPackages: Set<String> = emptySet(),
+)
+
+object PreparationPlanner {
+    fun create(
+        available: List<Extension.Available>,
+        authorized: Set<RepositoryIdentity>,
+        installedVersions: Map<String, Long>,
+        sharedPackages: Set<String>,
+        selection: PreparationSelection,
+        languages: Set<String>,
+        librarySources: Set<Long>,
+        manualPackages: Set<String>,
+        includeNsfw: Boolean,
+    ): PreparationPlan {
+        val eligible =
+            available.filter { extension ->
+                RepositoryIdentity.of(extension.store) in authorized &&
+                    RepositoryIdentity.of(extension.store).canVerify &&
+                    extension.pkgName !in sharedPackages &&
+                    (includeNsfw || !extension.isNsfw) &&
+                    when (selection) {
+                        PreparationSelection.LIBRARY ->
+                            extension.sources.any { it.id in librarySources }
+                        PreparationSelection.LANGUAGES ->
+                            extension.lang in languages ||
+                                extension.sources.any { it.lang in languages }
+                        PreparationSelection.MANUAL -> extension.pkgName in manualPackages
+                    }
+            }
+        // Never choose a repository/key for a duplicate package on the user's behalf.
+        val grouped = eligible.groupBy { it.pkgName }
+        val conflicts =
+            grouped
+                .filterValues { versions ->
+                    versions.map { RepositoryIdentity.of(it.store) }.distinct().size > 1 ||
+                        versions
+                            .groupBy { it.versionCode }
+                            .values
+                            .any { sameVersion ->
+                                sameVersion.map { it.apkUrl }.distinct().size > 1
+                            }
+                }
+                .keys
+        return PreparationPlan(
+            extensions =
+            grouped
+                .filterKeys { it !in conflicts }
+                .values
+                .map { it.maxBy { version -> version.versionCode } }
+                .filter { (installedVersions[it.pkgName] ?: -1) < it.versionCode }
+                .filter {
+                    it.libVersion in ExtensionLibraryCompatibility.supportedVersions &&
+                        RepositoryIdentity.isHttps(it.apkUrl)
+                }
+                .sortedBy { it.name },
+            conflicts = conflicts,
+            unsupportedPackages =
+            eligible
+                .filter {
+                    it.libVersion !in ExtensionLibraryCompatibility.supportedVersions ||
+                        !RepositoryIdentity.isHttps(it.apkUrl)
+                }
+                .map { it.pkgName }
+                .toSet(),
+            missingSourceIds =
+            librarySources -
+                available
+                    .filter { RepositoryIdentity.of(it.store) in authorized }
+                    .flatMap { it.sources }
+                    .map { it.id }
+                    .toSet(),
+        )
+    }
+}
