+package eu.kanade.tachiyomi.extension.util
+
+import com.android.apksig.ApkVerifier
+import java.io.File
+import java.io.IOException
+import java.security.MessageDigest
+
+/** Verify signed bytes, not only certificate metadata exposed by PackageManager. */
+internal object PrivateExtensionSignature {
+    fun verify(file: File, androidApi: Int): Set<String> {
+        val result =
+            ApkVerifier.Builder(file)
+                .setMinCheckedPlatformVersion(androidApi)
+                .setMaxCheckedPlatformVersion(androidApi)
+                .build()
+                .verify()
+        if (!result.isVerified || result.signerCertificates.isEmpty()) {
+            throw IOException("Private extension APK signature verification failed")
+        }
+        return result.signerCertificates
+            .map { certificate ->
+                MessageDigest.getInstance("SHA-256").digest(certificate.encoded).joinToString("") {
+                    "%02x".format(it)
+                }
+            }
+            .toSet()
+    }
+
+    fun requireReviewedIdentity(
+        expectedPackage: String,
+        expectedKey: String,
+        actualPackage: String,
+        verifiedKeys: Set<String>,
+    ) {
+        if (
+            expectedPackage != actualPackage ||
+            verifiedKeys.none { it.equals(expectedKey, ignoreCase = true) }
+        ) {
+            throw IOException(
+                "Private extension does not match the reviewed package and certificate",
+            )
+        }
+    }
+}
