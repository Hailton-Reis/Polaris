+package eu.kanade.tachiyomi.data.profile
+
+import android.app.Application
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import tachiyomi.domain.chapter.interactor.GetChaptersByMangaId
+import tachiyomi.domain.manga.interactor.GetLibraryManga
+import uy.kohesive.injekt.Injekt
+import uy.kohesive.injekt.api.get
+
+/** Counts logical chapters per work; refreshes only changed works between profile visits. */
+internal object ProfileRepository {
+    private val lock = Mutex()
+    private val reads = mutableMapOf<Long, Long>()
+
+    data class Snapshot(val xp: Long, val read: Long, val works: Int)
+
+    suspend fun snapshot(
+        context: Application,
+        refreshAll: Boolean,
+        changed: Set<Long> = emptySet(),
+    ): Snapshot =
+        lock.withLock {
+            val library = Injekt.get<GetLibraryManga>().await().distinctBy { it.id }
+            reads.keys.retainAll(library.map { it.id }.toSet())
+            val chapters = Injekt.get<GetChaptersByMangaId>()
+            for (work in library) {
+                if (
+                    refreshAll ||
+                        work.id in changed ||
+                        work.id !in reads ||
+                        (work.manga.source == tachiyomi.domain.source.model.MERGED_SOURCE_ID &&
+                            changed.isNotEmpty())
+                ) {
+                    val allChapters =
+                        if (work.manga.source == tachiyomi.domain.source.model.MERGED_SOURCE_ID)
+                            Injekt.get<
+                                    tachiyomi.domain.chapter.interactor.GetMergedChaptersByMangaId
+                                >()
+                                .await(work.id, dedupe = false)
+                        else chapters.await(work.id)
+                    reads[work.id] = PolarisLevelManager.logicalReadCount(allChapters)
+                }
+            }
+            val count = reads.values.sum()
+            val preferences = ProfilePreferences(context)
+            val previous = preferences.getProgress()
+            val progress =
+                if (previous == null) {
+                    val legacy = preferences.hasLegacyProgress()
+                    val downloads =
+                        if (legacy)
+                            Injekt.get<eu.kanade.tachiyomi.data.download.DownloadManager>()
+                                .getDownloadCount()
+                                .toLong()
+                        else 0L
+                    PolarisLevelManager.start(
+                        count,
+                        library.sumOf { it.readCount },
+                        downloads,
+                        legacy,
+                    )
+                } else PolarisLevelManager.advance(previous, count)
+            preferences.setProgress(progress)
+            Snapshot(progress.xp, count, library.size)
+        }
