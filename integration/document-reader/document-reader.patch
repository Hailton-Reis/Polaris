+import eu.kanade.tachiyomi.ui.documents.DocumentImportOptions
+import eu.kanade.tachiyomi.ui.documents.DocumentKind
+import tachiyomi.domain.category.model.Category
+import tachiyomi.i18n.at.ATMR
+import tachiyomi.presentation.core.i18n.stringResource
+import java.util.Locale
+
+@Composable
+fun DocumentImportDialog(
+    request: DocumentImportRequest,
+    categories: List<Category>,
+    onDismiss: () -> Unit,
+    onInclude: (DocumentImportOptions) -> Unit,
+) {
+    var title by rememberSaveable(request.id) { mutableStateOf(request.title) }
+    var kind by rememberSaveable(request.id) { mutableStateOf(request.kind) }
+    var byFormat by rememberSaveable(request.id) { mutableStateOf(true) }
+    var selected by rememberSaveable(request.id) { mutableStateOf(emptyList<Long>()) }
+    var newCategory by rememberSaveable(request.id) { mutableStateOf("") }
+    val kindName = documentKindName(kind)
+    val formatPrefix = stringResource(ATMR.strings.document_format_category_prefix)
+
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        title = { Text(stringResource(ATMR.strings.document_include_title)) },
+        text = {
+            Column(
+                Modifier.heightIn(max = 460.dp).verticalScroll(rememberScrollState()),
+                verticalArrangement = Arrangement.spacedBy(12.dp),
+            ) {
+                Text(request.name, style = MaterialTheme.typography.bodyMedium)
+                Text(
+                    stringResource(
+                        ATMR.strings.document_selected_format,
+                        request.format?.extension?.uppercase(Locale.ROOT)
+                            ?: stringResource(ATMR.strings.document_detect_format),
+                    ),
+                    style = MaterialTheme.typography.bodySmall,
+                )
+                OutlinedTextField(
+                    value = title,
+                    onValueChange = { title = it.take(180) },
+                    label = { Text(stringResource(ATMR.strings.document_library_title)) },
+                    singleLine = true,
+                    modifier = Modifier.fillMaxWidth(),
+                )
+                Text(stringResource(ATMR.strings.document_content_type))
+                FlowRow(horizontalArrangement = Arrangement.spacedBy(6.dp)) {
+                    DocumentKind.entries.forEach { option ->
+                        FilterChip(
+                            selected = kind == option,
+                            onClick = { kind = option },
+                            label = { Text(documentKindName(option)) },
+                        )
+                    }
+                }
+                Text(stringResource(ATMR.strings.document_kind_hint), style = MaterialTheme.typography.bodySmall)
+                Row(verticalAlignment = Alignment.CenterVertically) {
+                    Checkbox(checked = byFormat, onCheckedChange = { byFormat = it })
+                    Text(stringResource(ATMR.strings.document_category_by_format))
+                }
+                if (categories.isNotEmpty()) {
+                    Text(stringResource(ATMR.strings.document_existing_categories))
+                    FlowRow(horizontalArrangement = Arrangement.spacedBy(6.dp)) {
+                        categories.forEach { category ->
+                            FilterChip(selected = category.id in selected, onClick = {
+                                selected =
+                                    if (category.id in selected) selected - category.id else selected + category.id
+                            }, label = { Text(category.name) })
+                        }
+                    }
+                }
+                OutlinedTextField(
+                    value = newCategory,
+                    onValueChange = { newCategory = it.take(80) },
+                    label = { Text(stringResource(ATMR.strings.document_new_category)) },
+                    singleLine = true,
+                    modifier = Modifier.fillMaxWidth(),
+                )
+                Text(stringResource(ATMR.strings.document_category_hint), style = MaterialTheme.typography.bodySmall)
+            }
+        },
+        confirmButton = {
+            TextButton(onClick = {
+                onInclude(
+                    DocumentImportOptions(
+                        kind,
+                        kindName,
+                        byFormat,
+                        formatPrefix,
+                        selected.toSet(),
+                        newCategory,
+                        title,
+                    ),
+                )
+            }) { Text(stringResource(ATMR.strings.document_include)) }
+        },
+        dismissButton = {
+            TextButton(onClick = onDismiss) { Text(stringResource(ATMR.strings.document_cancel)) }
+        },
+    )
+}
+
+@Composable
+private fun documentKindName(kind: DocumentKind): String = stringResource(
+    when (kind) {
+        DocumentKind.MANGA -> ATMR.strings.document_kind_manga
+        DocumentKind.MANHWA -> ATMR.strings.document_kind_manhwa
+        DocumentKind.COMICS -> ATMR.strings.document_kind_comics
+        DocumentKind.BOOK -> ATMR.strings.document_books
+        DocumentKind.ARTICLE -> ATMR.strings.document_articles
+        DocumentKind.DOCUMENT -> ATMR.strings.document_kind_documents
+    },
+)
