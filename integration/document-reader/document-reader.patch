+    <string name="polaris_work_source_search">Buscar fontes</string>
+    <string name="pref_ocr_engine_saved_hint">Usado nas novas traduções. Para comparar motores, exclua apenas a tradução salva do capítulo e traduza novamente.</string>
+    <string name="polaris_update_waiting">Aguardando para retomar…</string>
+    <string name="polaris_update_download_hint">Você pode sair desta tela durante o download. Se a conexão cair, o Polaris tenta novamente e preserva a parte recebida quando o servidor permite retomar. Ao terminar, toque em Instalar aqui ou na notificação.</string>
