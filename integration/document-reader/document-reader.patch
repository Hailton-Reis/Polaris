+package eu.kanade.tachiyomi.data.profile
+
+import eu.kanade.domain.ui.UiPreferences
+import eu.kanade.tachiyomi.util.system.LauncherIconManager
+import tachiyomi.core.common.preference.PreferenceStore
+import tachiyomi.domain.library.model.LibraryManga
+
+/** Reuses library emissions; does not observe the database or query chapters on its own. */
+internal object ProfileAchievementStore {
+    private val lock = Any()
+
+    fun record(store: PreferenceStore, library: List<LibraryManga>): AchievementProgress =
+        synchronized(lock) {
+            val pref = store.getString(ProfileAchievements.PREFERENCE_KEY)
+            val previous = ProfileAchievements.decode(pref.get())
+            val next = ProfileAchievements.advance(previous, ProfileAchievements.count(library))
+            val encoded = ProfileAchievements.encode(next)
+            if (pref.get() != encoded) pref.set(encoded)
+            LauncherIconManager.refreshRewards(UiPreferences(store))
+            next
+        }
+
+    fun mergeRestoredProgress(store: PreferenceStore, raw: String) =
+        synchronized(lock) {
+            val pref = store.getString(ProfileAchievements.PREFERENCE_KEY)
+            val merged =
+                ProfileAchievements.advance(
+                    ProfileAchievements.decode(pref.get()),
+                    ProfileAchievements.decode(raw),
+                )
+            pref.set(ProfileAchievements.encode(merged))
+        }
+
+    fun mergeRestoredIcons(store: PreferenceStore, incoming: Set<String>) =
+        synchronized(lock) {
+            val ui = UiPreferences(store)
+            LauncherIconManager.retainRewards(ui, incoming)
+        }
+}
diff --git a/app/src/main/java/eu/kanade/tachiyomi/data/profile/ProfileAchievements.kt b/app/src/main/java/eu/kanade/tachiyomi/data/profile/ProfileAchievements.kt
