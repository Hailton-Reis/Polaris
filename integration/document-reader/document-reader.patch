+import androidx.compose.ui.unit.sp
+import eu.kanade.tachiyomi.R
+import eu.kanade.translation.data.TranslationFont
+
+internal data class TranslationTypeface(
+    val family: FontFamily,
+    val cedillaFallback: FontFamily? = null,
+)
+
+internal fun TranslationFont.readerTypeface(): TranslationTypeface = TranslationTypeface(
+    // All bundled files declare regular weight. Do not synthesize the app theme's weight.
+    family = FontFamily(Font(res, weight = FontWeight.Normal)),
+    cedillaFallback = if (this == TranslationFont.ANIME_ACE) {
+        FontFamily(Font(R.font.bubble_sans, weight = FontWeight.Normal))
+    } else {
+        null
+    },
+)
+
+/** Use the same styled text for fitting and drawing; preserve the actual Unicode characters. */
+internal fun translationDisplayText(
+    text: String,
+    fontSizeSp: Int,
+    cedillaFallback: FontFamily?,
+): AnnotatedString = buildAnnotatedString {
+    append(text)
+    if (cedillaFallback != null) {
+        text.forEachIndexed { index, character ->
+            if (character == 'Ç' || character == 'ç') {
+                addStyle(
+                    SpanStyle(
+                        fontFamily = cedillaFallback,
+                        // Match the C cap height of the bundled Anime Ace (863/1024)
+                        // with Bubble Sans (749/1000), including its comic-style lowercase.
+                        fontSize = (fontSizeSp * ANIME_CEDILLA_SCALE).sp,
+                    ),
+                    index,
+                    index + 1,
+                )
+            }
+        }
+    }
+}
+
+internal fun translationTextStyle(base: TextStyle, fontSizeSp: Int, fontFamily: FontFamily): TextStyle = base.copy(
+    fontSize = fontSizeSp.sp,
+    fontFamily = fontFamily,
+    fontWeight = FontWeight.Normal,
+    fontStyle = FontStyle.Normal,
+    fontSynthesis = FontSynthesis.None,
+    letterSpacing = 0.sp,
+    // Natural metrics include accents and fallback glyph descenders. The previous
+    // 0.98em leading compressed them independently of what the chosen fonts need.
+    lineHeight = TextUnit.Unspecified,
+    platformStyle = PlatformTextStyle(includeFontPadding = true),
+    lineHeightStyle = LineHeightStyle(LineHeightStyle.Alignment.Proportional, LineHeightStyle.Trim.None),
+    textAlign = TextAlign.Center,
+    lineBreak = LineBreak.Paragraph,
+    hyphens = Hyphens.None,
+)
+
+private const val ANIME_CEDILLA_SCALE = 1.125f
