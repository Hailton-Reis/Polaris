@@ -0,0 +1,122 @@
+package eu.kanade.tachiyomi.ui.documents
+
+import io.mockk.coEvery
+import io.mockk.coVerify
+import io.mockk.mockk
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitAll
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.yield
+import mihon.core.archive.DocumentFormat
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.assertThrows
+import tachiyomi.domain.category.model.Category
+import tachiyomi.domain.category.repository.CategoryRepository
+import tachiyomi.domain.manga.repository.MangaRepository
+import java.io.IOException
+
+class DocumentOrganizationTest {
+    private val categories = mockk<CategoryRepository>()
+    private val manga = mockk<MangaRepository>()
+    private val stored = mutableListOf<Category>()
+    private val memberships = mutableMapOf<Long, List<Long>>()
+    private val organizer = DocumentOrganizer(categories, manga) { 0x41L }
+
+    init {
+        coEvery { categories.getAll() } answers { stored.toList() }
+        coEvery { categories.insert(any()) } coAnswers {
+            yield()
+            stored += firstArg<Category>().copy(id = (stored.maxOfOrNull { it.id } ?: 0) + 1)
+        }
+        coEvery { manga.setMangaCategories(any(), any()) } answers {
+            memberships[firstArg()] = secondArg<List<Long>>().toList()
+        }
+    }
+
+    private fun options(kind: DocumentKind = DocumentKind.BOOK, format: Boolean = true) =
+        DocumentImportOptions(
+            kind,
+            when (kind) {
+                DocumentKind.BOOK -> "Livros"
+                DocumentKind.ARTICLE -> "Artigos"
+                else -> kind.categoryAliases.first()
+            },
+            format,
+            "Formato",
+        )
+
+    private fun names(id: Long): Set<String> = memberships[id].orEmpty()
+        .map { category -> stored.single { it.id == category }.name }.toSet()
+
+    @Test
+    fun `two pdfs keep different user chosen content types and share the format category`() = runTest {
+        memberships[900] = listOf(123)
+        organizer.assign(1, DocumentFormat.PDF, options(DocumentKind.BOOK))
+        organizer.assign(2, DocumentFormat.PDF, options(DocumentKind.ARTICLE))
+        assertEquals(setOf("Livros", "Formato: PDF"), names(1))
+        assertEquals(setOf("Artigos", "Formato: PDF"), names(2))
+        assertEquals(1, stored.count { it.name == "Formato: PDF" })
+        assertEquals(listOf(123L), memberships[900])
+        coVerify(exactly = 0) { manga.setMangaCategories(900, any()) }
+    }
+
+    @Test
+    fun `existing categories are reused across accents case and the supported interface languages`() = runTest {
+        stored += listOf(Category(10, "  MANGA  ", 2, 0), Category(11, "Format: pdf", 3, 0))
+        organizer.assign(1, DocumentFormat.PDF, options(DocumentKind.MANGA))
+        assertEquals(setOf(10L, 11L), memberships[1]?.toSet())
+        assertEquals(2, stored.size)
+        coVerify(exactly = 0) { categories.insert(any()) }
+    }
+
+    @Test
+    fun `format grouping can be disabled and a personal category can be created`() = runTest {
+        stored += Category(9, "Existing shelf", 8, 12)
+        organizer.assign(
+            1,
+            DocumentFormat.EPUB,
+            options(format = false).copy(categoryIds = setOf(9), newCategoryName = "  Research   2026  "),
+        )
+        assertEquals(setOf("Livros", "Existing shelf", "Research 2026"), names(1))
+        assertFalse(stored.any { it.name.startsWith("Formato") })
+        assertEquals(listOf(9L, 10L), stored.drop(1).map { it.order })
+        assertTrue(stored.drop(1).all { it.flags == 0x41L })
+    }
+
+    @Test
+    fun `selected and newly typed categories are deduplicated without replacing category settings`() = runTest {
+        stored += Category(9, "Ciência", 8, 12)
+        organizer.assign(1, DocumentFormat.TXT, options().copy(categoryIds = setOf(9), newCategoryName = "CIENCIA"))
+        assertEquals(3, memberships[1]?.size)
+        assertEquals(Category(9, "Ciência", 8, 12), stored.first())
+    }
+
+    @Test
+    fun `a deleted or system category is rejected before any category or membership is written`() = runTest {
+        for (id in listOf(0L, 99L)) {
+            assertThrows<IllegalArgumentException> {
+                organizer.assign(1, DocumentFormat.PDF, options().copy(categoryIds = setOf(id)))
+            }
+        }
+        assertTrue(stored.isEmpty())
+        assertTrue(memberships.isEmpty())
+    }
+
+    @Test
+    fun `membership failure is reported to the import flow`() = runTest {
+        coEvery { manga.setMangaCategories(any(), any()) } throws IOException("database unavailable")
+        assertThrows<IOException> { organizer.assign(1, DocumentFormat.PDF, options()) }
+        assertTrue(memberships.isEmpty())
+    }
+
+    @Test
+    fun `simultaneous additions reuse shared categories`() = runTest {
+        (1L..8L).map { id -> async { organizer.assign(id, DocumentFormat.PDF, options()) } }.awaitAll()
+        assertEquals(2, stored.size)
+        assertEquals(8, memberships.size)
+        assertTrue(memberships.values.all { it.toSet().size == 2 })
+    }
+}
