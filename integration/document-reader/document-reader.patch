@@ -0,0 +1,127 @@
+package eu.kanade.tachiyomi.data.backup.create
+
+import kotlinx.coroutines.CancellationException
+import org.junit.jupiter.api.Assertions.assertArrayEquals
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.assertThrows
+import java.io.ByteArrayInputStream
+import java.io.ByteArrayOutputStream
+import java.io.IOException
+import java.io.OutputStream
+import java.util.zip.GZIPInputStream
+import java.util.zip.GZIPOutputStream
+
+class BackupArchiveWriterTest {
+    private val payload = ByteArray(170_000) { ((it * 13 + it / 7) % 251).toByte() }
+    private fun gzip(bytes: ByteArray): ByteArray = ByteArrayOutputStream().also { buffer ->
+        GZIPOutputStream(buffer).use { it.write(bytes) }
+    }.toByteArray()
+
+    @Test fun `successful result requires closed output and exact verified payload`() {
+        var closed = false
+        val output = object : ByteArrayOutputStream() {
+            override fun close() {
+                closed = true
+                super.close()
+            }
+        }
+        BackupArchiveWriter.writeVerified(payload, { output }, {
+            assertTrue(closed)
+            ByteArrayInputStream(output.toByteArray())
+        })
+        assertArrayEquals(payload, GZIPInputStream(ByteArrayInputStream(output.toByteArray())).readBytes())
+    }
+
+    @Test fun `write failure closes the stream and cannot proceed to verification`() {
+        var closed = false
+        var reads = 0
+        val output = object : OutputStream() {
+            override fun write(value: Int) {
+                throw IOException("Disk full")
+            }
+            override fun close() {
+                closed = true
+            }
+        }
+        assertThrows<IOException> {
+            BackupArchiveWriter.writeVerified(payload, { output }, {
+                reads++
+                null
+            })
+        }
+        assertTrue(closed)
+        assertEquals(0, reads)
+    }
+
+    @Test fun `failed output close cannot be reported as verified`() {
+        var reads = 0
+        val output = object : ByteArrayOutputStream() {
+            override fun close() {
+                throw IOException("Provider failed to commit")
+            }
+        }
+        assertThrows<IOException> {
+            BackupArchiveWriter.writeVerified(payload, { output }, {
+                reads++
+                ByteArrayInputStream(output.toByteArray())
+            })
+        }
+        assertEquals(0, reads)
+    }
+
+    @Test fun `write only destination is explicitly unverifiable`() {
+        assertThrows<BackupReadbackUnavailable> {
+            BackupArchiveWriter.writeVerified(payload, { ByteArrayOutputStream() }, { throw SecurityException() })
+        }
+    }
+
+    @Test fun `trailing garbage or another gzip member is rejected like the actual backup decoder`() {
+        for (suffix in listOf(byteArrayOf(1, 2, 3), gzip(byteArrayOf()))) {
+            assertThrows<BackupReadbackMismatch> {
+                BackupArchiveWriter.verify(payload, { ByteArrayInputStream(gzip(payload) + suffix) })
+            }
+        }
+    }
+
+    @Test fun `truncated gzip fails verification`() {
+        val compressed = gzip(payload)
+        assertThrows<BackupReadbackMismatch> {
+            BackupArchiveWriter.verify(payload, { ByteArrayInputStream(compressed.copyOf(compressed.size - 5)) })
+        }
+    }
+
+    @Test fun `valid gzip carrying different bytes cannot be reported as success`() {
+        val changed = payload.copyOf().also { it[9] = (it[9] + 1).toByte() }
+        assertThrows<BackupReadbackMismatch> {
+            BackupArchiveWriter.verify(payload, { ByteArrayInputStream(gzip(changed)) })
+        }
+    }
+
+    @Test fun `extra or missing decompressed bytes fail verification`() {
+        for (bytes in listOf(payload.copyOf(payload.size - 1), payload + byteArrayOf(1))) {
+            assertThrows<BackupReadbackMismatch> {
+                BackupArchiveWriter.verify(payload, { ByteArrayInputStream(gzip(bytes)) })
+            }
+        }
+    }
+
+    @Test fun `cancellation during copy or read back stays cancellation`() {
+        var checks = 0
+        assertThrows<CancellationException> {
+            BackupArchiveWriter.writeVerified(payload, { ByteArrayOutputStream() }, { null }) {
+                if (++checks == 3) throw CancellationException()
+            }
+        }
+        checks = 0
+        assertThrows<CancellationException> {
+            BackupArchiveWriter.verify(payload, { ByteArrayInputStream(gzip(payload)) }) {
+                if (++checks == 3) throw CancellationException()
+            }
+        }
+        assertThrows<CancellationException> {
+            BackupArchiveWriter.verify(payload, { throw CancellationException() })
+        }
+    }
+}
