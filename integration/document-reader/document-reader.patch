+package eu.kanade.tachiyomi.data.updater
+
+import tachiyomi.core.common.preference.Preference
+import tachiyomi.core.common.preference.PreferenceStore
+
+class PolarisUpdatePreferences(store: PreferenceStore) {
+    private val automaticPreference = store.getBoolean("polaris_check_app_updates", true)
+    private val experimentalPreference = store.getBoolean("polaris_experimental_updates", false)
+    private val stableCheck = store.getLong(Preference.appStateKey("polaris_app_update_check_false"), 0)
+    private val experimentalCheck = store.getLong(Preference.appStateKey("polaris_app_update_check_true"), 0)
+    fun automatic() = automaticPreference
+    fun experimental() = experimentalPreference
+    fun lastCheck(experimental: Boolean) = if (experimental) experimentalCheck else stableCheck
+
+    fun resetChecks() {
+        lastCheck(false).set(0)
+        lastCheck(true).set(0)
+    }
+
+    fun shouldCheck(force: Boolean, experimental: Boolean, now: Long): Boolean =
+        force || (automatic().get() && isDue(experimental, now))
+
+    fun isDue(experimental: Boolean, now: Long): Boolean {
+        val last = lastCheck(experimental).get()
+        return last == 0L || now < last || now - last >= 24 * 60 * 60 * 1000L
+    }
+}
