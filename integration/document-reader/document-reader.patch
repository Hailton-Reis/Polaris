+++ b/app/src/test/java/eu/kanade/tachiyomi/extension/sandbox/BrowserCookieSessionTest.kt
@@ -0,0 +1,158 @@
+package eu.kanade.tachiyomi.extension.sandbox
+
+import okhttp3.Cookie
+import okhttp3.CookieJar
+import okhttp3.HttpUrl
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import org.junit.jupiter.api.Assertions.*
+import org.junit.jupiter.api.Test
+
+class BrowserCookieSessionTest {
+    private val url = "https://reader.example.com/".toHttpUrl()
+
+    private class Jar : CookieJar {
+        var values = emptyList<Cookie>()
+        var writes = 0
+
+        override fun loadForRequest(url: HttpUrl) = values.filter { it.matches(url) }
+
+        override fun saveFromResponse(url: HttpUrl, cookies: List<Cookie>) {
+            writes++
+            values = cookies
+        }
+    }
+
+    private fun cookie(value: String) = requireNotNull(Cookie.parse(url, value))
+
+    @Test
+    fun `only the selected HTTPS origin is accepted`() {
+        val session = BrowserCookieSession(url.toString(), Jar())
+        assertTrue(session.accepts("https://reader.example.com/account/login"))
+        listOf(
+                "http://reader.example.com/",
+                "https://other.example.com/",
+                "https://reader.example.com:444/",
+                "https://reader.example.com@evil.example/",
+                "file:///secret",
+                "content://secret",
+                "javascript:alert(1)",
+                "https://127.0.0.1/",
+                "https://localhost/",
+                "intent://reader.example.com/",
+            )
+            .forEach { assertFalse(session.accepts(it), it) }
+    }
+
+    @Test
+    fun `HTTP sources cannot create browser sessions`() {
+        assertThrows(IllegalArgumentException::class.java) {
+            BrowserCookieSession("http://example.com", Jar())
+        }
+    }
+
+    @Test
+    fun `cookie attributes and host boundary survive browser import`() {
+        val jar = Jar()
+        BrowserCookieSession(url.toString(), jar)
+            .complete(
+                mapOf(
+                    url.toString() to
+                        listOf(
+                            "login=token; Domain=example.com; Path=/account; Secure; HttpOnly; Max-Age=3600"
+                        )
+                )
+            )
+        val cookie = jar.values.single()
+        assertTrue(cookie.secure && cookie.httpOnly && cookie.persistent && cookie.hostOnly)
+        assertEquals("/account", cookie.path)
+        assertEquals("reader.example.com", cookie.domain)
+        assertFalse(cookie.matches("https://sibling.example.com/account".toHttpUrl()))
+    }
+
+    @Test
+    fun `temporary browser cookies remain temporary`() {
+        val jar = Jar()
+        BrowserCookieSession(url.toString(), jar)
+            .complete(mapOf(url.toString() to listOf("session=v; Secure; HttpOnly")))
+        assertFalse(jar.values.single().persistent)
+    }
+
+    @Test
+    fun `cancelling without completion writes nothing`() {
+        val jar = Jar().apply { values = listOf(cookie("old=value; Secure; HttpOnly")) }
+        BrowserCookieSession(url.toString(), jar).seed()
+        assertEquals(0, jar.writes)
+        assertEquals("old", jar.values.single().name)
+    }
+
+    @Test
+    fun `invalid snapshot origins reject the whole import`() {
+        val jar = Jar()
+        assertThrows(IllegalArgumentException::class.java) {
+            BrowserCookieSession(url.toString(), jar)
+                .complete(
+                    mapOf(
+                        url.toString() to listOf("valid=yes"),
+                        "https://evil.example/" to listOf("secret=no"),
+                    )
+                )
+        }
+        assertEquals(0, jar.writes)
+    }
+
+    @Test
+    fun `oversized or malformed browser output never partially commits`() {
+        for (headers in
+            listOf(
+                listOf("good=yes", "invalid"),
+                listOf("x=" + "v".repeat(9000)),
+                (0..CookieCodec.MAX_COOKIES).map { "c$it=value" },
+            )) {
+            val jar = Jar()
+            assertThrows(Exception::class.java) {
+                BrowserCookieSession(url.toString(), jar).complete(mapOf(url.toString() to headers))
+            }
+            assertEquals(0, jar.writes)
+        }
+    }
+
+    @Test
+    fun `removed seeded cookies expire with their original domain identity`() {
+        val jar = Jar().apply { values = listOf(cookie("old=value; Domain=example.com; Secure")) }
+        val session = BrowserCookieSession(url.toString(), jar)
+        session.seed()
+        session.complete(mapOf(url.toString() to emptyList()))
+        assertTrue(jar.values.single().expiresAt < System.currentTimeMillis())
+        assertEquals("example.com", jar.values.single().domain)
+        assertFalse(jar.values.single().hostOnly)
+    }
+
+    @Test
+    fun `cleared sessions cannot be restored by a browser still open`() {
+        val jar =
+            object : RevocableCookieJar {
+                var active = true
+
+                override fun isActive() = active
+
+                override fun loadForRequest(url: HttpUrl) = emptyList<Cookie>()
+
+                override fun saveFromResponse(url: HttpUrl, cookies: List<Cookie>) =
+                    throw AssertionError("Revoked write")
+            }
+        val session = BrowserCookieSession(url.toString(), jar)
+        session.seed()
+        jar.active = false
+        assertThrows(IllegalStateException::class.java) {
+            session.complete(mapOf(url.toString() to listOf("new=v")))
+        }
+    }
+
+    @Test
+    fun `partitioned cookies never become unpartitioned credentials`() {
+        val jar = Jar()
+        BrowserCookieSession(url.toString(), jar)
+            .complete(mapOf(url.toString() to listOf("token=v; Secure; Partitioned")))
+        assertTrue(jar.values.isEmpty())
+    }
+}
diff --git a/app/src/test/java/eu/kanade/tachiyomi/extension/sandbox/CookieBankTest.kt b/app/src/test/java/eu/kanade/tachiyomi/extension/sandbox/CookieBankTest.kt
new file mode 100644
index 0000000..9b8f701
--- /dev/null
+++ b/app/src/test/java/eu/kanade/tachiyomi/extension/sandbox/CookieBankTest.kt
@@ -0,0 +1,210 @@
+package eu.kanade.tachiyomi.extension.sandbox
+
+import java.io.IOException
+import kotlinx.serialization.json.*
+import okhttp3.Cookie
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import org.junit.jupiter.api.Assertions.*
+import org.junit.jupiter.api.Test
+
+class CookieBankTest {
+    private val url = "https://reader.example.com/login".toHttpUrl()
+    private val now = System.currentTimeMillis()
+
+    private fun cookie(
+        name: String,
+        value: String = "value",
+        persistent: Boolean = false,
+        path: String = "/",
+        hostOnly: Boolean = true,
+        secure: Boolean = true,
+        expires: Long? = null,
+        domain: String? = null,
+    ): Cookie =
+        Cookie.Builder()
+            .name(name)
+            .value(value)
+            .path(path)
+            .apply {
+                if (domain != null) domain(domain)
+                else if (hostOnly) hostOnlyDomain(url.host) else domain("example.com")
+                if (persistent || expires != null) expiresAt(expires ?: (now + 60000))
+                if (secure) secure()
+                httpOnly()
+            }
+            .build()
+
+    private class Storage : CookieStorage {
+        var saved = emptyList<Cookie>()
+        var fail = false
+
+        override fun load() = saved.toList()
+
+        override fun save(cookies: List<Cookie>) {
+            if (fail) throw IOException("fixture")
+            saved = cookies.toList()
+        }
+
+        override fun clear() {
+            if (fail) throw IOException("fixture")
+            saved = emptyList()
+        }
+    }
+
+    @Test
+    fun `session cookies survive worker client replacement without entering disk state`() {
+        val storage = Storage()
+        val bank = CookieBank(storage) { now }
+        bank.newSessionJar().saveFromResponse(url, listOf(cookie("session")))
+        assertEquals("session", bank.newSessionJar().loadForRequest(url).single().name)
+        assertTrue(storage.saved.isEmpty())
+        assertTrue(CookieBank(storage) { now }.newSessionJar().loadForRequest(url).isEmpty())
+        assertEquals(1, bank.status().temporary)
+    }
+
+    @Test
+    fun `persistent cookies restore and preserve secure httpOnly path and host flags`() {
+        val storage = Storage()
+        val bank = CookieBank(storage) { now }
+        bank
+            .newSessionJar()
+            .saveFromResponse(url, listOf(cookie("login", persistent = true, path = "/library")))
+        val restored = CookieBank(storage) { now }.newSessionJar()
+        assertTrue(restored.loadForRequest(url).isEmpty())
+        val c = restored.loadForRequest("https://reader.example.com/library/1".toHttpUrl()).single()
+        assertTrue(c.secure && c.httpOnly && c.hostOnly && c.persistent)
+        assertTrue(
+            restored.loadForRequest("http://reader.example.com/library/1".toHttpUrl()).isEmpty()
+        )
+        assertTrue(
+            restored.loadForRequest("https://other.example.com/library/1".toHttpUrl()).isEmpty()
+        )
+        assertTrue(
+            restored
+                .loadForRequest("https://sub.reader.example.com/library/1".toHttpUrl())
+                .isEmpty()
+        )
+    }
+
+    @Test
+    fun `independent response names merge and expiration deletes only the matching cookie`() {
+        val storage = Storage()
+        val bank = CookieBank(storage) { now }
+        val jar = bank.newSessionJar()
+        jar.saveFromResponse(url, listOf(cookie("a", persistent = true)))
+        jar.saveFromResponse(url, listOf(cookie("b", persistent = true)))
+        assertEquals(setOf("a", "b"), jar.loadForRequest(url).map { it.name }.toSet())
+        jar.saveFromResponse(url, listOf(cookie("a", expires = 0)))
+        assertEquals(listOf("b"), jar.loadForRequest(url).map { it.name })
+        assertEquals(listOf("b"), storage.saved.map { it.name })
+    }
+
+    @Test
+    fun `same-name cookies for a deeper path precede the root session`() {
+        val bank = CookieBank(Storage()) { now }
+        val jar = bank.newSessionJar()
+        jar.saveFromResponse(
+            url,
+            listOf(cookie("login", "root"), cookie("login", "library", path = "/library")),
+        )
+        assertEquals(
+            listOf("library", "root"),
+            jar.loadForRequest("https://reader.example.com/library/1".toHttpUrl()).map { it.value },
+        )
+        assertEquals(listOf("root"), jar.loadForRequest(url).map { it.value })
+    }
+
+    @Test
+    fun `foreign cookie origins do not override a host-only session`() {
+        val bank = CookieBank(Storage()) { now }
+        val jar = bank.newSessionJar()
+        jar.saveFromResponse(url, listOf(cookie("own"), cookie("foreign", domain = "evil.org")))
+        assertEquals(listOf("own"), jar.loadForRequest(url).map { it.name })
+        assertTrue(jar.loadForRequest("https://cdn.example.com/".toHttpUrl()).isEmpty())
+        assertTrue(jar.loadForRequest("https://example.net/".toHttpUrl()).isEmpty())
+    }
+
+    @Test
+    fun `clear revokes old clients and ignores delayed authenticated responses`() {
+        val storage = Storage()
+        val bank = CookieBank(storage) { now }
+        val old = bank.newSessionJar()
+        old.saveFromResponse(url, listOf(cookie("login", persistent = true)))
+        bank.clear()
+        old.saveFromResponse(url, listOf(cookie("login", "must-not-return", persistent = true)))
+        assertTrue(old.loadForRequest(url).isEmpty())
+        assertTrue(storage.saved.isEmpty())
+        val fresh = bank.newSessionJar()
+        fresh.saveFromResponse(url, listOf(cookie("new")))
+        assertEquals(listOf("new"), fresh.loadForRequest(url).map { it.name })
+        assertTrue(old.loadForRequest(url).isEmpty())
+    }
+
+    @Test
+    fun `count and escaped byte budgets bound memory and persistent payloads`() {
+        val storage = Storage()
+        val bank = CookieBank(storage) { now }
+        val jar = bank.newSessionJar()
+        jar.saveFromResponse(url, (0..200).map { cookie("n$it", persistent = true) })
+        assertTrue(jar.loadForRequest(url).size <= CookieCodec.MAX_COOKIES)
+        jar.saveFromResponse(
+            url,
+            (0..20).map { cookie("long$it", "\\".repeat(2000), persistent = true) },
+        )
+        val current = jar.loadForRequest(url)
+        assertTrue(
+            CookieCodec.encode(current).toString().toByteArray().size <= CookieCodec.MAX_BYTES
+        )
+        jar.saveFromResponse(url, listOf(cookie("too_big", "a".repeat(4097), persistent = true)))
+        assertFalse(jar.loadForRequest(url).any { it.name == "too_big" })
+    }
+
+    @Test
+    fun `storage failure keeps memory usable reports failure and does not claim disk persistence`() {
+        val storage = Storage().apply { fail = true }
+        val bank = CookieBank(storage) { now }
+        val jar = bank.newSessionJar()
+        jar.saveFromResponse(url, listOf(cookie("login", persistent = true)))
+        assertEquals(1, jar.loadForRequest(url).size)
+        assertTrue(bank.status().storageUnavailable)
+        assertTrue(storage.saved.isEmpty())
+        assertTrue(runCatching { bank.clear() }.isFailure)
+        assertTrue(jar.loadForRequest(url).isEmpty())
+    }
+
+    @Test
+    fun `expired saved entries are removed rather than revived after reload`() {
+        val storage =
+            Storage().apply {
+                saved = listOf(cookie("old", persistent = true, expires = now - 10000))
+            }
+        val bank = CookieBank(storage) { now }
+        assertEquals(0, bank.status().persistent)
+        assertTrue(storage.saved.isEmpty())
+    }
+
+    @Test
+    fun `stored codec rejects wrong scalar types extra fields and oversized lists`() {
+        val text = CookieCodec.encode(listOf(cookie("saved", persistent = true))).toString()
+        assertEquals("saved", CookieCodec.decode(text).single().name)
+        assertTrue(
+            runCatching {
+                    CookieCodec.decode(text.replace("\"secure\":true", "\"secure\":\"true\""))
+                }
+                .isFailure
+        )
+        val node = Json.parseToJsonElement(text).jsonArray.single().jsonObject
+        assertTrue(
+            runCatching { CookieCodec.decode(JsonArray(List(65) { node }).toString()) }.isFailure
+        )
+        assertTrue(
+            runCatching {
+                    CookieCodec.decode(
+                        JsonArray(listOf(JsonObject(node + ("extra" to JsonPrimitive(true)))))
+                            .toString()
+                    )
+                }
+                .isFailure
+        )
+    }
+}
diff --git a/app/src/test/java/eu/kanade/tachiyomi/extension/sandbox/SandboxFilterCodecTest.kt b/app/src/test/java/eu/kanade/tachiyomi/extension/sandbox/SandboxFilterCodecTest.kt
