+++ b/core/archive/src/main/kotlin/mihon/core/archive/DocumentFormat.kt
@@ -0,0 +1,103 @@
+package mihon.core.archive
+
+import java.io.InputStream
+import java.io.OutputStream
+import java.net.URI
+import java.net.URLDecoder
+import java.util.Locale
+
+enum class DocumentFormat(val extension: String, val mime: String, val text: Boolean) {
+    PDF("pdf", "application/pdf", false),
+    EPUB("epub", "application/epub+zip", true),
+    DOCX("docx", "application/vnd.openxmlformats-officedocument.wordprocessingml.document", true),
+    TXT("txt", "text/plain", true),
+    CBZ("cbz", "application/vnd.comicbook+zip", false),
+    ZIP("zip", "application/zip", false),
+    CBR("cbr", "application/vnd.comicbook-rar", false),
+    RAR("rar", "application/vnd.rar", false),
+    CB7("cb7", "application/x-7z-compressed", false),
+    SEVEN_ZIP("7z", "application/x-7z-compressed", false),
+    CBT("cbt", "application/x-tar", false),
+    TAR("tar", "application/x-tar", false),
+    ;
+
+    companion object {
+        fun fromName(name: String): DocumentFormat? {
+            val extension = name.substringBefore('?').substringBefore('#').substringAfterLast('.', "")
+                .lowercase(Locale.ROOT)
+            return entries.firstOrNull { it.extension == extension }
+        }
+    }
+}
+
+object DocumentLimits {
+    const val MAX_FILE_BYTES = 256L * 1024 * 1024
+    const val MAX_TEXT_BYTES = 16 * 1024 * 1024
+    const val MAX_SECTION_BYTES = 4 * 1024 * 1024
+
+    fun copy(input: InputStream, output: OutputStream, limit: Long = MAX_FILE_BYTES): Long {
+        val buffer = ByteArray(32 * 1024)
+        var total = 0L
+        while (true) {
+            val count = input.read(buffer)
+            if (count < 0) return total
+            total += count
+            require(total <= limit) { "Document exceeds the supported size limit" }
+            output.write(buffer, 0, count)
+        }
+    }
+}
+
+/** Resolves archive references only; never maps a ZIP entry to a filesystem path. */
+object DocumentArchivePath {
+    fun resolve(baseFile: String, href: String): String? {
+        return runCatching {
+            if (href.startsWith("//") || href.contains('\u0000')) return null
+            val raw = href.substringBefore('#').substringBefore('?').replace('\\', '/')
+            if (URI(raw.replace(" ", "%20")).isAbsolute) return null
+            val decoded = URLDecoder.decode(raw.replace("+", "%2B"), "UTF-8")
+            if (decoded.contains('\u0000') || decoded.startsWith("//")) return null
+            val base = if (decoded.startsWith('/')) "" else baseFile.substringBeforeLast('/', "")
+            val parts = mutableListOf<String>()
+            for (part in "$base/$decoded".split('/')) {
+                when (part) {
+                    "", "." -> Unit
+                    ".." -> if (parts.isEmpty()) return null else parts.removeAt(parts.lastIndex)
+                    else -> parts += part
+                }
+            }
+            parts.joinToString("/").takeIf { it.isNotBlank() }
+        }.getOrNull()
+    }
+}
+
+object DocumentRenderSize {
+    fun pixels(width: Int, height: Int): Pair<Int, Int> {
+        require(width > 0 && height > 0)
+        val scale = minOf(
+            1600.0 / width,
+            2400.0 / maxOf(width, height),
+            kotlin.math.sqrt(4_000_000.0 / (width.toDouble() * height)),
+        )
+        return maxOf(1, (width * scale).toInt()) to maxOf(1, (height * scale).toInt())
+    }
+}
+
+object DocumentTextChunks {
+    fun split(value: String, maximum: Int = 3000): List<String> {
+        require(maximum >= 2)
+        val result = mutableListOf<String>()
+        var start = 0
+        while (start < value.length) {
+            var end = minOf(start + maximum, value.length)
+            if (end < value.length) {
+                val space = value.lastIndexOf(' ', end - 1)
+                if (space >= start + maximum / 2) end = space + 1
+                if (value[end - 1].isHighSurrogate() && value[end].isLowSurrogate()) end--
+            }
+            result += value.substring(start, end)
+            start = end
+        }
+        return result
+    }
+}
