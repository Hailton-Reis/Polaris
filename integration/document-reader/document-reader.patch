+        return SMangaUpdate(remote, ordered)
+    }
+
+    private suspend fun load(
+        binding: WorkSource,
+        existing: List<Chapter>,
+        root: WorkSource,
+        details: Boolean,
+        provider: HttpSource,
+    ): Catalog {
+        val request =
+            SManga.create().also {
+                it.url = binding.url
