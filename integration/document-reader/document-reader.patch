@@ -0,0 +1,49 @@
+package eu.kanade.tachiyomi.extension.util
+
+import java.io.File
+import java.io.FileOutputStream
+import java.io.IOException
+import java.nio.file.Files
+import java.nio.file.StandardCopyOption
+
+/** Same-directory staging: never delete the working extension before a validated atomic replacement. */
+internal object PrivateExtensionFiles {
+    @Synchronized
+    fun replace(source: File, target: File, checkCancelled: () -> Unit = {}, validate: (File) -> Unit) {
+        checkCancelled()
+        require(source.isFile) { "Extension download is missing" }
+        val folder = requireNotNull(target.parentFile)
+        check(folder.isDirectory || folder.mkdirs()) { "Cannot create private extension directory" }
+        val staged = File.createTempFile(".${target.name}.", ".pending", folder)
+        try {
+            source.inputStream().use { input ->
+                FileOutputStream(staged).use { output ->
+                    // Android14 requires dynamically loaded code to be read-only before writing.
+                    if (!staged.setReadOnly()) throw IOException("Cannot protect staged extension")
+                    val buffer = ByteArray(64 * 1024)
+                    while (true) {
+                        checkCancelled()
+                        val count = input.read(buffer)
+                        if (count < 0) break
+                        output.write(buffer, 0, count)
+                    }
+                    output.fd.sync()
+                }
+            }
+            checkCancelled()
+            validate(staged)
+            checkCancelled()
+            Files.move(
+                staged.toPath(),
+                target.toPath(),
+                StandardCopyOption.ATOMIC_MOVE,
+                StandardCopyOption.REPLACE_EXISTING,
+            )
+        } finally {
+            staged.delete()
+        }
+    }
+
+    @Synchronized
+    fun delete(target: File): Boolean = target.delete()
+}
