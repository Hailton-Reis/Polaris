diff --git a/app/src/test/java/eu/kanade/tachiyomi/data/updater/PolarisApkDownloaderTest.kt b/app/src/test/java/eu/kanade/tachiyomi/data/updater/PolarisApkDownloaderTest.kt
new file mode 100644
index 0000000..a17f91f
--- /dev/null
+++ b/app/src/test/java/eu/kanade/tachiyomi/data/updater/PolarisApkDownloaderTest.kt
@@ -0,0 +1,217 @@
+package eu.kanade.tachiyomi.data.updater
+
+import com.sun.net.httpserver.HttpExchange
+import com.sun.net.httpserver.HttpServer
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.test.runTest
+import okhttp3.OkHttpClient
+import org.junit.jupiter.api.AfterEach
+import org.junit.jupiter.api.Assertions.assertArrayEquals
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.assertThrows
+import org.junit.jupiter.api.io.TempDir
+import java.io.File
+import java.io.IOException
+import java.net.InetSocketAddress
+import java.security.MessageDigest
+import java.util.Collections
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicInteger
+
+/** Real HTTP/stream tests: no Android, mocked transport, new SDK or remote server required. */
+class PolarisApkDownloaderTest {
+    @TempDir lateinit var directory: File
+    private val bytes = ByteArray(192 * 1024) { ((it * 31 + it / 11) % 251).toByte() }
+    private val hash get() = digest(bytes)
+    private val client = OkHttpClient.Builder().retryOnConnectionFailure(false)
+        .readTimeout(3, TimeUnit.SECONDS).build()
+    private val requests = Collections.synchronizedList(mutableListOf<String?>())
+    private val executor = Executors.newCachedThreadPool { task -> Thread(task).apply { isDaemon = true } }
+    private var server: HttpServer? = null
+    private val apk get() = File(directory, "update.apk")
+    private fun downloader() = PolarisApkDownloader(directory, client)
+
+    @AfterEach fun close() {
+        server?.stop(0)
+        executor.shutdownNow()
+        client.dispatcher.executorService.shutdownNow()
+        client.connectionPool.evictAll()
+    }
+
+    @Test fun `interrupted transfer resumes with a new downloader instance and verifies the entire APK`() = runTest {
+        val prefix = 70_000
+        val url = serve { exchange, count ->
+            if (count == 1) interrupt(exchange, prefix) else remaining(exchange, prefix)
+        }
+        assertThrows<IOException> { downloader().download(url, hash) }
+        assertFalse(apk.exists())
+        assertEquals(prefix.toLong(), partial(url).length())
+        val progress = mutableListOf<Long>()
+        val result = downloader().download(url, hash) { received, _ -> progress += received }
+        assertArrayEquals(bytes, result.readBytes())
+        assertEquals(listOf(null, "bytes=$prefix-"), requests)
+        assertTrue(progress.first() >= prefix)
+        assertEquals(bytes.size.toLong(), progress.last())
+        assertFalse(partial(url).exists())
+    }
+
+    @Test fun `server ignoring Range restarts cleanly without appending a second full APK`() = runTest {
+        val url = serve { exchange, count ->
+            if (count == 1) interrupt(exchange, 30_000) else full(exchange)
+        }
+        assertThrows<IOException> { downloader().download(url, hash) }
+        assertArrayEquals(bytes, downloader().download(url, hash).readBytes())
+        assertEquals("bytes=30000-", requests.last())
+    }
+
+    @Test fun `incorrect partial response is never appended or offered for installation`() = runTest {
+        val url = serve { exchange, _ -> remaining(exchange, 123) }
+        partial(url).writeBytes(bytes.copyOf(100))
+        assertThrows<UpdateResponseException> { downloader().download(url, hash) }
+        assertFalse(apk.exists())
+        assertFalse(partial(url).exists())
+    }
+
+    @Test fun `416 after receiving the final byte promotes only a matching digest`() = runTest {
+        val url = serve { exchange, _ ->
+            exchange.sendResponseHeaders(416, -1)
+            exchange.close()
+        }
+        partial(url).writeBytes(bytes)
+        assertArrayEquals(bytes, downloader().download(url, hash).readBytes())
+        assertEquals(listOf("bytes=${bytes.size}-"), requests)
+    }
+
+    @Test fun `416 with a corrupt partial discards it and requests the full file`() = runTest {
+        val url = serve { exchange, count ->
+            if (count == 1) {
+                exchange.sendResponseHeaders(416, -1)
+                exchange.close()
+            } else {
+                full(exchange)
+            }
+        }
+        partial(url).writeText("wrong bytes")
+        assertArrayEquals(bytes, downloader().download(url, hash).readBytes())
+        assertEquals(listOf("bytes=11-", null), requests)
+    }
+
+    @Test fun `checksum mismatch removes the candidate and leaves no installable APK`() = runTest {
+        val url = serve { exchange, _ -> full(exchange) }
+        assertThrows<IOException> { downloader().download(url, "0".repeat(64)) }
+        assertFalse(apk.exists())
+        assertTrue(directory.listFiles()!!.none { it.extension == "part" })
+    }
+
+    @Test fun `cancellation retains written bytes and the next attempt resumes them`() = runTest {
+        val url = serve { exchange, _ ->
+            val offset = exchange.requestHeaders.getFirst("Range")?.substringAfter('=')?.substringBefore('-')?.toInt()
+            if (offset == null) full(exchange) else remaining(exchange, offset)
+        }
+        assertThrows<CancellationException> {
+            downloader().download(url, hash) { received, _ ->
+                if (received > 0) throw CancellationException("Simulated worker interruption")
+            }
+        }
+        val saved = partial(url).length()
+        assertTrue(saved > 0)
+        assertFalse(apk.exists())
+        assertArrayEquals(bytes, downloader().download(url, hash).readBytes())
+        assertEquals("bytes=$saved-", requests.last())
+    }
+
+    @Test fun `verified APK is reused when the install screen is reopened`() = runTest {
+        val url = serve { exchange, _ -> full(exchange) }
+        downloader().download(url, hash)
+        assertArrayEquals(bytes, downloader().download(url, hash.uppercase()).readBytes())
+        assertEquals(1, requests.size)
+    }
+
+    @Test fun `another release cannot reuse stale partial bytes`() = runTest {
+        val url = serve { exchange, _ -> full(exchange) }
+        val old = partial("$url/old")
+        old.writeText("old release")
+        assertArrayEquals(bytes, downloader().download(url, hash).readBytes())
+        assertFalse(old.exists())
+        assertEquals(listOf<String?>(null), requests)
+    }
+
+    @Test fun `legacy requests without a digest restart rather than merging unpinned bytes`() = runTest {
+        val url = serve { exchange, count ->
+            if (count == 1) interrupt(exchange, 30_000) else full(exchange)
+        }
+        assertThrows<IOException> { downloader().download(url, null) }
+        assertArrayEquals(bytes, downloader().download(url, null).readBytes())
+        assertEquals(listOf(null, null), requests)
+    }
+
+    @Test fun `retryable HTTP error preserves a partial for the next worker attempt`() = runTest {
+        val url = serve { exchange, count ->
+            if (count == 1) {
+                exchange.sendResponseHeaders(503, -1)
+                exchange.close()
+            } else {
+                remaining(exchange, 500)
+            }
+        }
+        partial(url).writeBytes(bytes.copyOf(500))
+        val failure = assertThrows<UpdateHttpException> { downloader().download(url, hash) }
+        assertTrue(failure.retryable)
+        assertFalse(UpdateHttpException(404).retryable)
+        assertEquals(500, partial(url).length())
+        assertArrayEquals(bytes, downloader().download(url, hash).readBytes())
+    }
+
+    @Test fun `encoded response is rejected before it changes the partial`() = runTest {
+        val url = serve { exchange, _ ->
+            exchange.responseHeaders.set("Content-Encoding", "gzip")
+            full(exchange)
+        }
+        assertThrows<UpdateResponseException> { downloader().download(url, hash) }
+        assertFalse(apk.exists())
+    }
+
+    private fun partial(url: String) = File(directory, "update-${PolarisApkDownloader.identity(url, hash)}.part")
+
+    private fun serve(handler: (HttpExchange, Int) -> Unit): String {
+        val count = AtomicInteger()
+        val instance = HttpServer.create(InetSocketAddress("127.0.0.1", 0), 0)
+        instance.executor = executor
+        instance.createContext("/apk") { exchange ->
+            requests += exchange.requestHeaders.getFirst("Range")
+            try {
+                handler(exchange, count.incrementAndGet())
+            } finally {
+                exchange.close()
+            }
+        }
+        instance.start()
+        server = instance
+        return "http://127.0.0.1:${instance.address.port}/apk"
+    }
+
+    private fun full(exchange: HttpExchange) {
+        exchange.sendResponseHeaders(200, bytes.size.toLong())
+        exchange.responseBody.use { it.write(bytes) }
+    }
+
+    private fun interrupt(exchange: HttpExchange, prefix: Int) {
+        exchange.sendResponseHeaders(200, bytes.size.toLong())
+        exchange.responseBody.write(bytes, 0, prefix)
+        exchange.responseBody.flush()
+        // Closing before the declared Content-Length simulates a lost connection.
+    }
+
+    private fun remaining(exchange: HttpExchange, offset: Int) {
+        exchange.responseHeaders.set("Content-Range", "bytes $offset-${bytes.lastIndex}/${bytes.size}")
+        exchange.sendResponseHeaders(206, (bytes.size - offset).toLong())
+        exchange.responseBody.use { it.write(bytes, offset, bytes.size - offset) }
+    }
+
+    private fun digest(value: ByteArray) = MessageDigest.getInstance("SHA-256").digest(value)
+        .joinToString("") { "%02x".format(it) }
+}
