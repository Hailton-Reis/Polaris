+package eu.kanade.tachiyomi.ui.documents
+
+import android.content.ContentResolver
+import android.content.Context
+import android.database.Cursor
+import android.net.Uri
+import io.mockk.every
+import io.mockk.justRun
+import io.mockk.mockk
+import io.mockk.verify
+import kotlinx.coroutines.test.runTest
+import mihon.core.archive.DocumentFormat
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.assertThrows
+
+class DocumentSelectionTest {
+    private val resolver = mockk<ContentResolver>()
+    private val context = mockk<Context> { every { contentResolver } returns resolver }
+    private val uri = mockk<Uri> { every { scheme } returns "content" }
+    private val cursor = mockk<Cursor> {
+        every { moveToFirst() } returns true
+        every { getString(0) } returns "My paper.PDF"
+        justRun { close() }
+    }
+
+    init {
+        every { resolver.query(uri, any(), any(), any(), any()) } returns cursor
+    }
+
+    @Test
+    fun `selecting a phone file reads its description without opening or copying its contents`() = runTest {
+        val selection = DocumentImporter(context).describeUri(uri)
+        assertEquals("My paper.PDF", selection.name)
+        assertEquals(DocumentFormat.PDF, selection.format)
+        verify(exactly = 0) { resolver.openInputStream(any()) }
+        verify(exactly = 0) { context.cacheDir }
+        verify(exactly = 1) { cursor.close() }
+    }
+
+    @Test
+    fun `unsupported selection is rejected before any file copy`() = runTest {
+        every { cursor.getString(0) } returns "installer.apk"
+        assertThrows<IllegalStateException> { DocumentImporter(context).describeUri(uri) }
+        verify(exactly = 0) { resolver.openInputStream(any()) }
+    }
+
+    @Test
+    fun `a raw filesystem uri is not treated as permission to scan the phone`() = runTest {
+        every { uri.scheme } returns "file"
+        assertThrows<IllegalArgumentException> { DocumentImporter(context).describeUri(uri) }
+        verify(exactly = 0) { resolver.query(any(), any(), any(), any(), any()) }
+    }
+}
diff --git a/app/src/test/java/eu/kanade/tachiyomi/ui/documents/TextDocumentTest.kt b/app/src/test/java/eu/kanade/tachiyomi/ui/documents/TextDocumentTest.kt
new file mode 100644
index 0000000..a588cab
--- /dev/null
+++ b/app/src/test/java/eu/kanade/tachiyomi/ui/documents/TextDocumentTest.kt
@@ -0,0 +1,207 @@
+@file:Suppress("ktlint:standard:max-line-length")
+
+package eu.kanade.tachiyomi.ui.documents
+
+import mihon.core.archive.DocumentArchivePath
+import mihon.core.archive.DocumentBlock
+import mihon.core.archive.DocumentFormat
+import mihon.core.archive.DocumentLimits
+import mihon.core.archive.DocumentRenderSize
+import mihon.core.archive.DocumentTextChunks
+import mihon.core.archive.TextDocument
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertNull
+import org.junit.jupiter.api.Assertions.assertThrows
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import java.io.ByteArrayInputStream
+import java.io.ByteArrayOutputStream
+import java.nio.file.Files
+import java.util.zip.ZipEntry
+import java.util.zip.ZipOutputStream
+
+class TextDocumentTest {
+    private fun zip(entries: Map<String, String>, block: (java.io.File) -> Unit) {
+        val file = Files.createTempFile("polaris-document", ".zip").toFile()
+        try {
+            ZipOutputStream(file.outputStream()).use { output ->
+                entries.forEach { (name, value) ->
+                    output.putNextEntry(ZipEntry(name))
+                    output.write(value.toByteArray())
+                    output.closeEntry()
+                }
+            }
+            block(file)
+        } finally {
+            file.delete()
+        }
+    }
+
+    private fun epub(extra: Map<String, String>) = mapOf(
+        "META-INF/container.xml" to
+            "<container><rootfiles><rootfile full-path='OPS/package.opf'/></rootfiles></container>",
+        "OPS/package.opf" to
+            """<package xmlns:dc="urn:dc"><metadata><dc:title>Ciência</dc:title><dc:creator>Ana</dc:creator></metadata><manifest><item id="second" href="chapters/two.xhtml" media-type="application/xhtml+xml"/><item id="first" href="chapters/one.xhtml" media-type="application/xhtml+xml"/></manifest><spine><itemref idref="first"/><itemref idref="second"/></spine></package>""",
+        "OPS/chapters/one.xhtml" to
+            "<html><body><h1>First</h1><p>Hello <em>reader</em>!</p><img src='../images/a%20b+1.png'/><script>never execute</script></body></html>",
+        "OPS/chapters/two.xhtml" to "<html><body><p>Second section</p></body></html>",
+        "OPS/images/a b+1.png" to "test image bytes",
+    ) + extra
+
+    @Test
+    fun `epub follows spine order and preserves metadata text and local images`() = zip(epub(emptyMap())) { file ->
+        TextDocument(file, DocumentFormat.EPUB).use { reader ->
+            assertEquals("Ciência", reader.title)
+            assertEquals("Ana", reader.author)
+            assertEquals(listOf("OPS/chapters/one.xhtml", "OPS/chapters/two.xhtml"), reader.sections.map { it.key })
+            val blocks = reader.readSection(0)
+            assertEquals(
+                listOf("First", "Hello reader!"),
+                blocks.filterIsInstance<DocumentBlock.Text>().map {
+                    it.value
+                },
+            )
+            assertTrue((blocks.first() as DocumentBlock.Text).heading)
+            assertEquals("OPS/images/a b+1.png", blocks.filterIsInstance<DocumentBlock.Image>().single().path)
+            assertEquals("test image bytes", reader.image("OPS/images/a b+1.png").toString(Charsets.UTF_8))
+        }
+    }
+
+    @Test
+    fun `epub rejects archive escape and ignores network resources`() = zip(
+        epub(
+            mapOf(
+                "OPS/chapters/one.xhtml" to
+                    "<html><body><p>Visible</p><img src='https://example.invalid/tracker.png'/><img src='../../../secret.png'/></body></html>",
+            ),
+        ),
+    ) { file ->
+        TextDocument(file, DocumentFormat.EPUB).use { reader ->
+            assertEquals(listOf(DocumentBlock.Text("Visible")), reader.readSection(0))
+        }
+    }
+
+    @Test
+    fun `docx extracts body paragraphs line breaks tables and embedded images in order`() = zip(
+        mapOf(
+            "word/document.xml" to
+                """<w:document xmlns:w="urn:word" xmlns:r="urn:rel" xmlns:a="urn:drawing"><w:body><w:p><w:r><w:t>Title</w:t></w:r></w:p><w:p><w:r><w:t>One</w:t><w:tab/><w:t>two</w:t><w:br/><w:t>three</w:t></w:r></w:p><w:p><w:r><a:blip r:embed="img1"/></w:r></w:p><w:tbl><w:tr><w:tc><w:p><w:r><w:t>Cell A</w:t></w:r></w:p></w:tc><w:tc><w:p><w:r><w:t>Cell B</w:t></w:r></w:p></w:tc></w:tr></w:tbl></w:body></w:document>""",
+            "word/_rels/document.xml.rels" to
+                "<Relationships><Relationship Id='img1' Target='media/picture.png'/><Relationship Id='external' TargetMode='External' Target='https://example.invalid/a'/></Relationships>",
+            "word/media/picture.png" to "picture",
+        ),
+    ) { file ->
+        TextDocument(file, DocumentFormat.DOCX).use { reader ->
+            val blocks = reader.readSection(0)
+            assertEquals(
+                listOf("Title", "One\ttwo\nthree", "Cell A", "Cell B"),
+                blocks.filterIsInstance<DocumentBlock.Text>().map {
+                    it.value
+                },
+            )
+            assertEquals(DocumentBlock.Image("word/media/picture.png"), blocks[2])
+        }
+    }
+
+    @Test
+    fun `zip renamed docx must contain the actual word document`() = zip(mapOf("other.txt" to "not Word")) { file ->
+        assertThrows(IllegalStateException::class.java) { TextDocument(file, DocumentFormat.DOCX) }
+    }
+
+    @Test
+    fun `txt supports utf8 utf16 bom and windows1252`() {
+        for (bytes in listOf(
+            "Hello ciência".toByteArray(),
+            "Hello ciência".toByteArray(Charsets.UTF_16),
+            "Hello ciência".toByteArray(charset("windows-1252")),
+        )) {
+            val file = Files.createTempFile("polaris-text", ".txt").toFile()
+            try {
+                file.writeBytes(bytes)
+                TextDocument(file, DocumentFormat.TXT).use {
+                    assertEquals("Hello ciência", (it.readSection(0).single() as DocumentBlock.Text).value)
+                }
+            } finally {
+                file.delete()
+            }
+        }
+    }
+
+    @Test
+    fun `long paragraphs are bounded without losing unicode or text`() {
+        val value = "A paragraph with 😀 science and symbols αβ. ".repeat(600)
+        val chunks = DocumentTextChunks.split(value)
+        assertEquals(value, chunks.joinToString(""))
+        assertTrue(chunks.all { it.length <= 3000 })
+        assertTrue(chunks.none { it.last().isHighSurrogate() || it.first().isLowSurrogate() })
+    }
+
+    @Test
+    fun `large txt has multiple navigable sections with bounded text blocks`() {
+        val file = Files.createTempFile("polaris-long-text", ".txt").toFile()
+        try {
+            file.writeText("Long paragraph. ".repeat(3000))
+            TextDocument(file, DocumentFormat.TXT).use { reader ->
+                assertTrue(reader.sections.size > 1)
+                assertTrue(
+                    reader.sections.indices.flatMap {
+                        reader.readSection(it)
+                    }.filterIsInstance<DocumentBlock.Text>().all {
+                        it.value.length <=
+                            3000
+                    },
+                )
+            }
+        } finally {
+            file.delete()
+        }
+    }
+
+    @Test
+    fun `entry resolution keeps plus signs decodes spaces and rejects remote or escaping paths`() {
+        assertEquals(
+            "OPS/images/a b+1.png",
+            DocumentArchivePath.resolve("OPS/text/a.xhtml", "../images/a%20b+1.png#fragment"),
+        )
+        for (path in listOf(
+            "../../../outside",
+            "https://example.com/x",
+            "file:///private",
+            "//example.com/x",
+            "data:image/png;base64,AAA",
+        )) {
+            assertNull(DocumentArchivePath.resolve("OPS/book.xhtml", path), path)
+        }
+    }
+
+    @Test
+    fun `oversized section is rejected before it becomes a text view`() = zip(
+        epub(
+            mapOf(
+                "OPS/chapters/one.xhtml" to "x".repeat(DocumentLimits.MAX_SECTION_BYTES + 1),
+            ),
+        ),
+    ) { file ->
+        TextDocument(file, DocumentFormat.EPUB).use { reader ->
+            assertThrows(IllegalArgumentException::class.java) { reader.readSection(0) }
+        }
+    }
+
+    @Test
+    fun `bounded copy rejects overflow and pdf rendering has a bounded pixel budget`() {
+        val output = ByteArrayOutputStream()
+        assertThrows(IllegalArgumentException::class.java) {
+            DocumentLimits.copy(ByteArrayInputStream(ByteArray(20)), output, 10)
+        }
+        assertTrue(output.size() <= 10)
+        for ((width, height) in listOf(612 to 792, 20000 to 30000, 1 to 100000, 50000 to 1)) {
+            val size = DocumentRenderSize.pixels(width, height)
+            assertTrue(size.first > 0 && size.second > 0)
+            assertTrue(size.first.toLong() * size.second <= 4_000_000)
+            assertTrue(maxOf(size.first, size.second) <= 2400)
+        }
+        assertFalse(DocumentFormat.fromName("BOOK.EPUB") == null)
+        assertNull(DocumentFormat.fromName("installer.apk"))
+    }
+}
