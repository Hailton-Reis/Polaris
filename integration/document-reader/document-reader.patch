+    suspend fun translateProbe(text: String): String
+}
+
+/** Readiness is reported only after both the official SDK download and an on-device probe succeed. */
+object EnglishTranslationBootstrap {
+    suspend fun verifyExisting(createSession: () -> EnglishTranslationSession) {
+        createSession().use { session -> verify(session) }
+    }
+
+    suspend fun prepare(createSession: () -> EnglishTranslationSession) {
+        createSession().use { session ->
+            session.downloadRequiredModels()
+            verify(session)
+        }
+    }
+
+    private suspend fun verify(session: EnglishTranslationSession) {
+        check(session.translateProbe("Hello").isNotBlank()) { "English-Portuguese model check failed" }
+    }
+}
