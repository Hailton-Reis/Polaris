@@ -0,0 +1,100 @@
+package mihon.core.archive
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.Color
+import android.graphics.pdf.PdfRenderer
+import android.os.ParcelFileDescriptor
+import com.hippo.unifile.UniFile
+import java.io.Closeable
+import java.io.File
+import java.io.InputStream
+import java.util.UUID
+
+class PdfPageReader(private val context: Context, source: UniFile) : Closeable {
+    private val lease = DocumentFiles.materialize(context, source)
+    private val file = lease.file
+    private val descriptor = try {
+        ParcelFileDescriptor.open(file, ParcelFileDescriptor.MODE_READ_ONLY)
+    } catch (
+        error: Throwable,
+    ) {
+        lease.close()
+        throw error
+    }
+    private val renderer = try {
+        PdfRenderer(descriptor)
+    } catch (error: Throwable) {
+        descriptor.close()
+        lease.close()
+        throw error
+    }
+    private val cache = File(context.cacheDir, "pdf-pages/${file.name}").apply { mkdirs() }
+    private var closed = false
+
+    val pageCount: Int = try {
+        renderer.pageCount.also { require(it in 1..10000) { "Unsupported PDF page count" } }
+    } catch (error: Throwable) {
+        renderer.close()
+        lease.close()
+        throw error
+    }
+
+    fun pageKey(index: Int): String = "pdf-${index.toString().padStart(5, '0')}.png"
+
+    @Synchronized
+    fun openPage(index: Int): InputStream {
+        check(!closed)
+        require(index in 0 until pageCount)
+        val target = File(cache, pageKey(index))
+        val pageLease = DocumentCacheBudget.acquire(context.cacheDir, target) {
+            if (!target.isFile || target.length() == 0L) {
+                val temporary = File(cache, ".$index-${UUID.randomUUID()}.png")
+                try {
+                    renderer.openPage(index).use { page ->
+                        val (width, height) = DocumentRenderSize.pixels(page.width, page.height)
+                        val bitmap = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888)
+                        try {
+                            bitmap.eraseColor(Color.WHITE)
+                            page.render(bitmap, null, null, PdfRenderer.Page.RENDER_MODE_FOR_DISPLAY)
+                            temporary.outputStream().use { output ->
+                                check(bitmap.compress(Bitmap.CompressFormat.PNG, 100, output))
+                            }
+                        } finally {
+                            bitmap.recycle()
+                        }
+                    }
+                    check(temporary.renameTo(target)) { "Cannot cache PDF page" }
+                } finally {
+                    temporary.delete()
+                }
+            }
+        }
+        return try {
+            object : java.io.FilterInputStream(target.inputStream()) {
+                override fun close() {
+                    try {
+                        super.close()
+                    } finally {
+                        pageLease.close()
+                    }
+                }
+            }
+        } catch (error: Throwable) {
+            pageLease.close()
+            throw error
+        }
+    }
+
+    @Synchronized
+    override fun close() {
+        if (!closed) {
+            closed = true
+            try {
+                renderer.close()
+            } finally {
+                lease.close()
+            }
+        }
+    }
+}
