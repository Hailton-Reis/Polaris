+                    .filter { it.url !in knownNative && !ChapterOrigin.isRouted(it.url) }
+                    .map { chapter ->
+                        projectedChapter(chapter).also { added ->
+                            val clean =
+                                JsonObject(
+                                    MemoColumnAdapter.decode(chapter.memo).filterKeys {
+                                        !it.startsWith("polaris.")
+                                    }
+                                )
+                            val o =
+                                ChapterOrigin(
+                                    portable.source,
+                                    binding?.name.orEmpty(),
+                                    binding?.language.orEmpty(),
+                                    portable.url,
+                                    chapter.url,
+                                    sourceMemo = clean,
+                                )
+                            added.url =
+                                if (portable.source == raw.source && portable.url == raw.url)
+                                    chapter.url
+                                else ChapterOrigin.storedUrl(portable.source, chapter.url)
+                            added.memo = MemoColumnAdapter.encode(o.attach(clean))
+                        }
+                    }
+        val originalGroups = raw.chapters.groupBy(::key)
+        raw.chapters.forEach { chapter ->
+            val corresponding = nativeUrl(chapter)?.let(native::get) ?: return@forEach
+            val group = originalGroups.getValue(key(chapter))
+            val wasRead = group.any { it.read }
+            val wasBookmarked = group.any { it.bookmark }
+            // Only changes made in a reader retaining memo affect the saved Polaris editions.
+            if (corresponding.read != wasRead) group.forEach { it.read = corresponding.read }
