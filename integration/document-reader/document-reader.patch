+package eu.kanade.tachiyomi.polaris
+
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.net.Uri
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import androidx.test.platform.app.InstrumentationRegistry
+import eu.kanade.domain.ui.UiPreferences
+import eu.kanade.domain.ui.model.LauncherIcon
+import eu.kanade.tachiyomi.util.system.LauncherIconManager
+import java.util.UUID
+import org.junit.*
+import org.junit.Assert.*
+import org.junit.runner.RunWith
+import tachiyomi.core.common.preference.AndroidPreferenceStore
+
+@RunWith(AndroidJUnit4::class)
+class LauncherIconAndroidTest {
+    private val context = InstrumentationRegistry.getInstrumentation().targetContext
+    private val state = mutableMapOf<LauncherIcon, Int>()
+    private val name = "polaris-icon-test-${UUID.randomUUID()}"
+    private lateinit var preferences: UiPreferences
+
+    @Before
+    fun setup() {
+        LauncherIcon.entries.forEach {
+            state[it] =
+                context.packageManager.getComponentEnabledSetting(
+                    LauncherIconManager.component(context, it)
+                )
+        }
+        preferences =
+            UiPreferences(
+                AndroidPreferenceStore(
+                    context,
+                    context.getSharedPreferences(name, Context.MODE_PRIVATE),
+                )
+            )
+    }
+
+    @After
+    fun restore() {
+        state.entries
+            .sortedBy {
+                if (
+                    it.value == PackageManager.COMPONENT_ENABLED_STATE_ENABLED ||
+                        (it.key == LauncherIcon.DEFAULT &&
+                            it.value == PackageManager.COMPONENT_ENABLED_STATE_DEFAULT)
+                )
+                    0
+                else 1
+            }
+            .forEach { (icon, value) ->
+                context.packageManager.setComponentEnabledSetting(
+                    LauncherIconManager.component(context, icon),
+                    value,
+                    PackageManager.DONT_KILL_APP,
+                )
+            }
+        context.deleteSharedPreferences(name)
+    }
+
+    @Test
+    fun everyChoiceHasExactlyOneVisibleLauncherAndInflatesItsIcon() {
+        for (icon in LauncherIcon.entries) {
+            assertTrue(LauncherIconManager.change(context, icon, preferences).isSuccess)
+            val launchers =
+                context.packageManager.queryIntentActivities(
+                    Intent(Intent.ACTION_MAIN)
+                        .addCategory(Intent.CATEGORY_LAUNCHER)
+                        .setPackage(context.packageName),
+                    0,
+                )
+            assertEquals(1, launchers.size)
+            assertEquals(
+                LauncherIconManager.component(context, icon).className,
+                launchers.single().activityInfo.name,
+            )
+            assertTrue(launchers.single().loadIcon(context.packageManager).intrinsicWidth > 0)
+            assertEquals(icon, preferences.launcherIcon.get())
+            assertNotNull(context.packageManager.getLaunchIntentForPackage(context.packageName))
+        }
+    }
+
+    @Test
+    fun iconSwitchKeepsOriginalActivityAndRepositoryLinksAvailable() {
+        assertTrue(
+            LauncherIconManager.change(context, LauncherIcon.CONSTELLATION, preferences).isSuccess
+        )
+        val main = ComponentName(context.packageName, "eu.kanade.tachiyomi.ui.main.MainActivity")
+        assertTrue(context.packageManager.getActivityInfo(main, 0).enabled)
+        val link =
+            Intent(
+                    Intent.ACTION_VIEW,
+                    Uri.parse("mihon://extension-store?url=https://example.org/repo.json"),
+                )
+                .setPackage(context.packageName)
+        assertEquals(
+            main.className,
+            context.packageManager
+                .resolveActivity(link, PackageManager.MATCH_DEFAULT_ONLY)
+                ?.activityInfo
+                ?.name,
+        )
+    }
+
+    @Test
+    fun unknownRestoredChoiceAndMissingEnabledAliasesRecoverToOriginal() {
+        preferences.launcherIcon.set(LauncherIcon.ORBIT)
+        LauncherIcon.entries.forEach {
+            context.packageManager.setComponentEnabledSetting(
+                LauncherIconManager.component(context, it),
+                PackageManager.COMPONENT_ENABLED_STATE_DISABLED,
+                PackageManager.DONT_KILL_APP,
+            )
+        }
+        LauncherIconManager.reconcile(context, preferences)
+        assertTrue(LauncherIconManager.isEnabled(context, LauncherIcon.ORBIT))
+        context
+            .getSharedPreferences(name, Context.MODE_PRIVATE)
+            .edit()
+            .putString("polaris_launcher_icon", "FUTURE_OPTION")
+            .commit()
+        LauncherIconManager.reconcile(context, preferences)
+        assertTrue(LauncherIconManager.isEnabled(context, LauncherIcon.DEFAULT))
+        assertEquals(1, LauncherIcon.entries.count { LauncherIconManager.isEnabled(context, it) })
+    }
+}
