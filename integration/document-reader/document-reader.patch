@@ -0,0 +1,121 @@
+package tachiyomi.domain.chapter.interactor
+
+import kotlinx.coroutines.flow.*
+import tachiyomi.domain.chapter.model.*
+import tachiyomi.domain.chapter.repository.ChapterRepository
+import tachiyomi.domain.manga.model.*
+import tachiyomi.domain.manga.repository.*
+
+class GetLibraryWorkChapters(
+    private val mangas: MangaRepository,
+    private val chapters: ChapterRepository,
+    private val works: LibraryWorkRepository,
+) {
+    suspend fun rootId(id: Long): Long {
+        val owner = mangas.getMangaById(id)
+        val state = LibraryWork.from(owner.memo) ?: return id
+        val favorites = works.favorites()
+        val root = favorites.firstOrNull { state.isPrimary(it) } ?: return id
+        return root.id.takeIf {
+            members(root.id).let { it.size > 1 && it.any { member -> member.id == id } }
+        } ?: id
+    }
+
+    private suspend fun declaredMembers(id: Long): List<Manga> {
+        val root = mangas.getMangaById(id)
+        return LibraryWork.from(root.memo)?.resolve(root, works.favorites()) ?: listOf(root)
+    }
+
+    suspend fun members(id: Long): List<Manga> {
+        val declared = declaredMembers(id)
+        if (declared.size < 2) return declared
+        val raw = declared.map { chapters.getChapterByMangaId(it.id, false) }
+        return validatedMembers(declared, raw)
+    }
+
+    private fun validatedMembers(members: List<Manga>, raw: List<List<Chapter>>): List<Manga> =
+        if (members.size < 2 || ChapterNumbering.compatibleEditions(members, raw)) members
+        else listOf(members.first())
+
+    private fun annotate(owner: Manga, root: Manga, raw: List<Chapter>, rank: Int): List<Chapter> {
+        val work = LibraryWork.from(root.memo)
+        val edition =
+            work?.editions?.firstOrNull { it.source == owner.source && it.url == owner.url }
+        val pinned = WorkSources.from(root.memo).pinned
+        return raw.map { chapter ->
+            val origin =
+                (if (ChapterOrigin.KEY in chapter.memo) ChapterOrigin.from(chapter.memo) else null)
+                    ?: ChapterOrigin(owner.source, "", "", owner.url, chapter.url, rank)
+            val language = origin.language.ifBlank { edition?.language.orEmpty() }
+            val pinRank =
+                if (
+                    pinned == null ||
+                        pinned.sourceId == origin.sourceId && pinned.url == origin.mangaUrl
+                )
+                    0
+                else 1000
+            val languageRank =
+                when (language.lowercase().replace('_', '-')) {
+                    "pt-br" -> 0
+                    "pt" -> 1
+                    "en" -> 2
+                    else -> 3
+                }
+            val memo =
+                if (owner.id == root.id && work == null) ChapterStorage.strip(chapter.memo)
+                else
+                    origin
+                        .copy(
+                            rank = pinRank + languageRank * 100 + origin.rank.coerceIn(0, 99),
+                            language = language,
+                            sourceName = origin.sourceName.ifBlank { edition?.sourceName.orEmpty() },
+                        )
+                        .attach(ChapterStorage.strip(chapter.memo))
+            ChapterStorage.of(owner).attach(chapter.copy(memo = memo))
+        }
+    }
+
+    data class Snapshot(val members: List<Manga>, val chapters: List<Chapter>)
+
+    private suspend fun project(
+        members: List<Manga>,
+        raw: List<List<Chapter>>,
+        filtered: Boolean,
+    ): Snapshot {
+        val valid = validatedMembers(members, raw)
+        return Snapshot(
+            valid,
+            valid.flatMapIndexed { index, owner ->
+                val visible =
+                    if (filtered) chapters.getChapterByMangaId(owner.id, true) else raw[index]
+                annotate(owner, valid.first(), visible, index)
+            },
+        )
+    }
+
+    suspend fun snapshot(id: Long, filtered: Boolean = false): Snapshot {
+        val members = declaredMembers(id)
+        val raw = members.map { chapters.getChapterByMangaId(it.id, false) }
+        return project(members, raw, filtered)
+    }
+
+    suspend fun await(id: Long, filtered: Boolean = false): List<Chapter> =
+        snapshot(id, filtered).chapters
+
+    @OptIn(kotlinx.coroutines.ExperimentalCoroutinesApi::class)
+    fun subscribe(id: Long, filtered: Boolean = false): Flow<List<Chapter>> =
+        works
+            .subscribeFavorites()
+            .map { favorites ->
+                val root = mangas.getMangaById(id)
+                LibraryWork.from(root.memo)?.resolve(root, favorites) ?: listOf(root)
+            }
+            .distinctUntilChanged()
+            .flatMapLatest { members ->
+                combine(
+                    members.map { owner -> chapters.getChapterByMangaIdAsFlow(owner.id, false) }
+                ) { lists ->
+                    project(members, lists.toList(), filtered).chapters
+                }
+            }
+}
