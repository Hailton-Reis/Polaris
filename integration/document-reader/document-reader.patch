+class PreferenceRestoreSecurityTest {
+    @Test
+    fun `a crafted backup cannot authorize extension trust or exact-byte security overrides`() =
+        runTest {
+            val store = mockk<PreferenceStore>()
+            val trust = Preference.appStateKey("trusted_extensions")
+            val overrides = Preference.appStateKey("polaris_extension_security_overrides")
+            val existingTrust =
+                InMemoryPreferenceStore.InMemoryPreference(
+                    trust,
+                    setOf("existing local trust"),
+                    emptySet(),
+                )
+            val existingOverrides =
+                InMemoryPreferenceStore.InMemoryPreference(
+                    overrides,
+                    setOf("existing local override"),
+                    emptySet(),
+                )
+            val ordinary = InMemoryPreferenceStore.InMemoryPreference("ordinary_setting", "", "")
+            every { store.getAll() } answers
+                {
+                    mapOf(
+                        trust to existingTrust.get(),
+                        overrides to existingOverrides.get(),
+                        "ordinary_setting" to ordinary.get(),
+                    )
+                }
+            every { store.getStringSet(trust, any()) } returns existingTrust
+            every { store.getStringSet(overrides, any()) } returns existingOverrides
+            every { store.getString("ordinary_setting", any()) } returns ordinary
+            val restored = PreferenceRestorer(mockk<Context>(), mockk<GetCategories>(), store)
+            restored.restorePreferences(
+                listOf(
+                    BackupPreference(trust, StringSetPreferenceValue(setOf("injected trust"))),
+                    BackupPreference(
+                        overrides,
+                        StringSetPreferenceValue(setOf("injected override")),
+                    ),
+                    BackupPreference(
+                        "ordinary_setting",
+                        StringPreferenceValue("preserved user setting"),
+                    ),
+                ),
+                store,
+            )
+            assertEquals(setOf("existing local trust"), existingTrust.get())
+            assertEquals(setOf("existing local override"), existingOverrides.get())
+            assertEquals("preserved user setting", ordinary.get())
+            verify(exactly = 0) { store.getStringSet(trust, any()) }
+            verify(exactly = 0) { store.getStringSet(overrides, any()) }
+        }
+
+    @Test
+    fun `an internal permission absent on the device is not created by imported app state`() =
+        runTest {
+            val store = mockk<PreferenceStore>()
+            val key = Preference.appStateKey("future_extension_runtime_approval")
+            every { store.getAll() } returns emptyMap<String, Any>()
+            val restorer = PreferenceRestorer(mockk<Context>(), mockk<GetCategories>(), store)
+            restorer.restorePreferences(
+                listOf(BackupPreference(key, StringSetPreferenceValue(setOf("approved")))),
