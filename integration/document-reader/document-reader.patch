+package eu.kanade.tachiyomi.extension.sandbox
+
+import android.content.Context
+import eu.kanade.tachiyomi.source.ConfigurableSource
+import eu.kanade.tachiyomi.source.model.*
+import eu.kanade.tachiyomi.source.online.HttpSource
+import java.io.File
+import kotlinx.serialization.json.*
+import okhttp3.Headers
+import okhttp3.MediaType.Companion.toMediaTypeOrNull
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.RequestBody.Companion.toRequestBody
+
+/**
+ * Host proxy containing only DTOs. Extension classes/constructors exist exclusively in the worker.
+ */
+internal class IsolatedHttpSource
+private constructor(private val runtime: Runtime, metadata: JsonObject) :
+    HttpSource(), ConfigurableSource {
+    override val id = metadata.getValue("id").jsonPrimitive.long
+    override val name = metadata.getValue("name").jsonPrimitive.content
+    override val lang = metadata.getValue("lang").jsonPrimitive.content
+    override val baseUrl = metadata.getValue("url").jsonPrimitive.content
+    override val supportsLatest = metadata.getValue("latest").jsonPrimitive.boolean
+    val supportsPreferences = metadata["preferencesSupported"]?.jsonPrimitive?.boolean == true
+    val owningPackageName: String?
+        get() = runtime.packageName
+
+    override fun getSourcePreferences() = runtime.preferences.preferences(id)
+
+    override fun setupPreferenceScreen(screen: androidx.preference.PreferenceScreen) {
+        error("Isolated preferences must be loaded asynchronously")
+    }
+
+    fun sessionStatus() = runtime.cookies.status()
+
+    fun clearSession() = runtime.cookies.clear()
+
+    fun browserSession(): BrowserCookieSession {
+        check(!runtime.isQuarantined()) { "Extension quarantined" }
+        return BrowserCookieSession(baseUrl, runtime.cookies.newSessionJar())
+    }
+
+    suspend fun preferenceSchema(): JsonObject = call("preferences")
+
+    suspend fun changePreferences(schema: String, changes: JsonObject): Boolean =
+        call(
+                "preferenceChange",
+                buildJsonObject {
+                    put("schema", schema)
+                    put("changes", changes)
+                },
+            )
+            .let {
+                it.getValue("accepted").jsonPrimitive.boolean ||
+                    it.getValue("changed").jsonPrimitive.boolean
+            }
+
+    fun hasLegacyPreferences(): Boolean =
+        runtime.context.getSharedPreferences("source_$id", Context.MODE_PRIVATE).all.isNotEmpty()
+
+    suspend fun importLegacyPreferences(schema: JsonObject): Boolean {
+        val keys = mutableSetOf<String>()
+        fun collect(nodes: JsonArray) {
+            nodes.forEach { node ->
+                val item = node.jsonObject
+                if (
+                    item["kind"]?.jsonPrimitive?.content in
+                        setOf("switch", "check", "list", "multi", "text")
+                )
+                    item["key"]?.jsonPrimitive?.content?.let(keys::add)
+                (item["children"] as? JsonArray)?.let(::collect)
+            }
+        }
+        collect(schema.getValue("nodes").jsonArray)
+        val selected =
+            runtime.context
+                .getSharedPreferences("source_$id", Context.MODE_PRIVATE)
+                .all
+                .filterKeys { it in keys }
+        if (selected.isEmpty()) return false
+        return call(
+                "preferenceImport",
+                buildJsonObject {
+                    put("schema", schema.getValue("schema"))
+                    put("changes", SandboxPreferenceValues.encode(selected))
+                },
+            )
+            .getValue("accepted")
+            .jsonPrimitive
+            .boolean
+    }
+
+    override fun getFilterList(): FilterList =
+        SandboxFilterCodec.host(runtime.filters[id] ?: JsonArray(emptyList()))
+
+    init {
+        require(id > 0)
+        SandboxNetworkPolicy.requireUrl(baseUrl)
+    }
+
+    private fun validateManga(manga: SManga): SManga =
+        manga.also { it.thumbnail_url?.let(SandboxNetworkPolicy::requireUrl) }
+
+    private val imageBaseClient =
+        SandboxHttpBroker.imageClient(
+            runtime.onViolation,
+            runtime.isQuarantined,
+            okhttp3.CookieJar.NO_COOKIES,
+        )
+    override val client: OkHttpClient
+        get() = imageBaseClient.newBuilder().cookieJar(runtime.cookies.newSessionJar()).build()
+
+    private suspend fun call(operation: String, arguments: JsonObject = JsonObject(emptyMap())) =
+        runtime.call(id, operation, arguments)
+
+    override suspend fun getPopularManga(page: Int) =
+        listing(call("popular", buildJsonObject { put("page", page) }))
+
+    override suspend fun getLatestUpdates(page: Int) =
+        listing(call("latest", buildJsonObject { put("page", page) }))
+
+    override suspend fun getSearchManga(page: Int, query: String, filters: FilterList) =
+        listing(
+            call(
+                "search",
+                buildJsonObject {
+                    SandboxFilterCodec.selection(filters)?.let { put("filters", it) }
+                    put("page", page)
+                    put("query", query)
+                },
+            )
+        )
+
+    private fun listing(value: JsonObject) =
+        MangasPage(
+            value.getValue("mangas").jsonArray.map {
+                validateManga(SandboxSourceCodec.manga(it.jsonObject))
+            },
+            value.getValue("next").jsonPrimitive.boolean,
+        )
+
+    override suspend fun getMangaUpdate(
+        manga: SManga,
+        chapters: List<SChapter>,
+        fetchDetails: Boolean,
+        fetchChapters: Boolean,
+    ): SMangaUpdate {
+        val value =
+            call(
+                "update",
+                buildJsonObject {
+                    put("manga", SandboxSourceCodec.manga(manga))
+                    put("chapters", JsonArray(chapters.map(SandboxSourceCodec::chapter)))
+                    put("details", fetchDetails)
+                    put("chaptersRequested", fetchChapters)
+                },
+            )
+        return SMangaUpdate(
+            validateManga(SandboxSourceCodec.manga(value.getValue("manga").jsonObject)),
+            value.getValue("chapters").jsonArray.map { SandboxSourceCodec.chapter(it.jsonObject) },
+        )
+    }
+
+    override suspend fun getPageList(chapter: SChapter): List<Page> =
+        call("pages", buildJsonObject { put("chapter", SandboxSourceCodec.chapter(chapter)) })
+            .getValue("pages")
+            .jsonArray
+            .map {
+                SandboxSourceCodec.page(it.jsonObject).also { page ->
+                    page.imageUrl?.let(SandboxNetworkPolicy::requireUrl)
+                }
+            }
+
+    override suspend fun getImageUrl(page: Page): String =
+        call("imageUrl", buildJsonObject { put("page", SandboxSourceCodec.page(page)) })
+            .getValue("url")
+            .jsonPrimitive
+            .content
+            .also { SandboxNetworkPolicy.requireUrl(it) }
+
+    override fun imageRequest(page: Page): Request =
+        kotlinx.coroutines.runBlocking {
+            val input =
+                call("imageRequest", buildJsonObject { put("page", SandboxSourceCodec.page(page)) })
+            SandboxNetworkPolicy.requireUrl(input.getValue("url").jsonPrimitive.content)
+            val builder = Request.Builder().url(input.getValue("url").jsonPrimitive.content)
+            input.getValue("headers").jsonArray.forEach { pair ->
+                val values = pair.jsonArray
+                builder.addHeader(values[0].jsonPrimitive.content, values[1].jsonPrimitive.content)
+            }
+            val method = input.getValue("method").jsonPrimitive.content
+            require(method in setOf("GET", "HEAD", "POST"))
+            val bytes =
+                java.util.Base64.getDecoder().decode(input.getValue("body").jsonPrimitive.content)
+            require(bytes.size <= SandboxNetworkPolicy.MAX_REQUEST_BYTES)
+            builder
+                .method(
+                    method,
+                    if (method == "POST")
+                        bytes.toRequestBody(
+                            input["type"]?.jsonPrimitive?.content?.toMediaTypeOrNull()
+                        )
+                    else null,
+                )
+                .build()
+        }
+
+    override fun getMangaUrl(manga: SManga) =
+        java.net.URI(baseUrl.trimEnd('/') + "/").resolve(manga.url).toString().also {
+            SandboxNetworkPolicy.requireUrl(it)
+        }
+
+    override fun getChapterUrl(chapter: SChapter) =
+        java.net.URI(baseUrl.trimEnd('/') + "/").resolve(chapter.url).toString().also {
+            SandboxNetworkPolicy.requireUrl(it)
+        }
+
+    override fun headersBuilder(): Headers.Builder =
+        Headers.Builder().add("User-Agent", "Polaris/isolated-extension")
+
+    private class Runtime(
+        val context: Context,
+        val apk: File,
+        val digest: String,
+        val classes: List<String>,
+        val onViolation: (String) -> Unit,
+        val isQuarantined: () -> Boolean,
+        val preferences: SandboxPreferenceStore,
+        val cookies: SandboxCookieStore,
+        val packageName: String?,
+    ) {
+        val filters = java.util.concurrent.ConcurrentHashMap<Long, JsonArray>()
+
+        fun remember(metadata: JsonObject) {
+            val all = metadata.getValue("sources").jsonArray
+            require(all.size in 1..256)
+            val ids = all.map { it.jsonObject.getValue("id").jsonPrimitive.long }.toSet()
+            require(ids.size == all.size && ids.all { it > 0 })
+            all.forEach { entry ->
+                val value = entry.jsonObject
+                SandboxNetworkPolicy.requireUrl(value.getValue("url").jsonPrimitive.content)
+                val schema = value.getValue("filters").jsonArray
+                SandboxFilterCodec.host(schema)
+                filters[value.getValue("id").jsonPrimitive.long] = schema
+            }
+            preferences.register(ids)
+            accept(metadata)
+        }
+
+        fun accept(result: JsonObject) {
+            (result["preferenceChanges"] as? JsonObject)?.let(preferences::accept)
+        }
+
+        suspend fun call(source: Long, operation: String, arguments: JsonObject): JsonObject {
+            check(!isQuarantined()) { "Extension quarantined" }
+            return ExtensionSandboxSession.withApk(
+                context,
+                apk,
+                digest,
+                classes,
+                onViolation,
+                preferenceSnapshot = preferences::snapshot,
+                cookieJar = cookies::newSessionJar,
+            ) {
+                remember(it.metadata)
+                it.request(source, operation, arguments).also(::accept)
+            }
+        }
+    }
+
+    companion object {
+        suspend fun load(
+            context: Context,
+            apk: File,
+            digest: String,
+            entryClasses: List<String>,
+            onViolation: (String) -> Unit,
+            isQuarantined: () -> Boolean,
+            preferenceIdentity: String = "unconfigured:$digest",
+            packageName: String? = null,
+        ): List<HttpSource> {
+            check(!isQuarantined())
+            val preferences = SandboxPreferenceStore(context, preferenceIdentity)
+            val runtime =
+                Runtime(
+                    context,
+                    apk,
+                    digest,
+                    entryClasses,
+                    onViolation,
+                    isQuarantined,
+                    preferences,
+                    SandboxCookieStore(context, preferenceIdentity),
+                    packageName,
+                )
+            val metadata =
+                ExtensionSandboxSession.withApk(
+                    context,
+                    apk,
+                    digest,
+                    entryClasses,
+                    onViolation,
+                    preferenceSnapshot = preferences::snapshot,
+                    cookieJar = runtime.cookies::newSessionJar,
+                ) {
+                    runtime.remember(it.metadata)
+                    it.metadata
+                }
+            return metadata.getValue("sources").jsonArray.map {
+                IsolatedHttpSource(runtime, it.jsonObject)
+            }
+        }
+    }
+}
