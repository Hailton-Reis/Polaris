+
+    @Test
+    fun `Ragnarok aliases join forty Portuguese chapters with sixty English chapters`() = runTest {
+        val pt = Provider(1, 40, "pt-BR", "Upando Sozinho Ragnarok", "DAUL", true)
+        val en = Provider(2, 60, "en", "Solo Leveling Ragnarok", "DAUL", true)
+        val prefs = preferences().also { it.enabledLanguages.set(setOf("pt-BR")) }
+        val identity =
+            tachiyomi.domain.manga.model.WorkIdentity(
+                "mangadex:ade0306c-f4b6-4890-9edb-1ddf04df2039",
