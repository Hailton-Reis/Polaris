+package eu.kanade.tachiyomi.data.backup.create
+
+import kotlinx.coroutines.CancellationException
+import okio.buffer
+import okio.gzip
+import okio.source
+import java.io.IOException
+import java.io.InputStream
+import java.io.OutputStream
+import java.util.zip.GZIPOutputStream
+
+internal class BackupReadbackUnavailable(cause: Throwable? = null) : IOException("Cannot read back the backup", cause)
+internal class BackupReadbackMismatch(cause: Throwable? = null) : IOException("Backup verification failed", cause)
+
+/** Caller supplies valid encoded protobuf. Verify gzip CRC and exact decompressed bytes before success. */
+internal object BackupArchiveWriter {
+    fun writeVerified(
+        payload: ByteArray,
+        openOutput: () -> OutputStream,
+        openInput: () -> InputStream?,
+        checkCancelled: () -> Unit = {},
+    ) {
+        checkCancelled()
+        val raw = openOutput()
+        val compressed = try {
+            GZIPOutputStream(raw)
+        } catch (error: Throwable) {
+            runCatching { raw.close() }.exceptionOrNull()?.let(error::addSuppressed)
+            throw error
+        }
+        compressed.use { output ->
+            var offset = 0
+            while (offset < payload.size) {
+                checkCancelled()
+                val count = minOf(64 * 1024, payload.size - offset)
+                output.write(payload, offset, count)
+                offset += count
+            }
+        }
+        verify(payload, openInput, checkCancelled)
+    }
+
+    fun verify(payload: ByteArray, openInput: () -> InputStream?, checkCancelled: () -> Unit = {}) {
+        checkCancelled()
+        val input = try {
+            openInput() ?: throw BackupReadbackUnavailable()
+        } catch (error: CancellationException) {
+            throw error
+        } catch (error: BackupReadbackUnavailable) {
+            throw error
+        } catch (error: Exception) {
+            throw BackupReadbackUnavailable(error)
+        }
+        try {
+            // Use the same strict gzip reader as BackupDecoder, including trailing-byte rejection.
+            input.source().gzip().buffer().use { decoded ->
+                val buffer = ByteArray(64 * 1024)
+                var offset = 0
+                while (true) {
+                    checkCancelled()
+                    val count = decoded.read(buffer)
+                    if (count < 0) break
+                    if (offset + count > payload.size) throw BackupReadbackMismatch()
+                    for (index in 0 until count) {
+                        if (buffer[index] != payload[offset + index]) throw BackupReadbackMismatch()
+                    }
+                    offset += count
+                }
+                if (offset != payload.size) throw BackupReadbackMismatch()
+            }
+        } catch (error: CancellationException) {
+            throw error
+        } catch (error: BackupReadbackMismatch) {
+            throw error
+        } catch (error: Exception) {
+            throw BackupReadbackMismatch(error)
+        }
+        checkCancelled()
+    }
+}
