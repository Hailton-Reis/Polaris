+package eu.kanade.tachiyomi.data.profile
+
+import eu.kanade.domain.ui.model.LauncherIcon
+import eu.kanade.domain.ui.model.LauncherIconRewards
+import eu.kanade.tachiyomi.source.model.SManga
+import org.junit.jupiter.api.Assertions.*
+import org.junit.jupiter.api.Test
+import tachiyomi.domain.library.model.LibraryManga
+import tachiyomi.domain.manga.model.Manga
+
+class ProfileAchievementsTest {
+    private fun row(
+        id: Long,
+        read: Long = 0,
+        total: Long = 10,
+        status: Int = SManga.ONGOING,
+    ): LibraryManga {
+        val manga = Manga.create().copy(id = id, favorite = true, status = status.toLong())
+        return LibraryManga(manga, emptyList(), total, read, 0, 0, 0, 0)
+    }
+
+    @Test
+    fun `each non-reading route independently unlocks at its boundary`() {
+        val icons = listOf(LauncherIcon.AURORA, LauncherIcon.ORBIT, LauncherIcon.CONSTELLATION)
+        for (metric in AchievementMetric.entries.filter { it != AchievementMetric.READING }) {
+            for (icon in icons) {
+                val goal =
+                    ProfileAchievements.all.single { it.reward == icon && it.metric == metric }
+                fun progress(n: Int) =
+                    when (metric) {
+                        AchievementMetric.LIBRARY -> AchievementProgress(library = n)
+                        AchievementMetric.STARTED -> AchievementProgress(started = n)
+                        else -> AchievementProgress(completed = n)
+                    }
+                assertFalse(
+                    icon in ProfileAchievements.rewards(0, progress(goal.target.toInt() - 1))
+                )
+                assertTrue(icon in ProfileAchievements.rewards(0, progress(goal.target.toInt())))
+            }
+        }
+    }
+
+    @Test
+    fun `all four paths are alternatives not cumulative requirements`() {
+        assertTrue(
+            LauncherIcon.ORBIT in
+                LauncherIconRewards.unlocked(
+                    0,
+                    emptySet(),
+                    LauncherIcon.DEFAULT,
+                    AchievementProgress(library = 25),
+                )
+        )
+        assertTrue(
+            LauncherIcon.CONSTELLATION in ProfileAchievements.rewards(9000, AchievementProgress())
+        )
+        assertFalse(
+            LauncherIcon.ORBIT in ProfileAchievements.rewards(4499, AchievementProgress(24, 9, 4))
+        )
+    }
+
+    @Test
+    fun `milestones survive deletion and repeated add remove does not accumulate fake counts`() {
+        var state = ProfileAchievements.advance(AchievementProgress(), AchievementProgress(5, 3, 1))
+        repeat(10) {
+            state = ProfileAchievements.advance(state, AchievementProgress())
+            state = ProfileAchievements.advance(state, AchievementProgress(5, 3, 1))
+        }
+        assertEquals(AchievementProgress(5, 3, 1), state)
+        assertEquals(setOf(LauncherIcon.AURORA), ProfileAchievements.rewards(0, state))
+    }
+
+    @Test
+    fun `logical editions and duplicate projection rows do not multiply library achievements`() {
+        val a = row(1, 1)
+        val secondEdition = a.manga.copy(id = 99)
+        val grouped = a.copy(editions = listOf(a.manga, secondEdition))
+        assertEquals(
+            AchievementProgress(2, 1, 0),
+            ProfileAchievements.count(listOf(grouped, grouped, row(2))),
+        )
+    }
+
+    @Test
+    fun `caught up ongoing unknown empty and partially read works are not finished`() {
+        val rows =
+            listOf(
+                row(1, 10),
+                row(2, 10, status = SManga.UNKNOWN),
+                row(3, 0, 0, SManga.COMPLETED),
+                row(4, 9, status = SManga.COMPLETED),
+            )
+        assertEquals(AchievementProgress(4, 3, 0), ProfileAchievements.count(rows))
+    }
+
+    @Test
+    fun `finishers require read known chapters and completed metadata across linked editions`() {
+        val done = row(1, 10, status = SManga.COMPLETED)
+        val conflicting =
+            row(2, 10, status = SManga.COMPLETED).let {
+                it.copy(
+                    editions =
+                        it.editions + it.manga.copy(id = 99, status = SManga.ONGOING.toLong())
+                )
+            }
+        assertEquals(
+            AchievementProgress(2, 2, 1),
+            ProfileAchievements.count(listOf(done, conflicting)),
+        )
+    }
+
+    @Test
+    fun `non favorites do not enter library milestones and restored progress round trips`() {
+        val removed =
+            row(2, 10, status = SManga.COMPLETED).let {
+                it.copy(manga = it.manga.copy(favorite = false))
+            }
+        val result = ProfileAchievements.count(listOf(row(1), removed))
+        assertEquals(AchievementProgress(1, 0, 0), result)
+        assertEquals(result, ProfileAchievements.decode(ProfileAchievements.encode(result)))
+    }
+
+    @Test
+    fun `malformed portable values are bounded and original launcher remains available`() {
+        for (raw in
+            listOf("", "no json", "[]", "{\"library\":\"25\"}", "x".repeat(2049))) assertEquals(
+            AchievementProgress(),
+            ProfileAchievements.decode(raw),
+        )
+        assertEquals(
+            AchievementProgress(0, 1_000_000, 0),
+            ProfileAchievements.decode("{\"library\":-1,\"started\":2000000,\"future\":1}"),
+        )
+        assertEquals(
+            setOf(LauncherIcon.DEFAULT),
+            LauncherIconRewards.unlocked(
+                0,
+                emptySet(),
+                LauncherIcon.DEFAULT,
+                ProfileAchievements.decode("invalid"),
+            ),
+        )
+    }
+}
