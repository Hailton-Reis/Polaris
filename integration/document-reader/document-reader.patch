@@ -0,0 +1,113 @@
+package eu.kanade.tachiyomi.data.profile
+
+import dev.icerock.moko.resources.StringResource
+import eu.kanade.domain.ui.model.LauncherIcon
+import eu.kanade.tachiyomi.source.model.SManga
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.intOrNull
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import tachiyomi.domain.library.model.LibraryManga
+import tachiyomi.i18n.at.ATMR as MR
+
+/** Portable high-water marks, independent from spendable balances or local file paths. */
+@Serializable
+data class AchievementProgress(val library: Int = 0, val started: Int = 0, val completed: Int = 0)
+
+enum class AchievementMetric(val title: StringResource, val progress: StringResource) {
+    READING(MR.strings.polaris_achievement_reader, MR.strings.polaris_achievement_points),
+    LIBRARY(MR.strings.polaris_achievement_collector, MR.strings.polaris_achievement_library),
+    STARTED(MR.strings.polaris_achievement_explorer, MR.strings.polaris_achievement_started),
+    COMPLETED(MR.strings.polaris_achievement_finisher, MR.strings.polaris_achievement_completed),
+}
+
+data class GrimoireAchievement(
+    val reward: LauncherIcon,
+    val metric: AchievementMetric,
+    val target: Long,
+) {
+    val id
+        get() = "${metric.name.lowercase(java.util.Locale.ROOT)}_$target"
+
+    fun value(xp: Long, progress: AchievementProgress): Long =
+        when (metric) {
+            AchievementMetric.READING -> xp.coerceIn(0, PolarisLevelManager.MAX_XP)
+            AchievementMetric.LIBRARY ->
+                progress.library.toLong().coerceIn(0, ProfileAchievements.MAX_COUNT.toLong())
+            AchievementMetric.STARTED ->
+                progress.started.toLong().coerceIn(0, ProfileAchievements.MAX_COUNT.toLong())
+            AchievementMetric.COMPLETED ->
+                progress.completed.toLong().coerceIn(0, ProfileAchievements.MAX_COUNT.toLong())
+        }
+}
+
+object ProfileAchievements {
+    const val PREFERENCE_KEY = "polaris_profile_achievements_v1"
+    const val MAX_COUNT = 1_000_000
+    private val codec = Json { ignoreUnknownKeys = true }
+    val all: List<GrimoireAchievement> =
+        listOf(
+                LauncherIcon.AURORA to listOf(900L, 5L, 3L, 1L),
+                LauncherIcon.ORBIT to listOf(4500L, 25L, 10L, 5L),
+                LauncherIcon.CONSTELLATION to listOf(9000L, 100L, 25L, 10L),
+            )
+            .flatMap { (icon, targets) ->
+                AchievementMetric.entries.zip(targets) { metric, target ->
+                    GrimoireAchievement(icon, metric, target)
+                }
+            }
+
+    fun decode(raw: String): AchievementProgress =
+        runCatching {
+                require(raw.length <= 2048)
+                val fields = codec.parseToJsonElement(raw).jsonObject
+                for (key in listOf("library", "started", "completed")) fields[key]?.let {
+                    val value = it.jsonPrimitive
+                    require(!value.isString && value.intOrNull != null)
+                }
+                normalize(codec.decodeFromString(AchievementProgress.serializer(), raw))
+            }
+            .getOrDefault(AchievementProgress())
+
+    fun encode(progress: AchievementProgress): String =
+        codec.encodeToString(AchievementProgress.serializer(), normalize(progress))
+
+    private fun normalize(p: AchievementProgress) =
+        AchievementProgress(
+            p.library.coerceIn(0, MAX_COUNT),
+            p.started.coerceIn(0, MAX_COUNT),
+            p.completed.coerceIn(0, MAX_COUNT),
+        )
+
+    fun advance(previous: AchievementProgress, current: AchievementProgress): AchievementProgress {
+        val a = normalize(previous)
+        val b = normalize(current)
+        return AchievementProgress(
+            maxOf(a.library, b.library),
+            maxOf(a.started, b.started),
+            maxOf(a.completed, b.completed),
+        )
+    }
+
+    /**
+     * Input is the existing unfiltered logical library projection, never category/search results.
+     */
+    fun count(rows: List<LibraryManga>): AchievementProgress {
+        val works = rows.filter { it.manga.favorite }.distinctBy { it.id }
+        return AchievementProgress(
+            library = works.size,
+            started = works.count { it.readCount > 0 },
+            completed =
+                works.count {
+                    it.totalChapters > 0 &&
+                        it.readCount >= it.totalChapters &&
+                        it.editions.isNotEmpty() &&
+                        it.editions.all { edition -> edition.status == SManga.COMPLETED.toLong() }
+                },
+        )
+    }
+
+    fun rewards(xp: Long, progress: AchievementProgress): Set<LauncherIcon> =
+        all.filter { it.value(xp, progress) >= it.target }.mapTo(linkedSetOf()) { it.reward }
+}
