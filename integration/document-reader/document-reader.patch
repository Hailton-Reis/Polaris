--- /dev/null
+++ b/app/src/test/java/eu/kanade/translation/TranslationDeletionGateTest.kt
@@ -0,0 +1,47 @@
+package eu.kanade.translation
+
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.async
+import kotlinx.coroutines.test.runTest
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.assertThrows
+import java.io.IOException
+
+class TranslationDeletionGateTest {
+    @Test fun `deletion waits for the old writer before removal and restart`() = runTest {
+        val stopped = CompletableDeferred<Unit>()
+        val events = mutableListOf<String>()
+        val gate = TranslationDeletionGate({ true }, {
+            stopped.await()
+            events += "joined"
+        }, { events += "restart" })
+        val job = async { gate.remove { events += "delete" } }
+        testScheduler.runCurrent()
+        assertTrue(events.isEmpty())
+        assertTrue(gate.deferStart())
+        stopped.complete(Unit)
+        job.await()
+        assertEquals(listOf("joined", "delete", "restart"), events)
+        assertFalse(gate.deferStart())
+    }
+
+    @Test fun `user pause during cleanup prevents an automatic restart`() = runTest {
+        var restarts = 0
+        val gate = TranslationDeletionGate({ true }, {}, { restarts++ })
+        gate.remove { gate.userPaused() }
+        assertEquals(0, restarts)
+    }
+
+    @Test fun `failed removal releases the gate and resumes other queued work`() = runTest {
+        var restarts = 0
+        val gate = TranslationDeletionGate({ true }, {}, { restarts++ })
+        assertThrows<IOException> { gate.remove { throw IOException("retained original") } }
+        assertFalse(gate.deferStart())
+        assertEquals(1, restarts)
+        gate.remove {}
+        assertEquals(2, restarts)
+    }
+}
