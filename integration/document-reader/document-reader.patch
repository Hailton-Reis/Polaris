index 0000000..84cac8c
--- /dev/null
+++ b/app/src/test/java/eu/kanade/tachiyomi/extension/util/ExtensionInstallerDownloadTest.kt
@@ -0,0 +1,301 @@
+package eu.kanade.tachiyomi.extension.util
+
+import android.content.Context
+import com.sun.net.httpserver.HttpServer
+import eu.kanade.domain.base.BasePreferences
+import eu.kanade.tachiyomi.extension.installer.Installer
+import eu.kanade.tachiyomi.extension.model.Extension
+import eu.kanade.tachiyomi.extension.model.InstallStep
+import io.mockk.every
+import io.mockk.justRun
+import io.mockk.mockk
+import io.mockk.mockkObject
+import io.mockk.unmockkObject
+import io.mockk.verify
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.async
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.onEach
+import kotlinx.coroutines.flow.toList
+import kotlinx.coroutines.runBlocking
+import kotlinx.coroutines.withContext
+import kotlinx.coroutines.withTimeout
+import okhttp3.OkHttpClient
+import org.junit.jupiter.api.AfterEach
+import org.junit.jupiter.api.Assertions.assertArrayEquals
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.BeforeEach
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.io.TempDir
+import tachiyomi.core.common.preference.Preference
+import java.io.File
+import java.io.IOException
+import java.net.InetSocketAddress
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicInteger
+
+/**
+ * Real localhost HTTP and file pipeline. Android package parsing/notifications are the mocked
+ * boundary.
+ */
+class ExtensionInstallerDownloadTest {
+    @TempDir lateinit var folder: File
+    private val context = mockk<Context>()
+    private val preference = mockk<Preference<BasePreferences.ExtensionInstaller>>()
+    private val client = OkHttpClient.Builder().readTimeout(10, TimeUnit.SECONDS).build()
+    private val extension =
+        Extension.Installed(
+            "Test",
+            "test.source",
+            "1",
+            1,
+            1.4,
+            "en",
+            false,
+            null,
+            emptyList(),
+            null,
+            isShared = false,
+        )
+    private val bytes = ByteArray(150_000) { (it % 251).toByte() }
+    private val started = arrayOf(CountDownLatch(1), CountDownLatch(1))
+    private val release = CountDownLatch(1)
+    private val requests = AtomicInteger()
+    private val threads =
+        Executors.newCachedThreadPool { task -> Thread(task).apply { isDaemon = true } }
+    private var server: HttpServer? = null
+    private lateinit var installer: ExtensionInstaller
+    private val cache
+        get() = File(folder, "cache")
+
+    private val target
+        get() = File(folder, "source.ext")
+
+    @BeforeEach
+    fun setup() {
+        cache.mkdirs()
+        every { context.cacheDir } returns cache
+        every { preference.get() } returns BasePreferences.ExtensionInstaller.PRIVATE
+        mockkObject(ExtensionLoader, Installer.Companion)
+        justRun { Installer.cancelInstallQueue(context, any()) }
+        every { ExtensionLoader.installPrivateExtensionFile(context, any(), any()) } answers
+            {
+                PrivateExtensionFiles.replace(secondArg(), target, thirdArg()) { staged ->
+                    assertArrayEquals(bytes, staged.readBytes())
+                }
+                true
+            }
+        installer = ExtensionInstaller(context, preference, client)
+    }
+
+    @AfterEach
+    fun cleanup() {
+        listOf(extension.pkgName, "test.Aa", "test.BB").forEach(installer::cancelInstall)
+        release.countDown()
+        client.dispatcher.cancelAll()
+        server?.stop(0)
+        threads.shutdownNow()
+        runBlocking {
+            withTimeout(5000) { while (cache.listFiles().orEmpty().isNotEmpty()) delay(10) }
+        }
+        unmockkObject(ExtensionLoader, Installer.Companion)
+        client.dispatcher.executorService.shutdownNow()
+        client.connectionPool.evictAll()
+        folder.walk().forEach { it.setWritable(true) }
+    }
+
+    @Test
+    fun `reviewed identity is passed to private validation without changing the selected installer`() =
+        runBlocking {
+            every { preference.get() } returns BasePreferences.ExtensionInstaller.LEGACY
+            every {
+                ExtensionLoader.installVerifiedPrivateExtensionFile(
+                    context,
+                    any(),
+                    ReviewedPrivateExtension(
+                        extension.pkgName,
+                        "a".repeat(64),
+                        extension.versionCode,
+                    ),
+                    any(),
+                )
+            } answers
+                {
+                    PrivateExtensionFiles.replace(secondArg(), target, arg(3)) { staged ->
+                        assertArrayEquals(bytes, staged.readBytes())
+                    }
+                    true
+                }
+            val steps =
+                installer
+                    .downloadAndInstall(
+                        serve(),
+                        extension,
+                        true,
+                        ReviewedPrivateExtension(
+                            extension.pkgName,
+                            "a".repeat(64),
+                            extension.versionCode,
+                        ),
+                    )
+                    .toList()
+            assertEquals(InstallStep.Installed, steps.last())
+            verify(exactly = 0) {
+                ExtensionLoader.installPrivateExtensionFile(context, any(), any())
+            }
+            assertEquals(BasePreferences.ExtensionInstaller.LEGACY, preference.get())
+        }
+
+    @Test
+    fun `repository revoked during transfer prevents private installation and preserves the old file`() =
+        runBlocking {
+            target.writeText("working")
+            val steps =
+                installer
+                    .downloadAndInstall(
+                        serve(),
+                        extension,
+                        true,
+                        ReviewedPrivateExtension(
+                            extension.pkgName,
+                            "a".repeat(64),
+                            extension.versionCode,
+                        ),
+                        beforePrivateInstall = {
+                            error("repository removed or signing key changed")
+                        },
+                    )
+                    .toList()
+            assertEquals(InstallStep.Error, steps.last())
+            assertEquals("working", target.readText())
+            verify(exactly = 0) {
+                ExtensionLoader.installPrivateExtensionFile(context, any(), any())
+            }
+            verify(exactly = 0) {
+                ExtensionLoader.installVerifiedPrivateExtensionFile(context, any(), any(), any())
+            }
+        }
+
+    private fun serve(partial: Boolean = false, status: Int = 200): String {
+        val instance = HttpServer.create(InetSocketAddress("127.0.0.1", 0), 0)
+        instance.executor = threads
+        instance.createContext("/extension.apk") { exchange ->
+            val index = requests.getAndIncrement()
+            try {
+                if (status != 200) {
+                    exchange.sendResponseHeaders(status, -1)
+                } else {
+                    exchange.sendResponseHeaders(200, bytes.size.toLong())
+                    if (partial) {
+                        exchange.responseBody.write(bytes, 0, 128)
+                        exchange.responseBody.flush()
+                        started[index.coerceAtMost(1)].countDown()
+                        release.await(5, TimeUnit.SECONDS)
+                        exchange.responseBody.write(bytes, 128, bytes.size - 128)
+                    } else {
+                        exchange.responseBody.write(bytes)
+                    }
+                }
+            } catch (_: IOException) {
+                // A cancelled client closes its socket while the server still holds its response.
+            } catch (_: InterruptedException) {
+                Thread.currentThread().interrupt()
+            } finally {
+                exchange.close()
+            }
+        }
+        instance.start()
+        server = instance
+        return "http://127.0.0.1:${instance.address.port}/extension.apk"
+    }
+
+    private suspend fun awaitStart(index: Int) {
+        assertTrue(withContext(Dispatchers.IO) { started[index].await(5, TimeUnit.SECONDS) })
+    }
+
+    @Test
+    fun `private download emits a terminal success and removes the consumed APK`() = runBlocking {
+        val steps = withTimeout(5000) { installer.downloadAndInstall(serve(), extension).toList() }
+        assertEquals(InstallStep.Installed, steps.last())
+        assertArrayEquals(bytes, target.readBytes())
+        withTimeout(5000) { while (cache.listFiles().orEmpty().isNotEmpty()) delay(10) }
+    }
+
+    @Test
+    fun `HTTP failure completes the flow with error and cleans its download`() = runBlocking {
+        val steps =
+            withTimeout(5000) {
+                installer.downloadAndInstall(serve(status = 503), extension).toList()
+            }
+        assertEquals(InstallStep.Error, steps.last())
+        verify(exactly = 0) { ExtensionLoader.installPrivateExtensionFile(context, any(), any()) }
+    }
+
+    @Test
+    fun `cancellation interrupts a stalled response without replacing the working extension`() =
+        runBlocking {
+            val original = "working".encodeToByteArray()
+            target.writeBytes(original)
+            val url = serve(partial = true)
+            val collecting = async { installer.downloadAndInstall(url, extension).toList() }
+            awaitStart(0)
+            installer.cancelInstall(extension.pkgName)
+            val steps = withTimeout(5000) { collecting.await() }
+            assertEquals(InstallStep.Idle, steps.last())
+            assertArrayEquals(original, target.readBytes())
+            verify(exactly = 0) {
+                ExtensionLoader.installPrivateExtensionFile(context, any(), any())
+            }
+        }
+
+    @Test
+    fun `different package names with the same hash cannot cancel each other`() = runBlocking {
+        val firstExtension = extension.copy(pkgName = "test.Aa")
+        val secondExtension = extension.copy(pkgName = "test.BB")
+        assertEquals(firstExtension.pkgName.hashCode(), secondExtension.pkgName.hashCode())
+        val url = serve(partial = true)
+        val first = async { installer.downloadAndInstall(url, firstExtension).toList() }
+        awaitStart(0)
+        val second = async { installer.downloadAndInstall(url, secondExtension).toList() }
+        awaitStart(1)
+        installer.cancelInstall(firstExtension.pkgName)
+        assertEquals(InstallStep.Idle, withTimeout(5000) { first.await() }.last())
+        release.countDown()
+        assertEquals(InstallStep.Installed, withTimeout(5000) { second.await() }.last())
+        assertArrayEquals(bytes, target.readBytes())
+    }
+
+    @Test
+    fun `completion of a cancelled attempt cannot remove the retry from active jobs`() =
+        runBlocking {
+            val url = serve(partial = true)
+            val oldAtIdle = CompletableDeferred<Unit>()
+            val releaseOldCollector = CompletableDeferred<Unit>()
+            val first = async {
+                installer
+                    .downloadAndInstall(url, extension)
+                    .onEach {
+                        if (it == InstallStep.Idle) {
+                            oldAtIdle.complete(Unit)
+                            releaseOldCollector.await()
+                        }
+                    }
+                    .toList()
+            }
+            awaitStart(0)
+            val second = async { installer.downloadAndInstall(url, extension).toList() }
+            withTimeout(5000) { oldAtIdle.await() }
+            awaitStart(1)
+            releaseOldCollector.complete(Unit)
+            withTimeout(5000) { first.await() }
+            installer.cancelInstall(extension.pkgName)
+            assertEquals(InstallStep.Idle, withTimeout(5000) { second.await() }.last())
+            verify(exactly = 0) {
+                ExtensionLoader.installPrivateExtensionFile(context, any(), any())
+            }
+        }
+}
