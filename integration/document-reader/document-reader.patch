@@ -0,0 +1,35 @@
+package eu.kanade.translation.recognizer
+
+import android.graphics.Bitmap
+import io.mockk.every
+import io.mockk.excludeRecords
+import io.mockk.mockk
+
+/** Authored pixels shared by single-pixel and bulk reads, as on a real Android bitmap. */
+internal fun bitmapFixture(imageWidth: Int, imageHeight: Int, pixel: (Int, Int) -> Int): Bitmap {
+    val values = IntArray(imageWidth * imageHeight) { pixel(it % imageWidth, it / imageWidth) }
+    return mockk<Bitmap> {
+        every { width } returns imageWidth
+        every { height } returns imageHeight
+        every { getPixel(any(), any()) } answers { values[secondArg<Int>() * imageWidth + firstArg<Int>()] }
+        every { getPixels(any(), any(), any(), any(), any(), any(), any()) } answers {
+            val output = firstArg<IntArray>()
+            val offset = secondArg<Int>()
+            val stride = thirdArg<Int>()
+            val x = arg<Int>(3)
+            val y = arg<Int>(4)
+            val copyWidth = arg<Int>(5)
+            val copyHeight = arg<Int>(6)
+            repeat(copyHeight) { row ->
+                System.arraycopy(values, (y + row) * imageWidth + x, output, offset + row * stride, copyWidth)
+            }
+        }
+    }.also { bitmap ->
+        excludeRecords {
+            bitmap.getPixel(any(), any())
+            bitmap.getPixels(any(), any(), any(), any(), any(), any(), any())
+            bitmap.width
+            bitmap.height
+        }
+    }
+}
