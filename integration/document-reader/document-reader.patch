+import tachiyomi.domain.chapter.model.Chapter
+import tachiyomi.domain.chapter.model.ChapterOrigin
+import tachiyomi.domain.chapter.model.ChapterVersions
+import tachiyomi.domain.chapter.model.NoChaptersException
+import tachiyomi.domain.chapter.service.ChapterRecognition
+import tachiyomi.domain.manga.model.Manga
+import tachiyomi.domain.manga.model.WorkSource
+import tachiyomi.domain.manga.model.WorkSources
+import tachiyomi.domain.source.model.MERGED_SOURCE_ID
+import tachiyomi.domain.source.model.StubSource
+import tachiyomi.domain.source.service.SourceManager
+
+/**
+ * Compares installed providers; storage, progress and glossary remain attached to the original
+ * work.
+ */
+class AutomaticSourceCatalog(
+    private val sourceManager: SourceManager,
+    private val preferences: SourcePreferences,
+    private val resolveIdentity: suspend (SManga) -> tachiyomi.domain.manga.model.WorkIdentity? = {
+        null
+    },
+    private val checkReadability: suspend (HttpSource, List<SChapter>) -> Boolean =
+        SourceReadabilityProbe::check,
+) {
+    private data class Catalog(
+        val binding: WorkSource,
+        val manga: SManga,
+        val chapters: List<SChapter>,
+    )
+
+    private val invalidated = ConcurrentHashMap.newKeySet<Long>()
+
+    fun invalidate(workId: Long) {
+        invalidated += workId
+    }
+
+    fun needsDiscovery(manga: Manga): Boolean {
+        val settings = WorkSources.from(manga.memo)
+        val provider = sourceManager.get(manga.source)
+        if (provider != null && (provider !is HttpSource || provider is INovelSource)) return false
+        val enabled = enabledSources()
+        if (enabled.isEmpty() || settings.pinned != null) return false
+        val now = System.currentTimeMillis()
+        val active = settings.candidates.filter { it.active }
+        val failedSamples =
+            active.isNotEmpty() &&
+                active.all { it.readability == "sample_failed" } &&
+                active.all { now - it.healthCheckedAt >= 60_000L }
+        return manga.id in invalidated ||
+            now - settings.checkedAt >= DISCOVERY_TTL ||
+            failedSamples ||
+            settings.installedFingerprint != fingerprint(enabled)
+    }
+
+    private fun enabledSources(): List<HttpSource> =
+        sourceManager
+            .getOnlineSources()
+            .filter {
+                it !is INovelSource &&
+                    it.id.toString() !in preferences.disabledSources.get() &&
+                    (it.lang in preferences.enabledLanguages.get() ||
+                        it.lang.lowercase().replace('_', '-') in setOf("en", "pt", "pt-br"))
+            }
+            .sortedWith(compareBy<HttpSource> { languageRank(it.lang) }.thenBy { it.id })
+
+    private fun fingerprint(sources: List<HttpSource>): String =
+        MessageDigest.getInstance("SHA-256")
+            .digest(sources.map { it.id }.sorted().joinToString(",").toByteArray())
+            .joinToString("") { "%02x".format(it) }
+
+    suspend fun <T> withWorkLock(id: Long, action: suspend () -> T): T =
+        locks.getOrPut(id) { Mutex() }.withLock { action() }
+
+    @OptIn(kotlinx.coroutines.ExperimentalCoroutinesApi::class)
+    suspend fun fetch(
+        source: Source,
+        manga: Manga,
+        existing: List<Chapter>,
+        fetchDetails: Boolean,
+        fetchChapters: Boolean,
+        allowDiscovery: Boolean,
+    ): SMangaUpdate? {
+        if (!fetchChapters || manga.source == MERGED_SOURCE_ID || source is INovelSource)
+            return null
+        val settings = WorkSources.from(manga.memo)
+        val pinned = settings.pinned
+        val original = source as? HttpSource
+        if (original == null && source !is StubSource && settings.candidates.isEmpty()) return null
+        val root =
+            settings.candidates.firstOrNull { it.sourceId == manga.source && it.url == manga.url }
+                ?: WorkSource(
+                    manga.source,
+                    source.name,
+                    source.lang,
+                    manga.url,
+                    manga.title,
+                    manga.author,
+                    manga.artist,
+                    cleanMemo(manga.memo),
+                )
+        val enabled = enabledSources()
+        val fingerprint = fingerprint(enabled)
+        val now = System.currentTimeMillis()
+        var discover =
+            pinned == null && (allowDiscovery || source is StubSource) && needsDiscovery(manga)
+        val catalogs = mutableListOf<Catalog>()
+        val bindings = mutableListOf<WorkSource>()
+        suspend fun loadSafely(binding: WorkSource): Catalog? {
+            val provider = sourceManager.get(binding.sourceId) as? HttpSource
+            val catalog =
+                try {
+                    if (provider == null) {
+                        null
+                    } else {
+                        withTimeoutOrNull(CATALOG_TIMEOUT) {
+                            load(
+                                binding,
+                                existing,
+                                root,
+                                fetchDetails || discover || binding.key != root.key,
+                                provider,
+                            )
+                        }
+                    }
+                } catch (error: CancellationException) {
+                    throw error
+                } catch (_: Exception) {
+                    null
+                }
+            bindings += catalog?.binding ?: binding.copy(available = false)
+            return catalog
+        }
+        val rootCatalog = if (pinned == null || pinned.key == root.key) loadSafely(root) else null
+        // A restored missing provider and a failing provider can recover without changing source
+        // IDs.
+        // Healthy background updates still do not search every extension.
+        if (pinned == null && (rootCatalog == null || rootCatalog.chapters.isEmpty())) {
+            discover = true
+        }
+        rootCatalog?.let { catalogs += it }
+        val reference = rootCatalog?.manga ?: manga.toSManga()
+        val identity =
+            settings.identity?.takeIf { now - it.checkedAt in 0 until 14 * DISCOVERY_TTL }
+                ?: if (discover) resolveIdentity(reference) else settings.identity
+        val searchTitles =
+            (listOf(reference.title) + identity?.titles.orEmpty())
+                .filter { it.isNotBlank() }
+                .distinctBy(SourceMatching::title)
+                .take(6)
+        val referenceChapters =
+            rootCatalog?.chapters?.takeIf { it.isNotEmpty() }?.map(::asChapter)
+                ?: existing.filter {
+                    (ChapterOrigin.from(it.memo)?.sourceId ?: manga.source) == manga.source
+                }
+
+        suspend fun sampled(catalog: Catalog): Catalog {
+            if (!discover) return catalog
+            val recent = settings.candidates.firstOrNull { it.key == catalog.binding.key }
+            val ttl = if (recent?.readability == "sample_failed") 60_000L else HEALTH_TTL
+            val health =
+                if (
+                    manga.id !in invalidated &&
+                        recent != null &&
+                        now - recent.healthCheckedAt in 0 until ttl
+                ) {
+                    recent.readability
+                } else {
+                    val provider = sourceManager.get(catalog.binding.sourceId) as? HttpSource
+                    if (provider != null && checkReadability(provider, catalog.chapters))
+                        "sample_passed"
+                    else "sample_failed"
+                }
+            val checked =
+                catalog.copy(
+                    binding = catalog.binding.copy(readability = health, healthCheckedAt = now)
+                )
+            val bindingIndex = bindings.indexOfFirst { it.key == checked.binding.key }
+            if (bindingIndex >= 0) bindings[bindingIndex] = checked.binding
+            return checked
+        }
+        if (catalogs.isNotEmpty()) catalogs[0] = sampled(catalogs[0])
+
+        suspend fun retain(catalog: Catalog) {
+            val compatible =
+                SourceMatching.compatibleNumbering(
+                    referenceChapters,
+                    catalog.chapters.map(::asChapter),
+                    corroboratedIdentity =
+                        identity != null &&
+                            SourceMatching.sameWork(reference, catalog.manga, identity),
+                )
+            if (pinned != null || compatible) {
+                catalogs += sampled(catalog)
+                catalogs.sortWith(catalogOrder(manga.source))
+                // Always keep the original provider as a fallback, even if alternatives have larger
+                // catalogs.
+                // Keep additional catalogues when they add missing logical chapters. Redundant
+                // fallback editions are bounded, but a larger overlapping catalogue must not erase
+                // an origin containing the only available later chapters.
+                val covered = mutableSetOf<ChapterVersions.Key>()
+                var redundantSlots = 0
+                val reserveRoot = catalogs.any { it.binding.key == root.key }
+                val keep =
+                    catalogs.filter { entry ->
+                        val keys = entry.chapters.map { ChapterVersions.key(asChapter(it)) }.toSet()
+                        val contributes = keys.any { it !in covered }
+                        val isRoot = entry.binding.key == root.key
+                        val fallback =
+                            !isRoot &&
+                                redundantSlots < MAX_ACTIVE_CATALOGS - if (reserveRoot) 1 else 0
+                        val selected = fallback || isRoot || contributes
+                        if (!isRoot && selected) redundantSlots++
+                        if (selected) covered += keys
+                        selected
+                    }
+                catalogs.retainAll(keep.toSet())
+            }
+        }
+        if (pinned != null) {
+            if (pinned.key != root.key) {
+                val binding = settings.candidates.find { it.key == pinned.key } ?: pinned
+                loadSafely(binding)?.let { retain(it) }
+            }
+        } else {
+            settings.candidates
+                .filter {
+                    it.active && it.key != root.key && it.sourceId in enabled.map { s -> s.id }
+                }
+                .forEach { binding -> loadSafely(binding)?.let { retain(it) } }
+            if (discover) {
+                val alreadyKnown = bindings.map { it.key }.toSet()
+                // Bound foreground discovery as well as each individual provider; partial successes
+                // remain useful.
+                discoveryLock.withLock {
+                    withTimeoutOrNull(DISCOVERY_TIMEOUT) {
+                        enabled
+                            .filter { it.id != manga.source }
+                            .asFlow()
+                            .flatMapMerge(concurrency = 2) { provider ->
+                                flow {
+                                    val catalog =
+                                        try {
+                                            withTimeoutOrNull(SEARCH_TIMEOUT) {
+                                                var matches = emptyList<SManga>()
+                                                for (query in searchTitles) {
+                                                    matches =
+                                                        provider
+                                                            .getSearchManga(
+                                                                1,
+                                                                query,
+                                                                provider.getFilterList(),
+                                                            )
+                                                            .mangas
+                                                            .filter {
+                                                                SourceMatching.titleMatches(
+                                                                    reference.title,
+                                                                    it.title,
+                                                                    identity,
+                                                                )
+                                                            }
+                                                            .distinctBy { it.url }
+                                                    if (matches.isNotEmpty()) break
+                                                }
+                                                if (matches.size != 1) {
+                                                    null
+                                                } else {
+                                                    val match = matches.single()
+                                                    val result =
+                                                        provider
+                                                            .getMangaUpdate(
+                                                                match,
+                                                                emptyList(),
+                                                                true,
+                                                                false,
+                                                            )
+                                                            .manga
+                                                    result.url = match.url
+                                                    if (
+                                                        !SourceMatching.sameWork(
+                                                            reference,
+                                                            result,
+                                                            identity,
+                                                        )
+                                                    ) {
+                                                        null
+                                                    } else {
+                                                        val binding =
+                                                            WorkSource(
+                                                                provider.id,
+                                                                provider.name,
+                                                                provider.lang,
+                                                                result.url,
+                                                                result.title,
+                                                                result.author,
+                                                                result.artist,
+                                                                cleanMemo(result.memo),
+                                                            )
+                                                        if (binding.key in alreadyKnown) {
+                                                            null
+                                                        } else {
+                                                            load(
+                                                                binding,
+                                                                existing,
+                                                                root,
+                                                                false,
+                                                                provider,
+                                                            )
+                                                        }
+                                                    }
+                                                }
+                                            }
+                                        } catch (error: CancellationException) {
+                                            throw error
+                                        } catch (_: Exception) {
+                                            null
+                                        }
+                                    if (catalog != null) emit(catalog)
+                                }
+                            }
+                            .collect { catalog ->
+                                bindings += catalog.binding
+                                retain(catalog)
+                            }
+                    }
+                }
+            }
+        }
+        if (catalogs.isEmpty() || catalogs.all { it.chapters.isEmpty() })
+            throw NoChaptersException()
+        catalogs.sortWith(catalogOrder(manga.source))
+        val activeKeys = catalogs.map { it.binding.key }.toSet()
+        val choices =
+            (bindings + settings.candidates.filter { old -> bindings.none { it.key == old.key } })
+                .distinctBy { it.key }
+                .map { it.copy(active = it.key in activeKeys) }
+        val state =
+            settings.copy(
+                candidates = choices,
+                checkedAt = if (discover) now else settings.checkedAt,
+                installedFingerprint = if (discover) fingerprint else settings.installedFingerprint,
+                identity = identity,
+            )
+        val output =
+            catalogs
+                .flatMapIndexed { rank, catalog ->
+                    catalog.chapters.map { chapter ->
+                        val origin =
+                            ChapterOrigin(
+                                catalog.binding.sourceId,
+                                catalog.binding.name,
+                                catalog.binding.language,
+                                catalog.binding.url,
+                                chapter.url,
+                                rank = rank,
+                                available = catalog.binding.readability != "sample_failed",
+                                sourceMemo = cleanMemo(chapter.memo),
+                            )
+                        SChapter.create().also {
+                            it.copyFrom(chapter)
+                            it.url =
+                                if (catalog.binding.key == root.key) {
+                                    chapter.url
+                                } else {
+                                    ChapterOrigin.storedUrl(origin.sourceId, chapter.url)
+                                }
+                            it.memo = origin.attach(cleanMemo(chapter.memo))
+                        }
+                    }
+                }
+                .toMutableList()
+        val fetchedUrls = output.map { it.url }.toHashSet()
+        // Missing remote rows are retained for history/downloads, but do not outrank an available
+        // edition.
+        existing
+            .filter { it.url !in fetchedUrls }
+            .forEach { old ->
+                val origin =
+                    ChapterOrigin.from(old.memo)
+                        ?: ChapterOrigin(
+                            root.sourceId,
+                            root.name,
+                            root.language,
+                            root.url,
+                            old.url,
+                            sourceMemo = cleanMemo(old.memo),
+                        )
+                output +=
+                    old.toSChapter().also {
+                        it.memo =
+                            origin.copy(available = false, rank = Int.MAX_VALUE).attach(old.memo)
+                    }
+            }
+        val remote =
+            (rootCatalog?.manga ?: manga.toSManga()).let { incoming ->
+                incoming.copy().also {
+                    it.url = manga.url
+                    it.memo = state.attach(JsonObject(manga.memo + cleanMemo(incoming.memo)))
+                }
+            }
+        val identities = output.associate { it.url to ChapterVersions.key(asChapter(it)) }
+        val ordered =
+            output
+                .distinctBy { it.url }
+                .sortedWith(
+                    compareByDescending<SChapter> {
+                            identities.getValue(it.url).season?.toIntOrNull() ?: 0
+                        }
+                        .thenByDescending { identities.getValue(it.url).volume?.toIntOrNull() ?: 0 }
+                        .thenByDescending {
+                            identities.getValue(it.url).number?.let(::BigDecimal)
+                                ?: BigDecimal("1E50")
+                        }
+                        .thenBy { ChapterOrigin.from(it.memo)?.rank ?: 0 }
+                )
+        if (discover) invalidated.remove(manga.id)
+        return SMangaUpdate(remote, ordered)
+    }
+
+    private suspend fun load(
+        binding: WorkSource,
+        existing: List<Chapter>,
+        root: WorkSource,
+        details: Boolean,
+        provider: HttpSource,
+    ): Catalog {
+        val request =
+            SManga.create().also {
+                it.url = binding.url
+                it.title = binding.title
+                it.author = binding.author
+                it.artist = binding.artist
+                it.memo = binding.sourceMemo
+            }
+        val previous =
+            existing
+                .filter { chapter ->
+                    val origin = ChapterOrigin.from(chapter.memo)
+                    if (origin == null) {
+                        binding.key == root.key && !ChapterOrigin.isRouted(chapter.url)
+                    } else {
+                        origin.sourceId == provider.id && origin.mangaUrl == binding.url
+                    }
+                }
+                .map { it.toRemoteSChapter() }
+        val update = provider.getMangaUpdate(request, previous, details, true)
+        check(update.chapters.size <= MAX_CHAPTERS_PER_CATALOG) {
+            "Catálogo excede o limite de comparação automática"
+        }
+        val prepared =
+            update.chapters.onEach { chapter ->
+                @Suppress("DEPRECATION") provider.prepareNewChapter(chapter, update.manga)
+                chapter.chapter_number =
+                    ChapterRecognition.parseChapterNumber(
+                            binding.title,
+                            chapter.name,
+                            chapter.chapter_number.toDouble(),
+                        )
+                        .toFloat()
+            }
+        val unique =
+            ChapterVersions.groups(prepared.map(::asChapter)).filter { it.key.number != null }
+        val numbers =
+            unique
+                .filter { it.key.special == null }
+                .mapNotNull {
+                    it.key.number?.toDoubleOrNull()?.takeIf { n -> n % 1.0 == 0.0 }?.toInt()
+                }
+                .toSet()
+        var continuous = 0
+        while (continuous + 1 in numbers) continuous++
+        return Catalog(
+            binding.copy(
+                title = update.manga.title,
+                author = update.manga.author,
+                artist = update.manga.artist,
+                sourceMemo = cleanMemo(update.manga.memo),
+                chapters = unique.size,
+                continuous = continuous,
+                available = true,
+            ),
+            update.manga,
+            prepared,
+        )
+    }
+
+    private fun catalogOrder(originalSource: Long): Comparator<Catalog> =
+        compareBy<Catalog> {
+                when (it.binding.readability) {
+                    "sample_passed" -> 0
+                    "sample_failed" -> 2
+                    else -> 1
+                }
+            }
+            .thenBy { languageRank(it.binding.language) }
+            .thenByDescending { it.binding.continuous }
+            .thenByDescending { it.binding.chapters }
+            .thenByDescending { it.binding.sourceId == originalSource }
+            .thenBy { it.binding.key }
+
+    private fun asChapter(chapter: SChapter): Chapter =
+        Chapter.create()
+            .copy(
+                url = chapter.url,
+                name = chapter.name,
+                chapterNumber = chapter.chapter_number.toDouble(),
+                scanlator = chapter.scanlator,
+                memo = chapter.memo,
+            )
+
+    private fun cleanMemo(memo: JsonObject): JsonObject =
+        JsonObject(memo.filterKeys { !it.startsWith("polaris.") })
+
+    companion object {
+        private val discoveryLock = Mutex()
+
+        private fun languageRank(language: String): Int =
+            when (language.lowercase().replace('_', '-')) {
+                "pt-br" -> 0
+                "pt" -> 1
+                else -> 2
+            }
+
+        private const val HEALTH_TTL = 10 * 60 * 1000L
+        private val locks = ConcurrentHashMap<Long, Mutex>()
+        private const val DISCOVERY_TTL = 24 * 60 * 60 * 1000L
+        private const val SEARCH_TIMEOUT = 30_000L
+        private const val CATALOG_TIMEOUT = 30_000L
+        private const val DISCOVERY_TIMEOUT = 60_000L
+        private const val MAX_ACTIVE_CATALOGS = 4
+        private const val MAX_CHAPTERS_PER_CATALOG = 20_000
+    }
+}
