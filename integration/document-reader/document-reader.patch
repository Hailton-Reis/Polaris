+package eu.kanade.tachiyomi.source.selection
+
+import eu.kanade.tachiyomi.source.*
+import eu.kanade.tachiyomi.source.online.HttpSource
+import io.mockk.*
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.test.runTest
+import kotlinx.serialization.json.*
+import org.junit.jupiter.api.Assertions.*
+import org.junit.jupiter.api.Test
+import tachiyomi.domain.chapter.model.Chapter
+import tachiyomi.domain.chapter.repository.ChapterRepository
+import tachiyomi.domain.manga.model.*
+import tachiyomi.domain.manga.repository.LibraryWorkRepository
+import tachiyomi.domain.source.model.StubSource
+import tachiyomi.domain.source.service.SourceManager
+
+class LibraryWorkConsolidatorTest {
+    private class Provider(override val id: Long, override val lang: String = "en") : HttpSource() {
+        override val name = "Provider$id"
+        override val baseUrl = "https://example.invalid"
+        override val supportsLatest = false
+    }
+
+    private class Manager(private val providers: List<Provider>) : SourceManager {
+        override val isInitialized = MutableStateFlow(true)
+        override val sources = MutableStateFlow<List<Source>>(providers)
+
+        override fun get(sourceKey: Long): Source? = providers.firstOrNull { it.id == sourceKey }
+
+        override fun getOrStub(sourceKey: Long): Source =
+            get(sourceKey) ?: StubSource(sourceKey, "en", "Missing")
+
+        override fun getAll(): List<Source> = providers
+
+        override fun getOnlineSources(): List<HttpSource> = providers
+
+        override fun getStubSources(): List<StubSource> = emptyList()
+    }
+
+    private fun manga(id: Long, title: String = "The Star", author: String? = "Jane") =
+        Manga.create()
+            .copy(
+                id = id,
+                source = id,
+                url = "/work",
+                title = title,
+                author = author,
+                favorite = true,
+            )
+
+    private fun chapters(owner: Long, range: IntRange = 1..2) =
+        range.map { n ->
+            Chapter.create()
+                .copy(
+                    id = owner * 100 + n,
+                    mangaId = owner,
+                    url = "/$n",
+                    name = "Chapter $n",
+                    chapterNumber = n.toDouble(),
+                )
+        }
+
+    private class Fixture(initial: List<Manga>) {
+        var saved = initial
+        val works = mockk<LibraryWorkRepository>()
+        val chapters = mockk<ChapterRepository>()
+        val service: LibraryWorkConsolidator
+
+        init {
+            coEvery { works.favorites() } answers { saved }
+            coEvery { works.commit(any(), any()) } coAnswers
+                {
+                    val expected = firstArg<List<Manga>>()
+                    val work = secondArg<LibraryWork>()
+                    saved =
+                        saved.map {
+                            if (it.id in expected.map { x -> x.id })
+                                it.copy(memo = work.attach(it.memo))
+                            else it
+                        }
+                    true
+                }
+            coEvery { chapters.getChapterByMangaId(any(), any()) } answers
+                {
+                    val owner = firstArg<Long>()
+                    (1..2).map { n ->
+                        Chapter.create()
+                            .copy(
+                                id = owner * 100 + n,
+                                mangaId = owner,
+                                url = "/$n",
+                                name = "Chapter $n",
+                                chapterNumber = n.toDouble(),
+                            )
+                    }
+                }
+            service =
+                LibraryWorkConsolidator(
+                    works,
+                    chapters,
+                    Manager(initial.map { Provider(it.source, if (it.id == 1L) "pt-BR" else "en") }),
+                )
+        }
+    }
+
+    @Test
+    fun `confirmed native editions are associated once without deleting favorites`() = runTest {
+        val f = Fixture(listOf(manga(1), manga(2)))
+        assertEquals(1, f.service.reconcile())
+        assertEquals(0, f.service.reconcile())
+        assertTrue(f.saved.all { it.favorite })
+        assertEquals(listOf(1L, 2L), f.saved.map { it.id })
+        assertTrue(f.saved.all { LibraryWork.from(it.memo) != null })
+    }
+
+    @Test
+    fun `disjoint numbering is not assumed equivalent without catalogue corroboration`() = runTest {
+        val f = Fixture(listOf(manga(1), manga(2)))
+        coEvery { f.chapters.getChapterByMangaId(2, any()) } returns chapters(2, 50..60)
+        assertEquals(0, f.service.reconcile())
+        coVerify(exactly = 0) { f.works.commit(any(), any()) }
+    }
+
+    @Test
+    fun `a known alias can join adjacent ranges from Portuguese and English`() = runTest {
+        val identity =
+            WorkIdentity(
+                "mangadex:ade0306c-f4b6-4890-9edb-1ddf04df2039",
+                listOf("Upando Sozinho Ragnarok", "Solo Leveling Ragnarok"),
+                listOf("DAUL"),
+                1,
+            )
+        val initial =
+            listOf(
+                    manga(1, "Upando Sozinho Ragnarok", "DAUL"),
+                    manga(2, "Solo Leveling Ragnarok", "DAUL"),
+                )
+                .map { it.copy(memo = WorkSources(identity = identity).attach(it.memo)) }
+        val f = Fixture(initial)
+        coEvery { f.chapters.getChapterByMangaId(1, any()) } returns chapters(1, 1..40)
+        coEvery { f.chapters.getChapterByMangaId(2, any()) } returns chapters(2, 41..60)
+        assertEquals(1, f.service.reconcile())
+    }
+
+    @Test
+    fun `unsupported catalogue IDs cannot corroborate adjacent non overlapping ranges`() = runTest {
+        val identity = WorkIdentity("unsupported:42", listOf("The Star"), listOf("Jane"), 1)
+        val initial =
+            listOf(manga(1), manga(2)).map {
+                it.copy(memo = WorkSources(identity = identity).attach(it.memo))
+            }
+        val f = Fixture(initial)
+        coEvery { f.chapters.getChapterByMangaId(1, any()) } returns chapters(1, 1..40)
+        coEvery { f.chapters.getChapterByMangaId(2, any()) } returns chapters(2, 41..60)
+        assertEquals(0, f.service.reconcile())
+        coVerify(exactly = 0) { f.works.commit(any(), any()) }
+    }
+
+    @Test
+    fun `explicit separation survives new reconciliation`() = runTest {
+        val a = manga(1).let { it.copy(memo = buildJsonObject { put(LibraryWork.SEPARATE, true) }) }
+        val f = Fixture(listOf(a, manga(2)))
+        assertEquals(0, f.service.reconcile())
+    }
+
+    @Test
+    fun `conflicting per edition pins remain separate`() = runTest {
+        val initial =
+            listOf(manga(1), manga(2)).map {
+                it.copy(
+                    memo =
+                        WorkSources(
+                                pinned = WorkSource(it.source, "Pinned", "en", it.url, it.title)
+                            )
+                            .attach(it.memo)
+                )
+            }
+        val f = Fixture(initial)
+        assertEquals(0, f.service.reconcile())
+        coVerify(exactly = 0) { f.works.commit(any(), any()) }
+    }
+
+    @Test
+    fun `a failed native chapter query leaves original records unchanged`() = runTest {
+        val initial = listOf(manga(1), manga(2))
+        val f = Fixture(initial)
+        coEvery { f.chapters.getChapterByMangaId(2, any()) } throws java.io.IOException("fixture")
+        assertTrue(runCatching { f.service.reconcile() }.isFailure)
+        assertEquals(initial, f.saved)
+        coVerify(exactly = 0) { f.works.commit(any(), any()) }
+    }
+
+    @Test
+    fun `completed groups do not starve the next batch of restored duplicates`() = runTest {
+        val initial = (1L..18L).map { manga(it, "Work ${(it-1)/2}") }
+        val f = Fixture(initial)
+        assertEquals(8, f.service.reconcile())
+        assertEquals(1, f.service.reconcile())
+        assertEquals(0, f.service.reconcile())
+        assertTrue(f.saved.all { LibraryWork.from(it.memo) != null })
+    }
+
+    @Test
+    fun `a stale plan retries fresh metadata and keeps a concurrent note`() = runTest {
+        val f = Fixture(listOf(manga(1), manga(2)))
+        var first = true
+        coEvery { f.works.commit(any(), any()) } coAnswers
+            {
+                if (first) {
+                    first = false
+                    f.saved = f.saved.map { if (it.id == 1L) it.copy(notes = "concurrent") else it }
+                    false
+                } else {
+                    val work = secondArg<LibraryWork>()
+                    f.saved = f.saved.map { it.copy(memo = work.attach(it.memo)) }
+                    true
+                }
+            }
+        assertEquals(1, f.service.reconcile())
+        assertEquals("concurrent", f.saved.first().notes)
+    }
+}
