+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.BeforeEach
+import org.junit.jupiter.api.Test
+
+class CaptionSurfaceRegressionTest {
+    @BeforeEach fun colors() {
+        mockkStatic(Color::class)
+        every { Color.alpha(any()) } answers { firstArg<Int>() ushr 24 and 0xff }
+        every { Color.red(any()) } answers { firstArg<Int>() ushr 16 and 0xff }
+        every { Color.green(any()) } answers { firstArg<Int>() ushr 8 and 0xff }
+        every { Color.blue(any()) } answers { firstArg<Int>() and 0xff }
+        every { Color.rgb(any<Int>(), any<Int>(), any<Int>()) } answers {
+            0xff000000.toInt() or (firstArg<Int>() shl 16) or (secondArg<Int>() shl 8) or thirdArg<Int>()
+        }
+    }
+
+    @AfterEach fun cleanup() = unmockkStatic(Color::class)
+
+    @Test fun `open dark or colored panels constrain the fallback when only two sides are detected`() {
+        for (color in listOf(0xff303044.toInt(), 0xff000000.toInt(), 0xffecd9ad.toInt())) {
+            for (scale in listOf(1, 2, 4)) {
+                val source = block(scale)
+                val image = bitmapFixture(400, 400) { x, y ->
+                    val letter = x in 85..240 && y in 100..120 && x % 10 < 5 && y % 10 < 6
+                    if (letter) {
+                        0xff777777.toInt()
+                    } else if (x in 80..250) {
+                        color
+                    } else {
+                        0xffa0b5c5.toInt()
+                    }
+                }
+                val analysis = SpeechBubbleAnalyzer(
+                    image,
+                    400 * scale,
+                    400 * scale,
+                    listOf(source.sourceRegion()),
+                ).analyze(source)
+                assertEquals(color, analysis.backgroundColor)
+                assertTrue(analysis.layoutRegion.x >= 80f * scale)
+                assertTrue(analysis.layoutRegion.x + analysis.layoutRegion.width <= 251f * scale)
+                assertTrue(source.sourceRegion().overlapFraction(analysis.layoutRegion) > 0.99f)
+            }
+        }
+    }
+
+    @Test fun `closed blue caption keeps a white foreground and writing inside its panel`() {
+        val source = block(1).copy(x = 100f, y = 125f, width = 200f, height = 20f)
+        val panel = 0xff303044.toInt()
+        val image = bitmapFixture(400, 400) { x, y -> if (x in 50..350 && y in 100..175) panel else 0xffc0c0c0.toInt() }
+        val analysis = SpeechBubbleAnalyzer(image, 400, 400, listOf(source.sourceRegion())).analyze(source)
+        assertEquals(panel, analysis.backgroundColor)
+        assertEquals(-1, analysis.foregroundColor)
+        assertTrue(analysis.layoutRegion.y >= 100f)
+        assertTrue(analysis.layoutRegion.y + analysis.layoutRegion.height <= 176f)
+    }
+
+    @Test fun `white oval remains detected and retains its established useful layout`() {
+        val source = block(1).copy(x = 145f, y = 170f, width = 110f, height = 20f)
+        val image = bitmapFixture(400, 400) { x, y ->
+            val dx = (x - 200f) / 118f
+            val dy = (y - 180f) / 88f
+            if (dx * dx + dy * dy <= 1f) -1 else 0xff000000.toInt()
+        }
+        val analysis = SpeechBubbleAnalyzer(image, 400, 400, listOf(source.sourceRegion())).analyze(source)
+        assertTrue(analysis.balloonDetected)
+        assertEquals(-1, analysis.backgroundColor)
+        val block = source.copy(
+            layoutRegion = analysis.layoutRegion,
+            cleanupRegion = analysis.cleanupRegion,
+            backgroundColor = analysis.backgroundColor,
+            balloonDetected = true,
+            geometryVersion = 2,
+        )
+        assertEquals(analysis.layoutRegion, TranslationPageLayout.resolve(listOf(block), 400f, 400f).single())
+    }
+
+    private fun block(scale: Int) = TranslationBlock(
+        text = "MY SKILLS AND STATS", translation = "MINHAS HABILIDADES E ESTATÍSTICAS",
+        x = 85f * scale, y = 100f * scale, width = 155f * scale, height = 20f * scale,
+        symWidth = 10f * scale, symHeight = 12f * scale, angle = 0f,
+    )
+}
diff --git a/app/src/test/java/eu/kanade/translation/recognizer/OcrStripPlanTest.kt b/app/src/test/java/eu/kanade/translation/recognizer/OcrStripPlanTest.kt
