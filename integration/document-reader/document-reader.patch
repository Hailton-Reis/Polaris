@@ -0,0 +1,209 @@
+package eu.kanade.tachiyomi.data.backup.models
+
+import org.junit.jupiter.api.Assertions.*
+import org.junit.jupiter.api.Test
+import tachiyomi.data.MemoColumnAdapter
+import tachiyomi.domain.chapter.model.Chapter
+import tachiyomi.domain.chapter.model.ChapterOrigin
+import tachiyomi.domain.manga.model.Manga
+import tachiyomi.domain.manga.model.WorkSource
+import tachiyomi.domain.manga.model.WorkSources
+
+class PortableMangaBackupTest {
+    private fun edition(n: Int, source: Long, read: Boolean = false, page: Long = 0) =
+        BackupChapter(
+            url = if (source == 1L) "/en/$n" else ChapterOrigin.storedUrl(source, "/pt/$n"),
+            name = "Chapter $n",
+            chapterNumber = n.toFloat(),
+            read = read,
+            lastPageRead = page,
+            memo =
+                MemoColumnAdapter.encode(
+                    ChapterOrigin(
+                            source,
+                            "Source",
+                            if (source == 1L) "en" else "pt-BR",
+                            "/work/$source",
+                            if (source == 1L) "/en/$n" else "/pt/$n",
+                        )
+                        .attach(Chapter.create().memo)
+                ),
+        )
+
+    private fun work(): BackupManga =
+        BackupManga(
+            source = 1,
+            url = "/work/1",
+            title = "Solo Leveling",
+            chapters = listOf(edition(1, 1, true, 7), edition(2, 1), edition(1, 2, page = 3)),
+            history =
+                listOf(
+                    BackupHistory("/en/1", 100, 5),
+                    BackupHistory(ChapterOrigin.storedUrl(2, "/pt/1"), 200, 8),
+                ),
+            categories = listOf(4),
+            notes = "personal note",
+            nextUpdate = 1700000000500L,
+            memo =
+                MemoColumnAdapter.encode(
+                    WorkSources(
+                            candidates =
+                                listOf(
+                                    WorkSource(
+                                        1,
+                                        "English",
+                                        "en",
+                                        "/work/1",
+                                        "Solo Leveling",
+                                        chapters = 2,
+                                        readability = "sample_passed",
+                                    ),
+                                    WorkSource(
+                                        2,
+                                        "Portuguese",
+                                        "pt-BR",
+                                        "/work/2",
+                                        "Upando Sozinho",
+                                        chapters = 1,
+                                        readability = "sample_passed",
+                                    ),
+                                )
+                        )
+                        .attach(Manga.create().memo)
+                ),
+        )
+
+    @Test
+    fun `external view has one real source with native URLs and logical read flags`() {
+        val original = work()
+        val exported = PortableMangaBackup.export(original)
+        assertEquals(1L, exported.source)
+        assertEquals("/work/1", exported.url)
+        assertEquals("Solo Leveling", exported.title)
+        assertEquals(listOf("/en/1", "/en/2"), exported.chapters.map { it.url })
+        assertTrue(exported.chapters.first().read)
+        assertEquals(7L, exported.chapters.first().lastPageRead)
+        assertEquals(listOf(BackupHistory("/en/1", 200, 13)), exported.history)
+        assertEquals(3, original.chapters.size)
+        assertFalse(original.chapters.last().read)
+    }
+
+    @Test
+    fun `Polaris round trip preserves old identity all editions history and settings`() {
+        val original = work()
+        val restored = PortableMangaBackup.restore(PortableMangaBackup.export(original))
+        assertEquals(original.source, restored.source)
+        assertEquals(original.url, restored.url)
+        assertEquals(original.title, restored.title)
+        assertEquals(original.chapters.map { it.url }, restored.chapters.map { it.url })
+        assertEquals(original.chapters.map { it.read }, restored.chapters.map { it.read })
+        assertEquals(
+            original.chapters.map { it.lastPageRead },
+            restored.chapters.map { it.lastPageRead },
+        )
+        assertEquals(original.history, restored.history)
+        assertEquals(original.categories, restored.categories)
+        assertEquals(original.notes, restored.notes)
+        assertEquals(original.nextUpdate, restored.nextUpdate)
+        assertEquals(original.nextUpdate, restored.getMangaImpl().nextUpdate)
+    }
+
+    @Test
+    fun `native reader that drops optional memo still has only valid source URLs`() {
+        val exported = PortableMangaBackup.export(work())
+        exported.memo = MemoColumnAdapter.encode(Manga.create().memo)
+        assertSame(exported, PortableMangaBackup.restore(exported))
+        assertFalse(exported.chapters.any { ChapterOrigin.isRouted(it.url) })
+    }
+
+    @Test
+    fun `native migration keeps the new identity instead of attaching the old work snapshot`() {
+        val exported = PortableMangaBackup.export(work())
+        exported.url = "/different"
+        val restored = PortableMangaBackup.restore(exported)
+        assertEquals("/different", restored.url)
+        assertEquals(1L, restored.source)
+        assertEquals(listOf("/en/1", "/en/2"), restored.chapters.map { it.url })
+        assertFalse(restored.memo.decodeToString().contains("polaris.backup.work.v1"))
+    }
+
+    @Test
+    fun `portable state edits affect matching logical chapter without inventing page equivalence`() {
+        val exported = PortableMangaBackup.export(work())
+        exported.chapters.first().read = false
+        exported.chapters.first().bookmark = true
+        exported.chapters.first().lastPageRead = 9
+        val restored = PortableMangaBackup.restore(exported)
+        assertFalse(restored.chapters[0].read)
+        assertTrue(restored.chapters[0].bookmark)
+        assertEquals(9L, restored.chapters[0].lastPageRead)
+        assertEquals(3L, restored.chapters[2].lastPageRead)
+        assertFalse(restored.chapters[1].bookmark)
+    }
+
+    @Test
+    fun `portable settings edits survive returning to Polaris`() {
+        val exported = PortableMangaBackup.export(work())
+        exported.notes = "changed in another reader"
+        exported.categories = listOf(9)
+        exported.favorite = false
+        val restored = PortableMangaBackup.restore(exported)
+        assertEquals(exported.notes, restored.notes)
+        assertEquals(listOf(9L), restored.categories)
+        assertFalse(restored.favorite)
+        assertEquals(3, restored.chapters.size)
+    }
+
+    @Test
+    fun `new native chapters and additional history survive returning to Polaris`() {
+        val exported = PortableMangaBackup.export(work())
+        exported.chapters =
+            exported.chapters +
+                BackupChapter(
+                    "/en/3",
+                    "Chapter 3",
+                    chapterNumber = 3f,
+                    read = true,
+                    lastPageRead = 4,
+                )
+        exported.history = listOf(BackupHistory("/en/1", 400, 20), BackupHistory("/en/3", 500, 6))
+        val restored = PortableMangaBackup.restore(exported)
+        assertEquals(4, restored.chapters.size)
+        val added = restored.chapters.single { it.url == "/en/3" }
+        assertEquals(1L, ChapterOrigin.from(MemoColumnAdapter.decode(added.memo))?.sourceId)
+        assertTrue(added.read)
+        assertEquals(4L, added.lastPageRead)
+        assertEquals(
+            20L,
+            restored.history
+                .filter { it.url.endsWith("/1") || it.url == ChapterOrigin.storedUrl(2, "/pt/1") }
+                .sumOf { it.readDuration },
+        )
+        assertEquals(6L, restored.history.single { it.url == "/en/3" }.readDuration)
+        assertEquals(400L, restored.history.single { it.url == "/en/1" }.lastRead)
+    }
+
+    @Test
+    fun `ordinary backups remain byte-model compatible without a Polaris envelope`() {
+        val ordinary =
+            BackupManga(
+                source = 1,
+                url = "/work",
+                chapters = listOf(BackupChapter("/chapter", "Chapter 1")),
+            )
+        assertSame(ordinary, PortableMangaBackup.export(ordinary))
+        assertSame(ordinary, PortableMangaBackup.restore(ordinary))
+    }
+
+    @Test
+    fun `portable backups retain source references for the visible provider and old storage identity`() {
+        val descriptors =
+            PortableMangaBackup.sourceDescriptors(PortableMangaBackup.export(work())).associateBy {
+                it.id
+            }
+        assertEquals(setOf(1L, 2L), descriptors.keys)
+        assertEquals("English", descriptors.getValue(1).name)
+        assertEquals("en", descriptors.getValue(1).language)
+        assertEquals("pt-BR", descriptors.getValue(2).language)
+    }
+}
