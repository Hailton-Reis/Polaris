+            if (expected.size !in 2..16 || expected.map { it.id }.distinct().size != expected.size)
+                return@transactionWithResult false
+            if (LibraryWork.from(work.attach(JsonObject(emptyMap()))) != work)
+                return@transactionWithResult false
+            val current =
+                expected.map { old ->
+                    database.mangasQueries
+                        .getMangaById(old.id, MangaMapper::mapManga)
+                        .awaitAsOneOrNull() ?: return@transactionWithResult false
+                }
+            if (
+                current != expected ||
+                    current.any { !it.favorite || LibraryWork.separated(it.memo) }
+            )
+                return@transactionWithResult false
+            if (!LibraryWork.compatible(current)) return@transactionWithResult false
+            val pins = current.mapNotNull { WorkSources.from(it.memo).pinned?.key }.distinct()
+            if (
+                pins.size > 1 ||
+                    pins.size == 1 &&
+                        current.none {
+                            work.isPrimary(it) && WorkSources.from(it.memo).pinned != null
+                        }
+            )
+                return@transactionWithResult false
+            if (
+                work.editions.size != current.size ||
+                    work.editions.any { edition -> current.none(edition::matches) }
+            )
+                return@transactionWithResult false
+            val chapterRepository = tachiyomi.data.chapter.ChapterRepositoryImpl(database)
+            val nativeChapters = current.map { chapterRepository.getChapterByMangaId(it.id, false) }
+            if (
+                !tachiyomi.domain.chapter.model.ChapterNumbering.compatibleEditions(
+                    current,
+                    nativeChapters,
+                )
+            )
+                return@transactionWithResult false
+            val previous = current.mapNotNull { LibraryWork.from(it.memo) }.distinct()
+            for (old in previous) for (edition in old.editions) {
+                if (current.none { it.source == edition.source && it.url == edition.url }) {
+                    val outside =
+                        database.mangasQueries
+                            .getMangaByUrlAndSource(
+                                edition.url,
+                                edition.source,
+                                MangaMapper::mapManga,
+                            )
+                            .awaitAsOneOrNull()
+                    if (outside?.favorite == true) return@transactionWithResult false
+                }
+            }
+            current.forEach { manga ->
+                database.mangasQueries.updateMemo(work.attach(manga.memo), manga.id)
+            }
+            true
+        }
+
+    override suspend fun detach(rootId: Long): Boolean =
+        database.transactionWithResult {
+            val root =
+                database.mangasQueries
+                    .getMangaById(rootId, MangaMapper::mapManga)
+                    .awaitAsOneOrNull() ?: return@transactionWithResult false
+            val work = LibraryWork.from(root.memo) ?: return@transactionWithResult false
+            val archived = work.attach(JsonObject(emptyMap())).getValue(LibraryWork.KEY)
+            (favorites() + root)
+                .distinctBy { it.id }
+                .filter { LibraryWork.from(it.memo) == work }
+                .forEach { member ->
+                    database.mangasQueries.updateMemo(
+                        JsonObject(
+                            LibraryWork.without(member.memo) +
+                                mapOf(
+                                    LibraryWork.SEPARATE to JsonPrimitive(true),
+                                    LibraryWork.SEPARATED_WORK to archived,
+                                )
+                        ),
+                        member.id,
+                    )
+                }
+            true
+        }
+
+    override suspend fun allowAutomatic(rootId: Long): Boolean =
+        database.transactionWithResult {
+            val root =
+                database.mangasQueries
+                    .getMangaById(rootId, MangaMapper::mapManga)
+                    .awaitAsOneOrNull() ?: return@transactionWithResult false
+            val archived = root.memo[LibraryWork.SEPARATED_WORK]
+            (favorites() + root)
+                .distinctBy { it.id }
+                .filter {
+                    it.id == root.id ||
+                        archived != null && it.memo[LibraryWork.SEPARATED_WORK] == archived
+                }
+                .forEach { member ->
+                    database.mangasQueries.updateMemo(
+                        JsonObject(member.memo - LibraryWork.SEPARATE - LibraryWork.SEPARATED_WORK),
+                        member.id,
+                    )
+                }
+            true
+        }
+}
