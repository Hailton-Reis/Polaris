@@ -0,0 +1,70 @@
+package tachiyomi.domain.chapter.model
+
+import java.math.BigDecimal
+import tachiyomi.domain.manga.model.LibraryWork
+import tachiyomi.domain.manga.model.Manga
+
+/** Shared by discovery, association commits and every grouped chapter read. */
+object ChapterNumbering {
+    private data class Scope(val season: String?, val volume: String?, val part: String?)
+
+    private class Profile(chapters: List<Chapter>) {
+        val empty = chapters.isEmpty()
+        val keys =
+            chapters
+                .map(ChapterVersions::key)
+                .filter { it.number != null && it.special == null }
+                .toSet()
+        val shapes =
+            keys.map { Triple(it.season != null, it.volume != null, it.part != null) }.toSet()
+        val ranges by
+            lazy(LazyThreadSafetyMode.NONE) {
+                keys
+                    .groupBy { Scope(it.season, it.volume, it.part) }
+                    .mapValues { (_, scoped) ->
+                        val integers =
+                            scoped.mapNotNull {
+                                it.number?.toBigDecimalOrNull()?.takeIf { n ->
+                                    n.stripTrailingZeros().scale() <= 0
+                                }
+                            }
+                        if (integers.isEmpty()) null else integers.min() to integers.max()
+                    }
+            }
+    }
+
+    fun compatible(
+        reference: List<Chapter>,
+        candidate: List<Chapter>,
+        corroboratedIdentity: Boolean = false,
+    ): Boolean = compatible(Profile(reference), Profile(candidate), corroboratedIdentity)
+
+    private fun compatible(a: Profile, b: Profile, corroborated: Boolean): Boolean {
+        // Library-only recovery can establish a first sequence, not remap unknown numbering.
+        if (a.empty) return b.keys.isNotEmpty()
+        if (a.keys.isEmpty() || b.keys.isEmpty() || a.shapes != b.shapes) return false
+        if (a.keys.any { it in b.keys }) return true
+        if (!corroborated || a.ranges.keys != b.ranges.keys) return false
+        // Adjacent ranges must belong to the same actual season/volume/part, not merely mention
+        // one.
+        return a.ranges.all { (scope, range) ->
+            val left = range ?: return@all false
+            val right = b.ranges[scope] ?: return@all false
+            left.second + BigDecimal.ONE == right.first ||
+                right.second + BigDecimal.ONE == left.first
+        }
+    }
+
+    fun compatibleEditions(members: List<Manga>, chapters: List<List<Chapter>>): Boolean {
+        if (members.size != chapters.size) return false
+        if (members.size < 2) return true
+        val corroborated = LibraryWork.sharedIdentity(members)
+        // Normalize each edition once, even for the maximum group of sixteen sources.
+        val profiles = chapters.map(::Profile)
+        return profiles.indices.all { a ->
+            profiles.indices.all { b ->
+                a == b || compatible(profiles[a], profiles[b], corroborated)
+            }
+        }
+    }
+}
