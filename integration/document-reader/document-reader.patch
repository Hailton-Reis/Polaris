+package eu.kanade.tachiyomi.extension.sandbox
+
+import android.app.Application
+import android.app.Service
+import android.content.Intent
+import android.os.*
+import dalvik.system.InMemoryDexClassLoader
+import eu.kanade.tachiyomi.network.NetworkHelper
+import eu.kanade.tachiyomi.source.Source
+import eu.kanade.tachiyomi.source.SourceFactory
+import eu.kanade.tachiyomi.source.online.HttpSource
+import java.io.ByteArrayInputStream
+import java.nio.ByteBuffer
+import java.security.MessageDigest
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+import java.util.zip.ZipInputStream
+import kotlinx.coroutines.runBlocking
+import kotlinx.coroutines.withTimeout
+import kotlinx.serialization.json.*
+import uy.kohesive.injekt.Injekt
+import uy.kohesive.injekt.api.addSingleton
+
+/** Experimental runner: platform-isolated UID, one APK lifetime, no host storage initialization. */
+internal class ExtensionSandboxService : Service() {
+    private var opened = false
+    private var sources = emptyList<HttpSource>()
+    private lateinit var workerApplication: SandboxWorkerApplication
+    private var knownPreferenceIds = emptySet<Long>()
+    private val serial = java.util.concurrent.Semaphore(1)
+    private val watchdog = Executors.newSingleThreadScheduledExecutor()
+
+    override fun onBind(intent: Intent): IBinder =
+        object : Binder() {
+            override fun onTransact(code: Int, data: Parcel, reply: Parcel?, flags: Int): Boolean {
+                if (reply == null || code !in 1..4)
+                    return super.onTransact(code, data, reply, flags)
+                data.enforceInterface(ExtensionSandboxProtocol.DESCRIPTOR)
+                check(Binder.getCallingUid() == applicationInfo.uid) { "Wrong sandbox caller" }
+                check(isWorker()) { "Service must run under an isolated UID" }
+                if (code == ExtensionSandboxProtocol.CLOSE) {
+                    reply.writeNoException()
+                    Thread {
+                            Thread.sleep(50)
+                            android.os.Process.killProcess(android.os.Process.myPid())
+                        }
+                        .start()
+                    return true
+                }
+                check(serial.tryAcquire()) { "Sandbox operation already active" }
+                val callingIdentity = Binder.clearCallingIdentity()
+                val deadline =
+                    watchdog.schedule(
+                        { android.os.Process.killProcess(android.os.Process.myPid()) },
+                        25,
+                        TimeUnit.SECONDS,
+                    )
+                try {
+                    val result =
+                        when (code) {
+                            4 ->
+                                buildJsonObject {
+                                    put("uid", android.os.Process.myUid())
+                                    put("pid", android.os.Process.myPid())
+                                }
+                            ExtensionSandboxProtocol.OPEN -> open(data)
+                            ExtensionSandboxProtocol.REQUEST ->
+                                runBlocking {
+                                    withTimeout(20_000L) {
+                                        request(
+                                            ExtensionSandboxProtocol.input(
+                                                data.createByteArray() ?: error("Missing operation")
+                                            )
+                                        )
+                                    }
+                                }
+                            else -> error("Unsupported sandbox command")
+                        }
+                    val output =
+                        if (::workerApplication.isInitialized)
+                            JsonObject(
+                                result +
+                                    ("preferenceChanges" to
+                                        workerApplication.snapshot(knownPreferenceIds))
+                            )
+                        else result
+                    val bytes = output.toString().toByteArray()
+                    val stream = ExtensionSandboxProtocol.pipe(bytes)
+                    reply.writeNoException()
+                    reply.writeTypedObject(stream, Parcelable.PARCELABLE_WRITE_RETURN_VALUE)
+                    stream.close()
+                } catch (error: Throwable) {
+                    // No arbitrary exception, stack, Parcelable or object graph is sent to the
+                    // host.
+                    reply.writeException(
+                        IllegalStateException(
+                            "Isolated source failed: ${error.javaClass.simpleName.take(80)}"
+                        )
+                    )
+                } finally {
+                    deadline.cancel(false)
+                    Binder.restoreCallingIdentity(callingIdentity)
+                    serial.release()
+                }
+                return true
+            }
+        }
+
+    private fun open(data: Parcel): JsonObject {
+        check(!opened) { "An isolated process must not be reused for another APK" }
+        opened =
+            true // Failed initialization cannot reuse a potentially contaminated process either.
+        @Suppress("DEPRECATION")
+        val file = data.readTypedObject(ParcelFileDescriptor.CREATOR) ?: error("Missing APK")
+        val wantedHash = data.readString() ?: error("Missing digest")
+        val entries = data.createStringArray()?.toList() ?: error("Missing entry classes")
+        require(entries.size in 1..64 && entries.all { it.length in 1..300 })
+        val broker = data.readStrongBinder() ?: error("Missing HTTP capability")
+        val preferences =
+            ExtensionSandboxProtocol.input(
+                data.createByteArray() ?: error("Missing preference snapshot")
+            )
+        knownPreferenceIds = preferences.keys.map { it.removePrefix("source_").toLong() }.toSet()
+        workerApplication = SandboxWorkerApplication(this, preferences)
+        val bytes =
+            ParcelFileDescriptor.AutoCloseInputStream(file).use {
+                ExtensionSandboxProtocol.readBounded(it, 32 * 1024 * 1024)
+            }
+        val digest =
+            MessageDigest.getInstance("SHA-256").digest(bytes).joinToString("") {
+                "%02x".format(it)
+            }
+        require(digest == wantedHash) { "APK bytes changed" }
+        check(
+            checkSelfPermission(android.Manifest.permission.INTERNET) !=
+                android.content.pm.PackageManager.PERMISSION_GRANTED
+        )
+        val dex = mutableListOf<ByteBuffer>()
+        var total = 0
+        var count = 0
+        ZipInputStream(ByteArrayInputStream(bytes)).use { zip ->
+            while (true) {
+                val entry = zip.nextEntry ?: break
+                require(++count <= 2048)
+                if (Regex("classes(?:[2-9][0-9]*)?\\.dex").matches(entry.name)) {
+                    val code = ExtensionSandboxProtocol.readBounded(zip, 16 * 1024 * 1024)
+                    total += code.size
+                    require(total <= 32 * 1024 * 1024)
+                    dex += ByteBuffer.wrap(code)
+                }
+                zip.closeEntry()
+            }
+        }
+        require(dex.isNotEmpty() && (Build.VERSION.SDK_INT >= 27 || dex.size == 1))
+        val loader =
+            if (Build.VERSION.SDK_INT >= 27) InMemoryDexClassLoader(dex.toTypedArray(), classLoader)
+            else InMemoryDexClassLoader(dex.single(), classLoader)
+        dev.mihon.injekt.patchInjekt()
+        Injekt.addSingleton(NetworkHelper.isolated(SandboxHttpBroker.client(broker)))
+        Injekt.addSingleton<Application>(workerApplication)
+        val found: List<Source> =
+            entries.flatMap { name ->
+                when (
+                    val value =
+                        Class.forName(name, true, loader).getDeclaredConstructor().newInstance()
+                ) {
+                    is Source -> listOf(value)
+                    is SourceFactory -> value.createSources()
+                    else -> error("Unsupported source class")
+                }
+            }
+        require(
+            found.size in 1..256 &&
+                found.all { it is HttpSource && it !is eu.kanade.tachiyomi.source.INovelSource }
+        ) {
+            "Only HTTP comic sources are supported by this runner"
+        }
+        sources = found.filterIsInstance<HttpSource>()
+        require(sources.map { it.id }.distinct().size == sources.size && sources.all { it.id > 0 })
+        knownPreferenceIds = knownPreferenceIds + sources.map { it.id }
+        require(knownPreferenceIds.size <= 256)
+        return buildJsonObject {
+            put("uid", android.os.Process.myUid())
+            putJsonArray("sources") {
+                sources.forEach { source ->
+                    add(
+                        buildJsonObject {
+                            put("id", source.id)
+                            put("name", source.name.take(300))
+                            put("lang", source.lang.take(20))
+                            put("url", source.baseUrl.take(8192))
+                            put("latest", source.supportsLatest)
+                            put(
+                                "preferencesSupported",
+                                source is eu.kanade.tachiyomi.source.ConfigurableSource,
+                            )
+                            put("filters", SandboxFilterCodec.schema(source.getFilterList()))
+                        }
+                    )
+                }
+            }
+        }
+    }
+
+    private suspend fun request(input: JsonObject): JsonObject {
+        val operation = input.getValue("operation").jsonPrimitive.content
+        require(operation in ExtensionSandboxProtocol.operations)
+        val source = sources.single { it.id == input.getValue("source").jsonPrimitive.long }
+        return when (operation) {
+            "popular",
+            "latest",
+            "search" -> {
+                val page = input["page"]?.jsonPrimitive?.int ?: 1
+                require(page in 1..100_000)
+                val result =
+                    when (operation) {
+                        "popular" -> source.getPopularManga(page)
+                        "latest" -> source.getLatestUpdates(page)
+                        else ->
+                            source.getSearchManga(
+                                page,
+                                input["query"]?.jsonPrimitive?.content.orEmpty().take(1000),
+                                source.getFilterList().also { filters ->
+                                    (input["filters"] as? JsonObject)?.let {
+                                        SandboxFilterCodec.apply(filters, it)
+                                    }
+                                },
+                            )
+                    }
+                require(result.mangas.size <= 500)
+                buildJsonObject {
+                    put("next", result.hasNextPage)
+                    put("mangas", JsonArray(result.mangas.map(SandboxSourceCodec::manga)))
+                }
+            }
+            "preferences" ->
+                SandboxPreferenceCodec.schema(
+                    SandboxPreferenceCodec.screen(source, workerApplication)
+                )
+            "preferenceImport" -> {
+                val screen = SandboxPreferenceCodec.screen(source, workerApplication)
+                val accepted =
+                    SandboxPreferenceCodec.importValues(
+                        screen,
+                        input.getValue("schema").jsonPrimitive.content,
+                        input.getValue("changes").jsonObject,
+                    )
+                buildJsonObject { put("accepted", accepted) }
+            }
+            "preferenceChange" -> {
+                val before = workerApplication.snapshot(knownPreferenceIds)
+                val screen = SandboxPreferenceCodec.screen(source, workerApplication)
+                val accepted =
+                    SandboxPreferenceCodec.change(
+                        screen,
+                        input.getValue("schema").jsonPrimitive.content,
+                        input.getValue("changes").jsonObject,
+                    )
+                buildJsonObject {
+                    put("accepted", accepted)
+                    put("changed", before != workerApplication.snapshot(knownPreferenceIds))
+                }
+            }
+            "update" -> {
+                val manga = SandboxSourceCodec.manga(input.getValue("manga").jsonObject)
+                val chapters =
+                    input["chapters"]?.jsonArray.orEmpty().map {
+                        SandboxSourceCodec.chapter(it.jsonObject)
+                    }
+                val result =
+                    source.getMangaUpdate(
+                        manga,
+                        chapters,
+                        input["details"]?.jsonPrimitive?.boolean ?: true,
+                        input["chaptersRequested"]?.jsonPrimitive?.boolean ?: true,
+                    )
+                require(result.chapters.size <= 20_000)
+                buildJsonObject {
+                    put("manga", SandboxSourceCodec.manga(result.manga))
+                    put("chapters", JsonArray(result.chapters.map(SandboxSourceCodec::chapter)))
+                }
+            }
+            "pages" -> {
+                val pages =
+                    source.getPageList(
+                        SandboxSourceCodec.chapter(input.getValue("chapter").jsonObject)
+                    )
+                require(pages.size <= 2000)
+                buildJsonObject { put("pages", JsonArray(pages.map(SandboxSourceCodec::page))) }
+            }
+            "imageRequest" -> {
+                val request =
+                    source.polarisSandboxImageRequest(
+                        SandboxSourceCodec.page(input.getValue("page").jsonObject)
+                    )
+                val body = okio.Buffer().also { request.body?.writeTo(it) }.readByteArray()
+                require(body.size <= SandboxNetworkPolicy.MAX_REQUEST_BYTES)
+                buildJsonObject {
+                    put("url", request.url.toString())
+                    put("method", request.method)
+                    putJsonArray("headers") {
+                        request.headers.forEach { (name, value) ->
+                            add(
+                                buildJsonArray {
+                                    add(name)
+                                    add(value)
+                                }
+                            )
+                        }
+                    }
+                    put("body", java.util.Base64.getEncoder().encodeToString(body))
+                    request.body?.contentType()?.let { put("type", it.toString()) }
+                }
+            }
+            "imageUrl" ->
+                buildJsonObject {
+                    put(
+                        "url",
+                        source.getImageUrl(
+                            SandboxSourceCodec.page(input.getValue("page").jsonObject)
+                        ),
+                    )
+                }
+            else -> error("Unsupported operation")
+        }
+    }
+
+    override fun onDestroy() {
+        watchdog.shutdownNow()
+        super.onDestroy()
+        android.os.Process.killProcess(android.os.Process.myPid())
+    }
+
+    companion object {
+        fun isWorker(): Boolean = android.os.Process.myUid() % 100_000 in 90_000..99_999
+    }
+}
