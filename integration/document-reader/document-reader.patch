+
+data class DocumentImportRequest(
+    val id: String = java.util.UUID.randomUUID().toString(),
+    val uri: Uri? = null,
+    val url: String? = null,
+    val name: String,
+    val format: DocumentFormat? = null,
+    val title: String = "",
+    val author: String? = null,
+    val kind: DocumentKind = DocumentKind.DOCUMENT,
+)
+
+data class DocumentsState(
+    val searching: Boolean = false,
+    val importing: Boolean = false,
+    val selecting: Boolean = false,
+    val pendingImport: DocumentImportRequest? = null,
+    val categories: List<Category> = emptyList(),
+    val error: Boolean = false,
+    val searched: Boolean = false,
+    val batch: DocumentSearchBatch? = null,
+    val importedManga: Long? = null,
+)
+
+class DocumentsViewModel : ViewModel() {
+    private val app: Application = Injekt.get()
+    private val importer = DocumentImporter(app)
+    private val search = DocumentSearch(Injekt.get<NetworkHelper>().client)
+    private val mutableState = MutableStateFlow(DocumentsState())
+    val state = mutableState.asStateFlow()
+    private var searchJob: Job? = null
+
+    fun search(query: String, kind: DocumentSearchKind, field: DocumentSearchField) {
+        if (query.trim().length !in 2..300) return
+        searchJob?.cancel()
+        searchJob = viewModelScope.launch {
+            mutableState.update { it.copy(searching = true, error = false) }
+            try {
+                val result = search.search(query.trim(), kind, field)
+                mutableState.update { it.copy(batch = result, searched = true, searching = false) }
+            } catch (cancelled: CancellationException) {
+                throw cancelled
+            } catch (_: Exception) {
+                mutableState.update { it.copy(searching = false, error = true) }
+            }
+        }
+    }
+
+    init {
+        viewModelScope.launch {
+            try {
+                Injekt.get<GetCategories>().subscribe().collect { categories ->
+                    mutableState.update { it.copy(categories = categories.filterNot(Category::isSystemCategory)) }
+                }
+            } catch (cancelled: CancellationException) {
+                throw cancelled
+            } catch (_: Exception) {
+                mutableState.update { it.copy(error = true) }
+            }
+        }
+    }
+
+    fun requestUri(uri: Uri) {
+        if (state.value.importing || state.value.selecting || state.value.pendingImport != null) return
+        mutableState.update { it.copy(selecting = true, error = false) }
+        viewModelScope.launch {
+            try {
+                val file = importer.describeUri(uri)
+                mutableState.update {
+                    it.copy(
+                        selecting = false,
+                        pendingImport = DocumentImportRequest(uri = uri, name = file.name, format = file.format),
+                    )
+                }
+            } catch (cancelled: CancellationException) {
+                throw cancelled
+            } catch (_: Exception) {
+                mutableState.update { it.copy(selecting = false, error = true) }
+            }
+        }
+    }
+
+    fun requestUrl(
+        url: String,
+        title: String = "",
+        document: RemoteDocument? = null,
+        author: String? = null,
+        kind: DocumentKind = DocumentKind.DOCUMENT,
+    ) {
+        if (state.value.importing || state.value.selecting || state.value.pendingImport != null) return
+        val parsed = (document?.url ?: url).trim().toHttpUrlOrNull()
+        if (parsed == null || parsed.username.isNotEmpty() || parsed.password.isNotEmpty()) {
+            mutableState.update { it.copy(error = true) }
+            return
+        }
+        mutableState.update {
+            it.copy(
+                error = false,
+                pendingImport = DocumentImportRequest(
+                    url = parsed.toString(),
+                    name = title.ifBlank { parsed.toString() },
+                    title = title,
+                    author = author,
+                    format = document?.format,
+                    kind = kind,
+                ),
+            )
+        }
+    }
+
+    fun dismissImport() {
+        mutableState.update { it.copy(pendingImport = null) }
+    }
+
+    fun includeDocument(options: DocumentImportOptions) {
+        val request = state.value.pendingImport ?: return
+        runImport {
+            request.uri?.let { importer.fromUri(it, options) }
+                ?: importer.fromUrl(
+                    checkNotNull(request.url),
+                    request.title.ifBlank { null },
+                    request.format,
+                    request.author,
+                    options,
+                )
+        }
+    }
+
+    private fun runImport(action: suspend () -> Long) {
+        if (state.value.importing) return
+        mutableState.update { it.copy(importing = true, error = false, pendingImport = null) }
+        viewModelScope.launch(Dispatchers.IO) {
+            try {
+                val mangaId = action()
+                mutableState.update { it.copy(importing = false, importedManga = mangaId) }
+            } catch (cancelled: CancellationException) {
+                throw cancelled
+            } catch (_: Exception) {
+                mutableState.update { it.copy(importing = false, error = true) }
+            }
+        }
+    }
+
+    fun consumeImport() {
+        mutableState.update { it.copy(importedManga = null) }
+    }
+}
+
+class DocumentsScreen(private val initialUri: String? = null) : Screen() {
+    @Composable
+    override fun Content() {
+        val navigator = LocalNavigator.currentOrThrow
+        val context = LocalContext.current
+        val model = viewModel<DocumentsViewModel>()
+        val state by model.state.collectAsState()
+        val preferences =
+            remember { context.getSharedPreferences("document_search", android.content.Context.MODE_PRIVATE) }
+        var webTemplate by rememberSaveable {
+            mutableStateOf(preferences.getString("web_template", DocumentWebSearch.DEFAULT).orEmpty())
+        }
+        var query by rememberSaveable { mutableStateOf("") }
+        var link by rememberSaveable { mutableStateOf("") }
+        var kind by rememberSaveable { mutableStateOf(DocumentSearchKind.ARTICLES) }
+        var field by rememberSaveable { mutableStateOf(DocumentSearchField.ANY) }
+        var importedInitial by rememberSaveable { mutableStateOf(false) }
+        val picker = rememberLauncherForActivityResult(ActivityResultContracts.OpenDocument()) { uri ->
+            uri?.let(model::requestUri)
+        }
+        LaunchedEffect(initialUri) {
+            if (initialUri != null && !importedInitial) {
+                importedInitial = true
+                model.requestUri(Uri.parse(initialUri))
+            }
+        }
+        LaunchedEffect(state.importedManga) {
+            state.importedManga?.let { id ->
+                model.consumeImport()
+                navigator.push(MangaScreen(id, fromSource = true))
+            }
+        }
+        Scaffold(topBar = { behavior ->
+            AppBar(
+                title = stringResource(ATMR.strings.documents_title),
+                navigateUp = navigator::pop,
+                scrollBehavior = behavior,
+            )
+        }) { padding ->
+            LazyColumn(
+                contentPadding = padding,
+                modifier = Modifier.padding(horizontal = 16.dp),
+                verticalArrangement = Arrangement.spacedBy(12.dp),
+            ) {
+                item { EnglishPreparationCard() }
+                item {
+                    Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                        Text(
+                            stringResource(ATMR.strings.document_supported),
+                            style = MaterialTheme.typography.bodySmall,
+                        )
+                        Text(
+                            stringResource(ATMR.strings.document_local_selection_hint),
+                            style = MaterialTheme.typography.bodySmall,
+                        )
+                        if (state.selecting) CircularProgressIndicator()
+                        Button(
+                            onClick = { picker.launch(arrayOf("*/*")) },
+                            enabled =
+                            !state.importing && !state.selecting,
+                        ) {
+                            Text(stringResource(ATMR.strings.document_import))
+                        }
+                        OutlinedTextField(
+                            value = link,
+                            onValueChange = { link = it },
+                            singleLine = true,
+                            label = {
+                                Text(stringResource(ATMR.strings.document_link))
+                            },
+                            modifier = Modifier.fillMaxWidth(),
+                        )
+                        OutlinedButton(
+                            onClick = { model.requestUrl(link) },
+                            enabled =
+                            !state.importing && !state.selecting && link.isNotBlank(),
+                        ) {
+                            Text(stringResource(ATMR.strings.document_import_link))
+                        }
+                        if (state.importing) {
+                            CircularProgressIndicator()
+                            Text(stringResource(ATMR.strings.document_importing))
+                        }
+                        if (state.error) {
+                            Text(
+                                stringResource(ATMR.strings.document_import_error),
+                                color = MaterialTheme.colorScheme.error,
+                            )
+                        }
+                    }
+                }
+                item {
+                    Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                        Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                            FilterChip(
+                                selected = kind == DocumentSearchKind.ARTICLES,
+                                onClick = {
+                                    kind =
+                                        DocumentSearchKind.ARTICLES
+                                },
+                                label = { Text(stringResource(ATMR.strings.document_articles)) },
+                            )
+                            FilterChip(
+                                selected = kind == DocumentSearchKind.BOOKS,
+                                onClick = {
+                                    kind =
+                                        DocumentSearchKind.BOOKS
+                                },
+                                label = { Text(stringResource(ATMR.strings.document_books)) },
+                            )
+                        }
+                        androidx.compose.foundation.layout.FlowRow(horizontalArrangement = Arrangement.spacedBy(6.dp)) {
+                            DocumentSearchField.entries.forEach { option ->
+                                FilterChip(selected = field == option, onClick = { field = option }, label = {
+                                    Text(
+                                        stringResource(
+                                            when (option) {
+                                                DocumentSearchField.ANY -> ATMR.strings.document_any_field
+                                                DocumentSearchField.TITLE -> ATMR.strings.document_title_field
+                                                DocumentSearchField.AUTHOR -> ATMR.strings.document_author_field
+                                                DocumentSearchField.DOI -> ATMR.strings.document_doi_field
+                                            },
+                                        ),
+                                    )
+                                })
+                            }
+                        }
+                        OutlinedTextField(
+                            value = query,
+                            onValueChange = { query = it },
+                            singleLine = true,
+                            label = {
+                                Text(stringResource(ATMR.strings.document_query))
+                            },
+                            modifier = Modifier.fillMaxWidth(),
+                        )
+                        Button(
+                            onClick = { model.search(query, kind, field) },
+                            enabled =
+                            !state.searching && query.trim().length in 2..300,
+                        ) {
+                            Text(stringResource(ATMR.strings.document_search))
+                        }
+                        Text(
+                            stringResource(ATMR.strings.document_search_scope),
+                            style = MaterialTheme.typography.bodySmall,
+                        )
+                        OutlinedTextField(
+                            value = webTemplate,
+                            onValueChange = {
+                                webTemplate = it.take(2000)
+                                preferences.edit().putString("web_template", webTemplate).apply()
+                            },
+                            label = { Text(stringResource(ATMR.strings.document_web_template)) },
+                            supportingText = { Text(stringResource(ATMR.strings.document_web_template_hint)) },
+                            modifier = Modifier.fillMaxWidth(),
+                        )
+                        val webUrl = runCatching { DocumentWebSearch.url(webTemplate, query) }.getOrNull()
+                        OutlinedButton(onClick = {
+                            webUrl?.let { context.startActivity(WebViewActivity.newIntent(context, it)) }
+                        }, enabled = webUrl != null) { Text(stringResource(ATMR.strings.document_web_search)) }
+                        if (state.searching) CircularProgressIndicator()
+                        state.batch?.let { batch ->
+                            Text(batch.providers.joinToString(" · "), style = MaterialTheme.typography.bodySmall)
+                            if (batch.errors.isNotEmpty()) {
+                                Text(
+                                    stringResource(ATMR.strings.document_provider_error, batch.errors.joinToString()),
+                                    color = MaterialTheme.colorScheme.error,
+                                )
+                            }
+                            if (batch.hits.isEmpty() && state.searched &&
+                                !state.searching
+                            ) {
+                                Text(stringResource(ATMR.strings.document_no_results))
+                            }
+                        }
+                    }
+                }
+                items(state.batch?.hits.orEmpty(), key = { it.id }) { hit ->
+                    ElevatedCard(Modifier.fillMaxWidth()) {
+                        Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                            Text(hit.title, style = MaterialTheme.typography.titleMedium)
+                            if (hit.authors.isNotBlank()) Text(hit.authors, style = MaterialTheme.typography.bodySmall)
+                            Text(hit.provider, style = MaterialTheme.typography.labelMedium)
+                            hit.doi?.let { Text("DOI: $it", style = MaterialTheme.typography.bodySmall) }
+                            if (hit.documents.isEmpty()) {
+                                Text(
+                                    stringResource(ATMR.strings.document_no_direct_file),
+                                    style = MaterialTheme.typography.bodySmall,
+                                )
+                            }
+                            hit.documents.forEach { file ->
+                                Button(onClick = {
+                                    model.requestUrl(
+                                        file.url,
+                                        hit.title,
+                                        file,
+                                        hit.authors,
+                                        if (hit.provider == "Crossref" ||
+                                            hit.provider == "Europe PMC"
+                                        ) {
+                                            DocumentKind.ARTICLE
+                                        } else {
+                                            DocumentKind.BOOK
+                                        },
+                                    )
+                                }, enabled = !state.importing && !state.selecting) {
+                                    Text(
+                                        stringResource(
+                                            ATMR.strings.document_add_format,
+                                            file.format.extension.uppercase(),
+                                        ),
+                                    )
+                                }
+                            }
+                            hit.landing?.let { url ->
+                                TextButton(onClick = {
+                                    context.startActivity(WebViewActivity.newIntent(context, url, title = hit.title))
+                                }) { Text(stringResource(ATMR.strings.document_open_source)) }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        state.pendingImport?.let { request ->
+            DocumentImportDialog(request, state.categories, model::dismissImport, model::includeDocument)
+        }
+    }
+}
