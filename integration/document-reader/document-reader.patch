+package eu.kanade.translation.presentation
+
+import android.content.Intent
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import androidx.test.platform.app.InstrumentationRegistry
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+
+@RunWith(AndroidJUnit4::class)
+class TranslationSurfaceLayoutTest {
+    @Test fun portugueseComicTextPreservesTheDarkCaptionAtTwoZoomLevels() {
+        for (scale in listOf(1f, 2f)) {
+            val original = render("pt-caption", scale, false)
+            val translated = render("pt-caption", scale, true)
+            try {
+                var ink = 0
+                for (y in 0 until translated.height) {
+                    for (x in 0 until translated.width) {
+                        val inside = x >= 20 * scale && x < 180 * scale && y >= 40 * scale && y < 120 * scale
+                        if (!inside) {
+                            assertEquals(original.getPixel(x, y), translated.getPixel(x, y))
+                        } else if (translated.getPixel(x, y) == -1) {
+                            ink++
+                        }
+                    }
+                }
+                assertTrue("Accented Portuguese text must remain visible", ink > 10)
+            } finally {
+                original.recycle()
+                translated.recycle()
+            }
+        }
+    }
+
+    @Test fun portugueseComicTextPreservesTheWhiteBalloonContour() {
+        val original = render("pt-white", 2f, false)
+        val translated = render("pt-white", 2f, true)
+        try {
+            for (y in 0 until translated.height) {
+                for (x in 0 until translated.width) {
+                    val dx = (x - 200f) / 160f
+                    val dy = (y - 170f) / 120f
+                    if (dx * dx + dy * dy > 1.04f) assertEquals(original.getPixel(x, y), translated.getPixel(x, y))
+                }
+            }
+        } finally {
+            original.recycle()
+            translated.recycle()
+        }
+    }
+
+    @Test fun darkCaptionTextAndCleanupStayInsideThePanelAtTwoZoomLevels() {
+        for (scale in listOf(1f, 2f)) {
+            val original = render("caption", scale, false)
+            val translated = render("caption", scale, true)
+            var white = 0
+            for (y in 0 until translated.height) {
+                for (x in 0 until translated.width) {
+                    val inside = x >= 20 * scale && x < 180 * scale && y >= 40 * scale && y < 120 * scale
+                    if (!inside) {
+                        assertEquals(
+                            "Outside caption at $x,$y scale=$scale",
+                            original.getPixel(x, y),
+                            translated.getPixel(x, y),
+                        )
+                    } else if (translated.getPixel(x, y) == -1) {
+                        white++
+                    }
+                }
+            }
+            assertTrue("Translation must remain visible", white > 10)
+            original.recycle()
+            translated.recycle()
+        }
+    }
+
+    @Test fun whiteBalloonContourAndArtworkRemainUntouched() {
+        val original = render("white", 1f, false)
+        val translated = render("white", 1f, true)
+        for (y in 0 until translated.height) {
+            for (x in 0 until translated.width) {
+                val dx = (x - 100f) / 80f
+                val dy = (y - 85f) / 60f
+                if (dx * dx + dy * dy >
+                    1.04f
+                ) {
+                    assertEquals("Outside balloon at $x,$y", original.getPixel(x, y), translated.getPixel(x, y))
+                }
+            }
+        }
+        original.recycle()
+        translated.recycle()
+    }
+
+    @Test fun legacyCleanupDoesNotAddPaddingOutsideItsMeasuredBounds() {
+        for (scale in listOf(1f, 2f)) {
+            val image = render("patch", scale, true)
+            assertEquals(
+                TranslationSurfaceTestActivity.ART,
+                image.getPixel((10 * scale).toInt() - 1, (11 * scale).toInt()),
+            )
+            assertEquals(-1, image.getPixel((11 * scale).toInt(), (11 * scale).toInt()))
+            assertEquals(TranslationSurfaceTestActivity.ART, image.getPixel((14 * scale).toInt(), (11 * scale).toInt()))
+            image.recycle()
+        }
+    }
+
+    @Test fun mixedSizeTitleTranslationsHaveSeparateRenderedWritingAreas() {
+        val image = render("titles", 1f, true)
+        var red = 0
+        var blue = 0
+        for (y in 0 until image.height) {
+            for (x in 0 until image.width) {
+                val color = image.getPixel(x, y)
+                if (color ==
+                    TranslationSurfaceTestActivity.RED
+                ) {
+                    assertTrue("Red title crossed its separator", y < 77.5f)
+                    red++
+                }
+                if (color ==
+                    TranslationSurfaceTestActivity.BLUE
+                ) {
+                    assertTrue("Blue title crossed its separator", y >= 77.5f)
+                    blue++
+                }
+            }
+        }
+        assertTrue(red > 10)
+        assertTrue(blue > 10)
+        image.recycle()
+    }
+
+    private fun render(scene: String, scale: Float, overlays: Boolean): Bitmap {
+        val instrumentation = InstrumentationRegistry.getInstrumentation()
+        val intent = Intent(instrumentation.targetContext, TranslationSurfaceTestActivity::class.java).apply {
+            putExtra("scene", scene)
+            putExtra("scale", scale)
+            putExtra("overlays", overlays)
+            addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+        }
+        val activity = instrumentation.startActivitySync(intent) as TranslationSurfaceTestActivity
+        try {
+            instrumentation.waitForIdleSync()
+            lateinit var result: Bitmap
+            instrumentation.runOnMainSync {
+                assertEquals(TranslationSurfaceTestActivity.VIEWPORT_SIZE, activity.composeView.width)
+                result =
+                    Bitmap.createBitmap(
+                        activity.composeView.width,
+                        activity.composeView.height,
+                        Bitmap.Config.ARGB_8888,
+                    )
+                activity.composeView.draw(Canvas(result))
+            }
+            val folder = instrumentation.targetContext.getExternalFilesDir("caption-layout-checks")!!
+            java.io.File(folder, "$scene-$scale-$overlays.png").outputStream().use {
+                result.compress(Bitmap.CompressFormat.PNG, 100, it)
+            }
+            return result
+        } finally {
+            instrumentation.runOnMainSync(activity::finish)
+            instrumentation.waitForIdleSync()
+        }
+    }
+}
