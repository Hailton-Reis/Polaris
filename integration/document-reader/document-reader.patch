+package eu.kanade.tachiyomi.data.profile
+
+import org.junit.jupiter.api.Assertions.*
+import org.junit.jupiter.api.Test
+import tachiyomi.domain.chapter.model.Chapter
+
+class PolarisLevelManagerTest {
+    @Test
+    fun `merged editions count once and unknown chapters retain their own identity`() {
+        val chapters =
+            listOf(
+                Chapter.create()
+                    .copy(id = 1, url = "/en/1", name = "Chapter 1 official", read = true),
+                Chapter.create()
+                    .copy(id = 2, url = "/pt/1", name = "Capítulo 1 unofficial", read = true),
+                Chapter.create().copy(id = 3, url = "/one", name = "Introduction", read = true),
+                Chapter.create().copy(id = 4, url = "/two", name = "Unknown", read = true),
+            )
+        assertEquals(3L, PolarisLevelManager.logicalReadCount(chapters))
+    }
+
+    @Test
+    fun `unknown URLs shared by legacy merged children remain distinct`() {
+        val chapters =
+            listOf(
+                Chapter.create()
+                    .copy(id = 1, mangaId = 4, url = "/intro", name = "Intro", read = true),
+                Chapter.create()
+                    .copy(id = 2, mangaId = 5, url = "/intro", name = "Intro", read = true),
+            )
+        assertEquals(2L, PolarisLevelManager.logicalReadCount(chapters))
+    }
+
+    @Test
+    fun `a fresh install never gets download XP before its first reading`() {
+        assertEquals(0L, PolarisLevelManager.start(0, 0, 200, preserveLegacy = false).xp)
+        assertEquals(450L, PolarisLevelManager.start(5, 10, 200, preserveLegacy = false).xp)
+        assertEquals(18900L, PolarisLevelManager.start(5, 10, 200, preserveLegacy = true).xp)
+    }
+
+    @Test
+    fun `legacy XP survives migration but later downloads do not enter progression`() {
+        val initial = PolarisLevelManager.initialProgress(5, 10, 20)
+        assertEquals(2700L, initial.xp)
+        assertEquals(initial, PolarisLevelManager.advance(initial, 5))
+        val next = PolarisLevelManager.advance(initial, 6)
+        assertEquals(2790L, next.xp)
+        assertEquals(next, PolarisLevelManager.advance(next, 2))
+        assertEquals(next, PolarisLevelManager.advance(next, 6))
+    }
+
+    @Test
+    fun `titles use stable identifiers and legacy names cannot equip locked titles`() {
+        assertEquals("level_120", PolarisLevelManager.equippedTitle("Caçador Rank S", 120).id)
+        assertEquals("level_10", PolarisLevelManager.equippedTitle("Caçador Rank S", 10).id)
+        assertEquals("level_20", PolarisLevelManager.equippedTitle("level_20", 40).id)
+    }
+
+    @Test
+    fun `extreme imported counts remain finite and maximum level is two hundred`() {
+        val max =
+            PolarisLevelManager.initialProgress(Long.MAX_VALUE, Long.MAX_VALUE, Long.MAX_VALUE)
+        assertEquals(PolarisLevelManager.MAX_XP, max.xp)
+        assertEquals(200, PolarisLevelManager.calculateLevelFromXp(max.xp))
+        assertEquals(0L, PolarisLevelManager.advance(ProfileProgress(-1, -2), -3).xp)
+        assertEquals(
+            PolarisLevelManager.getXpRequiredForLevel(200),
+            PolarisLevelManager.getXpRequiredForLevel(201),
+        )
+    }
+}
diff --git a/app/src/test/java/eu/kanade/tachiyomi/data/profile/ProfileAchievementsTest.kt b/app/src/test/java/eu/kanade/tachiyomi/data/profile/ProfileAchievementsTest.kt
