+package eu.kanade.tachiyomi.data.updater
+
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.test.runTest
+import kotlinx.serialization.json.Json
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.assertThrows
+import tachiyomi.domain.release.interactor.GetApplicationRelease
+import java.io.IOException
+
+class PolarisUpdateClientTest {
+    private val prefix = "$POLARIS_REPOSITORY_URL/releases/download/v0.2.0/"
+    private val apk = PolarisGithubAsset("Polaris-arm64-v8a.apk", prefix + "Polaris-arm64-v8a.apk", 123)
+    private val metadata = PolarisGithubAsset("manifest.json", prefix + "manifest.json")
+    private val manifest = PolarisUpdateManifest(
+        "0.2.0",
+        200,
+        26,
+        "polaris.dev",
+        listOf(
+            PolarisUpdateArtifact("arm64-v8a", apk.name, apk.size, "a".repeat(64)),
+        ),
+    )
+    private fun release(tag: String = "v0.2.0") = PolarisGithubRelease(
+        tag,
+        "$POLARIS_REPOSITORY_URL/releases/tag/$tag",
+        "Release notes",
+        assets = listOf(metadata, apk),
+    )
+    private suspend fun check(
+        releases: List<PolarisGithubRelease> = listOf(release()),
+        metadata: PolarisUpdateManifest = manifest,
+        experimental: Boolean = false,
+        abis: List<String> = listOf("arm64-v8a", "armeabi-v7a"),
+        api: Int = 26,
+        fetch: (suspend (Int) -> PolarisReleasePage)? = null,
+        load: (suspend (String) -> PolarisUpdateManifest)? = null,
+    ) = PolarisUpdateClient(
+        fetch ?: { PolarisReleasePage(releases, false) },
+        load ?: { metadata },
+    ).check("0.1.0-beta.3", 104, "polaris.dev", abis, api, experimental)
+
+    @Test
+    fun `default channel ignores drafts and prereleases even when tag is mislabeled`() = runTest {
+        val stable = release()
+        val candidate = release("v9.0.0").copy(draft = true)
+        val beta = release("v1.0.0-beta.1")
+        val marked = release("v2.0.0").copy(prerelease = true)
+        val result = check(listOf(candidate, beta, marked, stable)) as GetApplicationRelease.Result.NewUpdate
+        assertEquals(stable.tag, result.release.version)
+        assertEquals("a".repeat(64), result.release.sha256)
+        assertEquals("Release notes", result.release.info)
+    }
+
+    @Test
+    fun `beta channel is opt in and numeric beta ten is newer than beta two`() = runTest {
+        val result = check(
+            listOf(release("v0.2.0-beta.2"), release("v0.2.0-beta.10")),
+            manifest.copy(version = "0.2.0-beta.10"),
+            experimental = true,
+        ) as GetApplicationRelease.Result.NewUpdate
+        assertEquals("v0.2.0-beta.10", result.release.version)
+        assertEquals(GetApplicationRelease.Result.NoNewUpdate, check(listOf(release("v0.2.0-beta.10"))))
+    }
+
+    @Test
+    fun `stable of the current beta can be offered when its build code is newer`() = runTest {
+        val result = check(listOf(release("v0.1.0")), manifest.copy(version = "0.1.0"))
+        assertTrue(result is GetApplicationRelease.Result.NewUpdate)
+    }
+
+    @Test
+    fun `old versions and non increasing build codes never trigger downgrade`() = runTest {
+        assertEquals(GetApplicationRelease.Result.NoNewUpdate, check(listOf(release("v0.0.9"))))
+        assertEquals(GetApplicationRelease.Result.NoNewUpdate, check(metadata = manifest.copy(versionCode = 104)))
+        assertEquals(GetApplicationRelease.Result.NoNewUpdate, check(metadata = manifest.copy(versionCode = 100)))
+    }
+
+    @Test
+    fun `package identity and matching manifest version are required`() = runTest {
+        assertEquals(
+            GetApplicationRelease.Result.NoNewUpdate,
+            check(metadata = manifest.copy(applicationId = "other.app")),
+        )
+        assertEquals(GetApplicationRelease.Result.NoNewUpdate, check(metadata = manifest.copy(version = "0.3.0")))
+        assertEquals(GetApplicationRelease.Result.NoNewUpdate, check(listOf(release().copy(assets = listOf(apk)))))
+    }
+
+    @Test
+    fun `device ABI order selects a compatible published APK`() = runTest {
+        val arm32 = apk.copy(name = "Polaris-armeabi-v7a.apk", url = prefix + "Polaris-armeabi-v7a.apk")
+        val data = manifest.copy(
+            artifacts = manifest.artifacts + manifest.artifacts.first().copy(
+                abi = "armeabi-v7a",
+                file = arm32.name,
+            ),
+        )
+        val releases = listOf(release().copy(assets = listOf(metadata, arm32, apk)))
+        val preferred = check(releases, data) as GetApplicationRelease.Result.NewUpdate
+        assertEquals(apk.url, preferred.release.downloadLink)
+        val fallback = check(releases, data, abis = listOf("armeabi-v7a")) as GetApplicationRelease.Result.NewUpdate
+        assertEquals(arm32.url, fallback.release.downloadLink)
+        assertEquals(GetApplicationRelease.Result.NoNewUpdate, check(releases, data, abis = listOf("x86")))
+    }
+
+    @Test
+    fun `unsupported Android is distinguished from no update`() = runTest {
+        assertEquals(GetApplicationRelease.Result.OsTooOld, check(metadata = manifest.copy(minimumAndroidApi = 35)))
+    }
+
+    @Test
+    fun `newest unsupported release does not hide an older compatible update`() = runTest {
+        val newest = release("v0.3.0").copy(assets = listOf(metadata.copy(url = prefix + "new-manifest.json"), apk))
+        val result = check(listOf(newest, release()), load = {
+            if (it.endsWith("new-manifest.json")) manifest.copy(version = "0.3.0", minimumAndroidApi = 35) else manifest
+        }) as GetApplicationRelease.Result.NewUpdate
+        assertEquals("v0.2.0", result.release.version)
+    }
+
+    @Test
+    fun `unsafe APK assets and invalid checksums cannot be offered`() = runTest {
+        for (artifact in listOf(
+            manifest.artifacts.first().copy(sha256 = "bad"),
+            manifest.artifacts.first().copy(file = "../bad.apk"),
+            manifest.artifacts.first().copy(bytes = 999),
+        )) {
+            assertEquals(
+                GetApplicationRelease.Result.NoNewUpdate,
+                check(metadata = manifest.copy(artifacts = listOf(artifact))),
+            )
+        }
+        val external = release().copy(assets = listOf(metadata, apk.copy(url = "https://example.com/file.apk")))
+        assertEquals(GetApplicationRelease.Result.NoNewUpdate, check(listOf(external)))
+    }
+
+    @Test
+    fun `all pages are inspected instead of trusting GitHub listing order`() = runTest {
+        val pages = mutableListOf<Int>()
+        val result = check(fetch = { page ->
+            pages += page
+            if (page == 1) {
+                PolarisReleasePage(listOf(release("v0.0.1")), true)
+            } else {
+                PolarisReleasePage(listOf(release()), false)
+            }
+        })
+        assertEquals(listOf(1, 2), pages)
+        assertTrue(result is GetApplicationRelease.Result.NewUpdate)
+    }
+
+    @Test
+    fun `network failures and cancellation are not presented as no update`() = runTest {
+        assertThrows<IOException> { check(fetch = { throw IOException("offline") }) }
+        assertThrows<CancellationException> { check(load = { throw CancellationException() }) }
+    }
+
+    @Test
+    fun `real manifest shape ignores extra packaging fields and nullable release notes`() = runTest {
+        val json = Json { ignoreUnknownKeys = true }
+        val parsed = json.decodeFromString<PolarisUpdateManifest>(
+            """{
+            "version":"0.2.0","version_code":200,"minimum_android_api":26,"application_id":"polaris.dev",
+            "artifacts":[{"abi":"arm64-v8a","file":"Polaris-arm64-v8a.apk","bytes":123,"sha256":"${"a".repeat(64)}"}],
+            "physical_device_acceptance":"PENDING","unit_comparison":{}
+        }""",
+        )
+        assertTrue(check(metadata = parsed) is GetApplicationRelease.Result.NewUpdate)
+        assertEquals(GetApplicationRelease.Result.NoNewUpdate, check(listOf(release("invalid"))))
+    }
+}
