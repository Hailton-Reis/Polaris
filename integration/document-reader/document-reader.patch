+package eu.kanade.tachiyomi.data.backup.models
+
+import java.util.Base64
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.jsonPrimitive
+import kotlinx.serialization.protobuf.ProtoBuf
+import tachiyomi.data.MemoColumnAdapter
+import tachiyomi.domain.chapter.model.ChapterOrigin
+import tachiyomi.domain.chapter.model.ChapterVersions
+import tachiyomi.domain.manga.model.WorkSources
+
+/** Native source/URLs for other readers; optional memo preserves all Polaris editions locally. */
+internal object PortableMangaBackup {
+    private const val KEY = "polaris.backup.work.v1"
+    private const val MAX_SNAPSHOT = 16 * 1024 * 1024
+    private val codec = ProtoBuf
+
+    @Serializable
+    private data class Envelope(val source: Long, val url: String, val original: BackupManga)
+
+    private fun origin(chapter: BackupChapter) =
+        ChapterOrigin.from(MemoColumnAdapter.decode(chapter.memo))
+
+    private fun key(chapter: BackupChapter) = ChapterVersions.key(chapter.toChapterImpl())
+
+    private fun copy(manga: BackupManga): BackupManga =
+        codec.decodeFromByteArray(
+            BackupManga.serializer(),
+            codec.encodeToByteArray(BackupManga.serializer(), manga),
+        )
+
+    fun export(original: BackupManga): BackupManga {
+        require(KEY !in MemoColumnAdapter.decode(original.memo)) {
+            "Backup work is already projected"
+        }
+        if (
+            original.chapters.none { ChapterOrigin.isRouted(it.url) } &&
+                original.history.none { ChapterOrigin.isRouted(it.url) }
+        )
+            return original
+        val settings = WorkSources.from(MemoColumnAdapter.decode(original.memo))
+        val grouped = original.chapters.groupBy { origin(it)?.sourceId ?: original.source }
+        val choices =
+            settings.candidates.filter { binding ->
+                grouped[binding.sourceId].orEmpty().any {
+                    val o = origin(it)
+                    (o == null && binding.url == original.url) || o?.mangaUrl == binding.url
+                } && (settings.pinned == null || settings.pinned?.key == binding.key)
+            }
+        val versions = original.chapters.groupBy(::key)
+        fun covered(binding: tachiyomi.domain.manga.model.WorkSource) =
+            grouped[binding.sourceId]
+                .orEmpty()
+                .filter { chapter ->
+                    val o = origin(chapter)
+                    o?.mangaUrl == binding.url || (o == null && binding.url == original.url)
+                }
+                .map(::key)
+                .toSet()
+        val primary =
+            choices
+                .sortedWith(
+                    compareBy<tachiyomi.domain.manga.model.WorkSource> { !it.available }
+                        .thenBy {
+                            when (it.readability) {
+                                "sample_failed" -> 1
+                                else -> 0
+                            }
+                        }
+                        // A single-source reader cannot represent the union. Prefer coverage of
+                        // reading progress, then total coverage, before its language preference.
+                        .thenByDescending { binding ->
+                            covered(binding).count { logical ->
+                                versions[logical].orEmpty().any { it.read || it.lastPageRead > 0 }
+                            }
+                        }
+                        .thenByDescending { covered(it).size }
+                        .thenBy {
+                            when (it.language) {
+                                "pt-BR" -> 0
+                                "pt" -> 1
+                                "en" -> 2
+                                else -> 3
+                            }
+                        }
+                        .thenByDescending { it.chapters }
+                        .thenBy { it.key }
+                )
+                .firstOrNull()
