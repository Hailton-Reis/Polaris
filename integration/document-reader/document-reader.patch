+import tachiyomi.presentation.core.i18n.stringResource
+import uy.kohesive.injekt.Injekt
+import uy.kohesive.injekt.api.get
+import kotlin.coroutines.cancellation.CancellationException
+
+class PolarisStorageScreen : Screen() {
+    @Composable override fun Content() {
+        val navigator = LocalNavigator.currentOrThrow
+        val context = LocalContext.current
+        val scope = rememberCoroutineScope()
+        var refresh by remember { mutableStateOf(0) }
+        var data by remember { mutableStateOf<PolarisStorageSnapshot?>(null) }
+        var models by remember { mutableStateOf<String?>(null) }
+        var loading by remember { mutableStateOf(true) }
+        var failed by remember { mutableStateOf(false) }
+        var clearing by remember { mutableStateOf(false) }
+        LaunchedEffect(refresh) {
+            loading = true
+            failed = false
+            try {
+                data =
+                    withContext(Dispatchers.IO) {
+                        PolarisStorageUsage(context, Injekt.get<StorageManager>()).snapshot()
+                    }
+                models = runCatching {
+                    RemoteModelManager.getInstance().getDownloadedModels(TranslateRemoteModel::class.java).await()
+                        .map { it.language }.sorted().joinToString(", ").ifBlank { "—" }
+                }.getOrNull()
+            } catch (error: CancellationException) {
+                throw error
+            } catch (_: Exception) {
+                failed = true
+            } finally {
+                loading = false
+            }
+        }
+        Scaffold(topBar = { behavior ->
+            AppBar(
+                title = stringResource(ATMR.strings.storage_polaris_title),
+                navigateUp = navigator::pop,
+                scrollBehavior = behavior,
+            )
+        }) { padding ->
+            LazyColumn(
+                contentPadding = padding,
+                modifier = Modifier.padding(horizontal = 20.dp),
+                verticalArrangement = Arrangement.spacedBy(14.dp),
+            ) {
+                item {
+                    if (loading) CircularProgressIndicator()
+                    if (failed) Text(stringResource(ATMR.strings.storage_measure_failed))
+                    OutlinedButton(onClick = { refresh++ }, enabled = !loading && !clearing) {
+                        Text(stringResource(ATMR.strings.storage_refresh))
+                    }
+                }
+                data?.let { value ->
+                    item { SizeRow(stringResource(ATMR.strings.storage_original_downloads), value.downloads) }
+                    item { SizeRow(stringResource(ATMR.strings.storage_imported_copies), value.imports) }
+                    item { SizeRow(stringResource(ATMR.strings.storage_saved_translations), value.translations) }
+                    item {
+                        SizeRow(stringResource(ATMR.strings.storage_document_cache), StorageBytes(value.documentCache))
+                    }
+                    item { SizeRow(stringResource(ATMR.strings.storage_other_cache), value.otherCache) }
+                    item { SizeRow(stringResource(ATMR.strings.storage_internal_data), value.internal) }
+                    item { SizeRow(stringResource(ATMR.strings.storage_apks), StorageBytes(value.apks)) }
+                    item { SizeRow(stringResource(ATMR.strings.storage_native_libraries), value.nativeLibraries) }
+                }
+                item {
+                    Text(
+                        stringResource(
+                            ATMR.strings.storage_models,
+                            models ?: stringResource(ATMR.strings.storage_unknown),
+                        ),
+                    )
+                    Text(stringResource(ATMR.strings.storage_budget_note), style = MaterialTheme.typography.bodySmall)
+                    Button(onClick = {
+                        scope.launch {
+                            clearing = true
+                            try {
+                                withContext(Dispatchers.IO) { DocumentCacheBudget.trim(context.cacheDir, 0) }
+                                refresh++
+                            } catch (error: CancellationException) {
+                                throw error
+                            } catch (_: Exception) {
+                                failed = true
+                            } finally {
+                                clearing = false
+                            }
+                        }
+                    }, enabled = !clearing) { Text(stringResource(ATMR.strings.storage_clear_documents)) }
+                    Text(stringResource(ATMR.strings.storage_delete_policy), style = MaterialTheme.typography.bodySmall)
+                    Text(stringResource(ATMR.strings.storage_measure_note), style = MaterialTheme.typography.bodySmall)
+                }
+            }
+        }
+    }
+
+    @Composable private fun SizeRow(label: String, size: StorageBytes?) {
+        val context = LocalContext.current
+        Column {
+            Text(label, style = MaterialTheme.typography.titleSmall)
+            Text(
+                if (size == null) {
+                    stringResource(ATMR.strings.storage_unknown)
+                } else {
+                    Formatter.formatFileSize(context, size.bytes) + if (size.partial) " +" else ""
+                },
+            )
+        }
+    }
+}
