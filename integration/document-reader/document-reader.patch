+                            )
+                        }
+                    } finally {
+                        image.recycle()
+                    }
+                }
+                awaitState(true)
+                capture("isolated-settings.png")
+                val point = IntArray(2)
+                scenario.onActivity { activity ->
+                    val owner =
+                        activity.supportFragmentManager.fragments
+                            .filterIsInstance<PreferenceFragmentCompat>()
+                            .single()
+                    val control =
+                        requireNotNull(
+                            owner.listView.findViewById<android.widget.CompoundButton>(
+                                androidx.preference.R.id.switchWidget
+                            )
+                        )
+                    control.getLocationOnScreen(point)
+                    point[0] += control.width / 2
+                    point[1] += control.height / 2
+                }
+                val downTime = android.os.SystemClock.uptimeMillis()
+                fun touch(action: Int) {
+                    val event =
+                        android.view.MotionEvent.obtain(
+                            downTime,
+                            android.os.SystemClock.uptimeMillis(),
+                            action,
+                            point[0].toFloat(),
+                            point[1].toFloat(),
+                            0,
+                        )
+                    event.source = android.view.InputDevice.SOURCE_TOUCHSCREEN
+                    try {
+                        instrumentation.sendPointerSync(event)
+                    } finally {
+                        event.recycle()
+                    }
+                }
+                touch(android.view.MotionEvent.ACTION_DOWN)
+                android.os.SystemClock.sleep(50)
+                touch(android.view.MotionEvent.ACTION_UP)
+                awaitState(false)
+                assertFalse(source.getSourcePreferences().getBoolean("enabled", true))
+                capture("isolated-settings-disabled.png")
+            }
+        }
