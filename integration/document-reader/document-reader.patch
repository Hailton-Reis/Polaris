+package eu.kanade.tachiyomi.extension.preparation
+
+import eu.kanade.tachiyomi.extension.model.Extension
+import java.util.concurrent.atomic.AtomicInteger
+import kotlin.coroutines.coroutineContext
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.CoroutineStart
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.TimeoutCancellationException
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withTimeout
+
+enum class PreparationStatus {
+    QUEUED,
+    DOWNLOADING,
+    INSTALLING,
+    READY,
+    NEEDS_TRUST,
+    FAILED,
+    CANCELLED;
+
+    val terminal
+        get() = this in setOf(READY, NEEDS_TRUST, FAILED, CANCELLED)
+}
+
+data class PreparationEntry(
+    val extension: Extension.Available,
+    val status: PreparationStatus = PreparationStatus.QUEUED,
+)
+
+data class PreparationBatch(
+    val running: Boolean = false,
+    val entries: List<PreparationEntry> = emptyList(),
+)
+
+/**
+ * App-lifetime queue, two workers at most. Nothing starts merely by observing it or restoring a
+ * backup.
+ */
+class ExtensionPreparationQueue(
+    private val scope: CoroutineScope,
+    private val isAuthorized: suspend (RepositoryIdentity) -> Boolean,
+    private val install:
+        suspend (Extension.Available, (PreparationStatus) -> Unit) -> PreparationStatus,
+    private val timeoutMillis: Long = 180_000,
+    private val onComplete: (PreparationBatch) -> Unit = {},
+) {
+    private val mutableState = MutableStateFlow(PreparationBatch())
+    val state = mutableState.asStateFlow()
+    private var job: Job? = null
+
+    @Synchronized
+    fun start(extensions: List<Extension.Available>, consent: Boolean): Boolean {
+        if (!consent || job?.isCompleted == false || extensions.isEmpty()) return false
+        if (extensions.map { it.pkgName }.distinct().size != extensions.size) return false
+        if (
+            extensions.any {
+                !RepositoryIdentity.of(it.store).canVerify || !RepositoryIdentity.isHttps(it.apkUrl)
+            }
+        ) {
+            return false
+        }
+        launchBatch(extensions.map(::PreparationEntry))
+        return true
+    }
+
+    @Synchronized
+    fun retryFailures(consent: Boolean): Boolean {
+        if (!consent || job?.isCompleted == false) return false
+        val entries = state.value.entries
+        if (
+            entries.none {
+                it.status in setOf(PreparationStatus.FAILED, PreparationStatus.CANCELLED)
+            }
+        ) {
+            return false
+        }
+        launchBatch(
+            entries.map {
+                if (it.status in setOf(PreparationStatus.FAILED, PreparationStatus.CANCELLED)) {
+                    it.copy(status = PreparationStatus.QUEUED)
+                } else {
+                    it
+                }
+            }
+        )
+        return true
+    }
+
+    @Synchronized
+    fun cancel() {
+        job?.cancel()
+    }
+
+    @Synchronized
+    fun clear() {
+        if (job?.isCompleted != false) mutableState.value = PreparationBatch()
+    }
+
+    private fun launchBatch(entries: List<PreparationEntry>) {
+        val pending = entries.filter { !it.status.terminal }
+        val cursor = AtomicInteger()
+        val next =
+            scope.launch(start = CoroutineStart.LAZY) {
+                coroutineScope {
+                    repeat(minOf(2, pending.size)) {
+                        launch {
+                            while (true) {
+                                coroutineContext.ensureActive()
+                                val entry = pending.getOrNull(cursor.getAndIncrement()) ?: break
+                                val extension = entry.extension
+                                try {
+                                    val result =
+                                        withTimeout(timeoutMillis) {
+                                            check(
+                                                isAuthorized(RepositoryIdentity.of(extension.store))
+                                            )
+                                            install(extension) { status ->
+                                                require(
+                                                    status == PreparationStatus.DOWNLOADING ||
+                                                        status == PreparationStatus.INSTALLING
+                                                )
+                                                update(extension.pkgName, status)
+                                            }
+                                        }
+                                    update(
+                                        extension.pkgName,
+                                        when (result) {
+                                            PreparationStatus.READY,
+                                            PreparationStatus.NEEDS_TRUST -> result
+                                            else -> PreparationStatus.FAILED
+                                        },
+                                    )
+                                } catch (_: TimeoutCancellationException) {
+                                    coroutineContext.ensureActive()
+                                    update(extension.pkgName, PreparationStatus.FAILED)
+                                } catch (error: CancellationException) {
+                                    throw error
+                                } catch (_: Exception) {
+                                    update(extension.pkgName, PreparationStatus.FAILED)
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        job = next
+        mutableState.value = PreparationBatch(running = true, entries = entries)
+        next.invokeOnCompletion {
+            synchronized(this@ExtensionPreparationQueue) {
+                if (job === next) {
+                    mutableState.update { batch ->
+                        batch.copy(
+                            running = false,
+                            entries =
+                                batch.entries.map {
+                                    if (!it.status.terminal) {
+                                        it.copy(status = PreparationStatus.CANCELLED)
+                                    } else {
+                                        it
+                                    }
+                                },
+                        )
+                    }
+                    runCatching { onComplete(mutableState.value) }
+                }
+            }
+        }
+        next.start()
+    }
+
+    private fun update(pkg: String, status: PreparationStatus) {
+        mutableState.update { batch ->
+            batch.copy(
+                entries =
+                    batch.entries.map {
+                        if (it.extension.pkgName == pkg) it.copy(status = status) else it
+                    }
+            )
+        }
+    }
+}
