+package eu.kanade.tachiyomi.source.selection
+
+import kotlinx.serialization.json.*
+import org.junit.jupiter.api.Assertions.*
+import org.junit.jupiter.api.Test
+import tachiyomi.domain.manga.model.*
+
+class WorkSearchGroupingTest {
+    private val identity =
+        WorkIdentity(
+            "mangadex:ade0306c-f4b6-4890-9edb-1ddf04df2039",
+            listOf("Solo Leveling Ragnarok", "Upando Sozinho Ragnarok", "나 혼자만 레벨업 라그나로크"),
+            listOf("DAUL"),
+            1,
+        )
+
+    private fun hit(
+        source: Long,
+        title: String = "Solo Leveling Ragnarok",
+        author: String? = "DAUL",
+        language: String = "en",
+        favorite: Boolean = false,
+        url: String = "/work",
+    ) =
+        WorkSearchHit(
+            Manga.create()
+                .copy(
+                    id = source,
+                    source = source,
+                    url = url,
+                    title = title,
+                    author = author,
+                    favorite = favorite,
+                ),
+            "Source $source",
+            language,
+        )
+
+    @Test
+    fun `confirmed aliases yield one card and prefer Brazilian Portuguese for new work`() {
+        val pt = hit(3, "Upando Sozinho Ragnarok", language = "pt-BR")
+        val en = hit(1)
+        val ko = hit(2, "나 혼자만 레벨업 라그나로크", language = "ko")
+        val group =
+            WorkSearchGrouping.group(listOf(en, ko, pt), identities = listOf(identity)).single()
+        assertEquals(pt.manga, group.representative)
+        assertEquals(3, group.editions.size)
+    }
+
+    @Test
+    fun `a novel local document or unknown medium is not reused as the comic favorite`() {
+        val unknown = hit(99, favorite = true).copy(isComic = false)
+        val group =
+            WorkSearchGrouping.group(listOf(hit(1)), listOf(unknown), listOf(identity)).single()
+        assertEquals(1L, group.representative.id)
+        assertEquals(1, group.editions.size)
+    }
+
+    @Test
+    fun `translation names alone are not guessed`() {
+        assertEquals(
+            2,
+            WorkSearchGrouping.group(listOf(hit(1), hit(2, "Upando Sozinho Ragnarok"))).size,
+        )
+    }
+
+    @Test
+    fun `unknown and generic creators cannot collapse homonymous titles`() {
+        for (creator in listOf(null, "Unknown", "N/A", "Artist", "Various")) assertEquals(
+            2,
+            WorkSearchGrouping.group(listOf(hit(1, author = creator), hit(2, author = creator)))
+                .size,
+        )
+    }
+
+    @Test
+    fun `different known creators retain separate homonyms`() {
+        assertEquals(
+            2,
+            WorkSearchGrouping.group(listOf(hit(1), hit(2, author = "Someone Else"))).size,
+        )
+    }
+
+    @Test
+    fun `sequels parts and novel qualifiers remain distinct`() {
+        for (name in
+            listOf(
+                "Solo Leveling",
+                "Solo Leveling Ragnarok 2",
+                "Solo Leveling Ragnarok Part 2",
+                "Solo Leveling Ragnarok (Novel)",
+            )) assertEquals(
+            2,
+            WorkSearchGrouping.group(listOf(hit(1), hit(2, name)), identities = listOf(identity))
+                .size,
+        )
+    }
+
+    @Test
+    fun `global grouping rejects fuzzy spelling matches`() {
+        assertEquals(
+            2,
+            WorkSearchGrouping.group(listOf(hit(1), hit(2, "Solo Levelling Ragnarok"))).size,
+        )
+    }
+
+    @Test
+    fun `distinct URLs inside one provider need catalogue corroboration`() {
+        val a = hit(1)
+        val b = hit(1, url = "/remake")
+        assertEquals(2, WorkSearchGrouping.group(listOf(a, b)).size)
+        assertEquals(1, WorkSearchGrouping.group(listOf(a, b), identities = listOf(identity)).size)
+    }
+
+    @Test
+    fun `conflicting catalogue identities are ambiguous even with matching creator`() {
+        val other = identity.copy(catalogId = "mangadex:00000000-0000-0000-0000-000000000001")
+        assertEquals(
+            2,
+            WorkSearchGrouping.group(listOf(hit(1), hit(2)), identities = listOf(identity, other))
+                .size,
+        )
+    }
+
+    @Test
+    fun `a multi author bridge cannot transitively merge unrelated works`() {
+        val a = hit(1, author = "Alice")
+        val bridge = hit(2, author = "Alice, Bob")
+        val b = hit(3, author = "Bob")
+        val groups = WorkSearchGrouping.group(listOf(a, bridge, b))
+        assertEquals(2, groups.size)
+        assertEquals(listOf(1, 2), groups.map { it.editions.size }.sorted())
+    }
+
+    @Test
+    fun `an ambiguous saved bridge cannot hide two separate result cards`() {
+        val a = hit(1, author = "Alice")
+        val b = hit(2, author = "Bob")
+        val bridge = hit(99, author = "Alice, Bob", favorite = true)
+        val groups = WorkSearchGrouping.group(listOf(a, b), favorites = listOf(bridge))
+        assertEquals(2, groups.size)
+        assertFalse(groups.any { it.representative.id == 99L })
+    }
+
+    @Test
+    fun `a restored favorite remains the original entry even when source is missing`() {
+        val memo = buildJsonObject { put("private-annotation", "keep") }
+        val restored =
+            hit(99, "Upando Sozinho Ragnarok", language = "pt-BR", favorite = true).let {
+                it.copy(manga = it.manga.copy(chapterFlags = 123, memo = memo, notes = "keep note"))
+            }
+        val result =
+            WorkSearchGrouping.group(listOf(hit(1)), listOf(restored), listOf(identity)).single()
+        assertEquals(restored.manga, result.representative)
+        assertEquals(2, result.editions.size)
+    }
+
+    @Test
+    fun `an exact source URL is the same saved record without creator metadata`() {
+        val remote = hit(1, author = null)
+        val favorite = remote.copy(manga = remote.manga.copy(favorite = true))
+        assertEquals(
+            favorite.manga,
+            WorkSearchGrouping.group(listOf(remote, remote), listOf(favorite))
+                .single()
+                .representative,
+        )
+    }
+
+    @Test
+    fun `existing pinned favorite wins over language and older unpinned favorite`() {
+        val pt = hit(2, language = "pt-BR", favorite = true)
+        val en =
+            hit(1, favorite = true).let { item ->
+                item.copy(
+                    manga =
+                        item.manga.copy(
+                            memo =
+                                WorkSources(
+                                        pinned =
+                                            WorkSource(1, "Pinned", "en", "/work", item.manga.title)
+                                    )
+                                    .attach(item.manga.memo)
+                        )
+                )
+            }
+        assertEquals(en.manga, WorkSearchGrouping.group(listOf(pt, en)).single().representative)
+    }
+
+    @Test
+    fun `missing creator cannot borrow catalogue certainty from title alone`() {
+        assertEquals(
+            2,
+            WorkSearchGrouping.group(
+                    listOf(hit(1), hit(2, "Upando Sozinho Ragnarok", author = null)),
+                    identities = listOf(identity),
+                )
+                .size,
+        )
+    }
+
+    @Test
+    fun `a previously pinned work memo is preserved byte for byte`() {
+        val old =
+            WorkSources(
+                    pinned = WorkSource(99, "User choice", "en", "/chosen", "A"),
+                    checkedAt = 123,
+                )
+                .attach(buildJsonObject { put("note", "keep") })
+        assertSame(old, UnifiedWorkSearch.attach(old, listOf(hit(1), hit(2))))
+    }
+
+    @Test
+    fun `candidate linking preserves notes glossary and existing candidate health without local IDs`() {
+        val oldCandidate =
+            WorkSource(
+                1,
+                "Old",
+                "en",
+                "/work",
+                "Solo Leveling Ragnarok",
+                readability = "sample_failed",
+                healthCheckedAt = 100,
+            )
+        val before =
+            WorkSources(candidates = listOf(oldCandidate), checkedAt = 500)
+                .attach(
+                    buildJsonObject {
+                        put("glossary", "keep")
+                        put("notes", "keep too")
+                    }
+                )
+        val memo = UnifiedWorkSearch.attach(before, listOf(hit(1), hit(2)))
+        assertEquals(before["glossary"], memo["glossary"])
+        assertEquals(before["notes"], memo["notes"])
+        val after = WorkSources.from(memo)
+        assertEquals(oldCandidate, after.candidates.first())
+        assertEquals(0L, after.checkedAt)
+        assertEquals(2, after.candidates.size)
+        assertFalse(memo.toString().contains("mangaId"))
+        assertSame(memo, UnifiedWorkSearch.attach(memo, listOf(hit(1), hit(2))))
+    }
+
+    @Test
+    fun `only bounded native candidates are attached and host metadata is not sent to a provider`() {
+        val sourceMemo = buildJsonObject {
+            put("provider", "keep")
+            put("polaris.private", "drop")
+        }
+        val hits =
+            (1L..40L).map { n -> hit(n).let { it.copy(manga = it.manga.copy(memo = sourceMemo)) } }
+        val saved = WorkSources.from(UnifiedWorkSearch.attach(JsonObject(emptyMap()), hits))
+        assertEquals(16, saved.candidates.size)
+        assertEquals(setOf("provider"), saved.candidates.first().sourceMemo.keys)
+        assertTrue(saved.candidates.none { it.active })
+    }
+
+    @Test
+    fun `large unrelated result sets remain distinct and preserve a matching library entry`() {
+        val hits =
+            (1L..1000L).map { source ->
+                hit(source, title = "Work $source", author = "Creator $source")
+            }
+        val favorite =
+            hits.last().let { it.copy(manga = it.manga.copy(favorite = true, id = 2000)) }
+        val groups = WorkSearchGrouping.group(hits, listOf(favorite))
+        assertEquals(1000, groups.size)
+        assertEquals(2000L, groups.last().representative.id)
+    }
+}
