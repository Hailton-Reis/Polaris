@@ -0,0 +1,77 @@
+package eu.kanade.tachiyomi.extension.sandbox
+
+import android.content.Context
+import android.content.SharedPreferences
+import java.security.MessageDigest
+import kotlinx.serialization.json.*
+
+/**
+ * Host-only namespace bound to package/signing identity. Standard source keys are used on export.
+ */
+internal class SandboxPreferenceStore(private val context: Context, identity: String) {
+    private val scope =
+        MessageDigest.getInstance("SHA-256").digest(identity.toByteArray()).joinToString("") {
+            "%02x".format(it)
+        }
+    private val index =
+        context.getSharedPreferences("polaris_sandbox_index_$scope", Context.MODE_PRIVATE)
+
+    private fun ids() =
+        index
+            .getStringSet("sources", emptySet())
+            .orEmpty()
+            .map { it.toLong().also { id -> require(id > 0) } }
+            .toSet()
+
+    fun register(sourceIds: Set<Long>) =
+        synchronized(LOCK) {
+            require(sourceIds.all { it > 0 })
+            val all = ids() + sourceIds
+            require(all.size <= 256)
+            check(index.edit().putStringSet("sources", all.map { it.toString() }.toSet()).commit())
+        }
+
+    fun preferences(id: Long): SharedPreferences {
+        require(id > 0 && id in ids())
+        return context.getSharedPreferences("polaris_sandbox_${scope}_$id", Context.MODE_PRIVATE)
+    }
+
+    fun snapshot(): JsonObject =
+        synchronized(LOCK) {
+            buildJsonObject {
+                    ids().sorted().forEach { id ->
+                        val values = preferences(id).all
+                        if (values.isNotEmpty())
+                            put("source_$id", SandboxPreferenceValues.encode(values))
+                    }
+                }
+                .also {
+                    require(it.toString().toByteArray().size <= ExtensionSandboxProtocol.MAX_INPUT)
+                }
+        }
+
+    fun accept(values: JsonObject) =
+        synchronized(LOCK) {
+            require(
+                values.size <= 256 &&
+                    values.toString().toByteArray().size <= ExtensionSandboxProtocol.MAX_INPUT
+            )
+            // Validate the full envelope before persisting any source, including scope ownership.
+            val known = ids()
+            val decoded =
+                values.map { (name, value) ->
+                    require(name.matches(Regex("source_[1-9][0-9]{0,18}")))
+                    val id = name.removePrefix("source_").toLong()
+                    require(id in known)
+                    id to SandboxPreferenceValues.decode(value.jsonObject)
+                }
+            decoded.forEach { (id, value) ->
+                if (preferences(id).all != value)
+                    SandboxPreferenceValues.write(preferences(id), value)
+            }
+        }
+
+    private companion object {
+        val LOCK = Any()
+    }
+}
diff --git a/app/src/main/java/eu/kanade/tachiyomi/extension/sandbox/SandboxPreferenceUi.kt b/app/src/main/java/eu/kanade/tachiyomi/extension/sandbox/SandboxPreferenceUi.kt
new file mode 100644
index 0000000..2ef0cbe
--- /dev/null
+++ b/app/src/main/java/eu/kanade/tachiyomi/extension/sandbox/SandboxPreferenceUi.kt
@@ -0,0 +1,347 @@
+package eu.kanade.tachiyomi.extension.sandbox
+
+import android.text.InputType
+import android.view.inputmethod.EditorInfo
+import androidx.appcompat.app.AlertDialog
+import androidx.lifecycle.lifecycleScope
+import androidx.preference.*
+import kotlinx.coroutines.*
+import kotlinx.serialization.json.*
+import tachiyomi.core.common.i18n.stringResource
+import tachiyomi.i18n.at.ATMR
+
+/**
+ * Stock AndroidX widgets only. No source listener, Intent, view class or Parcelable reaches host
+ * UI.
+ */
+internal class SandboxPreferenceUi(
+    private val owner: PreferenceFragmentCompat,
+    private val source: IsolatedHttpSource,
+) {
+    private val context
+        get() = owner.requireContext()
+
+    private val scope
+        get() = owner.lifecycleScope
+
+    private var dirty = false
+    private var loginOpened = false
+
+    fun onResume() {
+        if (loginOpened) {
+            loginOpened = false
+            load()
+        }
+    }
+
+    fun load() {
+        val loading = owner.preferenceManager.createPreferenceScreen(context)
+        loading.addPreference(
+            Preference(context).apply {
+                title = context.stringResource(ATMR.strings.sandbox_settings_loading)
+                isEnabled = false
+            }
+        )
+        owner.preferenceScreen = loading
+        scope.launch {
+            try {
+                val (schema, session) =
+                    withContext(Dispatchers.IO) {
+                        (if (source.supportsPreferences) source.preferenceSchema() else null) to
+                            source.sessionStatus()
+                    }
+                render(schema, session)
+            } catch (cancelled: CancellationException) {
+                throw cancelled
+            } catch (_: Exception) {
+                failure()
+            }
+        }
+    }
+
+    fun onStop() {
+        if (dirty) {
+            source.owningPackageName?.let {
+                eu.kanade.tachiyomi.extension.util.ExtensionInstallReceiver.notifyReplaced(
+                    context,
+                    it,
+                )
+            }
+            dirty = false
+        }
+    }
+
+    private fun failure() {
+        if (!owner.isAdded) return
+        val screen = owner.preferenceManager.createPreferenceScreen(context)
+        screen.addPreference(
+            Preference(context).apply {
+                title = context.stringResource(ATMR.strings.sandbox_settings_failed)
+                summary = context.stringResource(ATMR.strings.sandbox_settings_retry)
+                setOnPreferenceClickListener {
+                    load()
+                    true
+                }
+            }
+        )
+        owner.preferenceScreen = screen
+    }
+
+    private fun render(schema: JsonObject?, session: CookieBank.Status) {
+        if (!owner.isAdded) return
+        schema?.let(SandboxPreferenceCodec::validate)
+        val screen = owner.preferenceManager.createPreferenceScreen(context)
+        screen.addPreference(
+            Preference(context).apply {
+                title = context.stringResource(ATMR.strings.sandbox_settings_title)
+                summary = context.stringResource(ATMR.strings.sandbox_settings_explanation)
+                isSelectable = false
+            }
+        )
+        fun change(key: String, value: Any): Boolean {
+            screen.isEnabled = false
+            scope.launch {
+                try {
+                    val accepted =
+                        withContext(Dispatchers.IO) {
+                            source.changePreferences(
+                                requireNotNull(schema).getValue("schema").jsonPrimitive.content,
+                                SandboxPreferenceValues.encode(mapOf(key to value)),
+                            )
+                        }
+                    dirty = dirty || accepted
+                    if (!accepted && owner.isAdded)
+                        android.widget.Toast.makeText(
+                                context,
+                                context.stringResource(ATMR.strings.sandbox_settings_rejected),
+                                android.widget.Toast.LENGTH_LONG,
+                            )
+                            .show()
+                    load()
+                } catch (cancelled: CancellationException) {
+                    throw cancelled
+                } catch (_: Exception) {
+                    failure()
+                }
+            }
+            return false // Persistence happens only after the worker accepts the change.
+        }
+        fun add(nodes: JsonArray, parent: PreferenceGroup) {
+            nodes.forEach { element ->
+                val node = element.jsonObject
+                val kind = node.getValue("kind").jsonPrimitive.content
+                val key = node["key"]?.jsonPrimitive?.content
+                val widget: Preference =
+                    when (kind) {
+                        "group" -> PreferenceCategory(context)
