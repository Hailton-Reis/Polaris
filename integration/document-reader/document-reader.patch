+                Result.success(store(key = "b".repeat(64)))
+            assertTrue(
+                ExtensionStoreRepositoryImpl(service, database).insertVerified(store()).isFailure,
+            )
+            coVerify(exactly = 0) {
+                database.extension_storeQueries.upsert(
+                    any(),
+                    any(),
+                    any(),
+                    any(),
+                    any(),
+                    any(),
+                    any(),
+                    any(),
+                )
+            }
+        }
+
+    @Test
+    fun `reviewed metadata is inserted with its original certificate and identity`() = runTest {
+        val service = mockk<ExtensionStoreService>()
+        val database = mockk<Database>(relaxed = true)
+        coEvery { service.fetch(store().indexUrl) } returns Result.success(store())
+        assertTrue(
+            ExtensionStoreRepositoryImpl(service, database).insertVerified(store()).isSuccess,
+        )
+        coVerify(exactly = 1) {
+            database.extension_storeQueries.upsert(
+                store().indexUrl,
+                store().name,
+                store().badgeLabel,
+                store().signingKey,
+                store().contact.website,
+                null,
+                false,
+                null,
+            )
+        }
