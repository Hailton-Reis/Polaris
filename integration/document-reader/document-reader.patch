+package eu.kanade.tachiyomi.data.backup.restore.restorers
+
+/**
+ * Native source preference keys only; a backup cannot select a host settings file or sandbox scope.
+ */
+internal object SourcePreferenceNamespace {
+    fun valid(key: String): Boolean {
+        if (!key.startsWith("source_")) return false
+        val id = key.removePrefix("source_").toLongOrNull() ?: return false
+        return key == "source_$id"
+    }
+}
