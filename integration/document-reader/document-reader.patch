@@ -0,0 +1,117 @@
+package eu.kanade.tachiyomi.source.selection
+
+import eu.kanade.tachiyomi.network.GET
+import eu.kanade.tachiyomi.network.awaitSuccess
+import eu.kanade.tachiyomi.source.model.SManga
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.withTimeoutOrNull
+import kotlinx.serialization.json.*
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okhttp3.OkHttpClient
+import tachiyomi.domain.manga.model.WorkIdentity
+
+/** Public catalogue metadata; no account, LLM or executable repository is downloaded here. */
+class WorkIdentityResolver(private val client: OkHttpClient) {
+    suspend fun resolve(reference: SManga): WorkIdentity? {
+        return try {
+            withTimeoutOrNull(5_000L) {
+                val direct =
+                    UUID.find(reference.url)?.value?.takeIf {
+                        // A random UUID from another provider is not a MangaDex identity.
+                        reference.memo["polaris.identity.mangadex"]?.jsonPrimitive?.content == it ||
+                            reference.url.startsWith("https://mangadex.org/title/")
+                    }
+                val url =
+                    if (direct != null)
+                        "https://api.mangadex.org/manga/$direct".toHttpUrl().newBuilder()
+                    else
+                        "https://api.mangadex.org/manga"
+                            .toHttpUrl()
+                            .newBuilder()
+                            .addQueryParameter("title", reference.title.take(200))
+                            .addQueryParameter("limit", "10")
+                url.addQueryParameter("includes[]", "author")
+                    .addQueryParameter("includes[]", "artist")
+                client.newCall(GET(url.build().toString())).awaitSuccess().use { response ->
+                    val source = response.body.source()
+                    source.request(MAX_BYTES + 1)
+                    check(source.buffer.size <= MAX_BYTES) { "Catalogue metadata too large" }
+                    val parsed = Json.parseToJsonElement(source.readUtf8()).jsonObject
+                    val data = parsed["data"] ?: return@use null
+                    select(reference, if (data is JsonArray) data else JsonArray(listOf(data)))
+                }
+            }
+        } catch (error: CancellationException) {
+            throw error
+        } catch (_: Exception) {
+            null
+        }
+    }
+
+    internal fun select(reference: SManga, records: JsonArray): WorkIdentity? {
+        val people = SourceMatching.people(reference.author, reference.artist)
+        val matches =
+            records.take(10).mapNotNull { record ->
+                val item = record.jsonObject
+                val attributes = item["attributes"]?.jsonObject ?: return@mapNotNull null
+                // MangaDex "manga" and its individual ID keep sequels and unrelated media separate.
+                if (item["type"]?.jsonPrimitive?.content != "manga") return@mapNotNull null
+                val alternate = attributes["altTitles"]?.jsonArray.orEmpty().map { it.jsonObject }
+                val preferred =
+                    listOf("en", "pt-br", "pt").flatMap { language ->
+                        alternate.mapNotNull { it[language] }
+                    }
+                val titles =
+                    (preferred +
+                            attributes["title"]?.jsonObject?.values.orEmpty() +
+                            alternate.flatMap { it.values })
+                        .mapNotNull {
+                            (it as? JsonPrimitive)?.content?.takeIf { n -> n.length in 2..300 }
+                        }
+                        .distinct()
+                        .take(32)
+                if (
+                    titles.none {
+                        SourceMatching.title(it) == SourceMatching.title(reference.title)
+                    }
+                )
+                    return@mapNotNull null
+                val creators =
+                    item["relationships"]
+                        ?.jsonArray
+                        .orEmpty()
+                        .filter {
+                            it.jsonObject["type"]?.jsonPrimitive?.content in
+                                listOf("author", "artist")
+                        }
+                        .mapNotNull {
+                            it.jsonObject["attributes"]
+                                ?.jsonObject
+                                ?.get("name")
+                                ?.jsonPrimitive
+                                ?.content
+                        }
+                if (
+                    creators.isEmpty() ||
+                        (people.isNotEmpty() &&
+                            creators.flatMap { SourceMatching.people(it) }.none { it in people })
+                )
+                    return@mapNotNull null
+                val id = item["id"]?.jsonPrimitive?.content ?: return@mapNotNull null
+                if (!UUID.matches(id)) return@mapNotNull null
+                WorkIdentity(
+                    "mangadex:$id",
+                    titles,
+                    creators.distinct(),
+                    System.currentTimeMillis(),
+                )
+            }
+        return matches.singleOrNull()
+    }
+
+    companion object {
+        private const val MAX_BYTES = 2 * 1024 * 1024L
+        private val UUID =
+            Regex("[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}")
+    }
+}
