+                                        LocalContext.current,
+                                    ),
+                                    language in state.languages,
+                                    enabled = !state.busy,
+                                    onChange = { model.language(language) },
+                                )
+                            }
+                        } else if (state.selection == PreparationSelection.MANUAL) {
+                            items(
+                                state.available
+                                    .filter {
+                                        (state.includeNsfw || !it.isNsfw) &&
+                                            it.pkgName !in state.sharedPackages &&
+                                            (state.installedVersions[it.pkgName] ?: -1) <
+                                            it.versionCode &&
+                                            (
+                                                it.name.contains(query, true) ||
+                                                    it.sources.any { source ->
+                                                        source.name.contains(query, true)
+                                                    }
+                                                )
+                                    }
+                                    .distinctBy { it.pkgName }
+                                    .sortedBy { it.name },
+                                key = { it.pkgName },
+                            ) { extension ->
+                                PreparationCheck(
+                                    "${extension.name} · ${extension.lang}",
+                                    extension.pkgName in state.manualPackages,
+                                    enabled = !state.busy,
+                                    onChange = { model.manualPackage(extension.pkgName) },
+                                )
+                            }
+                        } else {
+                            items(plan.extensions, key = { it.pkgName }) { extension ->
+                                Text(extension.name)
+                            }
+                        }
+                    }
+                }
+                item { HorizontalDivider(Modifier.padding(vertical = 8.dp)) }
+            }
+        }
+    }
+}
+
+@Composable
+private fun PreparationCheck(
+    label: String,
+    checked: Boolean,
+    enabled: Boolean,
+    onChange: (Boolean) -> Unit,
+) {
+    Row(
+        Modifier.fillMaxWidth()
+            .toggleable(
+                value = checked,
+                enabled = enabled,
+                role = Role.Checkbox,
+                onValueChange = onChange,
+            )
+            .padding(vertical = 8.dp),
+    ) {
+        Checkbox(checked = checked, onCheckedChange = null, enabled = enabled)
+        Text(label, modifier = Modifier.weight(1f).padding(start = 8.dp))
+    }
+}
