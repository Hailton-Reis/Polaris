--- /dev/null
+++ b/app/src/test/java/eu/kanade/domain/chapter/model/ChapterRoutingTest.kt
@@ -0,0 +1,31 @@
+package eu.kanade.domain.chapter.model
+
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertNotEquals
+import org.junit.jupiter.api.Test
+import tachiyomi.domain.chapter.model.Chapter
+import tachiyomi.domain.chapter.model.ChapterOrigin
+
+class ChapterRoutingTest {
+    @Test fun `network request restores provider URL and memo without changing storage identity`() {
+        val memo = JsonObject(mapOf("provider-state" to JsonPrimitive("opaque")))
+        val origin = ChapterOrigin(-5, "Alternative", "en", "/work", "/chapter/1", sourceMemo = memo)
+        val stored = Chapter.create().copy(
+            url = ChapterOrigin.storedUrl(-5, "/chapter/1"),
+            name = "Chapter 1",
+            memo = origin.attach(memo),
+        )
+        assertEquals(stored.url, stored.toSChapter().url)
+        assertEquals("/chapter/1", stored.toRemoteSChapter().url)
+        assertEquals(memo, stored.toRemoteSChapter().memo)
+        assertNotEquals(stored.url, stored.toRemoteSChapter().url)
+    }
+
+    @Test fun `primary legacy chapter retains URL and provider metadata`() {
+        val chapter = Chapter.create().copy(url = "/chapter/1", name = "Chapter 1")
+        assertEquals(chapter.toSChapter().url, chapter.toRemoteSChapter().url)
+        assertEquals(chapter.memo, chapter.toRemoteSChapter().memo)
+    }
+}
