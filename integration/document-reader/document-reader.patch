+package eu.kanade.tachiyomi.polaris
+
+import android.content.Context
+import android.content.res.Configuration
+import android.os.Bundle
+import android.view.View
+import android.widget.FrameLayout
+import androidx.fragment.app.FragmentActivity
+import androidx.preference.PreferenceFragmentCompat
+import eu.kanade.tachiyomi.R
+import eu.kanade.tachiyomi.extension.sandbox.IsolatedHttpSource
+import eu.kanade.tachiyomi.extension.sandbox.SandboxPreferenceUi
+import java.util.Locale
+
+/** Non-exported component fixture; only trusted host proxies and synthetic settings are used. */
+class SandboxSettingsTestActivity : FragmentActivity() {
+    companion object {
+        internal var fixtureSource: IsolatedHttpSource? = null
+    }
+
+    override fun attachBaseContext(base: Context) {
+        super.attachBaseContext(
+            base.createConfigurationContext(
+                Configuration(base.resources.configuration).apply { setLocale(Locale("pt", "BR")) }
+            )
+        )
+    }
+
+    override fun onCreate(state: Bundle?) {
+        setTheme(R.style.Theme_Tachiyomi)
+        super.onCreate(state)
+        val frame = FrameLayout(this).apply { id = View.generateViewId() }
+        setContentView(frame)
+        if (state == null)
+            supportFragmentManager
+                .beginTransaction()
+                .replace(frame.id, SettingsFragment())
+                .commitNow()
+    }
+
+    class SettingsFragment : PreferenceFragmentCompat() {
+        private var controller: SandboxPreferenceUi? = null
+
+        // Match SourcePreferencesFragment: force the preference overlay instead of using
+        // the activity's MaterialSwitch view style as a SwitchPreferenceCompat style.
+        override fun getContext(): Context? {
+            val base = super.getContext() ?: return null
+            val theme = android.util.TypedValue()
+            base.theme.resolveAttribute(R.attr.preferenceTheme, theme, true)
+            return androidx.appcompat.view.ContextThemeWrapper(base, theme.resourceId)
+        }
+
+        override fun onCreatePreferences(state: Bundle?, root: String?) {
+            controller = SandboxPreferenceUi(this, requireNotNull(fixtureSource)).also { it.load() }
+        }
+
+        override fun onStop() {
+            controller?.onStop()
+            super.onStop()
+        }
