@@ -0,0 +1,85 @@
+package eu.kanade.tachiyomi.extension.preparation
+
+import eu.kanade.tachiyomi.extension.util.PrivateExtensionFiles
+import eu.kanade.tachiyomi.extension.util.PrivateExtensionSignature
+import org.junit.jupiter.api.Assertions.assertArrayEquals
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.assertThrows
+import org.junit.jupiter.api.io.TempDir
+import java.io.File
+import java.io.IOException
+
+class PrivateExtensionSignatureTest {
+    @TempDir lateinit var folder: File
+
+    private fun fixture(name: String): File {
+        val stream =
+            PrivateExtensionSignatureTest::class
+                .java
+                .getResourceAsStream("/extension-preparation/$name")
+        val bytes = requireNotNull(stream).use { it.readBytes() }
+        return File(folder, name).apply { writeBytes(bytes) }
+    }
+
+    @Test
+    fun `signed fixture verifies under Android 8 and Android 14 signature rules`() {
+        val apk = fixture("signed.apk")
+        val keys = PrivateExtensionSignature.verify(apk, 26)
+        assertEquals(1, keys.size)
+        assertEquals(keys, PrivateExtensionSignature.verify(apk, 34))
+        PrivateExtensionSignature.requireReviewedIdentity(
+            "test.polaris.reviewed",
+            keys.single().uppercase(),
+            "test.polaris.reviewed",
+            keys,
+        )
+    }
+
+    @Test
+    fun `an altered signed apk is rejected before replacement and working file survives`() {
+        val old = File(folder, "working.ext").apply { writeText("working") }
+        val changed = fixture("tampered.apk")
+        assertThrows<IOException> {
+            PrivateExtensionFiles.replace(changed, old) { staged ->
+                PrivateExtensionSignature.verify(staged, 26)
+            }
+        }
+        assertEquals("working", old.readText())
+        assertEquals(0, folder.listFiles()!!.count { it.name.endsWith(".pending") })
+    }
+
+    @Test
+    fun `correct certificate cannot authorize a different package or an unreviewed key`() {
+        val apk = fixture("signed.apk")
+        val keys = PrivateExtensionSignature.verify(apk, 26)
+        val old = File(folder, "working.ext").apply { writeText("working") }
+        for (
+        (pkg, key) in
+        listOf("wrong.package" to keys.single(), "test.polaris.reviewed" to "0".repeat(64))
+        ) {
+            assertThrows<IOException> {
+                PrivateExtensionFiles.replace(apk, old) { staged ->
+                    PrivateExtensionSignature.requireReviewedIdentity(
+                        pkg,
+                        key,
+                        "test.polaris.reviewed",
+                        PrivateExtensionSignature.verify(staged, 26),
+                    )
+                }
+            }
+            assertEquals("working", old.readText())
+        }
+    }
+
+    @Test
+    fun `verified bytes can replace the extension without changing the apk`() {
+        val apk = fixture("signed.apk")
+        val old = File(folder, "working.ext").apply { writeText("working") }
+        PrivateExtensionFiles.replace(apk, old) { staged ->
+            PrivateExtensionSignature.verify(staged, 26)
+        }
+        assertArrayEquals(apk.readBytes(), old.readBytes())
+        old.setWritable(true)
+    }
+}
