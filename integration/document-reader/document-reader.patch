+package eu.kanade.tachiyomi.ui.documents
+
+import java.io.ByteArrayInputStream
+import java.io.ByteArrayOutputStream
+import java.io.IOException
+import org.junit.jupiter.api.Assertions.*
+import org.junit.jupiter.api.Test
+
+class DocumentImportSpaceTest {
+    @Test
+    fun `copy preserves bytes and leaves streams owned by caller`() {
+        val bytes = ByteArray(90000) { it.toByte() }
+        val output = ByteArrayOutputStream()
+        var checks = 0
+        assertEquals(
+            bytes.size.toLong(),
+            DocumentImportSpace.copy(
+                ByteArrayInputStream(bytes),
+                output,
+                100000,
+                { Long.MAX_VALUE },
+                { checks++ },
+            ),
+        )
+        assertArrayEquals(bytes, output.toByteArray())
+        assertTrue(checks >= 3)
+    }
+
+    @Test
+    fun `insufficient space rejects the next chunk before writing`() {
+        val output = ByteArrayOutputStream()
+        assertThrows(IOException::class.java) {
+            DocumentImportSpace.copy(
+                ByteArrayInputStream(ByteArray(100)),
+                output,
+                1000,
+                { DocumentImportSpace.RESERVE_BYTES + 99 },
+                {},
+            )
+        }
+        assertEquals(0, output.size())
+    }
+
+    @Test
+    fun `capacity is checked again as a stream grows`() {
+        val output = ByteArrayOutputStream()
+        assertThrows(IOException::class.java) {
+            DocumentImportSpace.copy(
+                ByteArrayInputStream(ByteArray(70000)),
+                output,
+                100000,
+                { DocumentImportSpace.RESERVE_BYTES + 40000 - output.size() },
+                {},
+            )
+        }
+        assertEquals(32 * 1024, output.size())
+    }
+
+    @Test
+    fun `file limit holds even when storage is plentiful`() {
+        val output = ByteArrayOutputStream()
+        assertThrows(IllegalArgumentException::class.java) {
+            DocumentImportSpace.copy(
+                ByteArrayInputStream(ByteArray(100)),
+                output,
+                99,
+                { Long.MAX_VALUE },
+                {},
+            )
+        }
+        assertEquals(0, output.size())
+    }
+
+    @Test
+    fun `cancellation stops before more bytes are read or written`() {
+        val output = ByteArrayOutputStream()
+        assertThrows(java.util.concurrent.CancellationException::class.java) {
+            DocumentImportSpace.copy(
+                ByteArrayInputStream(ByteArray(100)),
+                output,
+                1000,
+                { Long.MAX_VALUE },
+                { throw java.util.concurrent.CancellationException() },
+            )
+        }
+        assertEquals(0, output.size())
+    }
+
+    @Test
+    fun `unknown capacity empty inputs and overflow never appear as available space`() {
+        assertThrows(IOException::class.java) { DocumentImportSpace.requireAvailable(0, 1) }
+        assertThrows(IOException::class.java) {
+            DocumentImportSpace.requireAvailable(Long.MAX_VALUE, Long.MAX_VALUE)
+        }
+        assertThrows(IllegalArgumentException::class.java) {
+            DocumentImportSpace.copy(
+                ByteArrayInputStream(byteArrayOf()),
+                ByteArrayOutputStream(),
+                100,
+                { Long.MAX_VALUE },
+                {},
+            )
+        }
+    }
+}
diff --git a/app/src/test/java/eu/kanade/tachiyomi/ui/documents/DocumentOrganizationTest.kt b/app/src/test/java/eu/kanade/tachiyomi/ui/documents/DocumentOrganizationTest.kt
