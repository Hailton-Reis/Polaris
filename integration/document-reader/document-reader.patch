+            original.history
+                .mapNotNull { h ->
+                    val chapter =
+                        originalByUrl[h.url]
+                            ?: return@mapNotNull h.takeUnless { ChapterOrigin.isRouted(it.url) }
+                    val target = nativeByKey[key(chapter)]?.firstOrNull() ?: return@mapNotNull null
+                    h.copy(url = target.url)
+                }
+                .groupBy { it.url }
+                .map { (nativeUrl, history) ->
+                    BackupHistory(
