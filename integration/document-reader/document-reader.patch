+                TextTranslatorLanguage.PORTUGUESE,
+                "Keep other chapter",
+                "Manter outro capítulo",
+                preferences.store,
+            )
+        }
+        TranslationCache.removeSources(work, listOf("This deleted line"), preferences.store)
+        for (language in listOf(TextRecognizerLanguage.ENGLISH, TextRecognizerLanguage.JAPANESE)) {
+            assertNull(
+                TranslationCache.get(
+                    work,
+                    language,
+                    TextTranslatorLanguage.PORTUGUESE,
+                    "This deleted line",
+                    preferences.store,
+                ),
+            )
+            assertEquals(
+                "Manter outro capítulo",
+                TranslationCache.get(
+                    work,
+                    language,
+                    TextTranslatorLanguage.PORTUGUESE,
+                    "Keep other chapter",
+                    preferences.store,
+                ),
+            )
+        }
+        TranslationCache.clearMachineOutput(work, preferences.store)
+        assertEquals(vocabulary, TranslationMemory.entries(work, preferences.store))
+        assertEquals(0, TranslationCache.snapshotEntries(work, preferences.store).size)
+    }
 }
 
