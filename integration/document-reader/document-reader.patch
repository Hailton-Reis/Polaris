+package eu.kanade.tachiyomi.data.profile
+
+import android.graphics.BitmapFactory
+import java.io.File
+import java.io.IOException
+import java.io.InputStream
+import java.util.UUID
+
+/** App-owned images only. A failed import never removes the currently selected image. */
+internal class ProfileImageStore(
+    private val directory: File,
+    private val validate: (File) -> Boolean = { file ->
+        val options = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+        BitmapFactory.decodeFile(file.absolutePath, options)
+        options.outWidth in 1..8192 &&
+            options.outHeight in 1..8192 &&
+            options.outWidth.toLong() * options.outHeight <= 40_000_000
+    },
+) {
+    fun save(input: InputStream, slot: String): String =
+        input.use { source ->
+            require(slot in setOf("avatar", "banner"))
+            if (!directory.exists() && !directory.mkdirs())
+                throw IOException("Profile directory unavailable")
+            val temporary = File(directory, "$slot-${UUID.randomUUID()}.tmp")
+            val target = File(directory, "${slot}_${UUID.randomUUID()}.img")
+            try {
+                temporary.outputStream().use { output ->
+                    var count = 0L
+                    val buffer = ByteArray(8192)
+                    while (true) {
+                        val size = source.read(buffer)
+                        if (size < 0) break
+                        count += size
+                        if (count > MAX_BYTES) throw IOException("Profile image exceeds limit")
+                        output.write(buffer, 0, size)
+                    }
+                }
+                if (!validate(temporary)) throw IOException("Invalid profile image")
+                if (!temporary.renameTo(target))
+                    throw IOException("Profile image could not be committed")
+                // Local preference update must happen before old-image deletion (handled by
+                // caller).
+                target.absolutePath
+            } finally {
+                temporary.delete()
+            }
+        }
+
+    fun owned(path: String?): File? =
+        path?.let { value ->
+            runCatching {
+                    val file = File(value).canonicalFile
+                    file.takeIf {
+                        it.parentFile == directory.canonicalFile &&
+                            Regex("(?:avatar|banner)_[A-Za-z0-9-]+\\.(?:jpg|img)")
+                                .matches(it.name) &&
+                            it.isFile
+                    }
+                }
+                .getOrNull()
+        }
+
+    fun deleteOwned(path: String?) {
+        owned(path)?.delete()
+    }
+
+    companion object {
+        const val MAX_BYTES = 8L * 1024 * 1024
+    }
+}
