--- /dev/null
+++ b/app/src/main/java/eu/kanade/domain/ui/model/LauncherIconRewards.kt
@@ -0,0 +1,33 @@
+package eu.kanade.domain.ui.model
+
+import eu.kanade.tachiyomi.data.profile.PolarisLevelManager
+import eu.kanade.tachiyomi.data.profile.ProfileProgress
+import kotlinx.serialization.json.Json
+
+/** Cosmetic milestones, never a spendable balance. Existing/restored selections stay usable. */
+object LauncherIconRewards {
+    private val codec = Json { ignoreUnknownKeys = true }
+
+    fun xp(raw: String): Long =
+        runCatching {
+                require(raw.length <= 512)
+                codec
+                    .decodeFromString(ProfileProgress.serializer(), raw)
+                    .xp
+                    .coerceIn(0, PolarisLevelManager.MAX_XP)
+            }
+            .getOrDefault(0)
+
+    fun unlocked(
+        xp: Long,
+        saved: Set<String>,
+        selected: LauncherIcon,
+        achievements: eu.kanade.tachiyomi.data.profile.AchievementProgress =
+            eu.kanade.tachiyomi.data.profile.AchievementProgress(),
+    ): Set<LauncherIcon> {
+        val earned = eu.kanade.tachiyomi.data.profile.ProfileAchievements.rewards(xp, achievements)
+        return LauncherIcon.entries.filterTo(linkedSetOf()) {
+            it == LauncherIcon.DEFAULT || it == selected || it.name in saved || it in earned
+        }
+    }
+}
