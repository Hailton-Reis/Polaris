diff --git a/app/src/androidTest/java/eu/kanade/translation/recognizer/OcrStripImageTest.kt b/app/src/androidTest/java/eu/kanade/translation/recognizer/OcrStripImageTest.kt
new file mode 100644
index 0000000..6b8d94e
--- /dev/null
+++ b/app/src/androidTest/java/eu/kanade/translation/recognizer/OcrStripImageTest.kt
@@ -0,0 +1,104 @@
+package eu.kanade.translation.recognizer
+
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.net.Uri
+import androidx.exifinterface.media.ExifInterface
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import androidx.test.platform.app.InstrumentationRegistry
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import java.io.ByteArrayInputStream
+import java.io.ByteArrayOutputStream
+import java.io.File
+
+@RunWith(AndroidJUnit4::class)
+class OcrStripImageTest {
+    @Test
+    fun regionsPreserveCoordinatesAndPixelBudgetAndCloseOnFailure() {
+        val bytes = bandedImage(Bitmap.CompressFormat.PNG)
+        var opened = 0
+        var closed = 0
+        val image = OcrImage(Uri.EMPTY) {
+            opened++
+            object : ByteArrayInputStream(bytes) {
+                private var wasClosed = false
+                override fun close() {
+                    if (!wasClosed) closed++
+                    wasClosed = true
+                    super.close()
+                }
+            }
+        }
+        val source = checkNotNull(OcrStripImage.open(image))
+        assertEquals(opened, closed)
+        assertEquals(64, source.width)
+        assertEquals(5000, source.height)
+        try {
+            source.use {
+                for (strip in source.strips) {
+                    val bitmap = source.decode(strip)
+                    try {
+                        assertEquals(64, bitmap.width)
+                        assertEquals(strip.bottom - strip.top, bitmap.height)
+                        assertTrue(bitmap.width * bitmap.height <= OcrStripPlan.MAX_TILE_PIXELS)
+                        val y = bitmap.height / 2
+                        assertEquals(colorAt(strip.top + y), bitmap.getPixel(32, y))
+                    } finally {
+                        bitmap.recycle()
+                    }
+                }
+                throw java.io.IOException("intentional test failure")
+            }
+        } catch (error: java.io.IOException) {
+            assertEquals("intentional test failure", error.message)
+        }
+        assertTrue(runCatching { source.decode(source.strips.first()) }.isFailure)
+        assertEquals(opened, closed)
+    }
+
+    @Test
+    fun rotatedExifDoesNotUseRawRegionCoordinates() {
+        val context = InstrumentationRegistry.getInstrumentation().targetContext
+        val file = File.createTempFile("ocr-strip-exif", ".jpg", context.cacheDir)
+        try {
+            file.writeBytes(bandedImage(Bitmap.CompressFormat.JPEG))
+            ExifInterface(file.absolutePath).apply {
+                setAttribute(ExifInterface.TAG_ORIENTATION, ExifInterface.ORIENTATION_ROTATE_90.toString())
+                saveAttributes()
+            }
+            assertNull(OcrStripImage.open(OcrImage(Uri.fromFile(file)) { file.inputStream() }))
+        } finally {
+            file.delete()
+        }
+    }
+
+    private fun bandedImage(format: Bitmap.CompressFormat): ByteArray {
+        val bitmap = Bitmap.createBitmap(64, 5000, Bitmap.Config.ARGB_8888)
+        try {
+            val canvas = Canvas(bitmap)
+            val paint = Paint()
+            for (y in 0 until 5000) {
+                paint.color = colorAt(y)
+                canvas.drawRect(0f, y.toFloat(), 64f, (y + 1).toFloat(), paint)
+            }
+            return ByteArrayOutputStream().use { output ->
+                assertTrue(bitmap.compress(format, 100, output))
+                output.toByteArray()
+            }
+        } finally {
+            bitmap.recycle()
+        }
+    }
+
+    private fun colorAt(y: Int) = when {
+        y < 1600 -> Color.BLUE
+        y < 3300 -> Color.RED
+        else -> Color.GREEN
+    }
+}
