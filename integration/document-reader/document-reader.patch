+++ b/app/src/androidTest/java/eu/kanade/translation/presentation/PortugueseTypographyAndroidTest.kt
@@ -0,0 +1,161 @@
+package eu.kanade.translation.presentation
+
+import android.graphics.Bitmap
+import androidx.compose.material3.Typography
+import androidx.compose.ui.graphics.Canvas
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.asImageBitmap
+import androidx.compose.ui.text.TextLayoutResult
+import androidx.compose.ui.text.TextMeasurer
+import androidx.compose.ui.text.font.createFontFamilyResolver
+import androidx.compose.ui.unit.Constraints
+import androidx.compose.ui.unit.Density
+import androidx.compose.ui.unit.LayoutDirection
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import androidx.test.platform.app.InstrumentationRegistry
+import eu.kanade.translation.data.TranslationFont
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import java.io.File
+
+@RunWith(AndroidJUnit4::class)
+class PortugueseTypographyAndroidTest {
+    private val context = InstrumentationRegistry.getInstrumentation().targetContext
+    private val measurer = TextMeasurer(createFontFamilyResolver(context), Density(1f), LayoutDirection.Ltr)
+
+    private fun measure(
+        text: String,
+        size: Int,
+        width: Int,
+        font: TranslationFont,
+        supplement: Boolean = true,
+    ): TextLayoutResult {
+        val face = font.readerTypeface()
+        return measurer.measure(
+            text = translationDisplayText(text, size, face.cedillaFallback.takeIf { supplement }),
+            style = translationTextStyle(Typography().bodyLarge, size, face.family),
+            constraints = Constraints(minWidth = width, maxWidth = width),
+        )
+    }
+
+    @Test fun cedillasMatchTheSelectedComicCapHeightInsteadOfTheSystemLowercase() {
+        val old = measure("C Ç ç", 48, 300, TranslationFont.ANIME_ACE, supplement = false)
+        val fixed = measure("C Ç ç", 48, 300, TranslationFont.ANIME_ACE)
+        val original = paint(old, "anime-system-cedilla")
+        val image = paint(fixed, "anime-comic-cedilla")
+        try {
+            val reference = capInkHeight(image, fixed, 0)
+            for (index in listOf(2, 4)) {
+                val height = capInkHeight(image, fixed, index)
+                assertTrue(
+                    "Cedilla cap height must match C: $height / $reference",
+                    height / reference.toFloat() in 0.85f..1.15f,
+                )
+            }
+            assertTrue(
+                "Reproduce the smaller system lowercase ç before the supplement",
+                capInkHeight(original, old, 4) < capInkHeight(image, fixed, 4),
+            )
+        } finally {
+            original.recycle()
+            image.recycle()
+        }
+    }
+
+    @Test fun portugueseAccentsStayInsideTheMeasuredParagraphWithEveryBundledFont() {
+        for (font in TranslationFont.entries) {
+            for (size in listOf(12, 24, 48)) {
+                val paragraph = measure(
+                    "AÇÃO, CORAÇÃO E PROTEÇÃO.\nVOCÊ ESTÁ AQUI, NÃO ESTÁ?\nÇ ç Ã Õ Á É Ê Í Ó Ô Ú À",
+                    size,
+                    320,
+                    font,
+                )
+                val image = paint(paragraph, "${font.name}-$size")
+                try {
+                    for (y in 0 until image.height) {
+                        for (x in 0 until image.width) {
+                            if (ink(image.getPixel(x, y))) {
+                                assertTrue(
+                                    "Glyph outside measured width: ${font.name}, $size at $x,$y",
+                                    x in PAD until PAD + paragraph.size.width,
+                                )
+                                assertTrue(
+                                    "Accent outside measured height: ${font.name}, $size at $x,$y",
+                                    y in PAD until PAD + paragraph.size.height,
+                                )
+                            }
+                        }
+                    }
+                } finally {
+                    image.recycle()
+                }
+            }
+        }
+    }
+
+    @Test fun widerSafeEnvelopesCanIncreaseReadablePortugueseWithoutClipping() {
+        val text = "A PROTEÇÃO E A CORAGEM FAZEM DIFERENÇA. VOCÊ PODE CONTINUAR!"
+        var improvements = 0
+        for (width in listOf(100, 140, 180)) {
+            for (height in listOf(60, 90, 120)) {
+                val choices = listOf(0.82f to 0.76f, 0.88f to 0.82f, 0.90f to 0.86f).map { (w, h) ->
+                    val availableWidth = (width * w).toInt()
+                    val availableHeight = (height * h).toInt()
+                    TranslationTextFit.select(4, 28) { size ->
+                        val paragraph = measure(text, size, availableWidth, TranslationFont.ANIME_ACE)
+                        TranslationTextFit.Measurement(
+                            !paragraph.hasVisualOverflow && paragraph.size.height <= availableHeight,
+                            TranslationTextFit.keepsWords(
+                                text,
+                                (0 until paragraph.lineCount - 1).map { paragraph.getLineEnd(it, true) },
+                            ),
+                        )
+                    }
+                }
+                var selected: TranslationTextFit.Selection? = null
+                choices.forEach { if (TranslationTextFit.preferCandidate(selected, it)) selected = it }
+                assertTrue(selected!!.fits)
+                if (selected!!.fontSizeSp > choices.first().fontSizeSp) improvements++
+                assertEquals(
+                    choices.filter { it.fits && it.keepsWords }.maxOfOrNull { it.fontSizeSp },
+                    selected!!.fontSizeSp,
+                )
+            }
+        }
+        assertTrue("Real shaped text must benefit from considering all safe envelopes", improvements > 0)
+    }
+
+    private fun paint(paragraph: TextLayoutResult, name: String): Bitmap {
+        val bitmap = Bitmap.createBitmap(
+            paragraph.size.width + 2 * PAD,
+            paragraph.size.height + 2 * PAD,
+            Bitmap.Config.ARGB_8888,
+        )
+        bitmap.eraseColor(android.graphics.Color.WHITE)
+        val canvas = Canvas(bitmap.asImageBitmap())
+        canvas.translate(PAD.toFloat(), PAD.toFloat())
+        paragraph.multiParagraph.paint(canvas, Color.Black)
+        val folder = context.getExternalFilesDir("portuguese-typography-checks")!!
+        File(folder, "$name.png").outputStream().use { bitmap.compress(Bitmap.CompressFormat.PNG, 100, it) }
+        return bitmap
+    }
+
+    private fun capInkHeight(bitmap: Bitmap, paragraph: TextLayoutResult, index: Int): Int {
+        val bounds = paragraph.getBoundingBox(index)
+        val left = (PAD + bounds.left).toInt().coerceAtLeast(0)
+        val right = (PAD + bounds.right).toInt().coerceAtMost(bitmap.width)
+        val baseline = (PAD + paragraph.getLineBaseline(0)).toInt()
+        val ys = (PAD until baseline).filter { y -> (left until right).any { x -> ink(bitmap.getPixel(x, y)) } }
+        assertTrue("Visible glyph at index $index", ys.isNotEmpty())
+        return ys.last() - ys.first() + 1
+    }
+
+    private fun ink(pixel: Int) = (pixel and 0xff) < 240
+
+    companion object {
+        private const val PAD = 32
+    }
+}
