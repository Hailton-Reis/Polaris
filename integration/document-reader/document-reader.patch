+package eu.kanade.tachiyomi.ui.documents
+
+import java.io.IOException
+import java.io.InputStream
+import java.io.OutputStream
+
+/** Advisory local-volume checks; providers and concurrent writers may still fail during IO. */
+internal object DocumentImportSpace {
+    const val RESERVE_BYTES = 8L * 1024 * 1024
+
+    fun requireAvailable(available: Long, nextBytes: Long) {
+        require(nextBytes >= 0)
+        if (available < RESERVE_BYTES || nextBytes > available - RESERVE_BYTES)
+            throw IOException(
+                "Not enough space to import this document; free storage and try again"
+            )
+    }
+
+    fun copy(
+        input: InputStream,
+        output: OutputStream,
+        maxBytes: Long,
+        available: () -> Long,
+        checkActive: () -> Unit,
+    ): Long {
+        require(maxBytes > 0)
+        val buffer = ByteArray(32 * 1024)
+        var total = 0L
+        while (true) {
+            checkActive()
+            val count = input.read(buffer)
+            if (count < 0) break
+            if (count == 0) continue
+            require(count <= maxBytes - total) { "Document exceeds the supported size limit" }
+            requireAvailable(available(), count.toLong())
+            output.write(buffer, 0, count)
+            total += count
+        }
+        require(total > 0) { "Empty document" }
+        return total
+    }
+}
