@@ -0,0 +1,42 @@
+package eu.kanade.tachiyomi.data.updater
+
+/** SemVer precedence; build metadata never creates an update. */
+data class PolarisReleaseVersion(
+    val numbers: List<Long>,
+    val prerelease: List<String>,
+) : Comparable<PolarisReleaseVersion> {
+    override fun compareTo(other: PolarisReleaseVersion): Int {
+        numbers.zip(other.numbers).forEach { (left, right) ->
+            left.compareTo(right).takeIf { it != 0 }?.let { return it }
+        }
+        if (prerelease.isEmpty() && other.prerelease.isEmpty()) return 0
+        if (prerelease.isEmpty()) return 1
+        if (other.prerelease.isEmpty()) return -1
+        prerelease.zip(other.prerelease).forEach { (left, right) ->
+            val comparison = when {
+                left.all(Char::isDigit) && right.all(Char::isDigit) ->
+                    left.length.compareTo(right.length).takeIf { it != 0 } ?: left.compareTo(right)
+                left.all(Char::isDigit) -> -1
+                right.all(Char::isDigit) -> 1
+                else -> left.compareTo(right)
+            }
+            if (comparison != 0) return comparison
+        }
+        return prerelease.size.compareTo(other.prerelease.size)
+    }
+
+    companion object {
+        private val pattern = Regex(
+            "^v?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)" +
+                "(?:-([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
+        )
+
+        fun parse(value: String): PolarisReleaseVersion? {
+            val match = pattern.matchEntire(value) ?: return null
+            val numbers = (1..3).map { match.groupValues[it].toLongOrNull() ?: return null }
+            val prerelease = match.groupValues[4].takeIf(String::isNotEmpty)?.split('.') ?: emptyList()
+            if (prerelease.any { it.all(Char::isDigit) && it.length > 1 && it.startsWith('0') }) return null
+            return PolarisReleaseVersion(numbers, prerelease)
+        }
+    }
+}
