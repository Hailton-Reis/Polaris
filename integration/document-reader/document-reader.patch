+                }
+            }
+        )
+        if (schema != null && source.hasLegacyPreferences())
+            screen.addPreference(
+                Preference(context).apply {
+                    title = context.stringResource(ATMR.strings.sandbox_settings_import)
+                    summary = context.stringResource(ATMR.strings.sandbox_settings_import_summary)
+                    setOnPreferenceClickListener {
+                        AlertDialog.Builder(context)
+                            .setTitle(title)
+                            .setMessage(
+                                context.stringResource(
+                                    ATMR.strings.sandbox_settings_import_warning
+                                ) + "\n\n" + source.name
+                            )
+                            .setNegativeButton(android.R.string.cancel, null)
+                            .setPositiveButton(android.R.string.ok) { _, _ ->
+                                screen.isEnabled = false
+                                scope.launch {
+                                    try {
+                                        val accepted =
+                                            withContext(Dispatchers.IO) {
+                                                source.importLegacyPreferences(schema)
+                                            }
