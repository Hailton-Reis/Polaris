@@ -0,0 +1,245 @@
+package eu.kanade.tachiyomi.extension.sandbox
+
+import eu.kanade.tachiyomi.source.model.Filter
+import eu.kanade.tachiyomi.source.model.FilterList
+import java.security.MessageDigest
+import kotlinx.serialization.json.*
+
+/** Only data crosses IPC; the worker applies state to its original extension-defined classes. */
+internal object SandboxFilterCodec {
+    const val MAX_NODES = 512
+    const val MAX_DEPTH = 6
+    const val MAX_TEXT = 4096
+    private const val MAX_SCHEMA_BYTES = 256 * 1024
+
+    private class TaggedList(val nodes: List<Filter<*>>, val token: String) :
+        AbstractList<Filter<*>>() {
+        override val size
+            get() = nodes.size
+
+        override fun get(index: Int) = nodes[index]
+    }
+
+    private class Budget {
+        var count = 0
+
+        fun node(depth: Int) {
+            require(depth <= MAX_DEPTH && ++count <= MAX_NODES) { "Filter tree too large" }
+        }
+    }
+
+    private fun label(value: String): String = value.also { require(it.length <= 1024) }
+
+    private fun choices(values: Array<*>): JsonArray {
+        require(values.size in 1..512)
+        return JsonArray(values.map { JsonPrimitive(label(it.toString())) })
+    }
+
+    fun schema(filters: FilterList): JsonArray {
+        val budget = Budget()
+        val result = JsonArray(filters.map { encode(it, budget, 0) })
+        require(result.toString().toByteArray().size <= MAX_SCHEMA_BYTES)
+        return result
+    }
+
+    private fun encode(filter: Filter<*>, budget: Budget, depth: Int): JsonObject {
+        budget.node(depth)
+        return buildJsonObject {
+            put("name", label(filter.name))
+            when (filter) {
+                is Filter.Header -> put("kind", "header")
+                is Filter.Separator -> put("kind", "separator")
+                is Filter.Text -> {
+                    require(filter.state.length <= MAX_TEXT)
+                    put("kind", "text")
+                    put("state", filter.state)
+                }
+                is Filter.CheckBox -> {
+                    put("kind", "check")
+                    put("state", filter.state)
+                }
+                is Filter.TriState -> {
+                    require(filter.state in 0..2)
+                    put("kind", "tri")
+                    put("state", filter.state)
+                }
+                is Filter.Select<*> -> {
+                    require(filter.state in filter.values.indices)
+                    put("kind", "select")
+                    put("values", choices(filter.values))
+                    put("state", filter.state)
+                }
+                is Filter.Sort -> {
+                    require(filter.state == null || filter.state!!.index in filter.values.indices)
+                    put("kind", "sort")
+                    put("values", choices(filter.values))
+                    put(
+                        "state",
+                        filter.state?.let {
+                            buildJsonObject {
+                                put("index", it.index)
+                                put("ascending", it.ascending)
+                            }
+                        } ?: JsonNull,
+                    )
+                }
+                is Filter.Group<*> -> {
+                    put("kind", "group")
+                    put(
+                        "children",
+                        JsonArray(
+                            filter.state.map {
+                                encode(
+                                    it as? Filter<*> ?: error("Unsupported filter member"),
+                                    budget,
+                                    depth + 1,
+                                )
+                            }
+                        ),
+                    )
+                }
+            }
+        }
+    }
+
+    fun token(schema: JsonArray): String =
+        MessageDigest.getInstance("SHA-256").digest(schema.toString().toByteArray()).joinToString(
+            ""
+        ) {
+            "%02x".format(it)
+        }
+
+    fun host(schema: JsonArray): FilterList {
+        require(schema.toString().toByteArray().size <= MAX_SCHEMA_BYTES)
+        val budget = Budget()
+        fun decode(value: JsonElement, depth: Int): Filter<*> {
+            budget.node(depth)
+            val item = value.jsonObject
+            val name = label(item.getValue("name").jsonPrimitive.content)
+            fun values(): Array<String> =
+                item
+                    .getValue("values")
+                    .jsonArray
+                    .also { require(it.size in 1..512) }
+                    .map { label(it.jsonPrimitive.content) }
+                    .toTypedArray()
+            return when (item.getValue("kind").jsonPrimitive.content) {
+                "header" -> Filter.Header(name)
+                "separator" -> Filter.Separator(name)
+                "text" -> object : Filter.Text(name, string(item.getValue("state"))) {}
+                "check" -> object : Filter.CheckBox(name, boolean(item.getValue("state"))) {}
+                "tri" ->
+                    object :
+                        Filter.TriState(
+                            name,
+                            integer(item.getValue("state")).also { require(it in 0..2) },
+                        ) {}
+                "select" -> {
+                    val options = values()
+                    object :
+                        Filter.Select<String>(
+                            name,
+                            options,
+                            integer(item.getValue("state")).also { require(it in options.indices) },
+                        ) {}
+                }
+                "sort" -> {
+                    val options = values()
+                    object :
+                        Filter.Sort(name, options, sort(item.getValue("state"), options.size)) {}
+                }
+                "group" ->
+                    object :
+                        Filter.Group<Filter<*>>(
+                            name,
+                            item.getValue("children").jsonArray.map { decode(it, depth + 1) },
+                        ) {}
+                else -> error("Unsupported filter kind")
+            }
+        }
+        return FilterList(TaggedList(schema.map { decode(it, 0) }, token(schema)))
+    }
+
+    fun selection(filters: FilterList): JsonObject? {
+        if (filters.isEmpty()) return null
+        val tag =
+            filters.list as? TaggedList
+                ?: error("Filters did not originate from this isolated source")
+        return buildJsonObject {
+            put("schema", tag.token)
+            put("values", schema(filters))
+        }
+    }
+
+    fun apply(filters: FilterList, selected: JsonObject) {
+        val expected = selected.getValue("schema").jsonPrimitive.content
+        require(expected == token(schema(filters))) { "Filter options changed; reload filters" }
+        val values = selected.getValue("values").jsonArray
+        val budget = Budget()
+        val updates = mutableListOf<() -> Unit>()
+        fun plan(target: Filter<*>, element: JsonElement, depth: Int) {
+            budget.node(depth)
+            val value = element.jsonObject
+            val descriptor = encode(target, Budget(), 0)
+            require(value.keys == descriptor.keys)
+            require(value["kind"] == descriptor["kind"] && value["name"] == descriptor["name"])
+            if ("values" in descriptor) require(value["values"] == descriptor["values"])
+            when (target) {
+                is Filter.Header,
+                is Filter.Separator -> require(value.keys == descriptor.keys)
+                is Filter.Text -> {
+                    val state = string(value.getValue("state"))
+                    updates += { target.state = state }
+                }
+                is Filter.CheckBox -> {
+                    val state = boolean(value.getValue("state"))
+                    updates += { target.state = state }
+                }
+                is Filter.TriState -> {
+                    val state = integer(value.getValue("state"))
+                    require(state in 0..2)
+                    updates += { target.state = state }
+                }
+                is Filter.Select<*> -> {
+                    val state = integer(value.getValue("state"))
+                    require(state in target.values.indices)
+                    updates += { target.state = state }
+                }
+                is Filter.Sort -> {
+                    val state = sort(value.getValue("state"), target.values.size)
+                    updates += { target.state = state }
+                }
+                is Filter.Group<*> -> {
+                    val children = value.getValue("children").jsonArray
+                    require(children.size == target.state.size)
+                    target.state.zip(children).forEach { (child, input) ->
+                        plan(
+                            child as? Filter<*> ?: error("Unsupported filter member"),
+                            input,
+                            depth + 1,
+                        )
+                    }
+                }
+            }
+        }
+        require(values.size == filters.size)
+        filters.zip(values).forEach { (target, value) -> plan(target, value, 0) }
+        updates.forEach { it() }
+    }
+
+    private fun string(value: JsonElement) =
+        value.jsonPrimitive.also { require(it.isString && it.content.length <= MAX_TEXT) }.content
+
+    private fun integer(value: JsonElement) = value.jsonPrimitive.also { require(!it.isString) }.int
+
+    private fun boolean(value: JsonElement) =
+        value.jsonPrimitive.also { require(!it.isString) }.boolean
+
+    private fun sort(value: JsonElement, size: Int): Filter.Sort.Selection? {
+        if (value == JsonNull) return null
+        val objectValue = value.jsonObject
+        val index = integer(objectValue.getValue("index"))
+        require(index in 0 until size)
+        return Filter.Sort.Selection(index, boolean(objectValue.getValue("ascending")))
+    }
+}
