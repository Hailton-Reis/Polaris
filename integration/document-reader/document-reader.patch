index 0000000..9f67cab
--- /dev/null
+++ b/app/src/main/java/eu/kanade/tachiyomi/extension/sandbox/SandboxPreferenceCodec.kt
@@ -0,0 +1,298 @@
+package eu.kanade.tachiyomi.extension.sandbox
+
+import androidx.preference.*
+import eu.kanade.tachiyomi.data.preference.SharedPreferencesDataStore
+import eu.kanade.tachiyomi.source.ConfigurableSource
+import eu.kanade.tachiyomi.source.online.HttpSource
+import java.security.MessageDigest
+import kotlinx.serialization.json.*
+
+/**
+ * Extension UI/callback objects remain in the worker. The host receives stock-widget descriptors.
+ */
+internal object SandboxPreferenceCodec {
+    data class Screen(
+        val source: ConfigurableSource,
+        val root: PreferenceScreen,
+        val values: android.content.SharedPreferences,
+    )
+
+    fun screen(source: HttpSource, application: SandboxWorkerApplication): Screen {
+        val configurable = source as? ConfigurableSource ?: error("Source has no preferences")
+        val prefs =
+            application.getSharedPreferences(
+                "source_${source.id}",
+                android.content.Context.MODE_PRIVATE,
+            )
+        val themed =
+            android.view.ContextThemeWrapper(
+                application,
+                androidx.preference.R.style.PreferenceThemeOverlay,
+            )
+        val manager = PreferenceManager(themed)
+        manager.preferenceDataStore = SharedPreferencesDataStore(prefs)
+        val root = manager.createPreferenceScreen(themed)
+        manager.setPreferences(root)
+        configurable.setupPreferenceScreen(root)
+        root.onAttached()
+        return Screen(configurable, root, prefs)
+    }
+
+    fun schema(screen: Screen): JsonObject {
+        var count = 0
+        val keys = mutableSetOf<String>()
+        fun text(value: CharSequence?) = value?.toString()?.also { require(it.length <= 4096) }
+        fun node(pref: Preference, depth: Int): JsonObject {
+            require(depth <= 6 && ++count <= 256)
+            val key = pref.key?.also { require(it.length in 1..200 && keys.add(it)) }
+            val kind =
+                when (pref) {
+                    is PreferenceGroup -> "group"
+                    is SwitchPreferenceCompat,
+                    is SwitchPreference -> "switch"
+                    is CheckBoxPreference -> "check"
+                    is ListPreference -> "list"
+                    is MultiSelectListPreference -> "multi"
+                    is EditTextPreference -> "text"
+                    else -> "info"
+                }
+            val editable = kind in setOf("switch", "check", "list", "multi", "text")
+            if (editable) require(key != null)
+            val unsupportedAction =
+                pref.intent != null ||
+                    pref.fragment != null ||
+                    pref.onPreferenceClickListener != null
+            return buildJsonObject {
+                put("kind", kind)
+                key?.let { put("key", it) }
+                put("title", text(pref.title).orEmpty())
+                text(pref.summary)?.let { put("summary", it) }
+                put("visible", pref.isVisible)
+                put(
+                    "enabled",
+                    (if (pref is PreferenceCategory) !pref.shouldDisableDependents()
+                    else pref.isEnabled) && !unsupportedAction,
+                )
+                put("unsupportedAction", unsupportedAction || kind == "info")
+                if (pref is DialogPreference) text(pref.dialogMessage)?.let { put("message", it) }
+                when (pref) {
+                    is PreferenceGroup ->
+                        put(
+                            "children",
+                            JsonArray(
+                                (0 until pref.preferenceCount).map {
+                                    node(pref.getPreference(it), depth + 1)
+                                }
+                            ),
+                        )
+                    is TwoStatePreference -> put("value", pref.isChecked)
+                    is ListPreference -> {
+                        val entries = pref.entries.orEmpty()
+                        val values = pref.entryValues.orEmpty()
+                        require(entries.size == values.size && entries.size <= 512)
+                        put("entries", JsonArray(entries.map { JsonPrimitive(text(it).orEmpty()) }))
+                        put("values", JsonArray(values.map { JsonPrimitive(text(it).orEmpty()) }))
+                        put("value", pref.value?.let(::JsonPrimitive) ?: JsonNull)
+                    }
+                    is MultiSelectListPreference -> {
+                        val entries = pref.entries.orEmpty()
+                        val values = pref.entryValues.orEmpty()
+                        require(entries.size == values.size && entries.size <= 512)
+                        put("entries", JsonArray(entries.map { JsonPrimitive(text(it).orEmpty()) }))
+                        put("values", JsonArray(values.map { JsonPrimitive(text(it).orEmpty()) }))
+                        put("value", JsonArray(pref.values.orEmpty().sorted().map(::JsonPrimitive)))
+                    }
+                    is EditTextPreference -> {
+                        put("value", pref.text?.let(::JsonPrimitive) ?: JsonNull)
+                        put("password", key?.let(SandboxPreferenceValues::sensitive) == true)
+                    }
+                }
+            }
+        }
+        val nodes =
+            JsonArray(
+                (0 until screen.root.preferenceCount).map { node(screen.root.getPreference(it), 0) }
+            )
+        require(nodes.toString().toByteArray().size <= 128 * 1024)
+        return buildJsonObject {
+            put("nodes", nodes)
+            put("schema", token(nodes))
+        }
+    }
+
+    fun validate(schema: JsonObject) {
+        val nodes = schema.getValue("nodes").jsonArray
+        require(nodes.toString().toByteArray().size <= 128 * 1024)
+        require(schema.getValue("schema").jsonPrimitive.content == token(nodes))
+        var count = 0
+        val keys = mutableSetOf<String>()
+        fun string(value: JsonElement) {
+            require(value.jsonPrimitive.isString && value.jsonPrimitive.content.length <= 4096)
+        }
+        fun node(element: JsonElement, depth: Int) {
+            require(depth <= 6 && ++count <= 256)
+            val value = element.jsonObject
+            val kind = value.getValue("kind").jsonPrimitive.content
+            require(kind in setOf("group", "switch", "check", "text", "list", "multi", "info"))
+            string(value.getValue("title"))
+            value["summary"]?.let(::string)
+            value["message"]?.let(::string)
+            for (flag in listOf("enabled", "visible", "unsupportedAction")) require(
+                !value.getValue(flag).jsonPrimitive.isString &&
+                    value.getValue(flag).jsonPrimitive.booleanOrNull != null
+            )
+            value["key"]?.let { key ->
+                string(key)
+                require(
+                    key.jsonPrimitive.content.length in 1..200 &&
+                        keys.add(key.jsonPrimitive.content)
+                )
+            }
+            if (kind in setOf("switch", "check", "text", "list", "multi"))
+                require(value["key"] != null)
+            if (kind in setOf("list", "multi")) {
+                val entries = value.getValue("entries").jsonArray
+                val values = value.getValue("values").jsonArray
+                require(entries.size == values.size && entries.size <= 512)
+                entries.forEach(::string)
+                values.forEach(::string)
+            }
+            when (kind) {
+                "group" -> value.getValue("children").jsonArray.forEach { node(it, depth + 1) }
+                "switch",
+                "check" ->
+                    require(
+                        !value.getValue("value").jsonPrimitive.isString &&
+                            value.getValue("value").jsonPrimitive.booleanOrNull != null
+                    )
+                "text",
+                "list" -> if (value.getValue("value") != JsonNull) string(value.getValue("value"))
+                "multi" ->
+                    value
+                        .getValue("value")
+                        .jsonArray
+                        .also { require(it.size <= 256) }
+                        .forEach(::string)
+            }
+            value["password"]?.let {
+                require(!it.jsonPrimitive.isString && it.jsonPrimitive.booleanOrNull != null)
+            }
+        }
+        nodes.forEach { node(it, 0) }
+    }
+
+    private fun token(nodes: JsonArray): String {
+        fun shape(element: JsonElement): JsonElement =
+            when (element) {
+                is JsonArray -> JsonArray(element.map(::shape))
+                is JsonObject ->
+                    JsonObject(
+                        element
+                            .filterKeys { it !in setOf("value", "summary", "enabled", "visible") }
+                            .mapValues { (_, value) -> shape(value) }
+                    )
+                else -> element
+            }
+        return MessageDigest.getInstance("SHA-256")
+            .digest(shape(nodes).toString().toByteArray())
+            .joinToString("") { "%02x".format(it) }
+    }
+
+    fun importValues(screen: Screen, schemaToken: String, changes: JsonObject): Boolean {
+        val descriptor = schema(screen)
+        require(descriptor.getValue("schema").jsonPrimitive.content == schemaToken)
+        val keys = mutableSetOf<String>()
+        fun collect(array: JsonArray) {
+            array.forEach { item ->
+                val node = item.jsonObject
+                if (
+                    node["kind"]?.jsonPrimitive?.content in
+                        setOf("switch", "check", "text", "list", "multi")
+                )
+                    node["key"]?.jsonPrimitive?.content?.let(keys::add)
+                (node["children"] as? JsonArray)?.let(::collect)
+            }
+        }
+        collect(descriptor.getValue("nodes").jsonArray)
+        val incoming = SandboxPreferenceValues.decode(changes)
+        require(incoming.keys.all { it in keys })
+        val current = screen.values.all
+        val knownTypes = SandboxPreferenceValues.encode(current)
+        incoming.forEach { (key, _) ->
+            knownTypes[key]?.let {
+                require(
+                    it.jsonObject.getValue("type") ==
+                        changes.getValue(key).jsonObject.getValue("type")
+                ) {
+                    "Restored preference type changed"
+                }
+            }
+        }
+        // Restore stored types, not UI input types (custom listeners can persist integers from
+        // text).
+        SandboxPreferenceValues.write(screen.values, current + incoming)
+        return true
+    }
+
+    fun change(screen: Screen, schemaToken: String, changes: JsonObject): Boolean {
+        val descriptor = schema(screen)
+        require(descriptor.getValue("schema").jsonPrimitive.content == schemaToken) {
+            "Preference options changed"
+        }
+        val decoded = SandboxPreferenceValues.decode(changes)
+        val nodes = linkedMapOf<String, JsonObject>()
+        fun collect(array: JsonArray) {
+            array.forEach { item ->
+                val value = item.jsonObject
+                value["key"]?.jsonPrimitive?.content?.let { nodes[it] = value }
+                (value["children"] as? JsonArray)?.let(::collect)
+            }
+        }
+        collect(descriptor.getValue("nodes").jsonArray)
+        val planned =
+            decoded.map { (key, value) ->
+                val node = nodes[key] ?: error("Unknown preference key")
+                require(
+                    node.getValue("enabled").jsonPrimitive.boolean &&
+                        node.getValue("visible").jsonPrimitive.boolean
+                )
+                when (node.getValue("kind").jsonPrimitive.content) {
+                    "switch",
+                    "check" -> require(value is Boolean)
+                    "text" -> require(value is String)
+                    "list" ->
+                        require(
+                            value is String &&
+                                value in
+                                    node.getValue("values").jsonArray.map {
+                                        it.jsonPrimitive.content
+                                    }
+                        )
+                    "multi" ->
+                        require(
+                            value is Set<*> &&
+                                value.all {
+                                    it is String &&
+                                        it in
+                                            node.getValue("values").jsonArray.map { e ->
+                                                e.jsonPrimitive.content
+                                            }
+                                }
+                        )
+                    else -> error("Preference is not editable")
+                }
+                val pref =
+                    screen.root.findPreference<Preference>(key) ?: error("Missing preference")
+                Triple(pref, key, value)
+            }
+        // A false callback suppresses the default write; its own scoped writes still follow
+        // AndroidX semantics.
+        val accepted = linkedMapOf<String, Any>()
+        for ((pref, key, value) in planned) if (pref.callChangeListener(value))
+            accepted[key] = value
+        val next = screen.values.all.toMutableMap()
+        accepted.forEach { (key, value) -> next[key] = value }
+        if (next != screen.values.all) SandboxPreferenceValues.write(screen.values, next)
+        return accepted.size == planned.size
+    }
+}
diff --git a/app/src/main/java/eu/kanade/tachiyomi/extension/sandbox/SandboxPreferenceStore.kt b/app/src/main/java/eu/kanade/tachiyomi/extension/sandbox/SandboxPreferenceStore.kt
