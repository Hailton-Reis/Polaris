index 0000000..60652dd
--- /dev/null
+++ b/app/src/main/java/eu/kanade/tachiyomi/extension/sandbox/SandboxNetworkPolicy.kt
@@ -0,0 +1,88 @@
+package eu.kanade.tachiyomi.extension.sandbox
+
+import java.net.InetAddress
+import java.net.URI
+import java.util.Locale
+
+/** Every request and redirect is checked; socket DNS must use these same address checks. */
+internal object SandboxNetworkPolicy {
+    const val MAX_REQUEST_BYTES = 512 * 1024
+    const val MAX_RESPONSE_BYTES = 10 * 1024 * 1024
+
+    fun requireUrl(value: String): URI {
+        require(value.length <= 8192) { "URL too long" }
+        val url = URI(value)
+        val scheme = url.scheme?.lowercase(Locale.ROOT)
+        require(scheme in setOf("https", "http") && url.rawUserInfo == null) {
+            "Unsupported URL or credentials"
+        }
+        val host = url.host?.lowercase(Locale.ROOT)?.trim('[', ']') ?: error("Missing network host")
+        require(
+            host.isNotBlank() &&
+                !host.endsWith('.') &&
+                host != "localhost" &&
+                !host.endsWith(".localhost") &&
+                !host.endsWith(".local") &&
+                !host.endsWith(".internal") &&
+                !host.endsWith(".lan") &&
+                host != "metadata.google.internal"
+        ) {
+            "Local network host blocked"
+        }
+        // OkHttp may skip Dns.lookup for literal IPs. Validate them before any socket exists.
+        if (':' in host || host.all { it.isDigit() || it == '.' }) {
+            requirePublic(listOf(InetAddress.getByName(host)))
+        }
+        require(
+            url.port == -1 ||
+                (scheme == "https" && url.port == 443) ||
+                (scheme == "http" && url.port == 80)
+        ) {
+            "Network port blocked"
+        }
+        return url
+    }
+
+    fun requirePublic(addresses: List<InetAddress>): List<InetAddress> {
+        val local =
+            java.net.NetworkInterface.getNetworkInterfaces()
+                ?.toList()
+                .orEmpty()
+                .flatMap { it.inetAddresses.toList() }
+                .toSet()
+        require(addresses.isNotEmpty() && addresses.all { isPublic(it) && it !in local }) {
+            "Private, reserved or mixed DNS address blocked"
+        }
+        return addresses
+    }
+
+    fun isPublic(address: InetAddress): Boolean {
+        if (
+            address.isAnyLocalAddress ||
+                address.isLoopbackAddress ||
+                address.isLinkLocalAddress ||
+                address.isSiteLocalAddress ||
+                address.isMulticastAddress
+        )
+            return false
+        val b = address.address.map { it.toInt() and 255 }
+        if (b.size == 4) return ipv4(b)
+        if (b.size != 16 || (b[0] and 0xe0) != 0x20) return false // global unicast only
+        if (b[0] == 0x20 && b[1] == 1 && b[2] == 0x0d && b[3] == 0xb8) return false // documentation
+        if (b[0] == 0x20 && b[1] == 1 && b[2] == 0 && b[3] == 0) return false // Teredo
+        if (b[0] == 0x20 && b[1] == 2 && !ipv4(b.subList(2, 6))) return false // 6to4
+        return true
+    }
+
+    private fun ipv4(b: List<Int>): Boolean =
+        when {
+            b[0] == 0 || b[0] == 10 || b[0] == 127 || b[0] >= 224 -> false
+            b[0] == 100 && b[1] in 64..127 -> false
+            b[0] == 169 && b[1] == 254 -> false
+            b[0] == 172 && b[1] in 16..31 -> false
+            b[0] == 192 && (b[1] == 168 || (b[1] == 0 && b[2] in setOf(0, 2))) -> false
+            b[0] == 198 && (b[1] in 18..19 || (b[1] == 51 && b[2] == 100)) -> false
+            b[0] == 203 && b[1] == 0 && b[2] == 113 -> false
+            else -> true
+        }
+}
diff --git a/app/src/main/java/eu/kanade/tachiyomi/extension/sandbox/SandboxPreferenceCodec.kt b/app/src/main/java/eu/kanade/tachiyomi/extension/sandbox/SandboxPreferenceCodec.kt
