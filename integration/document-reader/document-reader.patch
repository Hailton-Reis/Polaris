+import eu.kanade.domain.ui.model.LauncherIcon
+import eu.kanade.domain.ui.model.LauncherIconRewards
+import tachiyomi.i18n.at.ATMR as MR
+import tachiyomi.presentation.core.i18n.stringResource
+
+@Composable
+internal fun AppIconPreferenceWidget(
+    value: LauncherIcon,
+    xp: Long = 0,
+    unlocked: Set<LauncherIcon>? = null,
+    achievements: eu.kanade.tachiyomi.data.profile.AchievementProgress =
+        eu.kanade.tachiyomi.data.profile.AchievementProgress(),
+    onSelect: (LauncherIcon) -> Unit,
+) {
+    val availableIcons =
+        unlocked ?: LauncherIconRewards.unlocked(xp, emptySet(), value, achievements)
+    Column(Modifier.padding(horizontal = 16.dp), verticalArrangement = Arrangement.spacedBy(8.dp)) {
+        Text(
+            stringResource(MR.strings.polaris_launcher_icon),
+            style = MaterialTheme.typography.titleMedium,
+        )
+        Text(
+            stringResource(MR.strings.polaris_icon_points, xp),
+            style = MaterialTheme.typography.bodySmall,
+        )
+        LauncherIcon.entries.chunked(2).forEach { row ->
+            Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                row.forEach { icon ->
+                    val available = icon in availableIcons
+                    OutlinedCard(
+                        onClick = { onSelect(icon) },
+                        enabled = available,
+                        modifier = Modifier.weight(1f),
+                        colors =
+                            CardDefaults.outlinedCardColors(
+                                containerColor =
+                                    if (value == icon) MaterialTheme.colorScheme.secondaryContainer
+                                    else MaterialTheme.colorScheme.surface
+                            ),
+                    ) {
+                        Column(
+                            Modifier.fillMaxWidth().padding(12.dp),
+                            horizontalAlignment = Alignment.CenterHorizontally,
+                            verticalArrangement = Arrangement.spacedBy(6.dp),
+                        ) {
+                            Surface(
+                                color = Color(icon.background),
+                                shape = MaterialTheme.shapes.medium,
+                            ) {
+                                Image(
+                                    painterResource(icon.preview),
+                                    stringResource(icon.title),
+                                    Modifier.size(72.dp),
+                                    contentScale = ContentScale.Fit,
+                                )
+                            }
+                            Text(
+                                stringResource(icon.title),
+                                style = MaterialTheme.typography.labelLarge,
+                                textAlign = TextAlign.Center,
+                            )
+                            Text(
+                                when {
+                                    value == icon ->
+                                        stringResource(tachiyomi.i18n.MR.strings.selected)
+                                    available -> stringResource(MR.strings.polaris_icon_unlocked)
+                                    else -> stringResource(MR.strings.polaris_achievement_any)
+                                },
+                                style = MaterialTheme.typography.labelSmall,
+                                textAlign = TextAlign.Center,
+                            )
+                        }
+                    }
+                }
+            }
+        }
+        Text(
+            stringResource(MR.strings.polaris_launcher_icon_help),
+            style = MaterialTheme.typography.bodySmall,
+            color = MaterialTheme.colorScheme.onSurfaceVariant,
+        )
+        eu.kanade.presentation.more.profile.GrimoireAchievements(xp, achievements, availableIcons)
+    }
+}
