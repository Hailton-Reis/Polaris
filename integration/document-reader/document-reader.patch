+
+    @Test
+    fun `portable association resolves after destination local IDs change`() {
+        val a = manga(1)
+        val b = manga(2)
+        val state = association(a, b)
+        val restored =
+            listOf(a.copy(id = 101), b.copy(id = 202)).map { it.copy(memo = state.attach(it.memo)) }
+        assertEquals(listOf(101L, 202L), state.resolve(restored.first(), restored).map { it.id })
+        assertFalse(state.attach(JsonObject(emptyMap())).toString().contains("mangaId"))
