+++ b/app/src/main/java/eu/kanade/tachiyomi/data/backup/models/PortableMangaBackup.kt
@@ -0,0 +1,316 @@
+package eu.kanade.tachiyomi.data.backup.models
+
+import java.util.Base64
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.jsonPrimitive
+import kotlinx.serialization.protobuf.ProtoBuf
+import tachiyomi.data.MemoColumnAdapter
+import tachiyomi.domain.chapter.model.ChapterOrigin
+import tachiyomi.domain.chapter.model.ChapterVersions
+import tachiyomi.domain.manga.model.WorkSources
+
+/** Native source/URLs for other readers; optional memo preserves all Polaris editions locally. */
+internal object PortableMangaBackup {
+    private const val KEY = "polaris.backup.work.v1"
+    private const val MAX_SNAPSHOT = 16 * 1024 * 1024
+    private val codec = ProtoBuf
+
+    @Serializable
+    private data class Envelope(val source: Long, val url: String, val original: BackupManga)
+
+    private fun origin(chapter: BackupChapter) =
+        ChapterOrigin.from(MemoColumnAdapter.decode(chapter.memo))
+
+    private fun key(chapter: BackupChapter) = ChapterVersions.key(chapter.toChapterImpl())
+
+    private fun copy(manga: BackupManga): BackupManga =
+        codec.decodeFromByteArray(
+            BackupManga.serializer(),
+            codec.encodeToByteArray(BackupManga.serializer(), manga),
+        )
+
+    fun export(original: BackupManga): BackupManga {
+        require(KEY !in MemoColumnAdapter.decode(original.memo)) {
+            "Backup work is already projected"
+        }
+        if (
+            original.chapters.none { ChapterOrigin.isRouted(it.url) } &&
+                original.history.none { ChapterOrigin.isRouted(it.url) }
+        )
+            return original
+        val settings = WorkSources.from(MemoColumnAdapter.decode(original.memo))
+        val grouped = original.chapters.groupBy { origin(it)?.sourceId ?: original.source }
+        val choices =
+            settings.candidates.filter { binding ->
+                grouped[binding.sourceId].orEmpty().any {
+                    val o = origin(it)
+                    (o == null && binding.url == original.url) || o?.mangaUrl == binding.url
+                } && (settings.pinned == null || settings.pinned?.key == binding.key)
+            }
+        val versions = original.chapters.groupBy(::key)
+        fun covered(binding: tachiyomi.domain.manga.model.WorkSource) =
+            grouped[binding.sourceId]
+                .orEmpty()
+                .filter { chapter ->
+                    val o = origin(chapter)
+                    o?.mangaUrl == binding.url || (o == null && binding.url == original.url)
+                }
+                .map(::key)
+                .toSet()
+        val primary =
+            choices
+                .sortedWith(
+                    compareBy<tachiyomi.domain.manga.model.WorkSource> { !it.available }
+                        .thenBy {
+                            when (it.readability) {
+                                "sample_failed" -> 1
+                                else -> 0
+                            }
+                        }
+                        // A single-source reader cannot represent the union. Prefer coverage of
+                        // reading progress, then total coverage, before its language preference.
+                        .thenByDescending { binding ->
+                            covered(binding).count { logical ->
+                                versions[logical].orEmpty().any { it.read || it.lastPageRead > 0 }
+                            }
+                        }
+                        .thenByDescending { covered(it).size }
+                        .thenBy {
+                            when (it.language) {
+                                "pt-BR" -> 0
+                                "pt" -> 1
+                                "en" -> 2
+                                else -> 3
+                            }
+                        }
+                        .thenByDescending { it.chapters }
+                        .thenBy { it.key }
+                )
+                .firstOrNull()
+        val source = primary?.sourceId ?: original.source
+        val url = primary?.url ?: original.url
+        val projected = copy(original)
+        projected.source = source
+        projected.url = url
+        if (primary != null) {
+            projected.title = primary.title
+            projected.author = primary.author ?: original.author
+            projected.artist = primary.artist ?: original.artist
+        }
+        projected.chapters =
+            original.chapters
+                .filter { chapter ->
+                    val o = origin(chapter)
+                    if (o == null)
+                        source == original.source &&
+                            url == original.url &&
+                            !ChapterOrigin.isRouted(chapter.url)
+                    else
+                        o.sourceId == source &&
+                            o.mangaUrl == url &&
+                            !ChapterOrigin.isRouted(o.chapterUrl)
+                }
+                .map { chapter ->
+                    val o = origin(chapter)
+                    // Work on the copied DTO; do not mutate the database's backup snapshot.
+                    val native = projectedChapter(chapter)
+                    native.url = o?.chapterUrl ?: chapter.url
+                    native.read = versions.getValue(key(chapter)).any { it.read }
+                    native.bookmark = versions.getValue(key(chapter)).any { it.bookmark }
+                    native.memo =
+                        MemoColumnAdapter.encode(
+                            JsonObject(MemoColumnAdapter.decode(native.memo) - ChapterOrigin.KEY)
+                        )
+                    native
+                }
+                .distinctBy { it.url }
+        val nativeByKey = projected.chapters.groupBy(::key)
+        val originalByUrl = original.chapters.associateBy { it.url }
+        projected.history =
+            original.history
+                .mapNotNull { h ->
+                    val chapter =
+                        originalByUrl[h.url]
+                            ?: return@mapNotNull h.takeUnless { ChapterOrigin.isRouted(it.url) }
+                    val target = nativeByKey[key(chapter)]?.firstOrNull() ?: return@mapNotNull null
+                    h.copy(url = target.url)
+                }
+                .groupBy { it.url }
+                .map { (nativeUrl, history) ->
+                    BackupHistory(
+                        nativeUrl,
+                        history.maxOf { it.lastRead },
+                        history.sumOf { it.readDuration },
+                    )
+                }
+        val bytes = codec.encodeToByteArray(Envelope.serializer(), Envelope(source, url, original))
+        require(bytes.size <= MAX_SNAPSHOT) { "Merged work exceeds portable backup limit" }
+        val memo = MemoColumnAdapter.decode(projected.memo)
+        projected.memo =
+            MemoColumnAdapter.encode(
+                JsonObject(
+                    (memo - WorkSources.KEY) +
+                        (KEY to JsonPrimitive(Base64.getEncoder().encodeToString(bytes)))
+                )
+            )
+        check(projected.chapters.none { ChapterOrigin.isRouted(it.url) })
+        check(projected.history.none { ChapterOrigin.isRouted(it.url) })
+        return projected
+    }
+
+    /** Used before lookup by source/URL so a Polaris round trip restores its original identity. */
+    fun restore(portable: BackupManga): BackupManga {
+        val encoded =
+            MemoColumnAdapter.decode(portable.memo)[KEY]?.jsonPrimitive?.content ?: return portable
+        require(encoded.length <= ((MAX_SNAPSHOT + 2) / 3) * 4) { "Oversized merged-work backup" }
+        val bytes = Base64.getDecoder().decode(encoded)
+        require(bytes.size <= MAX_SNAPSHOT)
+        val envelope = codec.decodeFromByteArray(Envelope.serializer(), bytes)
+        if (envelope.source != portable.source || envelope.url != portable.url) {
+            // A native reader may migrate the work and retain unknown memo fields. Its new
+            // identity wins; never resurrect the old Polaris work under a different source.
+            return copy(portable).also {
+                it.memo =
+                    MemoColumnAdapter.encode(JsonObject(MemoColumnAdapter.decode(it.memo) - KEY))
+            }
+        }
+        val raw = envelope.original
+        require(KEY !in MemoColumnAdapter.decode(raw.memo)) { "Nested merged-work snapshot" }
+        val native = portable.chapters.associateBy { it.url }
+        fun nativeUrl(chapter: BackupChapter): String? {
+            val o = origin(chapter)
+            return when {
+                o != null && o.sourceId == portable.source && o.mangaUrl == portable.url ->
+                    o.chapterUrl
+                o == null && raw.source == portable.source && raw.url == portable.url -> chapter.url
+                else -> null
+            }
+        }
+        val knownNative = raw.chapters.mapNotNull(::nativeUrl).toSet()
+        val binding =
+            WorkSources.from(MemoColumnAdapter.decode(raw.memo)).candidates.firstOrNull {
+                it.sourceId == portable.source && it.url == portable.url
+            }
+        // A native reader may have fetched new chapters while retaining the optional envelope.
+        raw.chapters =
+            raw.chapters +
+                portable.chapters
+                    .filter { it.url !in knownNative && !ChapterOrigin.isRouted(it.url) }
+                    .map { chapter ->
+                        projectedChapter(chapter).also { added ->
+                            val clean =
+                                JsonObject(
+                                    MemoColumnAdapter.decode(chapter.memo).filterKeys {
+                                        !it.startsWith("polaris.")
+                                    }
+                                )
+                            val o =
+                                ChapterOrigin(
+                                    portable.source,
+                                    binding?.name.orEmpty(),
+                                    binding?.language.orEmpty(),
+                                    portable.url,
+                                    chapter.url,
+                                    sourceMemo = clean,
+                                )
+                            added.url =
+                                if (portable.source == raw.source && portable.url == raw.url)
+                                    chapter.url
+                                else ChapterOrigin.storedUrl(portable.source, chapter.url)
+                            added.memo = MemoColumnAdapter.encode(o.attach(clean))
+                        }
+                    }
+        val originalGroups = raw.chapters.groupBy(::key)
+        raw.chapters.forEach { chapter ->
+            val corresponding = nativeUrl(chapter)?.let(native::get) ?: return@forEach
+            val group = originalGroups.getValue(key(chapter))
+            val wasRead = group.any { it.read }
+            val wasBookmarked = group.any { it.bookmark }
+            // Only changes made in a reader retaining memo affect the saved Polaris editions.
+            if (corresponding.read != wasRead) group.forEach { it.read = corresponding.read }
+            if (corresponding.bookmark != wasBookmarked)
+                group.forEach { it.bookmark = corresponding.bookmark }
+            chapter.lastPageRead = corresponding.lastPageRead
+        }
+        val byStoredUrl = raw.chapters.associateBy { it.url }
+        val byNativeUrl = raw.chapters.mapNotNull { c -> nativeUrl(c)?.let { it to c } }.toMap()
+        val histories = raw.history.toMutableList()
+        portable.history
+            .groupBy { it.url }
+            .forEach { (url, incoming) ->
+                val target = byNativeUrl[url] ?: return@forEach
+                val logical = key(target)
+                val previous = histories.filter { h -> byStoredUrl[h.url]?.let(::key) == logical }
+                val duration = incoming.sumOf { it.readDuration }
+                val lastRead = incoming.maxOf { it.lastRead }
+                val delta = (duration - previous.sumOf { it.readDuration }).coerceAtLeast(0)
+                if (delta > 0 || lastRead > (previous.maxOfOrNull { it.lastRead } ?: 0L)) {
+                    val index = histories.indexOfFirst { it.url == target.url }
+                    val own = histories.getOrNull(index)
+                    val updated =
+                        BackupHistory(
+                            target.url,
+                            maxOf(own?.lastRead ?: 0, lastRead),
+                            (own?.readDuration ?: 0) + delta,
+                        )
+                    if (index >= 0) histories[index] = updated else histories += updated
+                }
+            }
+        raw.history = histories
+        // Preserve edits made in another reader to the standard, portable settings.
+        // Identity/edition metadata remains from the saved Polaris work.
+        raw.categories = portable.categories
+        raw.tracking = portable.tracking
+        raw.favorite = portable.favorite
+        raw.dateAdded = portable.dateAdded
+        raw.viewer = portable.viewer
+        raw.viewer_flags = portable.viewer_flags
+        raw.chapterFlags = portable.chapterFlags
+        raw.updateStrategy = portable.updateStrategy
+        raw.lastModifiedAt = portable.lastModifiedAt
+        raw.favoriteModifiedAt = portable.favoriteModifiedAt
+        raw.excludedScanlators = portable.excludedScanlators
+        raw.version = portable.version
+        raw.notes = portable.notes
+        raw.nextUpdate = portable.nextUpdate
+        return raw
+    }
+
+    data class SourceDescriptor(val id: Long, val name: String, val language: String)
+
+    fun sourceDescriptors(portable: BackupManga): List<SourceDescriptor> {
+        val raw = restore(portable)
+        val bindings =
+            WorkSources.from(MemoColumnAdapter.decode(raw.memo)).candidates.map {
+                SourceDescriptor(it.sourceId, it.name, it.language)
+            }
+        val origins =
+            raw.chapters
+                .mapNotNull { origin(it) }
+                .map { SourceDescriptor(it.sourceId, it.sourceName, it.language) }
+        return (bindings +
+                origins +
+                SourceDescriptor(raw.source, "", "") +
+                SourceDescriptor(portable.source, "", ""))
+            .distinctBy { it.id }
+    }
+
+    private fun projectedChapter(c: BackupChapter) =
+        BackupChapter(
+            c.url,
+            c.name,
+            c.scanlator,
+            c.read,
+            c.bookmark,
+            c.lastPageRead,
+            c.dateFetch,
+            c.dateUpload,
+            c.chapterNumber,
+            c.sourceOrder,
+            c.lastModifiedAt,
+            c.version,
+            c.memo,
+        )
+}
