@@ -0,0 +1,168 @@
+package eu.kanade.tachiyomi.extension.sandbox
+
+import android.app.Application
+import android.content.Context
+import android.content.SharedPreferences
+import kotlinx.serialization.json.*
+
+/** In-memory worker state. The real host Application or its SharedPreferences never cross IPC. */
+internal class SandboxWorkerApplication(base: Context, input: JsonObject) : Application() {
+    private val preferences = linkedMapOf<String, MemoryPreferences>()
+
+    init {
+        attachBaseContext(base)
+        require(
+            input.size <= 256 &&
+                input.toString().toByteArray().size <= ExtensionSandboxProtocol.MAX_INPUT
+        )
+        input.forEach { (name, values) ->
+            requireName(name)
+            preferences[name] = MemoryPreferences(SandboxPreferenceValues.decode(values.jsonObject))
+        }
+    }
+
+    private fun requireName(name: String) {
+        require(name.matches(Regex("source_[1-9][0-9]{0,18}")))
+    }
+
+    override fun getApplicationContext(): Context = this
+
+    @Synchronized
+    override fun getSharedPreferences(name: String, mode: Int): SharedPreferences {
+        requireName(name)
+        require(mode == Context.MODE_PRIVATE)
+        if (name !in preferences) {
+            require(preferences.size < 256)
+            preferences[name] = MemoryPreferences(emptyMap())
+        }
+        return preferences.getValue(name)
+    }
+
+    @Synchronized
+    fun restore(snapshot: JsonObject) {
+        preferences.forEach { (name, prefs) ->
+            prefs.restore(
+                snapshot[name]?.jsonObject?.let(SandboxPreferenceValues::decode).orEmpty()
+            )
+        }
+    }
+
+    @Synchronized
+    fun snapshot(allowedIds: Set<Long>): JsonObject =
+        buildJsonObject {
+                preferences.forEach { (name, prefs) ->
+                    val id = name.removePrefix("source_").toLong()
+                    if (id in allowedIds) put(name, SandboxPreferenceValues.encode(prefs.all))
+                }
+            }
+            .also {
+                require(it.toString().toByteArray().size <= ExtensionSandboxProtocol.MAX_INPUT)
+            }
+}
+
+internal class MemoryPreferences(initial: Map<String, Any>) : SharedPreferences {
+    private val values = initial.toMutableMap()
+    private val listeners = mutableSetOf<SharedPreferences.OnSharedPreferenceChangeListener>()
+
+    @Synchronized
+    fun restore(snapshot: Map<String, Any>) {
+        SandboxPreferenceValues.encode(snapshot)
+        values.clear()
+        values.putAll(snapshot)
+    }
+
+    override fun getAll(): MutableMap<String, *> =
+        synchronized(this) {
+            values
+                .mapValues { (_, value) -> if (value is Set<*>) value.toSet() else value }
+                .toMutableMap()
+        }
+
+    override fun contains(key: String?): Boolean = synchronized(this) { values.containsKey(key) }
+
+    override fun getString(key: String?, defValue: String?): String? =
+        synchronized(this) { (values[key] ?: defValue) as String? }
+
+    @Suppress("UNCHECKED_CAST")
+    override fun getStringSet(key: String?, defValues: MutableSet<String>?): MutableSet<String>? =
+        synchronized(this) { ((values[key] ?: defValues) as Set<String>?)?.toMutableSet() }
+
+    override fun getInt(key: String?, defValue: Int): Int =
+        synchronized(this) { (values[key] ?: defValue) as Int }
+
+    override fun getLong(key: String?, defValue: Long): Long =
+        synchronized(this) { (values[key] ?: defValue) as Long }
+
+    override fun getFloat(key: String?, defValue: Float): Float =
+        synchronized(this) { (values[key] ?: defValue) as Float }
+
+    override fun getBoolean(key: String?, defValue: Boolean): Boolean =
+        synchronized(this) { (values[key] ?: defValue) as Boolean }
+
+    override fun registerOnSharedPreferenceChangeListener(
+        listener: SharedPreferences.OnSharedPreferenceChangeListener?
+    ) {
+        if (listener != null) synchronized(this) { listeners.add(listener) }
+    }
+
+    override fun unregisterOnSharedPreferenceChangeListener(
+        listener: SharedPreferences.OnSharedPreferenceChangeListener?
+    ) {
+        synchronized(this) { listeners.remove(listener) }
+    }
+
+    override fun edit(): SharedPreferences.Editor = Editor()
+
+    private inner class Editor : SharedPreferences.Editor {
+        val pending = linkedMapOf<String, Any?>()
+        var clear = false
+
+        private fun put(key: String?, value: Any?): SharedPreferences.Editor {
+            require(key != null && key.length in 1..200)
+            pending[key] = value
+            return this
+        }
+
+        override fun putString(key: String?, value: String?) = put(key, value)
+
+        override fun putStringSet(key: String?, values: MutableSet<String>?) =
+            put(key, values?.toSet())
+
+        override fun putInt(key: String?, value: Int) = put(key, value)
+
+        override fun putLong(key: String?, value: Long) = put(key, value)
+
+        override fun putFloat(key: String?, value: Float) = put(key, value)
+
+        override fun putBoolean(key: String?, value: Boolean) = put(key, value)
+
+        override fun remove(key: String?) = put(key, null)
+
+        override fun clear(): SharedPreferences.Editor {
+            clear = true
+            return this
+        }
+
+        override fun commit(): Boolean {
+            val callbacks: List<SharedPreferences.OnSharedPreferenceChangeListener>
+            synchronized(this@MemoryPreferences) {
+                val proposed = if (clear) mutableMapOf() else values.toMutableMap()
+                pending.forEach { (key, value) ->
+                    if (value == null) proposed.remove(key) else proposed[key] = value
+                }
+                SandboxPreferenceValues.encode(proposed)
+                values.clear()
+                values.putAll(proposed)
+                callbacks = listeners.toList()
+            }
+            pending.keys.forEach { key ->
+                callbacks.forEach { it.onSharedPreferenceChanged(this@MemoryPreferences, key) }
+            }
+            return true
+        }
+
+        override fun apply() {
+            commit()
+        }
+    }
+}
