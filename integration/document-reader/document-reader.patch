+
+    @Test
+    fun `large confirmed native editions keep all storage owners and logical chapter identities`() =
+        runTest {
+            val left = (1..10000).map { chapter(it.toLong(), 1, it) }
+            val right = (1..10000).map { chapter(10000L + it, 2, it) }
