@@ -0,0 +1,97 @@
+package eu.kanade.tachiyomi.storage
+
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import androidx.test.platform.app.InstrumentationRegistry
+import com.hippo.unifile.UniFile
+import eu.kanade.tachiyomi.data.backup.BackupDecoder
+import eu.kanade.tachiyomi.data.backup.create.BackupArchiveWriter
+import eu.kanade.tachiyomi.data.backup.create.BackupReadbackUnavailable
+import eu.kanade.tachiyomi.data.backup.models.Backup
+import eu.kanade.tachiyomi.data.backup.models.BackupManga
+import eu.kanade.tachiyomi.extension.util.PrivateExtensionFiles
+import kotlinx.coroutines.CancellationException
+import kotlinx.serialization.protobuf.ProtoBuf
+import org.junit.After
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertThrows
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import java.io.File
+import java.io.IOException
+import java.nio.file.Files
+
+/** Local Android filesystem/codec controls; no real extension code, remote provider or full-app acceptance. */
+@RunWith(AndroidJUnit4::class)
+class SafeStorageAndroidTest {
+    private val context = InstrumentationRegistry.getInstrumentation().targetContext
+    private val folder = Files.createTempDirectory(context.cacheDir.toPath(), "polaris-storage-").toFile()
+
+    @After fun cleanup() {
+        folder.walkBottomUp().forEach {
+            it.setWritable(true)
+            it.delete()
+        }
+    }
+
+    @Test fun atomicReplacementKeepsTheWorkingFileUntilValidationAndPublishesReadOnlyBytes() {
+        val target = File(folder, "source.ext").apply { writeText("working") }
+        val source = File(folder, "download.apk").apply { writeText("replacement") }
+        PrivateExtensionFiles.replace(source, target) { staged ->
+            assertEquals("working", target.readText())
+            assertEquals("replacement", staged.readText())
+            assertFalse(staged.canWrite())
+        }
+        assertEquals("replacement", target.readText())
+        assertFalse(target.canWrite())
+        assertTrue(folder.listFiles()!!.none { it.name.endsWith(".pending") })
+    }
+
+    @Test fun rejectedOrCancelledCopiesPreserveTheExistingExtension() {
+        val target = File(folder, "source.ext").apply { writeText("working") }
+        val source = File(folder, "download.apk").apply { writeBytes(ByteArray(180_000)) }
+        assertThrows(IOException::class.java) {
+            PrivateExtensionFiles.replace(source, target) { throw IOException("Rejected staged package") }
+        }
+        assertEquals("working", target.readText())
+        var checks = 0
+        assertThrows(CancellationException::class.java) {
+            PrivateExtensionFiles.replace(source, target, { if (++checks == 3) throw CancellationException() }) {}
+        }
+        assertEquals("working", target.readText())
+        assertTrue(folder.listFiles()!!.none { it.name.endsWith(".pending") })
+    }
+
+    @Test fun verifiedBackupSurvivesUniFileRenameAndDecodesFromTheFinalUri() {
+        val encoded = ProtoBuf.encodeToByteArray(
+            Backup.serializer(),
+            Backup(listOf(BackupManga(1234567890123L, "/test", "Ação preservada"))),
+        )
+        val pending = File(folder, "backup.tachibk.pending").apply { createNewFile() }
+        val document = checkNotNull(UniFile.fromFile(pending))
+        BackupArchiveWriter.writeVerified(encoded, { document.openOutputStream() }, { document.openInputStream() })
+        assertTrue(document.renameTo("backup.tachibk"))
+        BackupArchiveWriter.verify(encoded, { context.contentResolver.openInputStream(document.uri) })
+        val decoded = BackupDecoder(context, ProtoBuf).decode(document.uri)
+        assertEquals(1234567890123L, decoded.backupManga.single().source)
+        assertEquals("Ação preservada", decoded.backupManga.single().title)
+        assertFalse(pending.exists())
+    }
+
+    @Test fun unreadableDestinationCannotBeReportedAsVerified() {
+        val old = File(folder, "old.tachibk").apply { writeText("previous") }
+        val fresh = File(folder, "new.tachibk")
+        assertThrows(BackupReadbackUnavailable::class.java) {
+            BackupArchiveWriter.writeVerified(
+                "encoded input".encodeToByteArray(),
+                {
+                    fresh.outputStream()
+                },
+                { throw SecurityException("Read denied") },
+            )
+        }
+        assertArrayEquals("previous".encodeToByteArray(), old.readBytes())
+    }
+}
