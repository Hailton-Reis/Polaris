+package eu.kanade.tachiyomi.source.selection
+
+import eu.kanade.tachiyomi.source.model.SManga
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import tachiyomi.domain.chapter.model.Chapter
+
+class SourceMatchingTest {
+    private fun work(title: String, author: String?, artist: String? = null) = SManga.create().also {
+        it.title = title
+        it.author = author
+        it.artist = artist
+        it.url = "/work"
+    }
+    private fun chapters(vararg names: String) = names.mapIndexed { index, name ->
+        Chapter.create().copy(id = index.toLong(), url = "/$index", name = name)
+    }
+
+    @Test fun `exact normalized title and creator corroborate a work`() {
+        assertTrue(
+            SourceMatching.sameWork(
+                work("A Éstrela", "Jane Doe"),
+                work("A Estrela [Official]", "Jane Doe; Someone Else"),
+            ),
+        )
+    }
+
+    @Test fun `same title without creator is ambiguous`() {
+        assertFalse(SourceMatching.sameWork(work("The Star", null), work("The Star", null)))
+        assertFalse(SourceMatching.sameWork(work("The Star", "Unknown"), work("The Star", "Unknown")))
+    }
+
+    @Test fun `different creators and remakes are not automatically merged`() {
+        assertFalse(SourceMatching.sameWork(work("The Star", "Jane"), work("The Star", "Mary")))
+        assertFalse(SourceMatching.sameWork(work("The Star", "Jane"), work("The Star Remake", "Jane")))
+        assertFalse(SourceMatching.sameWork(work("The Star", "Jane"), work("The Star Novel", "Jane")))
+    }
+
+    @Test fun `overlapping ordinary sequences are compatible`() {
+        assertTrue(
+            SourceMatching.compatibleNumbering(
+                chapters("Chapter 1", "Chapter 2"),
+                chapters("Chapter 1 Official", "Chapter 3"),
+            ),
+        )
+    }
+
+    @Test fun `ambiguous reset or split numbering is rejected automatically`() {
+        assertFalse(SourceMatching.compatibleNumbering(chapters("Season 2 Chapter 1"), chapters("Chapter 1")))
+        assertFalse(SourceMatching.compatibleNumbering(chapters("Volume 1 Chapter 1"), chapters("Chapter 1")))
+        assertFalse(SourceMatching.compatibleNumbering(chapters("Chapter 1 Part 1"), chapters("Chapter 1")))
+        assertFalse(SourceMatching.compatibleNumbering(chapters("Chapter 1"), chapters("Chapter 100")))
+    }
+
+    @Test
+    fun `short CJK creator names remain valid corroboration`() {
+        assertTrue(SourceMatching.sameWork(work("星", "王五"), work("星", "王五")))
+        assertFalse(SourceMatching.sameWork(work("星", "未知"), work("星", "未知")))
+    }
+}
