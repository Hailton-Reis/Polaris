+        schema?.let { add(it.getValue("nodes").jsonArray, screen) }
+        if (schema == null)
+            screen.addPreference(
+                Preference(context).apply {
+                    title = context.stringResource(ATMR.strings.sandbox_no_custom_settings)
+                    isSelectable = false
+                    isIconSpaceReserved = false
+                }
+            )
+        screen.addPreference(
+            Preference(context).apply {
+                title = context.stringResource(ATMR.strings.sandbox_session_title)
+                summary =
+                    if (session.storageUnavailable)
