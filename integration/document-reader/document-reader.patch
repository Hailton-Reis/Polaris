+package eu.kanade.tachiyomi.data.track
+
+import android.net.Uri
+import java.security.MessageDigest
+import java.security.SecureRandom
+import java.util.Base64
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.Json
+import tachiyomi.core.common.preference.Preference
+import tachiyomi.core.common.preference.PreferenceStore
+import uy.kohesive.injekt.Injekt
+import uy.kohesive.injekt.api.get
+
+/** An external callback is not user consent to connect or disconnect a tracker. */
+internal class TrackerOAuthGate(
+    store: PreferenceStore,
+    private val now: () -> Long = System::currentTimeMillis,
+) {
+    @Serializable
+    private data class Pending(val provider: String, val state: String?, val started: Long)
+
+    private val pending = store.getString(Preference.appStateKey("polaris_tracker_oauth_pending"))
+    private val json = Json
+
+    fun begin(provider: String, state: String?) {
+        require(provider in PROVIDERS)
+        require((provider == "hikka-auth" && state == null) || !state.isNullOrBlank())
+        require(state == null || state.length <= 512)
+        pending.set(json.encodeToString(Pending.serializer(), Pending(provider, state, now())))
+    }
+
+    fun consume(scheme: String?, provider: String?, state: String?): Boolean {
+        if (scheme != "mihon" || provider !in PROVIDERS) return false
+        val text = pending.get()
+        if (text.length > 1024) return false
+        val saved =
+            runCatching { json.decodeFromString(Pending.serializer(), text) }.getOrNull()
+                ?: return false
+        if (saved.provider != provider || now() - saved.started !in 0..600_000L) return false
+        if (
+            saved.state != null &&
+                (state == null ||
+                    state.length > 512 ||
+                    !MessageDigest.isEqual(saved.state.toByteArray(), state.toByteArray()))
+        )
+            return false
+        pending.delete()
+        return true
+    }
+
+    companion object {
+        val PROVIDERS =
+            setOf(
+                "anilist-auth",
+                "bangumi-auth",
+                "mangabaka-auth",
+                "myanimelist-auth",
+                "shikimori-auth",
+                "hikka-auth",
+            )
+    }
+}
+
+object TrackerOAuthSession {
+    fun prepare(provider: String, url: Uri): Uri {
+        require(url.scheme == "https")
+        val state =
+            when (provider) {
+                // This provider has a custom server-issued reference protocol, not OAuth state
+                // echo.
+                "hikka-auth" -> null
+                "mangabaka-auth" ->
+                    url.getQueryParameter("state") ?: error("Missing provider state")
+                else ->
+                    Base64.getUrlEncoder()
+                        .withoutPadding()
+                        .encodeToString(ByteArray(32).also { SecureRandom().nextBytes(it) })
+            }
+        TrackerOAuthGate(Injekt.get()).begin(provider, state)
+        return if (state != null && provider != "mangabaka-auth")
+            url.buildUpon().appendQueryParameter("state", state).build()
+        else url
+    }
+
+    fun consume(uri: Uri, state: String?): Boolean =
+        TrackerOAuthGate(Injekt.get()).consume(uri.scheme, uri.host, state)
+}
