@@ -0,0 +1,67 @@
+package eu.kanade.tachiyomi.ui.documents
+
+import android.content.Context
+import com.google.mlkit.common.model.DownloadConditions
+import com.google.mlkit.nl.translate.TranslateLanguage
+import com.google.mlkit.nl.translate.Translation
+import com.google.mlkit.nl.translate.TranslatorOptions
+import eu.kanade.translation.recognizer.TextRecognizerLanguage
+import eu.kanade.translation.translator.TextTranslatorLanguage
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.tasks.await
+import kotlinx.coroutines.withContext
+import mihon.core.archive.DocumentBlock
+import tachiyomi.domain.translation.TranslationPreferences
+import java.io.File
+import java.security.MessageDigest
+import java.util.UUID
+
+class DocumentTextTranslator(private val context: Context, private val preferences: TranslationPreferences) {
+    suspend fun translate(blocks: List<DocumentBlock>): List<DocumentBlock> = withContext(Dispatchers.IO) {
+        val from = TextRecognizerLanguage.fromPref(preferences.translateFromLanguage()).code
+        val to =
+            TranslateLanguage.fromLanguageTag(TextTranslatorLanguage.fromPref(preferences.translateToLanguage()).code)
+                ?: error("Language is not supported by on-device translation")
+        if (from == to) return@withContext blocks
+        val translator = Translation.getClient(
+            TranslatorOptions.Builder().setSourceLanguage(from).setTargetLanguage(to).build(),
+        )
+        val cache = File(context.cacheDir, "document-translations").apply { mkdirs() }
+        var prepared = false
+        try {
+            blocks.map { block ->
+                if (block !is DocumentBlock.Text || block.value.isBlank()) return@map block
+                val key = MessageDigest.getInstance(
+                    "SHA-256",
+                ).digest("document-v1|$from|$to|${block.value}".toByteArray())
+                    .joinToString("") { "%02x".format(it) }
+                val file = File(cache, key)
+                val cached = runCatching { file.takeIf { it.isFile }?.readText() }.getOrNull()
+                val translated = if (!cached.isNullOrBlank()) {
+                    cached
+                } else {
+                    if (!prepared) {
+                        translator.downloadModelIfNeeded(DownloadConditions.Builder().build()).await()
+                        prepared = true
+                    }
+                    translator.translate(block.value).await().also { value ->
+                        if (value.isNotBlank()) {
+                            val temporary = File(cache, ".$key-${UUID.randomUUID()}")
+                            try {
+                                runCatching {
+                                    temporary.writeText(value)
+                                    temporary.renameTo(file)
+                                }
+                            } finally {
+                                temporary.delete()
+                            }
+                        }
+                    }
+                }
+                DocumentBlock.Text(translated.ifBlank { block.value }, block.heading)
+            }
+        } finally {
+            translator.close()
+        }
+    }
+}
