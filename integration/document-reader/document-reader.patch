--- /dev/null
+++ b/app/src/main/java/eu/kanade/translation/recognizer/OcrStripImage.kt
@@ -0,0 +1,73 @@
+package eu.kanade.translation.recognizer
+
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import android.graphics.BitmapRegionDecoder
+import android.graphics.Rect
+import androidx.exifinterface.media.ExifInterface
+import java.io.Closeable
+import java.io.IOException
+
+/** Shared decoder; only one original-scale region is held by either OCR engine. */
+@Suppress("DEPRECATION")
+internal class OcrStripImage private constructor(
+    private val decoder: BitmapRegionDecoder,
+    val width: Int,
+    val height: Int,
+    val strips: List<OcrStrip>,
+) : Closeable {
+    fun decode(strip: OcrStrip): Bitmap {
+        require(strip.top >= 0 && strip.bottom <= height && strip.bottom > strip.top)
+        require(width.toLong() * (strip.bottom - strip.top) <= OcrStripPlan.MAX_TILE_PIXELS)
+        return decoder.decodeRegion(
+            Rect(0, strip.top, width, strip.bottom),
+            BitmapFactory.Options().apply {
+                inPreferredConfig = Bitmap.Config.ARGB_8888
+                inSampleSize = 1
+                inScaled = false
+            },
+        ) ?: throw IOException("Não foi possível decodificar uma faixa da página")
+    }
+
+    override fun close() {
+        decoder.recycle()
+    }
+
+    companion object {
+        fun open(image: OcrImage): OcrStripImage? {
+            val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+            image.openInputStream().use { BitmapFactory.decodeStream(it, null, bounds) }
+            if (bounds.outWidth <= 0 || bounds.outHeight <= 0 ||
+                bounds.outMimeType !in setOf("image/jpeg", "image/png", "image/webp")
+            ) {
+                return null
+            }
+            val strips = OcrStripPlan.create(bounds.outWidth, bounds.outHeight)
+            if (strips.isEmpty()) return null
+            // Raw-region coordinates must agree with the EXIF-corrected reader.
+            val orientation = try {
+                image.openInputStream().use { input ->
+                    ExifInterface(
+                        input,
+                    ).getAttributeInt(ExifInterface.TAG_ORIENTATION, ExifInterface.ORIENTATION_UNDEFINED)
+                }
+            } catch (_: IOException) {
+                return null
+            }
+            if (orientation !in
+                setOf(ExifInterface.ORIENTATION_UNDEFINED, ExifInterface.ORIENTATION_NORMAL)
+            ) {
+                return null
+            }
+            val decoder = image.openInputStream().use { BitmapRegionDecoder.newInstance(it, false) }
+                ?: throw IOException("Não foi possível abrir a página para reconhecimento por faixas")
+            try {
+                check(decoder.width == bounds.outWidth && decoder.height == bounds.outHeight)
+                return OcrStripImage(decoder, bounds.outWidth, bounds.outHeight, strips)
+            } catch (error: Throwable) {
+                decoder.recycle()
+                throw error
+            }
+        }
+    }
+}
