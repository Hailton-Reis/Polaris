@@ -0,0 +1,134 @@
+package eu.kanade.tachiyomi.source.selection
+
+import eu.kanade.tachiyomi.source.INovelSource
+import eu.kanade.tachiyomi.source.online.HttpSource
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.flow.*
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.serialization.json.*
+import tachiyomi.domain.chapter.model.LogicalChapterCounts
+import tachiyomi.domain.chapter.repository.ChapterRepository
+import tachiyomi.domain.manga.model.*
+import tachiyomi.domain.manga.repository.LibraryWorkRepository
+import tachiyomi.domain.source.model.StubSource
+import tachiyomi.domain.source.service.SourceManager
+
+/** Offline metadata/numbering corroboration. Association is atomic; native records never move. */
+class LibraryWorkConsolidator(
+    private val works: LibraryWorkRepository,
+    private val chapters: ChapterRepository,
+    private val sources: SourceManager,
+) {
+    private val lock = Mutex()
+
+    suspend fun observe() {
+        combine(works.subscribeFavorites(), sources.sources) { favorites, providers ->
+                fingerprint(favorites) to providers.map { it.id to it.javaClass.name }
+            }
+            .distinctUntilChanged()
+            .collectLatest {
+                try {
+                    reconcile()
+                } catch (cancelled: CancellationException) {
+                    throw cancelled
+                } catch (error: Exception) {
+                    android.util.Log.w(
+                        "PolarisLibrary",
+                        "Association deferred; original records remain visible",
+                        error,
+                    )
+                }
+            }
+    }
+
+    suspend fun reconcile(): Int =
+        lock.withLock {
+            var committed = 0
+            repeat(2) {
+                val favorites = works.favorites()
+                val hits =
+                    favorites
+                        .filter { !LibraryWork.separated(it.memo) }
+                        .map { manga ->
+                            val source = sources.getOrStub(manga.source)
+                            WorkSearchHit(
+                                manga,
+                                source.name,
+                                source.lang,
+                                source is HttpSource && source !is INovelSource ||
+                                    source is StubSource &&
+                                        WorkSources.from(manga.memo).identity != null,
+                            )
+                        }
+                val identities =
+                    hits
+                        .mapNotNull { WorkSources.from(it.manga.memo).identity }
+                        .distinctBy { it.catalogId }
+                val groups =
+                    WorkSearchGrouping.group(hits.filter { it.isComic }, identities = identities)
+                var retry = false
+                for (group in
+                    groups
+                        .filter { it.editions.size in 2..16 }
+                        .filter { group ->
+                            val old = LibraryWork.from(group.representative.memo)
+                            old?.resolve(group.representative, favorites)?.map { it.id }?.toSet() !=
+                                group.editions.map { it.manga.id }.toSet()
+                        }
+                        .take(8)) {
+                    val members = group.editions.map { it.manga }
+                    val existing = LibraryWork.from(group.representative.memo)
+                    if (existing?.resolve(group.representative, favorites)?.size == members.size)
+                        continue
+                    val pins =
+                        members.mapNotNull { WorkSources.from(it.memo).pinned?.key }.distinct()
+                    if (pins.size > 1) continue
+                    val data = members.map { chapters.getChapterByMangaId(it.id) }
+                    val compatible =
+                        tachiyomi.domain.chapter.model.ChapterNumbering.compatibleEditions(
+                            members,
+                            data,
+                        )
+                    if (!compatible) continue
+                    val state =
+                        LibraryWork(
+                            group.representative.source,
+                            group.representative.url,
+                            group.editions.map {
+                                LibraryEdition(
+                                    it.manga.source,
+                                    it.manga.url,
+                                    it.manga.title,
+                                    it.manga.author,
+                                    it.manga.artist,
+                                    it.name,
+                                    it.language,
+                                )
+                            },
+                        )
+                    if (works.commit(members, state)) committed++ else retry = true
+                }
+                if (!retry) return@withLock committed
+            }
+            committed
+        }
+
+    private fun fingerprint(mangas: List<Manga>) =
+        mangas.map { manga ->
+            listOf(
+                manga.id,
+                manga.source,
+                manga.url,
+                manga.title,
+                manga.author,
+                manga.artist,
+                manga.lastUpdate,
+                WorkSources.from(manga.memo).identity,
+                WorkSources.from(manga.memo).pinned,
+                LibraryWork.from(manga.memo),
+                manga.memo[LibraryWork.SEPARATE],
+                (manga.memo[LogicalChapterCounts.KEY] as? JsonObject)?.get("rows"),
+            )
+        }
+}
