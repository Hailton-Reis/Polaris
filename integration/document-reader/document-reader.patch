+    }
+
+    @Test
+    fun `malformed and overflowing versions are rejected without crashing`() {
+        listOf("r2000", "v1", "1.0", "01.0.0", "1.0.0-beta.01", "1.0.0-", "1.0.0+x..y", "9999999999999999999999.0.0")
