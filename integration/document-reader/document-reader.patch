+
+@RunWith(AndroidJUnit4::class)
+class SandboxCookieAndroidTest {
+    private val instrumentation = InstrumentationRegistry.getInstrumentation()
+    private val context = instrumentation.targetContext
+    private val prefix = "synthetic-cookie-${UUID.randomUUID()}"
+    private val stores = mutableListOf<SandboxCookieStore>()
+    private val url = "https://example.com/login".toHttpUrl()
+
+    private fun store(
+        identity: String,
+        cache: SandboxCookieStore.SessionCache = SandboxCookieStore.SessionCache(),
+    ) = SandboxCookieStore(context, identity, cache).also { stores += it }
+
+    private fun cookie(name: String, value: String, persistent: Boolean = true) =
+        Cookie.Builder()
+            .name(name)
+            .value(value)
+            .hostOnlyDomain(url.host)
+            .path("/")
+            .secure()
+            .httpOnly()
+            .apply { if (persistent) expiresAt(System.currentTimeMillis() + 3600000) }
+            .build()
+
+    @After
+    fun cleanup() {
+        stores.forEach {
+            it.clear()
+            context.deleteSharedPreferences("polaris_sandbox_cookies_${it.scope}")
+        }
+        SandboxSettingsTestActivity.fixtureSource = null
+    }
+
+    private suspend fun source(identity: String): IsolatedHttpSource {
+        val file = File.createTempFile("cookie-source", ".apk", context.cacheDir)
+        try {
+            instrumentation.context.assets.open("polaris-sandbox/fixture.apk").use { input ->
+                file.outputStream().use(input::copyTo)
+            }
+            // Runtime retains this read-only path for the whole test; cleanup deletes it below.
+            val digest =
+                MessageDigest.getInstance("SHA-256").digest(file.readBytes()).joinToString("") {
+                    "%02x".format(it)
+                }
+            return IsolatedHttpSource.load(
+                    context,
+                    file,
+                    digest,
+                    listOf("polaris.sandbox.fixture.FixtureSource"),
+                    {},
+                    { false },
+                    preferenceIdentity = identity,
+                )
+                .single() as IsolatedHttpSource
+        } finally {
+            files += file
+        }
+    }
+
+    private val files = mutableListOf<File>()
+
+    @After
+    fun deleteFixtures() {
+        files.forEach(File::delete)
+    }
+
+    @Test
+    fun domainCookiesUseTheAndroidPublicSuffixAssetAndNeverBecomeSupercookies() {
+        val a = store("$prefix:domains")
+        val jar = a.newSessionJar()
+        val origin = "https://reader.example.com/login".toHttpUrl()
+        val parent =
+            Cookie.Builder()
+                .name("parent")
+                .value("allowed")
+                .domain("example.com")
+                .path("/")
+                .secure()
+                .build()
+        val supercookie =
+            Cookie.Builder().name("super").value("blocked").domain("com").path("/").secure().build()
+        jar.saveFromResponse(origin, listOf(parent, supercookie))
+        assertEquals(
+            listOf("parent"),
+            jar.loadForRequest("https://cdn.example.com/".toHttpUrl()).map { it.name },
+        )
+        assertTrue(jar.loadForRequest("https://unrelated.org/".toHttpUrl()).isEmpty())
+        assertEquals(1, a.status().temporary)
+    }
+
+    @Test
+    fun encryptedPersistentCookiesRestoreWithoutPersistingSessionOnlyCookies() {
+        val identity = "$prefix:A"
+        val a = store(identity)
+        a.newSessionJar()
+            .saveFromResponse(
+                url,
+                listOf(
+                    cookie("login", "synthetic-protected-secret"),
+                    cookie("temporary", "memory-only", false),
+                ),
+            )
+        assertEquals(1, a.status().persistent)
+        assertEquals(1, a.status().temporary)
+        val prefs = context.getSharedPreferences("polaris_sandbox_cookies_${a.scope}", 0)
+        val sealed = requireNotNull(prefs.getString("sealed", null))
+        assertTrue(sealed.startsWith("v1:"))
+        assertFalse(sealed.contains("synthetic-protected-secret"))
+        assertFalse(sealed.contains("memory-only"))
+        assertFalse(
+            java.util.Base64.getDecoder()
+                .decode(sealed.split(':')[2])
+                .toString(Charsets.UTF_8)
+                .contains("synthetic-protected-secret")
+        )
+        val restarted = store(identity)
+        val restored = restarted.newSessionJar().loadForRequest(url).single()
+        assertEquals("login", restored.name)
+        assertEquals("synthetic-protected-secret", restored.value)
+        assertTrue(restored.hostOnly && restored.secure && restored.httpOnly && restored.persistent)
+        assertEquals(0, restarted.status().temporary)
+    }
+
+    @Test
+    fun identitiesRemainSeparateAndCopiedCiphertextCannotGrantAnotherPrincipalASession() {
+        val a = store("$prefix:package-A:signer-A")
+        val b = store("$prefix:package-A:signer-B")
+        a.newSessionJar().saveFromResponse(url, listOf(cookie("login", "only-A")))
+        assertTrue(b.newSessionJar().loadForRequest(url).isEmpty())
+        val cipher =
+            context
+                .getSharedPreferences("polaris_sandbox_cookies_${a.scope}", 0)
+                .getString("sealed", null)
+        context
+            .getSharedPreferences("polaris_sandbox_cookies_${b.scope}", 0)
+            .edit()
+            .putString("sealed", cipher)
+            .commit()
+        val freshB = store("$prefix:package-A:signer-B")
+        assertTrue(freshB.newSessionJar().loadForRequest(url).isEmpty())
+        assertEquals(
+            "only-A",
+            store("$prefix:package-A:signer-A").newSessionJar().loadForRequest(url).single().value,
+        )
+    }
+
+    @Test
+    fun proxyImagesShareTheOwnedSessionAndClearRevokesAlreadyObtainedClients() =
+        runBlocking<Unit> {
+            val identity = "$prefix:proxy"
+            val a = SandboxCookieStore(context, identity).also { stores += it }
+            a.newSessionJar().saveFromResponse(url, listOf(cookie("login", "image-session")))
+            val proxy = source(identity)
+            assertEquals(1, proxy.sessionStatus().persistent)
+            val old = proxy.client.cookieJar
+            assertEquals("image-session", old.loadForRequest(url).single().value)
+            proxy.clearSession()
+            old.saveFromResponse(url, listOf(cookie("login", "delayed-must-not-return")))
+            assertTrue(old.loadForRequest(url).isEmpty())
+            assertTrue(proxy.client.cookieJar.loadForRequest(url).isEmpty())
+            assertTrue(a.newSessionJar().loadForRequest(url).isEmpty())
+        }
+
+    @Test
+    fun nonConfigurableSourceStillOffersAnExplicitSessionClearWithoutChangingOtherSources() =
+        runBlocking<Unit> {
+            val identity = "$prefix:ui"
+            val proxy = source(identity)
+            // Use the same process-wide principal cache as the real proxy; data remains synthetic.
+            val a = SandboxCookieStore(context, identity).also { stores += it }
+            val other = store("$prefix:unrelated")
+            a.newSessionJar().saveFromResponse(url, listOf(cookie("login", "to-clear")))
+            other.newSessionJar().saveFromResponse(url, listOf(cookie("login", "keep-other")))
+            assertFalse(proxy.supportsPreferences)
+            SandboxSettingsTestActivity.fixtureSource = proxy
+            ActivityScenario.launch(SandboxSettingsTestActivity::class.java).use { scenario ->
+                fun clickReady(): Boolean {
+                    val ready = java.util.concurrent.atomic.AtomicBoolean(false)
+                    scenario.onActivity { activity ->
+                        val owner =
+                            activity.supportFragmentManager.fragments
+                                .filterIsInstance<PreferenceFragmentCompat>()
+                                .single()
+                        val row =
+                            owner.preferenceScreen?.findPreference<androidx.preference.Preference>(
+                                "polaris_host_clear_session"
+                            )
+                        if (row != null) {
+                            ready.set(true)
+                            assertTrue(
+                                requireNotNull(row.onPreferenceClickListener).onPreferenceClick(row)
+                            )
+                        }
+                    }
+                    return ready.get()
+                }
+                val deadline = System.currentTimeMillis() + 60000
+                while (!clickReady() && System.currentTimeMillis() < deadline) Thread.sleep(100)
+                scenario.onActivity { activity ->
+                    val dialog = activity.window.decorView.rootView
+                    assertNotNull(dialog)
+                }
+                // The confirmation is a real dialog; click its positive button through UI
+                // automation.
+                instrumentation.waitForIdleSync()
+                val automation = instrumentation.uiAutomation
+                val info = automation.serviceInfo
+                val originalFlags = info.flags
+                try {
+                    info.flags =
+                        info.flags or
+                            android.accessibilityservice.AccessibilityServiceInfo
+                                .FLAG_REPORT_VIEW_IDS
+                    automation.serviceInfo = info
+                    val deadlineButton = System.currentTimeMillis() + 15000
+                    var clicked = false
+                    while (!clicked && System.currentTimeMillis() < deadlineButton) {
+                        val root = automation.rootInActiveWindow
+                        val buttons =
+                            root
+                                ?.takeIf { it.packageName?.toString() == context.packageName }
+                                ?.findAccessibilityNodeInfosByViewId("android:id/button1")
+                                .orEmpty()
+                        val button = buttons.firstOrNull { it.isVisibleToUser && it.isEnabled }
+                        if (button != null)
+                            clicked =
+                                button.performAction(
+                                    android.view.accessibility.AccessibilityNodeInfo.ACTION_CLICK
+                                )
+                        buttons.forEach { it.recycle() }
+                        root?.recycle()
+                        if (!clicked) Thread.sleep(100)
+                    }
+                    assertTrue("The explicit session-clear confirmation must be clicked", clicked)
+                } finally {
+                    info.flags = originalFlags
+                    automation.serviceInfo = info
+                }
+                val changed = System.currentTimeMillis() + 60000
+                while (
+                    proxy.sessionStatus().persistent != 0 && System.currentTimeMillis() < changed
+                ) Thread.sleep(100)
+                assertEquals(0, proxy.sessionStatus().persistent)
+                assertEquals("keep-other", other.newSessionJar().loadForRequest(url).single().value)
+            }
+        }
+}
