+package eu.kanade.tachiyomi.data.updater
+
+import eu.kanade.tachiyomi.network.await
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import java.io.EOFException
+import java.io.File
+import java.io.FileOutputStream
+import java.io.IOException
+import java.nio.file.Files
+import java.nio.file.StandardCopyOption
+import java.security.MessageDigest
+
+/** Keeps interrupted bytes separate from the APK offered to Android's installer. */
+internal class PolarisApkDownloader(
+    private val directory: File,
+    private val client: OkHttpClient,
+) {
+    suspend fun download(
+        url: String,
+        sha256: String?,
+        progress: (Long, Long) -> Unit = { _, _ -> },
+    ): File = lock.withLock {
+        if (!directory.isDirectory && !directory.mkdirs()) throw IOException("Cannot create update cache")
+        val apk = File(directory, "update.apk")
+        if (sha256 != null && apk.isFile) {
+            if (runCatching { PolarisUpdateIntegrity.verify(apk, sha256) }.isSuccess) {
+                progress(apk.length(), apk.length())
+                return@withLock apk
+            }
+        }
+
+        val part = File(directory, "update-${identity(url, sha256)}.part")
+        // This directory belongs exclusively to the updater. Retain only this release's partial download.
+        directory.listFiles()?.filter { it.name.startsWith("update-") && it.extension == "part" && it != part }
+            ?.forEach { it.delete() }
+        // Resuming without a pinned digest could combine bytes from two different APKs.
+        if (sha256 == null) part.delete()
+        var offset = part.length()
+        progress(offset, -1)
+
+        while (true) {
+            currentCoroutineContext().ensureActive()
+            val request = Request.Builder().url(url)
+                .header("Accept-Encoding", "identity")
+                .apply { if (offset > 0) header("Range", "bytes=$offset-") }
+                .build()
+            client.newCall(request).await().use { response ->
+                if (response.code == 416 && offset > 0) {
+                    // The connection may have died after writing the final byte, before promotion.
+                    if (sha256 != null && runCatching { PolarisUpdateIntegrity.verify(part, sha256) }.isSuccess) {
+                        return@withLock promote(part, apk, progress)
+                    }
+                    part.delete()
+                    offset = 0
+                    return@use
+                }
+                if (response.code != 200 && response.code != 206) {
+                    throw UpdateHttpException(response.code)
+                }
+                if (response.header("Content-Encoding")?.equals("identity", ignoreCase = true) == false) {
+                    part.delete()
+                    throw UpdateResponseException("Encoded APK response")
+                }
+                val length = response.body.contentLength()
+                val total: Long
+                val responseLength: Long
+                if (response.code == 206) {
+                    val range = response.header("Content-Range")?.let { RANGE.matchEntire(it) }
+                    val start = range?.groupValues?.get(1)?.toLongOrNull()
+                    val end = range?.groupValues?.get(2)?.toLongOrNull()
+                    val size = range?.groupValues?.get(3)?.toLongOrNull()
+                    if (offset <= 0 || start != offset || end == null || size == null ||
+                        end < offset || end >= size || (length >= 0 && length != end - offset + 1)
+                    ) {
+                        part.delete()
+                        throw UpdateResponseException("Invalid APK Content-Range")
+                    }
+                    total = size
+                    responseLength = end - offset + 1
+                } else {
+                    // A server may ignore Range. Truncate, never append a full response to old bytes.
+                    offset = 0
+                    total = length
+                    responseLength = length
+                }
+                var received = 0L
+                response.body.byteStream().use { input ->
+                    FileOutputStream(part, offset > 0).use { output ->
+                        progress(offset, total)
+                        val buffer = ByteArray(64 * 1024)
+                        while (true) {
+                            currentCoroutineContext().ensureActive()
+                            val count = input.read(buffer)
+                            if (count < 0) break
+                            received += count
+                            if (responseLength >= 0 && received > responseLength) {
+                                part.delete()
+                                throw UpdateResponseException("Oversized APK response")
+                            }
+                            output.write(buffer, 0, count)
+                            progress(offset + received, total)
+                        }
+                        output.fd.sync()
+                    }
+                }
+                if ((responseLength >= 0 && received != responseLength) ||
+                    (total >= 0 && part.length() != total)
+                ) {
+                    throw EOFException("Incomplete APK download")
+                }
+                currentCoroutineContext().ensureActive()
+                if (sha256 != null) PolarisUpdateIntegrity.verify(part, sha256)
+                return@withLock promote(part, apk, progress)
+            }
+        }
+        @Suppress("UNREACHABLE_CODE")
+        error("Unreachable")
+    }
+
+    private fun promote(part: File, apk: File, progress: (Long, Long) -> Unit): File {
+        Files.move(part.toPath(), apk.toPath(), StandardCopyOption.REPLACE_EXISTING, StandardCopyOption.ATOMIC_MOVE)
+        progress(apk.length(), apk.length())
+        return apk
+    }
+
+    companion object {
+        private val lock = Mutex()
+        private val RANGE = Regex("bytes (\\d+)-(\\d+)/(\\d+)")
+
+        fun identity(url: String, sha256: String?): String = MessageDigest.getInstance("SHA-256")
+            .digest("$url\n${sha256?.lowercase().orEmpty()}".toByteArray())
+            .joinToString("") { "%02x".format(it) }
+    }
+}
+
+internal class UpdateHttpException(val status: Int) : IOException("APK HTTP $status") {
+    val retryable: Boolean get() = status == 408 || status == 429 || status in 500..599
+}
+
+internal class UpdateResponseException(message: String) : IOException(message)
