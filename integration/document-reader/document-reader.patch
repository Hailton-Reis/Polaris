@@ -0,0 +1,26 @@
+package eu.kanade.translation
+
+import eu.kanade.translation.recognizer.TextRecognizerLanguage
+import java.util.Locale
+
+/** Metadata routing only. Mixed/unknown sources still require the selected OCR input language. */
+object SourceTranslationLanguage {
+    fun resolve(code: String?): TextRecognizerLanguage? = when (
+        code?.lowercase(Locale.ROOT)?.replace('_', '-')?.substringBefore('-')
+    ) {
+        "en" -> TextRecognizerLanguage.ENGLISH
+        "ja" -> TextRecognizerLanguage.JAPANESE
+        "zh" -> TextRecognizerLanguage.CHINESE
+        "ko" -> TextRecognizerLanguage.KOREAN
+        else -> null
+    }
+
+    fun automatic(english: Boolean, asianBeta: Boolean, override: Boolean?, code: String?, target: String): Boolean {
+        if (target.isBlank()) return false
+        val language = resolve(code)
+        if (language?.name == target) return false
+        if (override != null) return override
+        if (language == null) return false
+        return if (language == TextRecognizerLanguage.ENGLISH) english else asianBeta
+    }
+}
diff --git a/app/src/main/java/eu/kanade/translation/TranslationDeletionGate.kt b/app/src/main/java/eu/kanade/translation/TranslationDeletionGate.kt
new file mode 100644
index 0000000..0be4de6
--- /dev/null
+++ b/app/src/main/java/eu/kanade/translation/TranslationDeletionGate.kt
@@ -0,0 +1,46 @@
+package eu.kanade.translation
+
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import java.util.concurrent.atomic.AtomicLong
+
+/** Wait for cancelled writers before removing files; preserve an explicit user pause. */
+class TranslationDeletionGate(
+    private val running: () -> Boolean,
+    private val pauseAndAwait: suspend () -> Unit,
+    private val restart: () -> Unit,
+) {
+    private val mutex = Mutex()
+    private val pauseRevision = AtomicLong()
+
+    @Volatile private var active = false
+
+    @Volatile private var deferredStart = false
+
+    fun deferStart(): Boolean {
+        if (!active) return false
+        deferredStart = true
+        return true
+    }
+
+    fun userPaused() {
+        pauseRevision.incrementAndGet()
+        deferredStart = false
+    }
+
+    suspend fun remove(action: suspend () -> Unit) = mutex.withLock {
+        active = true
+        val resume = running()
+        val revision = pauseRevision.get()
+        try {
+            pauseAndAwait()
+            action()
+        } finally {
+            active = false
+            if ((resume && revision == pauseRevision.get()) || deferredStart) {
+                deferredStart = false
+                restart()
+            }
+        }
+    }
+}
