@@ -0,0 +1,25 @@
+package eu.kanade.tachiyomi.extension.novel
+
+import java.io.File
+import java.net.URI
+
+/** Repository metadata must not choose paths outside the private plugin directory. */
+internal object NovelPluginPaths {
+    fun file(root: File, id: String, suffix: String): File {
+        require(
+            id.matches(Regex("[\\p{L}\\p{N}_][\\p{L}\\p{N}_.-]*")) && id.toByteArray().size <= 160
+        )
+        require(suffix in setOf("js", "json"))
+        val directory = root.canonicalFile
+        return File(directory, "$id.$suffix").canonicalFile.also {
+            require(it.parentFile == directory)
+        }
+    }
+
+    fun requireHttps(url: String) {
+        val uri = URI(url)
+        require(
+            uri.scheme.equals("https", true) && !uri.host.isNullOrBlank() && uri.userInfo == null
+        )
+    }
+}
