+package eu.kanade.tachiyomi.data.profile
+
+import java.io.ByteArrayInputStream
+import java.io.InputStream
+import java.nio.file.Files
+import java.nio.file.Path
+import org.junit.jupiter.api.Assertions.*
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.io.TempDir
+
+class ProfileImageStoreTest {
+    @TempDir lateinit var root: Path
+
+    @Test
+    fun `invalid import keeps previous image closes input and removes partial file`() {
+        val dir = root.resolve("profile_images").toFile().apply { mkdir() }
+        val old = dir.resolve("avatar_123.jpg").apply { writeText("previous") }
+        var closed = false
+        val input =
+            object : ByteArrayInputStream(byteArrayOf(1, 2, 3)) {
+                override fun close() {
+                    closed = true
+                    super.close()
+                }
+            }
+        assertThrows(Exception::class.java) {
+            ProfileImageStore(dir) { false }.save(input, "avatar")
+        }
+        assertTrue(closed)
+        assertEquals("previous", old.readText())
+        assertEquals(listOf(old), dir.listFiles()!!.toList())
+    }
+
+    @Test
+    fun `directory failure still closes the supplied stream`() {
+        val bad = root.resolve("not-directory").toFile().apply { writeText("file") }
+        var closed = false
+        val source =
+            object : ByteArrayInputStream(byteArrayOf(1)) {
+                override fun close() {
+                    closed = true
+                    super.close()
+                }
+            }
+        assertThrows(Exception::class.java) {
+            ProfileImageStore(bad) { true }.save(source, "avatar")
+        }
+        assertTrue(closed)
+    }
+
+    @Test
+    fun `oversized stream is rejected without allocating the whole image`() {
+        var closed = false
+        var remaining = ProfileImageStore.MAX_BYTES + 1
+        val input =
+            object : InputStream() {
+                override fun read() = if (remaining-- > 0) 1 else -1
+
+                override fun read(b: ByteArray, off: Int, len: Int): Int {
+                    if (remaining <= 0) return -1
+                    val n = minOf(len.toLong(), remaining).toInt()
+                    remaining -= n
+                    return n
+                }
+
+                override fun close() {
+                    closed = true
+                }
+            }
+        val dir = root.resolve("profile_images").toFile()
+        assertThrows(Exception::class.java) {
+            ProfileImageStore(dir) { true }.save(input, "banner")
+        }
+        assertTrue(closed)
+        assertTrue(dir.listFiles()!!.isEmpty())
+    }
+
+    @Test
+    fun `only an owned canonical image can be deleted`() {
+        val dir = root.resolve("profile_images").toFile().apply { mkdir() }
+        val external = root.resolve("avatar_elsewhere.img").toFile().apply { writeText("keep") }
+        val store = ProfileImageStore(dir) { true }
+        store.deleteOwned(external.absolutePath)
+        assertTrue(external.exists())
+        val link = dir.resolve("avatar_link.img")
+        Files.createSymbolicLink(link.toPath(), external.toPath())
+        assertNull(store.owned(link.absolutePath))
+        val saved = store.save(ByteArrayInputStream(byteArrayOf(1, 2)), "avatar")
+        assertNotNull(store.owned(saved))
+        store.deleteOwned(saved)
+        assertNull(store.owned(saved))
+        assertTrue(external.exists())
+    }
+}
