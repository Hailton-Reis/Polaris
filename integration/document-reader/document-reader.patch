+        coEvery { service.fetch(any()) } returns Result.failure(IllegalStateException("offline"))
+        assertFalse(
+            ExtensionStoreRepositoryImpl(service, database).insertVerified(store()).isSuccess,
+        )
+        coVerify(exactly = 0) {
+            database.extension_storeQueries.upsert(
+                any(),
+                any(),
+                any(),
+                any(),
+                any(),
+                any(),
+                any(),
+                any(),
+            )
+        }
+    }
+
+    @Test
+    fun `background refresh cannot silently replace a restored signing certificate`() = runTest {
+        mockkStatic("app.cash.sqldelight.async.coroutines.QueryExtensionsKt")
+        try {
+            val database = mockk<Database>(relaxed = true)
+            val queries = database.extension_storeQueries
+            val query = mockk<Query<Extension_store>>()
+            every { queries.getAll() } returns query
+            val original = store()
+            coEvery { query.awaitAsList() } returns
