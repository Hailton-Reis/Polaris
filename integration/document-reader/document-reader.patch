+                                                    context,
+                                                    context.stringResource(
+                                                        ATMR.strings.sandbox_settings_rejected
+                                                    ),
+                                                    android.widget.Toast.LENGTH_LONG,
+                                                )
+                                                .show()
+                                        load()
+                                    } catch (cancelled: CancellationException) {
+                                        throw cancelled
+                                    } catch (_: Exception) {
+                                        failure()
+                                    }
+                                }
+                            }
+                            .show()
+                        true
+                    }
+                }
+            )
+        owner.preferenceScreen = screen
+    }
+}
