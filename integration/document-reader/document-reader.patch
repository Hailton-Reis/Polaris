+package eu.kanade.tachiyomi.extension.sandbox
+
+import kotlinx.serialization.json.*
+import org.junit.jupiter.api.Assertions.*
+import org.junit.jupiter.api.Test
+
+class SandboxPreferenceValuesTest {
+    @Test
+    fun `stored primitive types and string sets round trip without numeric coercion`() {
+        val values =
+            mapOf(
+                "text" to "synthetic",
+                "bool" to true,
+                "int" to 4,
+                "long" to Long.MAX_VALUE,
+                "float" to 0.5f,
+                "set" to setOf("b", "a"),
+            )
+        assertEquals(values, SandboxPreferenceValues.decode(SandboxPreferenceValues.encode(values)))
+    }
+
+    @Test
+    fun `wrong types nonfinite floats oversized values and arbitrary objects are refused`() {
+        assertThrows(IllegalArgumentException::class.java) {
+            SandboxPreferenceValues.encode(mapOf("bad" to Float.NaN))
+        }
+        assertThrows(IllegalArgumentException::class.java) {
+            SandboxPreferenceValues.encode(mapOf("bad" to "x".repeat(8193)))
+        }
+        assertThrows(IllegalStateException::class.java) {
+            SandboxPreferenceValues.encode(mapOf("bad" to Any()))
+        }
+        assertThrows(IllegalArgumentException::class.java) {
+            SandboxPreferenceValues.decode(
+                buildJsonObject {
+                    putJsonObject("bool") {
+                        put("type", "boolean")
+                        put("value", "true")
+                    }
+                }
+            )
+        }
+    }
+
+    @Test
+    fun `entry counts and total payload sizes stay bounded`() {
+        assertThrows(IllegalArgumentException::class.java) {
+            SandboxPreferenceValues.encode((1..257).associate { "k$it" to true })
+        }
+        assertThrows(IllegalArgumentException::class.java) {
+            SandboxPreferenceValues.encode((1..30).associate { "k$it" to "x".repeat(8192) })
+        }
+    }
+
+    @Test
+    fun `memory editor returns copies and rejects invalid batches before writing`() {
+        val prefs = MemoryPreferences(mapOf("tags" to setOf("a"), "count" to 1))
+        prefs.getStringSet("tags", null)!!.add("not saved")
+        assertEquals(setOf("a"), prefs.getStringSet("tags", null))
+        assertThrows(IllegalArgumentException::class.java) {
+            prefs.edit().putInt("count", 2).putString("bad", "x".repeat(8193)).commit()
+        }
+        assertEquals(1, prefs.getInt("count", 0))
+    }
+
+    @Test
+    fun `obvious access values and private marked fields are omitted by nonprivate backup policy`() {
+        assertTrue(SandboxPreferenceValues.sensitive("token"))
+        assertTrue(SandboxPreferenceValues.sensitive("api_key"))
+        assertTrue(SandboxPreferenceValues.sensitive("__PRIVATE_custom"))
+        assertFalse(SandboxPreferenceValues.sensitive("language"))
+    }
+}
diff --git a/app/src/test/java/eu/kanade/tachiyomi/extension/util/ExtensionInstallerDownloadTest.kt b/app/src/test/java/eu/kanade/tachiyomi/extension/util/ExtensionInstallerDownloadTest.kt
new file mode 100644
index 0000000..84cac8c
--- /dev/null
+++ b/app/src/test/java/eu/kanade/tachiyomi/extension/util/ExtensionInstallerDownloadTest.kt
@@ -0,0 +1,301 @@
+package eu.kanade.tachiyomi.extension.util
+
+import android.content.Context
+import com.sun.net.httpserver.HttpServer
+import eu.kanade.domain.base.BasePreferences
+import eu.kanade.tachiyomi.extension.installer.Installer
+import eu.kanade.tachiyomi.extension.model.Extension
+import eu.kanade.tachiyomi.extension.model.InstallStep
+import io.mockk.every
+import io.mockk.justRun
+import io.mockk.mockk
+import io.mockk.mockkObject
+import io.mockk.unmockkObject
+import io.mockk.verify
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.async
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.onEach
+import kotlinx.coroutines.flow.toList
+import kotlinx.coroutines.runBlocking
+import kotlinx.coroutines.withContext
+import kotlinx.coroutines.withTimeout
+import okhttp3.OkHttpClient
+import org.junit.jupiter.api.AfterEach
+import org.junit.jupiter.api.Assertions.assertArrayEquals
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.BeforeEach
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.io.TempDir
+import tachiyomi.core.common.preference.Preference
+import java.io.File
+import java.io.IOException
+import java.net.InetSocketAddress
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicInteger
+
+/**
+ * Real localhost HTTP and file pipeline. Android package parsing/notifications are the mocked
+ * boundary.
+ */
+class ExtensionInstallerDownloadTest {
+    @TempDir lateinit var folder: File
+    private val context = mockk<Context>()
+    private val preference = mockk<Preference<BasePreferences.ExtensionInstaller>>()
+    private val client = OkHttpClient.Builder().readTimeout(10, TimeUnit.SECONDS).build()
+    private val extension =
+        Extension.Installed(
+            "Test",
+            "test.source",
+            "1",
+            1,
+            1.4,
+            "en",
+            false,
+            null,
+            emptyList(),
+            null,
+            isShared = false,
+        )
+    private val bytes = ByteArray(150_000) { (it % 251).toByte() }
+    private val started = arrayOf(CountDownLatch(1), CountDownLatch(1))
+    private val release = CountDownLatch(1)
+    private val requests = AtomicInteger()
+    private val threads =
+        Executors.newCachedThreadPool { task -> Thread(task).apply { isDaemon = true } }
+    private var server: HttpServer? = null
+    private lateinit var installer: ExtensionInstaller
+    private val cache
+        get() = File(folder, "cache")
+
+    private val target
+        get() = File(folder, "source.ext")
+
+    @BeforeEach
+    fun setup() {
+        cache.mkdirs()
+        every { context.cacheDir } returns cache
+        every { preference.get() } returns BasePreferences.ExtensionInstaller.PRIVATE
+        mockkObject(ExtensionLoader, Installer.Companion)
+        justRun { Installer.cancelInstallQueue(context, any()) }
+        every { ExtensionLoader.installPrivateExtensionFile(context, any(), any()) } answers
+            {
+                PrivateExtensionFiles.replace(secondArg(), target, thirdArg()) { staged ->
+                    assertArrayEquals(bytes, staged.readBytes())
+                }
+                true
+            }
+        installer = ExtensionInstaller(context, preference, client)
+    }
+
+    @AfterEach
+    fun cleanup() {
+        listOf(extension.pkgName, "test.Aa", "test.BB").forEach(installer::cancelInstall)
+        release.countDown()
+        client.dispatcher.cancelAll()
+        server?.stop(0)
+        threads.shutdownNow()
+        runBlocking {
+            withTimeout(5000) { while (cache.listFiles().orEmpty().isNotEmpty()) delay(10) }
+        }
+        unmockkObject(ExtensionLoader, Installer.Companion)
+        client.dispatcher.executorService.shutdownNow()
+        client.connectionPool.evictAll()
+        folder.walk().forEach { it.setWritable(true) }
+    }
+
+    @Test
+    fun `reviewed identity is passed to private validation without changing the selected installer`() =
+        runBlocking {
+            every { preference.get() } returns BasePreferences.ExtensionInstaller.LEGACY
+            every {
+                ExtensionLoader.installVerifiedPrivateExtensionFile(
+                    context,
+                    any(),
+                    ReviewedPrivateExtension(
+                        extension.pkgName,
+                        "a".repeat(64),
+                        extension.versionCode,
+                    ),
+                    any(),
+                )
+            } answers
+                {
+                    PrivateExtensionFiles.replace(secondArg(), target, arg(3)) { staged ->
+                        assertArrayEquals(bytes, staged.readBytes())
+                    }
+                    true
+                }
+            val steps =
+                installer
+                    .downloadAndInstall(
+                        serve(),
+                        extension,
+                        true,
+                        ReviewedPrivateExtension(
+                            extension.pkgName,
+                            "a".repeat(64),
+                            extension.versionCode,
+                        ),
+                    )
+                    .toList()
+            assertEquals(InstallStep.Installed, steps.last())
+            verify(exactly = 0) {
+                ExtensionLoader.installPrivateExtensionFile(context, any(), any())
+            }
+            assertEquals(BasePreferences.ExtensionInstaller.LEGACY, preference.get())
+        }
+
+    @Test
+    fun `repository revoked during transfer prevents private installation and preserves the old file`() =
+        runBlocking {
+            target.writeText("working")
+            val steps =
+                installer
+                    .downloadAndInstall(
+                        serve(),
+                        extension,
+                        true,
+                        ReviewedPrivateExtension(
+                            extension.pkgName,
+                            "a".repeat(64),
+                            extension.versionCode,
+                        ),
+                        beforePrivateInstall = {
+                            error("repository removed or signing key changed")
+                        },
+                    )
+                    .toList()
+            assertEquals(InstallStep.Error, steps.last())
+            assertEquals("working", target.readText())
+            verify(exactly = 0) {
+                ExtensionLoader.installPrivateExtensionFile(context, any(), any())
+            }
+            verify(exactly = 0) {
+                ExtensionLoader.installVerifiedPrivateExtensionFile(context, any(), any(), any())
+            }
+        }
+
+    private fun serve(partial: Boolean = false, status: Int = 200): String {
+        val instance = HttpServer.create(InetSocketAddress("127.0.0.1", 0), 0)
+        instance.executor = threads
+        instance.createContext("/extension.apk") { exchange ->
+            val index = requests.getAndIncrement()
+            try {
+                if (status != 200) {
+                    exchange.sendResponseHeaders(status, -1)
+                } else {
+                    exchange.sendResponseHeaders(200, bytes.size.toLong())
+                    if (partial) {
+                        exchange.responseBody.write(bytes, 0, 128)
+                        exchange.responseBody.flush()
+                        started[index.coerceAtMost(1)].countDown()
+                        release.await(5, TimeUnit.SECONDS)
+                        exchange.responseBody.write(bytes, 128, bytes.size - 128)
+                    } else {
+                        exchange.responseBody.write(bytes)
+                    }
+                }
+            } catch (_: IOException) {
+                // A cancelled client closes its socket while the server still holds its response.
+            } catch (_: InterruptedException) {
+                Thread.currentThread().interrupt()
+            } finally {
+                exchange.close()
+            }
+        }
+        instance.start()
+        server = instance
+        return "http://127.0.0.1:${instance.address.port}/extension.apk"
+    }
+
+    private suspend fun awaitStart(index: Int) {
+        assertTrue(withContext(Dispatchers.IO) { started[index].await(5, TimeUnit.SECONDS) })
+    }
+
+    @Test
+    fun `private download emits a terminal success and removes the consumed APK`() = runBlocking {
+        val steps = withTimeout(5000) { installer.downloadAndInstall(serve(), extension).toList() }
+        assertEquals(InstallStep.Installed, steps.last())
+        assertArrayEquals(bytes, target.readBytes())
+        withTimeout(5000) { while (cache.listFiles().orEmpty().isNotEmpty()) delay(10) }
+    }
+
+    @Test
+    fun `HTTP failure completes the flow with error and cleans its download`() = runBlocking {
+        val steps =
+            withTimeout(5000) {
+                installer.downloadAndInstall(serve(status = 503), extension).toList()
+            }
+        assertEquals(InstallStep.Error, steps.last())
+        verify(exactly = 0) { ExtensionLoader.installPrivateExtensionFile(context, any(), any()) }
+    }
+
+    @Test
+    fun `cancellation interrupts a stalled response without replacing the working extension`() =
+        runBlocking {
+            val original = "working".encodeToByteArray()
+            target.writeBytes(original)
+            val url = serve(partial = true)
+            val collecting = async { installer.downloadAndInstall(url, extension).toList() }
+            awaitStart(0)
+            installer.cancelInstall(extension.pkgName)
+            val steps = withTimeout(5000) { collecting.await() }
+            assertEquals(InstallStep.Idle, steps.last())
+            assertArrayEquals(original, target.readBytes())
+            verify(exactly = 0) {
+                ExtensionLoader.installPrivateExtensionFile(context, any(), any())
+            }
+        }
+
+    @Test
+    fun `different package names with the same hash cannot cancel each other`() = runBlocking {
+        val firstExtension = extension.copy(pkgName = "test.Aa")
+        val secondExtension = extension.copy(pkgName = "test.BB")
+        assertEquals(firstExtension.pkgName.hashCode(), secondExtension.pkgName.hashCode())
+        val url = serve(partial = true)
+        val first = async { installer.downloadAndInstall(url, firstExtension).toList() }
+        awaitStart(0)
+        val second = async { installer.downloadAndInstall(url, secondExtension).toList() }
+        awaitStart(1)
+        installer.cancelInstall(firstExtension.pkgName)
+        assertEquals(InstallStep.Idle, withTimeout(5000) { first.await() }.last())
+        release.countDown()
+        assertEquals(InstallStep.Installed, withTimeout(5000) { second.await() }.last())
+        assertArrayEquals(bytes, target.readBytes())
+    }
+
+    @Test
+    fun `completion of a cancelled attempt cannot remove the retry from active jobs`() =
+        runBlocking {
+            val url = serve(partial = true)
+            val oldAtIdle = CompletableDeferred<Unit>()
+            val releaseOldCollector = CompletableDeferred<Unit>()
+            val first = async {
+                installer
+                    .downloadAndInstall(url, extension)
+                    .onEach {
+                        if (it == InstallStep.Idle) {
+                            oldAtIdle.complete(Unit)
+                            releaseOldCollector.await()
+                        }
+                    }
+                    .toList()
+            }
+            awaitStart(0)
+            val second = async { installer.downloadAndInstall(url, extension).toList() }
+            withTimeout(5000) { oldAtIdle.await() }
+            awaitStart(1)
+            releaseOldCollector.complete(Unit)
+            withTimeout(5000) { first.await() }
+            installer.cancelInstall(extension.pkgName)
+            assertEquals(InstallStep.Idle, withTimeout(5000) { second.await() }.last())
+            verify(exactly = 0) {
+                ExtensionLoader.installPrivateExtensionFile(context, any(), any())
+            }
+        }
+}
diff --git a/app/src/test/java/eu/kanade/tachiyomi/extension/util/ExtensionSecurityAuditTest.kt b/app/src/test/java/eu/kanade/tachiyomi/extension/util/ExtensionSecurityAuditTest.kt
new file mode 100644
index 0000000..4a90cce
--- /dev/null
+++ b/app/src/test/java/eu/kanade/tachiyomi/extension/util/ExtensionSecurityAuditTest.kt
@@ -0,0 +1,133 @@
+package eu.kanade.tachiyomi.extension.util
+
+import java.io.File
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import java.nio.file.Path
+import java.util.zip.ZipEntry
+import java.util.zip.ZipOutputStream
+import org.junit.jupiter.api.Assertions.*
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.io.TempDir
+
+class ExtensionSecurityAuditTest {
+    @TempDir lateinit var temporary: Path
+
+    private fun dex(owner: String, method: String): ByteArray {
+        val strings = listOf(owner, method)
+        val stringTable = 112
+        val types = stringTable + strings.size * 4
+        val methods = types + 4
+        val stringData = methods + 8
+        val data = ByteArray(stringData + strings.sumOf { it.length + 2 })
+        "dex\n035\u0000".toByteArray().copyInto(data)
+        val buffer = ByteBuffer.wrap(data).order(ByteOrder.LITTLE_ENDIAN)
+        buffer.putInt(32, data.size)
+        buffer.putInt(36, 112)
+        buffer.putInt(40, 0x12345678)
+        buffer.putInt(56, strings.size)
+        buffer.putInt(60, stringTable)
+        buffer.putInt(64, 1)
+        buffer.putInt(68, types)
+        buffer.putInt(88, 1)
+        buffer.putInt(92, methods)
+        buffer.putInt(types, 0)
+        buffer.putShort(methods, 0)
+        buffer.putInt(methods + 4, 1)
+        var offset = stringData
+        strings.forEachIndexed { index, value ->
+            buffer.putInt(stringTable + index * 4, offset)
+            data[offset++] = value.length.toByte()
+            value.toByteArray().copyInto(data, offset)
+            offset += value.length + 1
+        }
+        return data
+    }
+
+    private fun apk(vararg entries: Pair<String, ByteArray>): File {
+        val file = temporary.resolve("extension.apk").toFile()
+        ZipOutputStream(file.outputStream()).use { zip ->
+            entries.forEach { (name, bytes) ->
+                zip.putNextEntry(ZipEntry(name))
+                zip.write(bytes)
+                zip.closeEntry()
+            }
+        }
+        return file
+    }
+
+    @Test
+    fun `ordinary HTTP references are not labeled dangerous solely by method name`() {
+        assertTrue(
+            ExtensionSecurityAudit.inspectDex(dex("Lokhttp3/OkHttpClient;", "exec")).isEmpty()
+        )
+    }
+
+    @Test
+    fun `runtime execution and dynamically loaded code require quarantine`() {
+        for ((owner, method, risk) in
+            listOf(
+                Triple("Ljava/lang/Runtime;", "exec", "SHELL_EXECUTION"),
+                Triple("Ljava/lang/ProcessBuilder;", "start", "SHELL_EXECUTION"),
+                Triple("Ldalvik/system/DexClassLoader;", "<init>", "DYNAMIC_CODE"),
+                Triple("Landroid/content/ContentResolver;", "query", "SENSITIVE_PROVIDER"),
+                Triple("Landroid/telephony/SmsManager;", "sendTextMessage", "DEVICE_CONTROL"),
+                Triple("Lrikka/shizuku/Shizuku;", "getBinder", "DEVICE_CONTROL"),
+            )) assertEquals(setOf(risk), ExtensionSecurityAudit.inspectDex(dex(owner, method)))
+    }
+
+    @Test
+    fun `all dex files are inspected and native code and sensitive declarations are surfaced`() {
+        val file =
+            apk(
+                "classes.dex" to dex("Lokhttp3/OkHttpClient;", "newCall"),
+                "classes2.dex" to dex("Ljava/lang/Runtime;", "exec"),
+                "lib/arm64-v8a/libextra.so" to byteArrayOf(1),
+            )
+        val report =
+            ExtensionSecurityAudit.inspect(file, listOf("android.permission.READ_CONTACTS"))
+        assertEquals(
+            setOf("SHELL_EXECUTION", "NATIVE_CODE", "PRIVILEGED_PERMISSION"),
+            report.findings.toSet(),
+        )
+        assertTrue(ExtensionSecurityAudit.requiresQuarantine("test.extension", report, emptySet()))
+    }
+
+    @Test
+    fun `an approval binds package and exact bytes and does not authorize a changed update`() {
+        val file = apk("classes.dex" to dex("Ljava/lang/Runtime;", "exec"))
+        val first = ExtensionSecurityAudit.inspect(file, emptyList())
+        val approved = setOf(ExtensionSecurityAudit.approvalKey("test.extension", first)!!)
+        assertFalse(ExtensionSecurityAudit.requiresQuarantine("test.extension", first, approved))
+        assertTrue(ExtensionSecurityAudit.requiresQuarantine("other.extension", first, approved))
+        apk("classes.dex" to dex("Ljava/lang/Runtime;", "exec"), "extra" to byteArrayOf(42))
+        val changed = ExtensionSecurityAudit.inspect(file, emptyList())
+        assertNotEquals(first.sha256, changed.sha256)
+        assertTrue(ExtensionSecurityAudit.requiresQuarantine("test.extension", changed, approved))
+    }
+
+    @Test
+    fun `unreadable or out of bounds code fails closed and cannot be approved`() {
+        val malformed = dex("Ljava/lang/Runtime;", "exec")
+        ByteBuffer.wrap(malformed).order(ByteOrder.LITTLE_ENDIAN).putInt(92, Int.MAX_VALUE)
+        val report = ExtensionSecurityAudit.inspect(apk("classes.dex" to malformed), emptyList())
+        assertTrue("UNREADABLE_CODE" in report.findings)
+        assertNull(ExtensionSecurityAudit.approvalKey("test.extension", report))
+        assertTrue(
+            ExtensionSecurityAudit.requiresQuarantine(
+                "test.extension",
+                report,
+                setOf("test.extension:${report.sha256}"),
+            )
+        )
+    }
+
+    @Test
+    fun `a package without inspectable dex is not silently accepted`() {
+        assertEquals(
+            listOf("UNREADABLE_CODE"),
+            ExtensionSecurityAudit.inspect(apk("assets/readme" to byteArrayOf(1)), emptyList())
+                .findings,
+        )
+    }
+}
diff --git a/app/src/test/java/eu/kanade/tachiyomi/extension/util/PrivateExtensionFilesTest.kt b/app/src/test/java/eu/kanade/tachiyomi/extension/util/PrivateExtensionFilesTest.kt
new file mode 100644
