+                    BackupOptions(),
+                )
+            val bytes =
+                ProtoBuf.encodeToByteArray(Backup.serializer(), Backup(backupManga = exported))
+            val decoded = ProtoBuf.decodeFromByteArray(Backup.serializer(), bytes).backupManga
+            assertEquals(2, decoded.size)
+            assertEquals(setOf(1L, 2L), decoded.map { it.source }.toSet())
+            assertTrue(
+                decoded
+                    .flatMap { it.chapters }
+                    .none { ChapterStorage.KEY in MemoColumnAdapter.decode(it.memo) }
+            )
+            val native = GetChaptersByMangaId(f.chapters, f.query)
+            val interval = FetchInterval(native)
+            val tracks = TrackRepositoryImpl(f.db)
