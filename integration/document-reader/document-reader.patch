diff --git a/app/src/test/java/eu/kanade/tachiyomi/extension/preparation/ExtensionPreparationQueueTest.kt b/app/src/test/java/eu/kanade/tachiyomi/extension/preparation/ExtensionPreparationQueueTest.kt
new file mode 100644
index 0000000..e75faf5
--- /dev/null
+++ b/app/src/test/java/eu/kanade/tachiyomi/extension/preparation/ExtensionPreparationQueueTest.kt
@@ -0,0 +1,245 @@
+package eu.kanade.tachiyomi.extension.preparation
+
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.awaitCancellation
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.test.advanceTimeBy
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.runCurrent
+import kotlinx.coroutines.test.runTest
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Assertions.fail
+import org.junit.jupiter.api.Test
+
+class ExtensionPreparationQueueTest {
+    @Test
+    fun `completion is emitted once per explicit batch and includes trust failures`() = runTest {
+        val completed = mutableListOf<PreparationBatch>()
+        val queue =
+            ExtensionPreparationQueue(
+                this,
+                { true },
+                { ext, _ ->
+                    if (ext.pkgName == "ready") PreparationStatus.READY
+                    else PreparationStatus.NEEDS_TRUST
+                },
+                onComplete = { completed += it },
+            )
+        runCurrent()
+        assertTrue(completed.isEmpty())
+        assertFalse(queue.start(listOf(extension("ready")), false))
+        assertTrue(completed.isEmpty())
+        assertTrue(queue.start(listOf(extension("ready"), extension("blocked")), true))
+        advanceUntilIdle()
+        assertEquals(1, completed.size)
+        assertFalse(completed.single().running)
+        assertEquals(
+            listOf(PreparationStatus.READY, PreparationStatus.NEEDS_TRUST),
+            completed.single().entries.map { it.status },
+        )
+    }
+
+    @Test
+    fun `opening or restoring data never starts downloads and consent is mandatory`() = runTest {
+        var calls = 0
+        val queue =
+            ExtensionPreparationQueue(
+                this,
+                { true },
+                { _, _ ->
+                    calls++
+                    PreparationStatus.READY
+                },
+            )
+        runCurrent()
+        assertFalse(queue.start(listOf(extension()), consent = false))
+        assertEquals(0, calls)
+        assertFalse(queue.state.value.running)
+        assertTrue(queue.state.value.entries.isEmpty())
+    }
+
+    @Test
+    fun `at most two downloads run and each package is prepared once`() = runTest {
+        val gate = CompletableDeferred<Unit>()
+        var active = 0
+        var maximum = 0
+        val calls = mutableListOf<String>()
+        val queue =
+            ExtensionPreparationQueue(
+                this,
+                { true },
+                { ext, progress ->
+                    calls += ext.pkgName
+                    active++
+                    maximum = maxOf(maximum, active)
+                    progress(PreparationStatus.DOWNLOADING)
+                    gate.await()
+                    active--
+                    PreparationStatus.READY
+                },
+            )
+        assertTrue(queue.start((1..15).map { extension("pkg$it") }, true))
+        runCurrent()
+        assertEquals(2, calls.size)
+        assertFalse(queue.start(listOf(extension("replacement")), true))
+        gate.complete(Unit)
+        advanceUntilIdle()
+        assertEquals(2, maximum)
+        assertEquals(15, calls.distinct().size)
+        assertTrue(queue.state.value.entries.all { it.status == PreparationStatus.READY })
+        assertFalse(queue.state.value.running)
+    }
+
+    @Test
+    fun `cancelling before dispatch still finishes the queue`() = runTest {
+        val queue = ExtensionPreparationQueue(this, { true }, { _, _ -> fail("must not install") })
+        queue.start(listOf(extension()), true)
+        queue.cancel()
+        runCurrent()
+        assertFalse(queue.state.value.running)
+        assertEquals(PreparationStatus.CANCELLED, queue.state.value.entries.single().status)
+        queue.clear()
+        assertTrue(queue.state.value.entries.isEmpty())
+    }
+
+    @Test
+    fun `cancellation preserves completed items and does not start queued ones`() = runTest {
+        val calls = mutableListOf<String>()
+        val queue =
+            ExtensionPreparationQueue(
+                this,
+                { true },
+                { ext, _ ->
+                    calls += ext.pkgName
+                    if (ext.pkgName == "ready") PreparationStatus.READY else awaitCancellation()
+                },
+            )
+        queue.start(
+            listOf(extension("ready"), extension("slow1"), extension("slow2"), extension("queued")),
+            true,
+        )
+        runCurrent()
+        queue.cancel()
+        advanceUntilIdle()
+        assertEquals(PreparationStatus.READY, queue.state.value.entries.first().status)
+        assertTrue(
+            queue.state.value.entries.drop(1).all { it.status == PreparationStatus.CANCELLED }
+        )
+        assertFalse("queued" in calls)
+    }
+
+    @Test
+    fun `retry only repeats failed items and never grants trust`() = runTest {
+        val calls = mutableListOf<String>()
+        var failFirst = true
+        val queue =
+            ExtensionPreparationQueue(
+                this,
+                { true },
+                { ext, _ ->
+                    calls += ext.pkgName
+                    when (ext.pkgName) {
+                        "trust" -> PreparationStatus.NEEDS_TRUST
+                        "fail" ->
+                            if (failFirst) PreparationStatus.FAILED else PreparationStatus.READY
+                        else -> PreparationStatus.READY
+                    }
+                },
+            )
+        queue.start(listOf(extension("ok"), extension("trust"), extension("fail")), true)
+        advanceUntilIdle()
+        assertFalse(queue.retryFailures(false))
+        failFirst = false
+        assertTrue(queue.retryFailures(true))
+        advanceUntilIdle()
+        assertEquals(listOf("fail", "fail"), calls.filter { it == "fail" })
+        assertEquals(1, calls.count { it == "ok" })
+        assertEquals(1, calls.count { it == "trust" })
+        assertEquals(PreparationStatus.NEEDS_TRUST, queue.state.value.entries[1].status)
+    }
+
+    @Test
+    fun `repository changes are checked again before queued work and retries`() = runTest {
+        var authorized = true
+        val gate = CompletableDeferred<Unit>()
+        val calls = mutableListOf<String>()
+        val queue =
+            ExtensionPreparationQueue(
+                this,
+                { authorized },
+                { ext, _ ->
+                    calls += ext.pkgName
+                    gate.await()
+                    PreparationStatus.READY
+                },
+            )
+        queue.start((1..3).map { extension("pkg$it") }, true)
+        runCurrent()
+        authorized = false
+        gate.complete(Unit)
+        advanceUntilIdle()
+        assertEquals(2, calls.size)
+        assertEquals(PreparationStatus.FAILED, queue.state.value.entries.last().status)
+        queue.retryFailures(true)
+        advanceUntilIdle()
+        assertEquals(2, calls.size)
+    }
+
+    @Test
+    fun `a timed out item does not prevent other items from finishing`() = runTest {
+        val queue =
+            ExtensionPreparationQueue(
+                this,
+                { true },
+                { ext, _ ->
+                    if (ext.pkgName == "slow") delay(1000)
+                    PreparationStatus.READY
+                },
+                timeoutMillis = 100,
+            )
+        queue.start(listOf(extension("slow"), extension("ok")), true)
+        advanceTimeBy(101)
+        runCurrent()
+        assertEquals(
+            listOf(PreparationStatus.FAILED, PreparationStatus.READY),
+            queue.state.value.entries.map { it.status },
+        )
+        assertFalse(queue.state.value.running)
+    }
+
+    @Test
+    fun `duplicate packages invalid identities and insecure downloads are rejected before starting`() =
+        runTest {
+            val queue =
+                ExtensionPreparationQueue(this, { true }, { _, _ -> fail("must not install") })
+            assertFalse(queue.start(listOf(extension(), extension()), true))
+            assertFalse(queue.start(listOf(extension(repo = store(key = "NO_SIGNING_KEY"))), true))
+            assertFalse(
+                queue.start(listOf(extension().copy(apkUrl = "http://example.org/file.apk")), true)
+            )
+            assertTrue(queue.state.value.entries.isEmpty())
+        }
+
+    @Test
+    fun `one exception fails only its item and a new batch starts cleanly`() = runTest {
+        val queue =
+            ExtensionPreparationQueue(
+                this,
+                { true },
+                { ext, _ ->
+                    if (ext.pkgName == "bad") error("unavailable") else PreparationStatus.READY
+                },
+            )
+        queue.start(listOf(extension("bad"), extension("ok")), true)
+        advanceUntilIdle()
+        assertEquals(
+            listOf(PreparationStatus.FAILED, PreparationStatus.READY),
+            queue.state.value.entries.map { it.status },
+        )
+        assertTrue(queue.start(listOf(extension("new")), true))
+        advanceUntilIdle()
+        assertEquals(listOf("new"), queue.state.value.entries.map { it.extension.pkgName })
+    }
+}
diff --git a/app/src/test/java/eu/kanade/tachiyomi/extension/preparation/PreparationPlanTest.kt b/app/src/test/java/eu/kanade/tachiyomi/extension/preparation/PreparationPlanTest.kt
new file mode 100644
index 0000000..8daa45e
--- /dev/null
+++ b/app/src/test/java/eu/kanade/tachiyomi/extension/preparation/PreparationPlanTest.kt
@@ -0,0 +1,193 @@
+package eu.kanade.tachiyomi.extension.preparation
+
+import eu.kanade.tachiyomi.extension.model.Extension
+import mihon.domain.extension.model.ExtensionStore
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+
+internal fun store(name: String = "one", key: String = "a".repeat(64)) =
+    ExtensionStore(
+        "https://example.org/$name/index.pb",
+        name,
+        name,
+        key,
+        ExtensionStore.Contact("https://example.org", null),
+        false,
+        null,
+    )
+
+internal fun extension(
+    pkg: String = "test.one",
+    repo: ExtensionStore = store(),
+    lang: String = "en",
+    ids: List<Long> = listOf(42L),
+    version: Long = 2,
+    nsfw: Boolean = false,
+) =
+    Extension.Available(
+        pkg,
+        pkg,
+        "1.0",
+        version,
+        1.4,
+        lang,
+        nsfw,
+        ids.map { Extension.Available.Source(it, "en", pkg, "https://example.org") },
+        "https://example.org/$pkg.apk",
+        "",
+        repo,
+    )
+
+class PreparationPlanTest {
+    private fun plan(
+        available: List<Extension.Available>,
+        repos: Set<RepositoryIdentity> = setOf(RepositoryIdentity.of(store())),
+        installed: Map<String, Long> = emptyMap(),
+        shared: Set<String> = emptySet(),
+        mode: PreparationSelection = PreparationSelection.LANGUAGES,
+        langs: Set<String> = setOf("en"),
+        sources: Set<Long> = emptySet(),
+        manual: Set<String> = emptySet(),
+        nsfw: Boolean = false,
+    ) =
+        PreparationPlanner.create(
+            available,
+            repos,
+            installed,
+            shared,
+            mode,
+            langs,
+            sources,
+            manual,
+            nsfw,
+        )
+
+    @Test
+    fun `restored source ids select exact sources without title matching or remapping`() {
+        val ids = setOf(Long.MAX_VALUE - 4, 99L)
+        val original = extension(ids = listOf(Long.MAX_VALUE - 4))
+        val result =
+            plan(
+                listOf(original, extension("other", ids = listOf(10))),
+                mode = PreparationSelection.LIBRARY,
+                sources = ids,
+            )
+        assertEquals(listOf(original), result.extensions)
+        assertEquals(setOf(99L), result.missingSourceIds)
+        assertEquals(setOf(Long.MAX_VALUE - 4, 99L), ids)
+    }
+
+    @Test
+    fun `matching a member language includes multilingual extensions`() {
+        assertEquals(1, plan(listOf(extension(lang = "all"))).extensions.size)
+        assertTrue(plan(listOf(extension(lang = "all")), langs = setOf("ja")).extensions.isEmpty())
+    }
+
+    @Test
+    fun `installed private versions are skipped and shared packages are never converted`() {
+        val available = listOf(extension("current"), extension("update"), extension("shared"))
+        val result =
+            plan(
+                available,
+                installed = mapOf("current" to 2L, "update" to 1L),
+                shared = setOf("shared"),
+            )
+        assertEquals(listOf("update"), result.extensions.map { it.pkgName })
+    }
+
+    @Test
+    fun `same package from two repositories requires repository choice`() {
+        val first = extension()
+        val other = extension(repo = store("two", "b".repeat(64)))
+        val both =
+            plan(
+                listOf(first, other),
+                repos =
+                setOf(RepositoryIdentity.of(first.store), RepositoryIdentity.of(other.store)),
+            )
+        assertEquals(setOf(first.pkgName), both.conflicts)
+        assertTrue(both.extensions.isEmpty())
+        assertEquals(listOf(first), plan(listOf(first, other)).extensions)
+    }
+
+    @Test
+    fun `conflicting download urls for the same version are not chosen arbitrarily`() {
+        val one = extension()
+        assertTrue(
+            plan(listOf(one, one.copy(apkUrl = "https://other.org/file.apk"))).extensions.isEmpty(),
+        )
+    }
+
+    @Test
+    fun `exact duplicate metadata is deduplicated and latest version from one repository wins`() {
+        val one = extension()
+        assertEquals(
+            listOf(one.copy(versionCode = 3)),
+            plan(listOf(one, one, one.copy(versionCode = 3))).extensions,
+        )
+    }
+
+    @Test
+    fun `manual selection and adult content require explicit choices`() {
+        val adult = extension(nsfw = true)
+        assertTrue(
+            plan(listOf(adult), mode = PreparationSelection.MANUAL, manual = setOf(adult.pkgName))
+                .extensions
+                .isEmpty(),
+        )
+        assertEquals(
+            listOf(adult),
+            plan(
+                listOf(adult),
+                mode = PreparationSelection.MANUAL,
+                manual = setOf(adult.pkgName),
+                nsfw = true,
+            )
+                .extensions,
+        )
+        assertTrue(
+            plan(listOf(extension()), mode = PreparationSelection.MANUAL).extensions.isEmpty(),
+        )
+    }
+
+    @Test
+    fun `restored repositories without a certificate and changed keys do not authorize preparation`() {
+        val invalid = extension(repo = store(key = "NO_SIGNING_KEY"))
+        assertTrue(
+            plan(listOf(invalid), repos = setOf(RepositoryIdentity.of(invalid.store)))
+                .extensions
+                .isEmpty(),
+        )
+        assertTrue(plan(listOf(extension(repo = store(key = "b".repeat(64))))).extensions.isEmpty())
+        assertFalse(RepositoryIdentity("http://example.org/index.pb", "a".repeat(64)).canVerify)
+    }
+
+    @Test
+    fun `a newer package cannot silently switch an installed source to another selected repository`() {
+        val original = extension()
+        val alternative = extension(repo = store("two", "b".repeat(64)), version = 3)
+        val result =
+            plan(
+                listOf(original, alternative),
+                repos =
+                setOf(
+                    RepositoryIdentity.of(original.store),
+                    RepositoryIdentity.of(alternative.store),
+                ),
+                installed = mapOf(original.pkgName to 2L),
+            )
+        assertTrue(result.extensions.isEmpty())
+        assertEquals(setOf(original.pkgName), result.conflicts)
+    }
+
+    @Test
+    fun `unsupported extension library versions are reported without attempting installation`() {
+        val incompatible = extension().copy(libVersion = 99.0)
+        val insecure = extension("insecure").copy(apkUrl = "http://example.org/file.apk")
+        val result = plan(listOf(incompatible, insecure))
+        assertTrue(result.extensions.isEmpty())
+        assertEquals(setOf(incompatible.pkgName, insecure.pkgName), result.unsupportedPackages)
+    }
+}
