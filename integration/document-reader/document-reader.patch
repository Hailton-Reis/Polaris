@@ -0,0 +1,338 @@
+package eu.kanade.tachiyomi.extension.sandbox
+
+import android.content.Context
+import android.security.keystore.KeyGenParameterSpec
+import android.security.keystore.KeyProperties
+import java.io.IOException
+import java.security.KeyStore
+import java.security.MessageDigest
+import javax.crypto.Cipher
+import javax.crypto.KeyGenerator
+import javax.crypto.SecretKey
+import javax.crypto.spec.GCMParameterSpec
+import kotlinx.serialization.json.*
+import okhttp3.Cookie
+import okhttp3.CookieJar
+import okhttp3.HttpUrl
+
+/**
+ * Host-owned HTTP state. No CookieManager, global browser profile or source preferences are read.
+ */
+internal class SandboxCookieStore(
+    context: Context,
+    identity: String,
+    cache: SessionCache = processCache,
+) {
+    val scope =
+        MessageDigest.getInstance("SHA-256").digest(identity.toByteArray()).joinToString("") {
+            "%02x".format(it)
+        }
+    private val bank =
+        cache.banks.computeIfAbsent(scope) {
+            CookieBank(EncryptedCookieStorage(context.applicationContext, scope))
+        }
+
+    fun newSessionJar(): CookieJar = bank.newSessionJar()
+
+    fun status(): CookieBank.Status = bank.status()
+
+    fun clear() = bank.clear()
+
+    /**
+     * A fresh cache models a fresh host process; session-only cookies deliberately do not restore.
+     */
+    class SessionCache {
+        internal val banks = java.util.concurrent.ConcurrentHashMap<String, CookieBank>()
+    }
+
+    private companion object {
+        val processCache = SessionCache()
+    }
+}
+
+internal interface RevocableCookieJar : CookieJar {
+    fun isActive(): Boolean
+}
+
+internal interface CookieStorage {
+    fun load(): List<Cookie>
+
+    fun save(cookies: List<Cookie>)
+
+    fun clear()
+}
+
+/**
+ * One verified package/signer principal. Different requests merge cookies rather than replace
+ * hosts.
+ */
+internal class CookieBank(
+    private val storage: CookieStorage,
+    private val clock: () -> Long = System::currentTimeMillis,
+) {
+    data class Status(val persistent: Int, val temporary: Int, val storageUnavailable: Boolean)
+
+    private val values = linkedMapOf<Triple<String, String, String>, Cookie>()
+    private var loaded = false
+    private var generation = 0L
+    private var lastPersisted = ""
+    private var unavailable = false
+
+    private fun key(cookie: Cookie) = Triple(cookie.name, cookie.domain, cookie.path)
+
+    @Synchronized
+    private fun load() {
+        if (loaded) return
+        loaded = true
+        try {
+            val saved = storage.load()
+            require(saved.all { it.persistent && CookieCodec.valid(it) })
+            lastPersisted = CookieCodec.encode(saved).toString()
+            saved.forEach { cookie -> if (cookie.expiresAt > clock()) values[key(cookie)] = cookie }
+            trim()
+        } catch (_: Exception) {
+            values.clear()
+            unavailable = true
+        }
+    }
+
+    private fun trim() {
+        values.entries.removeAll { it.value.expiresAt <= clock() }
+        while (
+            values.size > CookieCodec.MAX_COOKIES ||
+                values.values.sumOf {
+                    CookieCodec.encode(listOf(it)).toString().toByteArray().size
+                } > CookieCodec.MAX_BYTES
+        ) values.remove(values.keys.first())
+    }
+
+    private fun persist() {
+        val persistent = values.values.filter { it.persistent }
+        val encoded = CookieCodec.encode(persistent).toString()
+        if (encoded == lastPersisted && !unavailable) return
+        try {
+            storage.save(persistent)
+            lastPersisted = encoded
+            unavailable = false
+        } catch (_: Exception) {
+            unavailable = true
+        } // Keep a usable in-memory session, report storage state.
+    }
+
+    @Synchronized
+    fun newSessionJar(): CookieJar {
+        val issued = generation
+        return object : RevocableCookieJar {
+            override fun isActive() = synchronized(this@CookieBank) { issued == generation }
+
+            override fun loadForRequest(url: HttpUrl): List<Cookie> =
+                synchronized(this@CookieBank) {
+                    SandboxNetworkPolicy.requireUrl(url.toString())
+                    if (issued != generation) return@synchronized emptyList()
+                    load()
+                    trim()
+                    persist()
+                    values.values.filter { it.matches(url) }.sortedByDescending { it.path.length }
+                }
+
+            override fun saveFromResponse(url: HttpUrl, cookies: List<Cookie>) {
+                synchronized(this@CookieBank) {
+                    SandboxNetworkPolicy.requireUrl(url.toString())
+                    if (issued != generation) return
+                    load()
+                    cookies.take(CookieCodec.MAX_COOKIES * 2).forEach { candidate ->
+                        if (!CookieCodec.valid(candidate)) return@forEach
+                        // Reuse OkHttp's public-suffix, host-only and domain checks, independent of
+                        // path.
+                        val cookie = Cookie.parse(url, candidate.toString()) ?: return@forEach
+                        if (cookie.secure && !url.isHttps) return@forEach
+                        values.remove(key(cookie))
+                        if (cookie.expiresAt > clock()) values[key(cookie)] = cookie
+                    }
+                    trim()
+                    persist()
+                }
+            }
+        }
+    }
+
+    @Synchronized
+    fun status(): Status {
+        load()
+        trim()
+        persist()
+        return Status(
+            values.values.count { it.persistent },
+            values.values.count { !it.persistent },
+            unavailable,
+        )
+    }
+
+    @Synchronized
+    fun clear() {
+        generation++ // Responses already in flight cannot repopulate a cleared session.
+        values.clear()
+        loaded = true
+        lastPersisted = ""
+        try {
+            storage.clear()
+            lastPersisted = "[]"
+            unavailable = false
+        } catch (error: Exception) {
+            unavailable = true
+            throw IOException("Session could not be cleared", error)
+        }
+    }
+}
+
+internal object CookieCodec {
+    const val MAX_COOKIES = 64
+    const val MAX_BYTES = 32 * 1024
+
+    fun valid(cookie: Cookie): Boolean =
+        cookie.name.length in 1..256 &&
+            cookie.value.toByteArray().size <= 4096 &&
+            cookie.domain.length in 1..253 &&
+            cookie.path.length in 1..1024 &&
+            cookie.path.startsWith("/")
+
+    fun encode(cookies: Collection<Cookie>): JsonArray {
+        require(cookies.size <= MAX_COOKIES && cookies.all(::valid))
+        return JsonArray(
+                cookies.map { c ->
+                    buildJsonObject {
+                        put("name", c.name)
+                        put("value", c.value)
+                        put("domain", c.domain)
+                        put("path", c.path)
+                        put("expires", c.expiresAt)
+                        put("secure", c.secure)
+                        put("httpOnly", c.httpOnly)
+                        put("hostOnly", c.hostOnly)
+                    }
+                }
+            )
+            .also { require(it.toString().toByteArray().size <= MAX_BYTES * 2) }
+    }
+
+    fun decode(text: String): List<Cookie> {
+        require(text.toByteArray().size <= MAX_BYTES * 2)
+        val items = Json.parseToJsonElement(text).jsonArray
+        require(items.size <= MAX_COOKIES)
+        return items.map { value ->
+            val c = value.jsonObject
+            fun string(key: String): String =
+                c.getValue(key).jsonPrimitive.also { require(it.isString) }.content
+            fun bool(key: String): Boolean =
+                c.getValue(key).jsonPrimitive.also { require(!it.isString) }.boolean
+            require(
+                c.keys ==
+                    setOf(
+                        "name",
+                        "value",
+                        "domain",
+                        "path",
+                        "expires",
+                        "secure",
+                        "httpOnly",
+                        "hostOnly",
+                    )
+            )
+            val expires = c.getValue("expires").jsonPrimitive.also { require(!it.isString) }.long
+            Cookie.Builder()
+                .name(string("name"))
+                .value(string("value"))
+                .apply {
+                    if (bool("hostOnly")) hostOnlyDomain(string("domain"))
+                    else domain(string("domain"))
+                }
+                .path(string("path"))
+                .expiresAt(expires)
+                .apply {
+                    if (bool("secure")) secure()
+                    if (bool("httpOnly")) httpOnly()
+                }
+                .build()
+                .also { require(valid(it)) }
+        }
+    }
+}
+
+/** Private app storage, AES-GCM authenticated with the verified principal as associated data. */
+internal class EncryptedCookieStorage(private val context: Context, private val scope: String) :
+    CookieStorage {
+    private val prefs by lazy {
+        context.getSharedPreferences("polaris_sandbox_cookies_$scope", Context.MODE_PRIVATE)
+    }
+    private val aad
+        get() = "Polaris.cookies.v1/$scope".toByteArray()
+
+    override fun load(): List<Cookie> {
+        val encoded = prefs.getString("sealed", null) ?: return emptyList()
+        try {
+            require(encoded.length <= 96 * 1024)
+            val pieces = encoded.split(':')
+            require(pieces.size == 3 && pieces[0] == "v1")
+            val iv = java.util.Base64.getDecoder().decode(pieces[1])
+            require(iv.size == 12)
+            val payload = java.util.Base64.getDecoder().decode(pieces[2])
+            require(payload.size in 16..(CookieCodec.MAX_BYTES * 2 + 16))
+            val cipher = Cipher.getInstance("AES/GCM/NoPadding")
+            cipher.init(Cipher.DECRYPT_MODE, key(create = false), GCMParameterSpec(128, iv))
+            cipher.updateAAD(aad)
+            return CookieCodec.decode(cipher.doFinal(payload).toString(Charsets.UTF_8))
+        } catch (error: Exception) {
+            prefs.edit().clear().commit() // A corrupt/copied ciphertext never grants a session.
+            throw IOException("Saved isolated session unavailable", error)
+        }
+    }
+
+    override fun save(cookies: List<Cookie>) {
+        if (cookies.isEmpty()) {
+            clear()
+            return
+        }
+        val data = CookieCodec.encode(cookies).toString().toByteArray()
+        val cipher = Cipher.getInstance("AES/GCM/NoPadding")
+        cipher.init(Cipher.ENCRYPT_MODE, key(create = true))
+        cipher.updateAAD(aad)
+        val encrypted = cipher.doFinal(data)
+        require(cipher.iv.size == 12)
+        val encoder = java.util.Base64.getEncoder()
+        val value =
+            "v1:" + encoder.encodeToString(cipher.iv) + ":" + encoder.encodeToString(encrypted)
+        check(prefs.edit().putString("sealed", value).commit()) { "Session storage failed" }
+    }
+
+    override fun clear() {
+        check(prefs.edit().clear().commit()) { "Session clear failed" }
+    }
+
+    private fun key(create: Boolean): SecretKey =
+        synchronized(KEY_LOCK) {
+            val store = KeyStore.getInstance("AndroidKeyStore").apply { load(null) }
+            (store.getKey(KEY_ALIAS, null) as? SecretKey)?.let {
+                return@synchronized it
+            }
+            check(create) { "Session key missing" }
+            KeyGenerator.getInstance(KeyProperties.KEY_ALGORITHM_AES, "AndroidKeyStore")
+                .apply {
+                    init(
+                        KeyGenParameterSpec.Builder(
+                                KEY_ALIAS,
+                                KeyProperties.PURPOSE_ENCRYPT or KeyProperties.PURPOSE_DECRYPT,
+                            )
+                            .setBlockModes(KeyProperties.BLOCK_MODE_GCM)
+                            .setEncryptionPaddings(KeyProperties.ENCRYPTION_PADDING_NONE)
+                            .setRandomizedEncryptionRequired(true)
+                            .build()
+                    )
+                }
+                .generateKey()
+        }
+
+    private companion object {
+        const val KEY_ALIAS = "polaris.sandbox.cookies.v1"
+        val KEY_LOCK = Any()
+    }
+}
