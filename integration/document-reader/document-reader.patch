+package eu.kanade.tachiyomi.extension.util
+
+import java.security.MessageDigest
+
+/** Portable repository metadata is distinct from the local decision to execute its code. */
+internal object RestoredRepositoryTrust {
+    fun identity(indexUrl: String, certificate: String): String =
+        MessageDigest.getInstance("SHA-256")
+            .digest((indexUrl + "\u0000" + certificate.lowercase()).toByteArray(Charsets.UTF_8))
+            .joinToString("") { "%02x".format(it) }
+}
