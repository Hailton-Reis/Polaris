+        require(bytes.size <= MAX_SNAPSHOT) { "Merged work exceeds portable backup limit" }
+        val memo = MemoColumnAdapter.decode(projected.memo)
+        projected.memo =
+            MemoColumnAdapter.encode(
+                JsonObject(
+                    (memo - WorkSources.KEY) +
+                        (KEY to JsonPrimitive(Base64.getEncoder().encodeToString(bytes)))
+                )
+            )
+        check(projected.chapters.none { ChapterOrigin.isRouted(it.url) })
+        check(projected.history.none { ChapterOrigin.isRouted(it.url) })
