diff --git a/app/src/main/java/eu/kanade/translation/EnglishTranslationBootstrap.kt b/app/src/main/java/eu/kanade/translation/EnglishTranslationBootstrap.kt
new file mode 100644
index 0000000..ee6316a
--- /dev/null
+++ b/app/src/main/java/eu/kanade/translation/EnglishTranslationBootstrap.kt
@@ -0,0 +1,26 @@
+package eu.kanade.translation
+
+import java.io.Closeable
+
+interface EnglishTranslationSession : Closeable {
+    suspend fun downloadRequiredModels()
+    suspend fun translateProbe(text: String): String
+}
+
+/** Readiness is reported only after both the official SDK download and an on-device probe succeed. */
+object EnglishTranslationBootstrap {
+    suspend fun verifyExisting(createSession: () -> EnglishTranslationSession) {
+        createSession().use { session -> verify(session) }
+    }
+
+    suspend fun prepare(createSession: () -> EnglishTranslationSession) {
+        createSession().use { session ->
+            session.downloadRequiredModels()
+            verify(session)
+        }
+    }
+
+    private suspend fun verify(session: EnglishTranslationSession) {
+        check(session.translateProbe("Hello").isNotBlank()) { "English-Portuguese model check failed" }
+    }
+}
diff --git a/app/src/main/java/eu/kanade/translation/EnglishTranslationSetupJob.kt b/app/src/main/java/eu/kanade/translation/EnglishTranslationSetupJob.kt
new file mode 100644
