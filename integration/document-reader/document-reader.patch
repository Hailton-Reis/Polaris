index 0000000..5182065
--- /dev/null
+++ b/app/src/main/java/eu/kanade/translation/recognizer/OcrStripPlan.kt
@@ -0,0 +1,84 @@
+package eu.kanade.translation.recognizer
+
+import kotlin.math.abs
+import kotlin.math.floor
+
+internal data class OcrStrip(val top: Int, val bottom: Int)
+
+internal data class StripOcrLine(
+    val block: OcrTextBlock,
+    val strip: Int,
+    val edgeDistance: Float,
+)
+
+/** Pixel-preserving sequential regions: no full-height bitmap or new model. */
+internal object OcrStripPlan {
+    const val MAX_TILE_PIXELS = 2_097_152
+
+    fun create(width: Int, height: Int): List<OcrStrip> {
+        require(width > 0 && height > 0)
+        if (width > 4096 || height.toLong() < width.toLong() * 3 || height <= 2048) return emptyList()
+        val tileHeight = minOf(2048, MAX_TILE_PIXELS / width)
+        val overlap = minOf(384, tileHeight / 4)
+        val step = tileHeight - overlap
+        val count = 1L + (height.toLong() - tileHeight + step - 1).coerceAtLeast(0) / step
+        require(count <= 256) { "Página muito alta para o limite de 256 faixas de OCR" }
+        return buildList {
+            var top = 0
+            while (true) {
+                val bottom = minOf(top.toLong() + tileHeight, height.toLong()).toInt()
+                add(OcrStrip(top, bottom))
+                if (bottom == height) break
+                top = bottom - overlap
+            }
+        }
+    }
+
+    fun deduplicate(lines: List<StripOcrLine>): List<OcrTextBlock> {
+        val kept = mutableListOf<StripOcrLine>()
+        val rows = mutableMapOf<Int, MutableList<StripOcrLine>>()
+        // Prefer lines away from a region edge, then a more complete reading.
+        for (line in lines.sortedWith(
+            compareByDescending<StripOcrLine> { it.edgeDistance }
+                .thenByDescending { it.block.text.length },
+        )) {
+            if (line.block.text.isBlank()) continue
+            val firstRow = floor(line.block.y / 64f).toInt()
+            val lastRow = floor((line.block.y + line.block.height) / 64f).toInt()
+            val neighbors = (firstRow..lastRow).asSequence().flatMap { rows[it].orEmpty().asSequence() }
+            if (neighbors.none { existing -> existing.strip != line.strip && sameLine(existing.block, line.block) }) {
+                kept += line
+                for (row in firstRow..lastRow) rows.getOrPut(row) { mutableListOf() }.add(line)
+            }
+        }
+        return kept.map { it.block }.sortedWith(compareBy<OcrTextBlock> { it.y }.thenBy { it.x })
+    }
+
+    private fun sameLine(a: OcrTextBlock, b: OcrTextBlock): Boolean {
+        val intersectionWidth = (minOf(a.x + a.width, b.x + b.width) - maxOf(a.x, b.x)).coerceAtLeast(0f)
+        val intersectionHeight = (minOf(a.y + a.height, b.y + b.height) - maxOf(a.y, b.y)).coerceAtLeast(0f)
+        val intersection = intersectionWidth * intersectionHeight
+        val areaA = a.width * a.height
+        val areaB = b.width * b.height
+        if (minOf(areaA, areaB) <= 0f) return false
+        if (intersection / (areaA + areaB - intersection).coerceAtLeast(1f) >= 0.72f) return true
+        val first = normalized(a.text)
+        val second = normalized(b.text)
+        // A strip can clip the top/bottom of the same line while recognizing its
+        // full text. Use the larger line's center tolerance only for equal text,
+        // nearly contained geometry and bounded height variation.
+        val heightRatio = maxOf(a.height, b.height) / minOf(a.height, b.height)
+        if (first.isNotEmpty() && first == second && heightRatio <= 2f &&
+            intersection / minOf(areaA, areaB) >= 0.90f &&
+            abs((a.y + a.height / 2) - (b.y + b.height / 2)) <= maxOf(a.height, b.height) * 0.25f
+        ) {
+            return true
+        }
+        val containedText = first.isNotEmpty() && second.isNotEmpty() &&
+            (first.contains(second) || second.contains(first))
+        return containedText && intersection / minOf(areaA, areaB) >= 0.90f &&
+            abs((a.y + a.height / 2) - (b.y + b.height / 2)) <= minOf(a.height, b.height) * 0.25f
+    }
+
+    private fun normalized(text: String) = text.lowercase().filter(Char::isLetterOrDigit)
+}
