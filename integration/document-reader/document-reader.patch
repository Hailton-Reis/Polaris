+            Preference(context).apply {
+                key = "polaris_host_clear_session"
+                isEnabled = session.persistent + session.temporary > 0 || session.storageUnavailable
+                title = context.stringResource(ATMR.strings.sandbox_session_clear)
+                summary = context.stringResource(ATMR.strings.sandbox_session_clear_summary)
+                isIconSpaceReserved = false
+                setOnPreferenceClickListener {
+                    AlertDialog.Builder(context)
+                        .setTitle(title)
+                        .setMessage(
+                            context.stringResource(ATMR.strings.sandbox_session_clear_confirm) +
+                                "\n\n" +
+                                source.name
+                        )
+                        .setNegativeButton(android.R.string.cancel, null)
+                        .setPositiveButton(android.R.string.ok) { _, _ ->
