+
+@Composable
+fun WorkSourceDialog(
+    settings: WorkSources,
+    original: WorkSource,
+    onSelect: (WorkSource?) -> Unit,
+    onSearch: () -> Unit,
+    onDismissRequest: () -> Unit,
+) {
+    AlertDialog(
+        onDismissRequest = onDismissRequest,
+        title = { Text(stringResource(ATMR.strings.polaris_work_source_title)) },
+        text = {
+            Column(Modifier.verticalScroll(rememberScrollState())) {
+                Text(stringResource(ATMR.strings.polaris_work_source_description))
+                RadioItem(
+                    label = stringResource(ATMR.strings.polaris_work_source_automatic),
+                    selected = settings.pinned == null,
+                    onClick = { onSelect(null) },
+                )
