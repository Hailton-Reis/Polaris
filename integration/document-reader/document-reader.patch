+package eu.kanade.tachiyomi.ui.documents
+
+import mihon.core.archive.DocumentCacheBudget
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.assertThrows
+import java.io.File
+import java.io.RandomAccessFile
+import java.nio.file.Files
+
+class DocumentCacheBudgetTest {
+    private fun fixture(block: (File) -> Unit) {
+        val root = Files.createTempDirectory("polaris-budget").toFile()
+        try {
+            block(root)
+        } finally {
+            root.deleteRecursively()
+        }
+    }
+    private fun file(root: File, name: String, size: Int = 30) = File(root, name).also {
+        requireNotNull(it.parentFile).mkdirs()
+        it.writeBytes(ByteArray(size))
+    }
+
+    @Test fun `evicts least recently used cache files while retaining imported originals`() = fixture { root ->
+        val original = file(root, "local/book.pdf")
+        val old = file(root, "pdf-pages/a/old.png").also { it.setLastModified(1000) }
+        val recent = file(root, "document-translations/recent").also { it.setLastModified(2000) }
+        assertEquals(30L, DocumentCacheBudget.trim(root, 30))
+        assertFalse(old.exists())
+        assertTrue(recent.exists())
+        assertTrue(original.exists())
+    }
+
+    @Test fun `open files can exceed the target until their final lease closes`() = fixture { root ->
+        val target = File(root, "document-files/large").also { requireNotNull(it.parentFile).mkdirs() }
+        val first = DocumentCacheBudget.acquire(root, target) {
+            RandomAccessFile(target, "rw").use { it.setLength(DocumentCacheBudget.LIMIT_BYTES + 1) }
+        }
+        val second = DocumentCacheBudget.acquire(root, target) {}
+        assertEquals(0L, DocumentCacheBudget.trim(root, 0))
+        first.close()
+        assertTrue(target.exists())
+        second.close()
+        assertFalse(target.exists())
+        second.close()
+    }
+
+    @Test fun `clear touches only managed directories and skips symbolic links`() = fixture { root ->
+        val original = file(root, "files/glossary")
+        file(root, "document-files/.stale-temp")
+        Files.createSymbolicLink(File(root, "document-files/link").toPath(), original.toPath())
+        DocumentCacheBudget.trim(root, 0)
+        assertTrue(original.exists())
+        assertEquals(0L, DocumentCacheBudget.size(root))
+    }
+
+    @Test fun `an arbitrary file cannot be registered as document cache`() = fixture { root ->
+        val original = file(root, "local/book.pdf")
+        assertThrows<IllegalArgumentException> { DocumentCacheBudget.acquire(root, original) {} }
+        assertTrue(original.exists())
+    }
+}
diff --git a/app/src/test/java/eu/kanade/tachiyomi/ui/documents/DocumentOrganizationTest.kt b/app/src/test/java/eu/kanade/tachiyomi/ui/documents/DocumentOrganizationTest.kt
