+                            val identity = RepositoryIdentity.of(store)
+                            Column {
+                                PreparationCheck(
+                                    store.name,
+                                    identity in state.selectedRepositories,
+                                    enabled = !state.busy && identity.canVerify && state.consent,
+                                    onChange = { model.selectRepository(identity) },
+                                )
+                                Text(store.indexUrl, style = MaterialTheme.typography.bodySmall)
+                                Text(
+                                    stringResource(ATMR.strings.preparation_key, store.signingKey),
+                                    style = MaterialTheme.typography.bodySmall,
+                                )
+                                if (!identity.canVerify) {
+                                    Text(stringResource(ATMR.strings.preparation_unsigned))
+                                }
+                            }
+                        }
+                        item {
+                            Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                                Text(stringResource(ATMR.strings.preparation_suggestions))
+                                RepositoryCatalog.entries.forEach { entry ->
+                                    OutlinedButton(
+                                        onClick = { model.previewRepository(entry.indexUrl) },
+                                        enabled = !state.busy && state.consent,
+                                    ) {
+                                        Text(
+                                            stringResource(
+                                                ATMR.strings.preparation_check_repo,
+                                                entry.name,
+                                            ),
+                                        )
+                                    }
+                                }
+                                OutlinedTextField(
+                                    value = url,
+                                    onValueChange = { url = it },
+                                    label = { Text(stringResource(ATMR.strings.preparation_link)) },
+                                    enabled = !state.busy,
+                                    singleLine = true,
+                                    modifier = Modifier.fillMaxWidth(),
+                                )
+                                OutlinedButton(
+                                    onClick = { model.previewRepository(url) },
+                                    enabled = url.isNotBlank() && !state.busy && state.consent,
+                                ) {
+                                    Text(stringResource(ATMR.strings.preparation_check_link))
+                                }
+                            }
+                        }
+                        state.pendingStore?.let { store ->
+                            item {
+                                Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                                    Text(
+                                        stringResource(ATMR.strings.preparation_review_repo),
+                                        style = MaterialTheme.typography.titleMedium,
+                                    )
+                                    Text(store.name)
+                                    Text(store.indexUrl)
+                                    Text(
+                                        stringResource(
+                                            ATMR.strings.preparation_key,
+                                            store.signingKey,
+                                        ),
+                                    )
+                                    Text(stringResource(ATMR.strings.preparation_key_warning))
+                                    Button(
+                                        onClick = { model.confirmRepository() },
+                                        enabled = !state.busy && state.consent,
+                                    ) {
+                                        Text(stringResource(ATMR.strings.preparation_add_repo))
+                                    }
+                                    TextButton(
+                                        onClick = model::dismissStore,
+                                        enabled = !state.busy,
+                                    ) {
+                                        Text(stringResource(ATMR.strings.preparation_dismiss))
+                                    }
+                                }
+                            }
+                        }
+                        item {
+                            Button(
+                                onClick = {
+                                    model.loadCatalog()
+                                    page = 2
+                                },
+                                enabled =
+                                state.selectedRepositories.isNotEmpty() &&
+                                    !state.busy &&
+                                    state.consent,
+                            ) {
+                                Text(stringResource(ATMR.strings.preparation_load_sources))
+                            }
+                        }
+                    }
+                    else -> {
+                        item {
+                            Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                                Text(
+                                    stringResource(ATMR.strings.preparation_choose),
+                                    style = MaterialTheme.typography.titleMedium,
+                                )
+                                state.catalogFailures.forEach {
+                                    Text(
+                                        stringResource(
+                                            ATMR.strings.preparation_partial_catalog,
+                                            it,
+                                        ),
+                                        color = MaterialTheme.colorScheme.error,
+                                    )
+                                }
+                                OutlinedButton(
+                                    onClick = { model.loadCatalog() },
+                                    enabled = !state.busy,
+                                ) {
+                                    Text(stringResource(ATMR.strings.preparation_refresh_catalog))
+                                }
+                                PreparationSelection.entries.forEach { choice ->
+                                    PreparationCheck(
+                                        stringResource(
+                                            when (choice) {
+                                                PreparationSelection.LIBRARY ->
+                                                    ATMR.strings.preparation_library
+                                                PreparationSelection.LANGUAGES ->
+                                                    ATMR.strings.preparation_languages
+                                                PreparationSelection.MANUAL ->
+                                                    ATMR.strings.preparation_manual
+                                            },
+                                        ),
+                                        choice == state.selection,
+                                        enabled = !state.busy,
+                                        onChange = { model.selection(choice) },
+                                    )
+                                }
+                                PreparationCheck(
+                                    stringResource(ATMR.strings.preparation_nsfw),
+                                    state.includeNsfw,
+                                    enabled = !state.busy,
+                                    onChange = model::includeNsfw,
+                                )
+                                if (state.selection == PreparationSelection.LANGUAGES) {
+                                    Text(stringResource(ATMR.strings.preparation_language_help))
+                                    OutlinedButton(
+                                        onClick = model::allLanguages,
+                                        enabled = !state.busy,
+                                    ) {
+                                        Text(stringResource(ATMR.strings.preparation_all_languages))
+                                    }
+                                }
+                                if (
+                                    state.selection == PreparationSelection.LIBRARY &&
+                                    plan.missingSourceIds.isNotEmpty()
+                                ) {
+                                    Text(
+                                        stringResource(
+                                            ATMR.strings.preparation_missing,
+                                            plan.missingSourceIds.size,
+                                        ),
+                                    )
+                                }
+                                if (plan.unsupportedPackages.isNotEmpty()) {
+                                    Text(
+                                        stringResource(
+                                            ATMR.strings.preparation_unsupported,
+                                            plan.unsupportedPackages.size,
+                                        ),
+                                    )
+                                }
+                                if (plan.conflicts.isNotEmpty()) {
+                                    Text(
+                                        stringResource(
+                                            ATMR.strings.preparation_conflicts,
+                                            plan.conflicts.size,
+                                        ),
+                                    )
+                                }
+                                Text(
+                                    stringResource(
+                                        ATMR.strings.preparation_review_count,
+                                        plan.extensions.size,
+                                    ),
+                                )
+                                Text(stringResource(ATMR.strings.preparation_download_notice))
+                                if (state.catalogLoaded && plan.extensions.isEmpty()) {
+                                    Text(stringResource(ATMR.strings.preparation_empty))
+                                }
+                                if (state.selection == PreparationSelection.MANUAL) {
+                                    OutlinedTextField(
+                                        value = query,
+                                        onValueChange = { query = it },
+                                        label = {
+                                            Text(stringResource(ATMR.strings.preparation_search))
+                                        },
+                                        modifier = Modifier.fillMaxWidth(),
+                                    )
+                                }
+                            }
+                        }
+                        if (state.selection == PreparationSelection.LANGUAGES) {
+                            items(
+                                state.available
+                                    .flatMap { it.sources.map { source -> source.lang } + it.lang }
+                                    .distinct()
+                                    .sorted(),
+                                key = { it },
+                            ) { language ->
+                                PreparationCheck(
+                                    LocaleHelper.getSourceDisplayName(
+                                        language,
+                                        LocalContext.current,
+                                    ),
+                                    language in state.languages,
+                                    enabled = !state.busy,
+                                    onChange = { model.language(language) },
+                                )
+                            }
+                        } else if (state.selection == PreparationSelection.MANUAL) {
+                            items(
+                                state.available
+                                    .filter {
+                                        (state.includeNsfw || !it.isNsfw) &&
+                                            it.pkgName !in state.sharedPackages &&
+                                            (state.installedVersions[it.pkgName] ?: -1) <
+                                            it.versionCode &&
+                                            (
+                                                it.name.contains(query, true) ||
+                                                    it.sources.any { source ->
+                                                        source.name.contains(query, true)
+                                                    }
+                                                )
+                                    }
+                                    .distinctBy { it.pkgName }
+                                    .sortedBy { it.name },
+                                key = { it.pkgName },
+                            ) { extension ->
+                                PreparationCheck(
+                                    "${extension.name} · ${extension.lang}",
+                                    extension.pkgName in state.manualPackages,
+                                    enabled = !state.busy,
+                                    onChange = { model.manualPackage(extension.pkgName) },
+                                )
+                            }
+                        } else {
+                            items(plan.extensions, key = { it.pkgName }) { extension ->
+                                Text(extension.name)
+                            }
+                        }
+                    }
+                }
+                item { HorizontalDivider(Modifier.padding(vertical = 8.dp)) }
+            }
+        }
+    }
+}
+
+@Composable
+private fun PreparationCheck(
+    label: String,
+    checked: Boolean,
+    enabled: Boolean,
+    onChange: (Boolean) -> Unit,
+) {
+    Row(
+        Modifier.fillMaxWidth()
+            .toggleable(
+                value = checked,
+                enabled = enabled,
+                role = Role.Checkbox,
+                onValueChange = onChange,
+            )
+            .padding(vertical = 8.dp),
+    ) {
+        Checkbox(checked = checked, onCheckedChange = null, enabled = enabled)
+        Text(label, modifier = Modifier.weight(1f).padding(start = 8.dp))
+    }
+}
