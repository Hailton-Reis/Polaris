+++ b/domain/src/test/java/tachiyomi/domain/translation/OcrExperimentPreferencesTest.kt
@@ -0,0 +1,123 @@
+package tachiyomi.domain.translation
+
+import io.mockk.every
+import io.mockk.mockk
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import tachiyomi.core.common.preference.InMemoryPreferenceStore
+import tachiyomi.core.common.preference.Preference
+import tachiyomi.core.common.preference.PreferenceStore
+
+class OcrExperimentPreferencesTest {
+    private fun preferences(): TranslationPreferences {
+        // The preview InMemoryPreferenceStore returns independent local copies;
+        // use key-stable handles to model Android persisted preference behavior.
+        val values = mutableMapOf<String, Preference<*>>()
+        val store = mockk<PreferenceStore>()
+        every { store.getBoolean(any(), any()) } answers {
+            @Suppress("UNCHECKED_CAST")
+            (
+                values.getOrPut(firstArg()) {
+                    InMemoryPreferenceStore.InMemoryPreference(firstArg(), null, secondArg<Boolean>())
+                } as Preference<Boolean>
+                )
+        }
+        every { store.getInt(any(), any()) } answers {
+            @Suppress("UNCHECKED_CAST")
+            (
+                values.getOrPut(firstArg()) {
+                    InMemoryPreferenceStore.InMemoryPreference(firstArg(), null, secondArg<Int>())
+                } as Preference<Int>
+                )
+        }
+        every { store.getString(any(), any()) } answers {
+            @Suppress("UNCHECKED_CAST")
+            (
+                values.getOrPut(firstArg()) {
+                    InMemoryPreferenceStore.InMemoryPreference(firstArg(), null, secondArg<String>())
+                } as Preference<String>
+                )
+        }
+        return TranslationPreferences(store)
+    }
+
+    @Test fun `legacy everything enabled preserves the chosen OCR and long page opt in`() {
+        val prefs = preferences()
+        prefs.ocrEngine().set(1)
+        prefs.longPageStrips().set(true)
+        prefs.dbnetExperimental().set(true)
+        prefs.reconcileOcrExperiments()
+        assertTrue(prefs.longPageStrips().get())
+        assertFalse(prefs.dbnetExperimental().get())
+        assertEquals(1, prefs.ocrEngine().get())
+    }
+
+    @Test fun `choosing DBNet and strips are mutually exclusive through their preference callbacks`() {
+        val prefs = preferences()
+        prefs.longPageStrips().set(true)
+        assertTrue(prefs.enableDbnetExperimental(true))
+        prefs.dbnetExperimental().set(true)
+        assertFalse(prefs.longPageStrips().get())
+        assertTrue(prefs.dbnetExperimental().get())
+        assertTrue(prefs.enableLongPageStrips(true))
+        prefs.longPageStrips().set(true)
+        assertFalse(prefs.dbnetExperimental().get())
+        assertTrue(prefs.longPageStrips().get())
+    }
+
+    @Test fun `turning off an experiment does not enable another one`() {
+        val prefs = preferences()
+        prefs.enableDbnetExperimental(false)
+        prefs.enableLongPageStrips(false)
+        assertFalse(prefs.longPageStrips().get())
+        assertFalse(prefs.dbnetExperimental().get())
+    }
+
+    @Test fun `DBNet alone remains a deliberate opt in`() {
+        val prefs = preferences()
+        prefs.dbnetExperimental().set(true)
+        prefs.reconcileOcrExperiments()
+        assertTrue(prefs.dbnetExperimental().get())
+        assertFalse(prefs.longPageStrips().get())
+    }
+
+    @Test fun `removing the English prerequisite turns off both dependent experiments`() {
+        val prefs = preferences()
+        prefs.longPageStrips().set(true)
+        prefs.dbnetExperimental().set(true)
+        prefs.reconcileOcrExperiments(englishPossible = false)
+        assertFalse(prefs.longPageStrips().get())
+        assertFalse(prefs.dbnetExperimental().get())
+    }
+
+    @Test fun `unsupported DBNet architecture preserves the selected OCR and strips`() {
+        val prefs = preferences()
+        prefs.ocrEngine().set(1)
+        prefs.longPageStrips().set(true)
+        prefs.dbnetExperimental().set(true)
+        prefs.reconcileOcrExperiments(dbnetDeviceSupported = false)
+        assertFalse(prefs.dbnetExperimental().get())
+        assertTrue(prefs.longPageStrips().get())
+        assertEquals(1, prefs.ocrEngine().get())
+    }
+
+    @Test fun `restoring a prerequisite does not silently reenable a child`() {
+        val prefs = preferences()
+        prefs.dbnetExperimental().set(true)
+        prefs.reconcileOcrExperiments(englishPossible = false)
+        prefs.reconcileOcrExperiments(englishPossible = true)
+        assertFalse(prefs.longPageStrips().get())
+        assertFalse(prefs.dbnetExperimental().get())
+    }
+
+    @Test fun `prerequisite reconciliation never changes translation or language choices`() {
+        val prefs = preferences()
+        prefs.translateFromLanguage().set("JAPANESE")
+        prefs.translationEngine().set(0)
+        prefs.reconcileOcrExperiments(englishPossible = false, dbnetDeviceSupported = false)
+        assertEquals("JAPANESE", prefs.translateFromLanguage().get())
+        assertEquals(0, prefs.translationEngine().get())
+    }
+}
