+        for (other in
+            listOf(
+                child.copy(favorite = false),
+                child.copy(title = "Other"),
+                child.copy(url = "/other"),
+            )) assertEquals(listOf(root), state.resolve(root, listOf(root, other)))
+        assertEquals(listOf(root), state.resolve(root, listOf(root)))
+    }
+
+    @Test
+    fun `metadata guard rejects homonyms unrelated creators and sequel qualifiers`() {
+        val a = manga(1)
+        assertFalse(LibraryWork.compatible(listOf(a, manga(2).copy(author = "Other"))))
+        assertFalse(LibraryWork.compatible(listOf(a, manga(2).copy(title = "The Star 2"))))
+        assertFalse(
+            LibraryWork.compatible(listOf(a.copy(author = null), manga(2).copy(author = null)))
+        )
+    }
+
+    @Test
+    fun `generic authors and a transitive author bridge cannot corroborate a library group`() {
+        assertFalse(
+            LibraryWork.compatible(
+                listOf(manga(1).copy(author = "Unknown"), manga(2).copy(author = "Unknown"))
+            )
+        )
+        assertFalse(
+            LibraryWork.compatible(
+                listOf(
+                    manga(1).copy(author = "Alice"),
+                    manga(2).copy(author = "Alice, Bob"),
+                    manga(3).copy(author = "Bob"),
+                )
+            )
+        )
+    }
+
+    @Test
+    fun `explicit conflicting pins prevent hiding either edition`() {
+        fun pin(m: Manga) =
+            m.copy(
+                memo =
+                    WorkSources(pinned = WorkSource(m.source, "Chosen", "en", m.url, m.title))
+                        .attach(m.memo)
+            )
+        val a = pin(manga(1))
+        val b = pin(manga(2))
+        val state = association(a, b)
+        val members = listOf(a, b).map { it.copy(memo = state.attach(it.memo)) }
+        assertEquals(listOf(members.first()), state.resolve(members.first(), members))
+    }
+
+    @Test
+    fun `malformed or oversized membership payloads are rejected`() {
+        assertNull(LibraryWork.from(buildJsonObject { put(LibraryWork.KEY, JsonPrimitive("bad")) }))
+        val a = manga(1)
+        val state = association(a, manga(2))
+        assertNull(
+            LibraryWork.from(
+                state
+                    .copy(editions = listOf(state.editions.first(), state.editions.first()))
+                    .attach(a.memo)
+            )
+        )
+        assertNull(LibraryWork.from(state.copy(primaryUrl = "/missing").attach(a.memo)))
+        assertNull(
+            LibraryWork.from(state.copy(editions = state.editions + state.editions).attach(a.memo))
+        )
+    }
+
+    @Test
+    fun `malformed separation preference is not executable data`() {
+        assertFalse(
+            LibraryWork.separated(
+                buildJsonObject { putJsonObject(LibraryWork.SEPARATE) { put("x", true) } }
+            )
+        )
+        assertTrue(LibraryWork.separated(buildJsonObject { put(LibraryWork.SEPARATE, true) }))
+    }
+
+    @Test
+    fun `group chapter query preserves original chapter IDs owner IDs and partial pages`() =
+        runTest {
+            val c = chapter(21, 2, 1).copy(lastPageRead = 17)
+            val (query, members, repo) = setup(right = listOf(c))
+            val all = query.await(1)
+            assertEquals(listOf(11L, 21L), all.map { it.id })
+            assertEquals(listOf(1L, 2L), all.map { it.mangaId })
+            assertEquals(17L, all.last().lastPageRead)
+            val owner = ChapterStorage.from(all.last())!!.owner(members.first())
+            assertEquals(2L, owner.id)
+            assertEquals(2L, owner.source)
+            assertEquals("/work/2", owner.url)
+            coVerify(exactly = 0) { repo.updateAll(any()) }
+        }
+
+    @Test
+    fun `explicit child query remains native while reader root lookup follows the association`() =
+        runTest {
+            val (query, _, _) = setup()
+            assertEquals(listOf(21L), query.await(2).map { it.id })
+            assertEquals(1L, query.rootId(2))
+        }
+
+    @Test
+    fun `unknown chapters from different owners never share a sentinel URL identity`() = runTest {
+        val left = chapter(11, 1, 1).copy(name = "Unknown", chapterNumber = -1.0, url = "/same")
+        val right = chapter(21, 2, 1).copy(name = "Unknown", chapterNumber = -1.0, url = "/same")
+        val (query, _, _) =
+            setup(left = listOf(chapter(12, 1, 2), left), right = listOf(chapter(22, 2, 2), right))
+        assertEquals(3, ChapterVersions.groups(query.await(1)).size)
+    }
+
+    @Test
+    fun `a pinned English edition ranks ahead of Portuguese while preserving active reading`() =
+        runTest {
+            val english = manga(1, 2)
+            val portuguese = manga(2, 1)
+            val pin = WorkSource(english.source, "English", "en", english.url, english.title)
+            val root = english.copy(memo = WorkSources(pinned = pin).attach(english.memo))
+            val (query, _, _) = setup(root, portuguese)
+            val versions = query.await(root.id)
+            assertEquals(11L, ChapterVersions.select(versions).single().id)
+            assertEquals(21L, ChapterVersions.select(versions, currentId = 21L).single().id)
+        }
+
+    @Test
+    fun `Portuguese edition ranks ahead of English without moving native chapters`() = runTest {
+        val a = manga(1, 2)
+        val b = manga(2, 1)
+        val (query, _, _) = setup(a, b)
+        val selected = ChapterVersions.sequence(query.await(1), a.source).single()
+        assertEquals(2L, selected.chapter.mangaId)
+        assertEquals("pt-BR", ChapterOrigin.from(selected.chapter.memo)!!.language)
+    }
+
+    @Test
+    fun `library projects union categories logical reads bookmarks and newest history`() = runTest {
+        val left = (1..40).map { chapter(it.toLong(), 1, it, read = it <= 10) }
+        val right =
+            (1..60).map {
+                chapter((100 + it).toLong(), 2, it, read = it <= 12, bookmark = it == 15)
+            }
+        val (query, members, _) = setup(left = left, right = right)
+        val raw =
+            members.mapIndexed { i, m ->
+                LibraryManga(
+                    m,
+                    listOf((i + 1).toLong()),
+                    if (i == 0) 40 else 60,
+                    if (i == 0) 10 else 12,
+                    if (i == 0) 0 else 1,
