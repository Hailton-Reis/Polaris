+fun EnglishPreparationCard() {
+    val context = LocalContext.current
+    val preference = remember { Injekt.get<TranslationPreferences>().preloadEnglishPortuguese() }
+    val automatic by remember { preference.changes() }.collectAsState(initial = preference.get())
+    val infos by remember {
+        WorkManager.getInstance(context).getWorkInfosForUniqueWorkFlow(EnglishTranslationSetupJob.NAME)
+    }.collectAsState(initial = emptyList())
+    val work = EnglishTranslationSetupJob.latest(infos)
+    val ready by EnglishTranslationSetupJob.modelsReady.collectAsState()
+    LaunchedEffect(Unit) { EnglishTranslationSetupJob.refreshLocal(context) }
+    val running = work?.state == WorkInfo.State.RUNNING
+    val status = when {
+        ready -> ATMR.strings.english_models_ready
+        running -> ATMR.strings.english_models_preparing
+        !automatic && work?.state != WorkInfo.State.ENQUEUED -> ATMR.strings.english_models_disabled
+        work?.state == WorkInfo.State.FAILED -> ATMR.strings.english_models_failed
+        else -> ATMR.strings.english_models_waiting
+    }
+    ElevatedCard(Modifier.fillMaxWidth()) {
+        Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(8.dp)) {
+            Text(stringResource(ATMR.strings.english_models_title), style = MaterialTheme.typography.titleSmall)
+            Text(stringResource(status), style = MaterialTheme.typography.bodyMedium)
+            Text(stringResource(ATMR.strings.english_models_explanation), style = MaterialTheme.typography.bodySmall)
+            if (!ready) {
+                TextButton(onClick = {
+                    EnglishTranslationSetupJob.schedule(context, manual = true)
+                }, enabled = !running) {
+                    Text(stringResource(ATMR.strings.english_models_prepare_now))
+                }
+            }
+        }
+    }
+}
