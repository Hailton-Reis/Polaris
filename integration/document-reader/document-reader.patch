diff --git a/app/src/test/java/mihon/domain/source/interactor/UpdateMangaFromRemoteTest.kt b/app/src/test/java/mihon/domain/source/interactor/UpdateMangaFromRemoteTest.kt
new file mode 100644
index 0000000..f064a3c
--- /dev/null
+++ b/app/src/test/java/mihon/domain/source/interactor/UpdateMangaFromRemoteTest.kt
@@ -0,0 +1,106 @@
+package mihon.domain.source.interactor
+
+import eu.kanade.domain.chapter.interactor.SyncChaptersWithSource
+import eu.kanade.domain.source.service.SourcePreferences
+import eu.kanade.tachiyomi.source.Source
+import eu.kanade.tachiyomi.source.model.SManga
+import eu.kanade.tachiyomi.source.model.SMangaUpdate
+import eu.kanade.tachiyomi.source.selection.AutomaticSourceCatalog
+import io.mockk.coEvery
+import io.mockk.coVerify
+import io.mockk.mockk
+import kotlinx.coroutines.test.runTest
+import kotlinx.serialization.json.JsonObject
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import tachiyomi.domain.chapter.model.Chapter
+import tachiyomi.domain.chapter.model.ChapterOrigin
+import tachiyomi.domain.chapter.repository.ChapterRepository
+import tachiyomi.domain.manga.model.Manga
+import tachiyomi.domain.manga.model.WorkSource
+import tachiyomi.domain.manga.model.WorkSources
+import tachiyomi.domain.manga.repository.MangaRepository
+import tachiyomi.domain.source.service.SourceManager
+
+class UpdateMangaFromRemoteTest {
+    private class Fixture {
+        val manager = mockk<SourceManager>()
+        val source = mockk<Source>()
+        val chapters = mockk<ChapterRepository>()
+        val repository = mockk<MangaRepository>()
+        val sync = mockk<SyncChaptersWithSource>()
+        var stored = Manga.create().copy(id = 10, source = 1, title = "The Star", url = "/work")
+        val origin = ChapterOrigin(2, "Alternative", "en", "/work", "/chapter/1")
+        val raw = listOf(
+            Chapter.create().copy(id = 1, mangaId = 10, url = "/primary/1", name = "Chapter 1"),
+            Chapter.create().copy(
+                id = 2,
+                mangaId = 10,
+                url = ChapterOrigin.storedUrl(2, "/chapter/1"),
+                name = "Chapter 1",
+                memo = origin.attach(JsonObject(emptyMap())),
+            ),
+        )
+        var duringFetch: () -> Unit = {}
+        val updater: UpdateMangaFromRemote
+        init {
+            coEvery { source.id } returns 1
+            coEvery { chapters.getChapterByMangaId(10, false) } returns raw
+            coEvery { repository.getMangaById(10) } answers { stored }
+            coEvery { repository.update(any()) } returns true
+            coEvery { repository.updateMemo(10, any()) } coAnswers {
+                val transform = secondArg<(JsonObject) -> JsonObject>()
+                stored = stored.copy(memo = transform(stored.memo))
+                true
+            }
+            coEvery { source.getMangaUpdate(any(), any(), any(), any()) } coAnswers {
+                duringFetch()
+                val remote = SManga.create().also {
+                    it.url = "/work"
+                    it.title = "The Star"
+                }
+                SMangaUpdate(remote, secondArg())
+            }
+            updater = UpdateMangaFromRemote(
+                manager,
+                chapters,
+                repository,
+                sync,
+                mockk(relaxed = true),
+                mockk(relaxed = true),
+                mockk(relaxed = true),
+                AutomaticSourceCatalog(manager, mockk<SourcePreferences>()),
+            )
+        }
+    }
+
+    @Test fun `details only refresh cannot remove or synchronize chapter editions`() = runTest {
+        val f = Fixture()
+        val result = f.updater(f.source, f.stored, fetchDetails = true, fetchChapters = false)
+        assertTrue(result.isSuccess)
+        assertTrue(result.getOrThrow().newChapters.isEmpty())
+        coVerify(exactly = 0) { f.sync.await(any(), any(), any(), any(), any()) }
+        coVerify {
+            f.source.getMangaUpdate(
+                any(),
+                match { list ->
+                    list.size == 1 && list.single().url == "/primary/1"
+                },
+                true,
+                false,
+            )
+        }
+        assertEquals(2, f.raw.size)
+    }
+
+    @Test fun `a source pin changed during network work is retained and stale synchronization aborts`() = runTest {
+        val f = Fixture()
+        val choice = WorkSource(2, "Alternative", "en", "/work", "The Star")
+        f.duringFetch = { f.stored = f.stored.copy(memo = WorkSources(pinned = choice).attach(f.stored.memo)) }
+        val result = f.updater(f.source, f.stored, fetchDetails = true, fetchChapters = false)
+        assertTrue(result.isFailure)
+        assertEquals(choice, WorkSources.from(f.stored.memo).pinned)
+        coVerify(exactly = 0) { f.sync.await(any(), any(), any(), any(), any()) }
+    }
+}
