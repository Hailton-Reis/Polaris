+    @Test fun `Portuguese glyph normalization is idempotent and preserves cedillas`() {
+        val text = "Ç ç Á Ã É Ê Í Ó Ô Õ Ú À ação"
+        assertEquals(text, normalizeTranslationText(normalizeTranslationText(text)))
