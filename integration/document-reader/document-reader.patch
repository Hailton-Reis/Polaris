+package tachiyomi.domain.chapter.model
+
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.decodeFromJsonElement
+import kotlinx.serialization.json.encodeToJsonElement
+
+/** Cached library counts; invalid snapshots fall back to database counts. Editions are never deleted. */
+@Serializable
+data class LogicalChapterCounts(val rows: Long, val total: Long, val read: Long, val bookmarked: Long) {
+    fun attach(memo: JsonObject): JsonObject = JsonObject(memo + (KEY to Json.encodeToJsonElement(this)))
+
+    companion object {
+        const val KEY = "polaris.chapter.counts.v1"
+        fun calculate(chapters: List<Chapter>): LogicalChapterCounts {
+            val groups = ChapterVersions.groups(chapters)
+            return LogicalChapterCounts(
+                chapters.size.toLong(),
+                groups.size.toLong(),
+                groups.count { it.read }.toLong(),
+                groups.count { it.bookmarked }.toLong(),
+            )
+        }
+        fun from(memo: JsonObject, rows: Long): LogicalChapterCounts? = runCatching {
+            Json.decodeFromJsonElement<LogicalChapterCounts>(memo.getValue(KEY)).takeIf {
+                it.rows == rows && it.total in 0..rows && it.read in 0..it.total && it.bookmarked in 0..it.total
+            }
+        }.getOrNull()
+    }
+}
