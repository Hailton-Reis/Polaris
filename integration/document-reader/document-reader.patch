+                MangaRestorer(
+                    f.db,
+                    categories,
+                    GetMangaByUrlAndSourceId(f.mangas),
+                    native,
+                    UpdateManga(f.mangas, interval),
+                    GetTracks(tracks),
+                    InsertTrack(tracks),
+                    interval,
+                )
+            val root = decoded.first { it.source == 1L }
+            root.chapters.forEach { it.bookmark = true }
+            restorer.restore(root, emptyList())
+            assertTrue(f.chapters.getChapterByMangaId(before[0].id).single().bookmark)
+            assertFalse(f.chapters.getChapterByMangaId(before[1].id).first().bookmark)
+            // Restore to another database with different local IDs using the production restorer.
+            Fixture().use { destination ->
+                destination.mangas.insertNetworkManga(
+                    listOf(
+                        Manga.create()
+                            .copy(
+                                source = 99,
+                                url = "/unrelated",
+                                title = "Other",
+                                favorite = false,
+                            )
+                    )
+                )
+                val dc = GetCategories(CategoryRepositoryImpl(destination.db))
+                val dn = GetChaptersByMangaId(destination.chapters, destination.query)
+                val di = FetchInterval(dn)
+                val dt = TrackRepositoryImpl(destination.db)
+                val restore =
+                    MangaRestorer(
+                        destination.db,
+                        dc,
+                        GetMangaByUrlAndSourceId(destination.mangas),
+                        dn,
+                        UpdateManga(destination.mangas, di),
+                        GetTracks(dt),
+                        InsertTrack(dt),
+                        di,
+                    )
+                decoded.forEach { restore.restore(it, emptyList()) }
+                val shown = GetLibraryManga(destination.mangas, destination.query).await().single()
+                assertEquals(2, shown.editions.size)
+                assertEquals(2L, shown.totalChapters)
+                assertNotEquals(before.first().id, shown.id)
+            }
+        }
+    }
