+package eu.kanade.tachiyomi.extension.sandbox
+
+import android.os.Binder
+import android.os.Parcel
+import android.os.ParcelFileDescriptor
+import eu.kanade.tachiyomi.network.AndroidCookieJar
+import java.io.DataInputStream
+import java.io.DataOutputStream
+import java.io.IOException
+import java.net.InetAddress
+import java.net.Proxy
+import java.util.concurrent.atomic.AtomicBoolean
+import kotlinx.serialization.json.*
+import okhttp3.*
+import okhttp3.MediaType.Companion.toMediaTypeOrNull
+import okhttp3.RequestBody.Companion.toRequestBody
+import okhttp3.ResponseBody.Companion.toResponseBody
+import okio.buffer
+
+/** A session capability. It cannot access global HTTP clients, cookies, files or preferences. */
+internal class SandboxHttpBroker(
+    private val workerUid: Int,
+    private val onViolation: (String) -> Unit,
+    cookieJar: CookieJar = AndroidCookieJar(memoryOnly = true),
+) : Binder(), AutoCloseable {
+    private val closed = AtomicBoolean(false)
+    private val slots = java.util.concurrent.Semaphore(2)
+    private val requestCount = java.util.concurrent.atomic.AtomicInteger(0)
+    private val client =
+        OkHttpClient.Builder()
+            .proxy(Proxy.NO_PROXY)
+            .dns { name ->
+                SandboxNetworkPolicy.requirePublic(InetAddress.getAllByName(name).toList())
+            }
+            .cookieJar(cookieJar)
+            .followRedirects(false)
+            .followSslRedirects(false)
+            .connectTimeout(10, java.util.concurrent.TimeUnit.SECONDS)
+            .readTimeout(10, java.util.concurrent.TimeUnit.SECONDS)
+            .callTimeout(15, java.util.concurrent.TimeUnit.SECONDS)
+            .build()
+
+    override fun onTransact(code: Int, data: Parcel, reply: Parcel?, flags: Int): Boolean {
+        if (code != 1 || reply == null) return super.onTransact(code, data, reply, flags)
+        data.enforceInterface(HTTP_DESCRIPTOR)
+        check(Binder.getCallingUid() == workerUid && !closed.get()) { "Revoked HTTP capability" }
+        check(slots.tryAcquire()) { "Too many HTTP requests" }
+        val callingIdentity = Binder.clearCallingIdentity()
+        var streaming = false
+        try {
+            require(requestCount.incrementAndGet() <= 60) { "HTTP operation budget exceeded" }
+            val request =
+                ExtensionSandboxProtocol.input(
+                    data.createByteArray() ?: error("Missing HTTP request")
+                )
+            val (headers, body) = execute(request)
+            val pipe = ParcelFileDescriptor.createReliablePipe()
+            streaming = true
+            Thread(
+                    {
+                        try {
+                            DataOutputStream(ParcelFileDescriptor.AutoCloseOutputStream(pipe[1]))
+                                .use {
+                                    val bytes = headers.toString().toByteArray()
+                                    it.writeInt(bytes.size)
+                                    it.write(bytes)
+                                    it.write(body)
+                                }
+                        } catch (_: Exception) {
+                            runCatching { pipe[1].closeWithError("HTTP stream closed") }
+                        } finally {
+                            slots.release()
+                        }
+                    },
+                    "polaris-sandbox-http",
+                )
+                .apply {
+                    isDaemon = true
+                    start()
+                }
+            reply.writeNoException()
+            reply.writeTypedObject(pipe[0], android.os.Parcelable.PARCELABLE_WRITE_RETURN_VALUE)
+            pipe[0].close()
+        } catch (error: IllegalArgumentException) {
+            close()
+            onViolation(error.message?.take(200) ?: "Network policy violation")
+            reply.writeException(SecurityException("Sandbox network request blocked"))
+        } catch (error: Exception) {
+            reply.writeException(IllegalStateException("Sandbox HTTP request failed"))
+        } finally {
+            Binder.restoreCallingIdentity(callingIdentity)
+            if (!streaming) slots.release()
+        }
+        return true
+    }
+
+    private fun execute(input: JsonObject): Pair<JsonObject, ByteArray> {
+        val url = input.getValue("url").jsonPrimitive.content
+        SandboxNetworkPolicy.requireUrl(url)
+        val method = input["method"]?.jsonPrimitive?.content ?: "GET"
+        require(method in setOf("GET", "HEAD", "POST")) { "HTTP method blocked" }
+        val headers = input["headers"]?.jsonArray.orEmpty()
+        require(headers.size <= 128) { "Too many headers" }
+        val builder = Request.Builder().url(url)
+        val denied =
+            setOf(
+                "host",
+                "connection",
+                "proxy-authorization",
+                "proxy-connection",
+                "content-length",
+                "transfer-encoding",
+            )
+        var size = 0
+        headers.forEach {
+            val pair = it.jsonArray
+            require(pair.size == 2)
+            val name = pair[0].jsonPrimitive.content
+            val value = pair[1].jsonPrimitive.content
+            size += name.length + value.length
+            require(size <= 64 * 1024 && name.lowercase() !in denied) { "HTTP headers blocked" }
+            builder.addHeader(name, value)
+        }
+        val raw =
+            input["body"]?.jsonPrimitive?.content?.let { java.util.Base64.getDecoder().decode(it) }
+                ?: byteArrayOf()
+        require(raw.size <= SandboxNetworkPolicy.MAX_REQUEST_BYTES) { "HTTP request too large" }
+        builder.method(
+            method,
+            if (method == "POST")
+                raw.toRequestBody(input["type"]?.jsonPrimitive?.content?.toMediaTypeOrNull())
+            else null,
+        )
+        var request = builder.build()
+        repeat(6) { redirect ->
+            check(!closed.get()) { "Revoked HTTP capability" }
+            SandboxNetworkPolicy.requireUrl(request.url.toString())
+            client.newCall(request).execute().use { response ->
+                if (response.code in setOf(301, 302, 303, 307, 308)) {
+                    require(redirect < 5) { "Too many redirects" }
+                    val next =
+                        response.header("Location")?.let(request.url::resolve)
+                            ?: error("Missing redirect target")
+                    SandboxNetworkPolicy.requireUrl(next.toString())
+                    val nextBuilder = request.newBuilder().url(next)
+                    if (
+                        next.host != request.url.host ||
+                            next.scheme != request.url.scheme ||
+                            next.port != request.url.port
+                    )
+                        nextBuilder.removeHeader("Authorization").removeHeader("Cookie")
+                    if (
+                        response.code == 303 ||
+                            ((response.code == 301 || response.code == 302) &&
+                                request.method == "POST")
+                    )
+                        nextBuilder.get().removeHeader("Content-Type")
+                    request = nextBuilder.build()
+                } else {
+                    val body =
+                        ExtensionSandboxProtocol.readBounded(
+                            response.body.byteStream(),
+                            SandboxNetworkPolicy.MAX_RESPONSE_BYTES,
+                        )
+                    val metadata = buildJsonObject {
+                        put("status", response.code)
+                        put("message", response.message)
+                        put("url", response.request.url.toString())
+                        putJsonArray("headers") {
+                            response.headers.forEach { (name, value) ->
+                                if (name.lowercase() !in setOf("set-cookie", "set-cookie2"))
+                                    add(
+                                        buildJsonArray {
+                                            add(name)
+                                            add(value)
+                                        }
+                                    )
+                            }
+                        }
+                    }
+                    return metadata to body
+                }
+            }
+        }
+        error("Redirect limit")
+    }
+
+    override fun close() {
+        closed.set(true)
+        client.dispatcher.cancelAll()
+        client.connectionPool.evictAll()
+    }
+
+    companion object {
+        const val HTTP_DESCRIPTOR = ExtensionSandboxProtocol.DESCRIPTOR + ".http"
+
+        fun imageClient(
+            onViolation: (String) -> Unit = {},
+            isQuarantined: () -> Boolean = { false },
+            cookieJar: CookieJar = AndroidCookieJar(memoryOnly = true),
+        ): OkHttpClient =
+            OkHttpClient.Builder()
+                .proxy(Proxy.NO_PROXY)
+                .dns { name ->
+                    SandboxNetworkPolicy.requirePublic(InetAddress.getAllByName(name).toList())
+                }
+                .cookieJar(cookieJar)
+                .followRedirects(false)
+                .followSslRedirects(false)
+                .callTimeout(20, java.util.concurrent.TimeUnit.SECONDS)
+                .addInterceptor { chain ->
+                    check(!isQuarantined()) { "Extension quarantined" }
+                    try {
+                        var request = chain.request()
+                        var result: Response? = null
+                        for (index in 0..5) {
+                            SandboxNetworkPolicy.requireUrl(request.url.toString())
+                            val response = chain.proceed(request)
+                            if (response.code !in setOf(301, 302, 303, 307, 308)) {
+                                result =
+                                    response
+                                        .newBuilder()
+                                        .body(boundedImageBody(response.body))
+                                        .build()
+                                break
+                            }
+                            val next = response.header("Location")?.let(request.url::resolve)
+                            response.close()
+                            require(index < 5 && next != null) { "Image redirect blocked" }
+                            SandboxNetworkPolicy.requireUrl(next.toString())
+                            val builder = request.newBuilder().url(next).get()
+                            if (
+                                next.host != request.url.host ||
+                                    next.scheme != request.url.scheme ||
+                                    next.port != request.url.port
+                            )
+                                builder.removeHeader("Authorization").removeHeader("Cookie")
+                            request = builder.build()
+                        }
+                        result ?: error("Image redirect limit")
+                    } catch (blocked: IllegalArgumentException) {
+                        onViolation("ISOLATED_NETWORK_VIOLATION")
+                        throw blocked
+                    }
+                }
+                .build()
+
+        private fun boundedImageBody(delegate: ResponseBody): ResponseBody =
+            object : ResponseBody() {
+                private val stream =
+                    object : okio.ForwardingSource(delegate.source()) {
+                            private var total = 0L
+
+                            override fun read(sink: okio.Buffer, byteCount: Long): Long {
+                                val count =
+                                    super.read(
+                                        sink,
+                                        minOf(
+                                            byteCount,
+                                            SandboxNetworkPolicy.MAX_RESPONSE_BYTES - total + 1,
+                                        ),
+                                    )
+                                if (count > 0) total += count
+                                if (total > SandboxNetworkPolicy.MAX_RESPONSE_BYTES)
+                                    throw IOException("Isolated image response exceeds budget")
+                                return count
+                            }
+                        }
+                        .buffer()
+
+                override fun contentType(): MediaType? = delegate.contentType()
+
+                override fun contentLength(): Long = delegate.contentLength()
+
+                override fun source(): okio.BufferedSource = stream
+            }
+
+        fun client(broker: android.os.IBinder): OkHttpClient =
+            OkHttpClient.Builder()
+                .addInterceptor { chain ->
+                    val request = chain.request()
+                    val body =
+                        okio
+                            .Buffer()
+                            .also { buffer -> request.body?.writeTo(buffer) }
+                            .readByteArray()
+                    require(body.size <= SandboxNetworkPolicy.MAX_REQUEST_BYTES)
+                    val json =
+                        buildJsonObject {
+                                put("url", request.url.toString())
+                                put("method", request.method)
+                                putJsonArray("headers") {
+                                    request.headers.forEach { (name, value) ->
+                                        add(
+                                            buildJsonArray {
+                                                add(name)
+                                                add(value)
+                                            }
+                                        )
+                                    }
+                                }
+                                put("body", java.util.Base64.getEncoder().encodeToString(body))
+                                request.body?.contentType()?.let { put("type", it.toString()) }
+                            }
+                            .toString()
+                            .toByteArray()
+                    val input = Parcel.obtain()
+                    val output = Parcel.obtain()
+                    try {
+                        require(json.size <= ExtensionSandboxProtocol.MAX_INPUT)
+                        input.writeInterfaceToken(HTTP_DESCRIPTOR)
+                        input.writeByteArray(json)
+                        check(broker.transact(1, input, output, 0))
+                        output.readException()
+                        @Suppress("DEPRECATION")
+                        val pipe =
+                            output.readTypedObject(ParcelFileDescriptor.CREATOR)
+                                ?: error("Missing HTTP stream")
+                        DataInputStream(ParcelFileDescriptor.AutoCloseInputStream(pipe)).use {
+                            stream ->
+                            val headerSize = stream.readInt()
+                            require(headerSize in 1..64 * 1024)
+                            val headerBytes = ByteArray(headerSize)
+                            stream.readFully(headerBytes)
+                            val headers =
+                                Json.parseToJsonElement(headerBytes.decodeToString()).jsonObject
+                            val raw =
+                                ExtensionSandboxProtocol.readBounded(
+                                    stream,
+                                    SandboxNetworkPolicy.MAX_RESPONSE_BYTES,
+                                )
+                            val responseHeaders =
+                                Headers.Builder()
+                                    .apply {
+                                        headers.getValue("headers").jsonArray.forEach {
+                                            val pair = it.jsonArray
+                                            add(
+                                                pair[0].jsonPrimitive.content,
+                                                pair[1].jsonPrimitive.content,
+                                            )
+                                        }
+                                    }
+                                    .build()
+                            Response.Builder()
+                                .request(
+                                    request
+                                        .newBuilder()
+                                        .url(headers.getValue("url").jsonPrimitive.content)
+                                        .build()
+                                )
+                                .protocol(Protocol.HTTP_1_1)
+                                .code(headers.getValue("status").jsonPrimitive.int)
+                                .message(headers.getValue("message").jsonPrimitive.content)
+                                .headers(responseHeaders)
+                                .body(
+                                    raw.toResponseBody(
+                                        responseHeaders["Content-Type"]?.toMediaTypeOrNull()
+                                    )
+                                )
+                                .build()
+                        }
+                    } finally {
+                        input.recycle()
+                        output.recycle()
+                    }
+                }
+                .build()
+    }
+}
