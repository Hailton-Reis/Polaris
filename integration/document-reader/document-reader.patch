+                                                                query,
+                                                                provider.getFilterList(),
+                                                            )
+                                                            .mangas
+                                                            .filter {
+                                                                SourceMatching.titleMatches(
+                                                                    reference.title,
+                                                                    it.title,
+                                                                    identity,
+                                                                )
+                                                            }
+                                                            .distinctBy { it.url }
