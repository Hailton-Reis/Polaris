+++ b/app/src/main/java/eu/kanade/tachiyomi/source/selection/SourceMatching.kt
@@ -0,0 +1,40 @@
+package eu.kanade.tachiyomi.source.selection
+
+import eu.kanade.tachiyomi.source.model.SManga
+import tachiyomi.domain.chapter.model.Chapter
+import tachiyomi.domain.chapter.model.ChapterVersions
+
+/** Similarity alone cannot join a remake, novel or unrelated work to a library entry. */
+internal object SourceMatching {
+    fun title(value: String): String = ChapterVersions.normalize(value)
+        .replace(Regex("\\s*[\\[(](?:unofficial|official|oficial)[\\])]\\s*$"), "")
+        .replace(Regex("[^\\p{L}\\p{N}]+"), " ").trim()
+
+    fun compatibleNumbering(
+        reference: List<Chapter>,
+        candidate: List<Chapter>,
+    ): Boolean {
+        val a = reference.map(ChapterVersions::key).filter { it.number != null && it.special == null }
+        val b = candidate.map(ChapterVersions::key).filter { it.number != null && it.special == null }
+        if (a.isEmpty() || b.isEmpty()) return false
+        // Missing season/volume/part information cannot establish equivalent numbering.
+        fun schemes(keys: List<ChapterVersions.Key>) = keys.map {
+            Triple(it.season != null, it.volume != null, it.part != null)
+        }.toSet()
+        return schemes(a) == schemes(b) && a.toSet().intersect(b.toSet()).isNotEmpty()
+    }
+
+    private fun people(vararg values: String?): Set<String> = values.filterNotNull()
+        .flatMap { it.split(Regex("[,;/&]|\\band\\b|\\be\\b")) }
+        .map(::title).filter {
+            it.length >= 2 && it !in setOf("unknown", "desconhecido", "not available", "n a", "n d", "未知", "暂无")
+        }.toSet()
+
+    fun sameWork(reference: SManga, candidate: SManga): Boolean {
+        if (title(reference.title) != title(candidate.title) || title(reference.title).isBlank()) return false
+        val creators = people(reference.author, reference.artist)
+        val otherCreators = people(candidate.author, candidate.artist)
+        // An absent creator is not confirmation. Keep the current source when identity is ambiguous.
+        return creators.isNotEmpty() && creators.intersect(otherCreators).isNotEmpty()
+    }
+}
diff --git a/app/src/main/java/eu/kanade/tachiyomi/ui/documents/DocumentImporter.kt b/app/src/main/java/eu/kanade/tachiyomi/ui/documents/DocumentImporter.kt
