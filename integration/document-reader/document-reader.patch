@@ -0,0 +1,119 @@
+package eu.kanade.tachiyomi.extension.sandbox
+
+import android.content.SharedPreferences
+import kotlinx.serialization.json.*
+
+/** Explicit scalar/set types; no JSON coercion, paths, class names or host preference handles. */
+internal object SandboxPreferenceValues {
+    const val MAX_KEYS = 256
+
+    fun sensitive(key: String): Boolean =
+        tachiyomi.core.common.preference.Preference.isPrivate(key) ||
+            key.contains(Regex("(?i)password|passwd|secret|token|api.?key"))
+
+    fun encode(values: Map<String, *>): JsonObject {
+        require(values.size <= MAX_KEYS)
+        return buildJsonObject {
+                values.forEach { (key, value) ->
+                    require(key.length in 1..200)
+                    put(
+                        key,
+                        buildJsonObject {
+                            when (value) {
+                                is String -> {
+                                    require(value.length <= 8192)
+                                    put("type", "string")
+                                    put("value", value)
+                                }
+                                is Boolean -> {
+                                    put("type", "boolean")
+                                    put("value", value)
+                                }
+                                is Int -> {
+                                    put("type", "int")
+                                    put("value", value)
+                                }
+                                is Long -> {
+                                    put("type", "long")
+                                    put("value", value)
+                                }
+                                is Float -> {
+                                    require(value.isFinite())
+                                    put("type", "float")
+                                    put("value", value)
+                                }
+                                is Set<*> -> {
+                                    require(
+                                        value.size <= 256 &&
+                                            value.all { it is String && it.length <= 8192 }
+                                    )
+                                    put("type", "set")
+                                    put(
+                                        "value",
+                                        JsonArray(
+                                            value
+                                                .map { JsonPrimitive(it as String) }
+                                                .sortedBy { it.content }
+                                        ),
+                                    )
+                                }
+                                else -> error("Unsupported preference value")
+                            }
+                        },
+                    )
+                }
+            }
+            .also { require(it.toString().toByteArray().size <= 128 * 1024) }
+    }
+
+    fun decode(values: JsonObject): Map<String, Any> {
+        require(values.size <= MAX_KEYS && values.toString().toByteArray().size <= 128 * 1024)
+        return values.mapValues { (key, item) ->
+            require(key.length in 1..200)
+            val pair = item.jsonObject
+            require(pair.keys == setOf("type", "value"))
+            val value = pair.getValue("value")
+            when (pair.getValue("type").jsonPrimitive.content) {
+                "string" ->
+                    value.jsonPrimitive
+                        .also { require(it.isString && it.content.length <= 8192) }
+                        .content
+                "boolean" -> value.jsonPrimitive.also { require(!it.isString) }.boolean
+                "int" -> value.jsonPrimitive.also { require(!it.isString) }.int
+                "long" -> value.jsonPrimitive.also { require(!it.isString) }.long
+                "float" ->
+                    value.jsonPrimitive
+                        .also { require(!it.isString) }
+                        .float
+                        .also { require(it.isFinite()) }
+                "set" ->
+                    value.jsonArray
+                        .also { require(it.size <= 256) }
+                        .map {
+                            it.jsonPrimitive
+                                .also { p -> require(p.isString && p.content.length <= 8192) }
+                                .content
+                        }
+                        .toSet()
+                else -> error("Unsupported preference type")
+            }
+        }
+    }
+
+    fun write(prefs: SharedPreferences, values: Map<String, *>) {
+        encode(values)
+        val editor = prefs.edit().clear()
+        values.forEach { (key, value) ->
+            when (value) {
+                is String -> editor.putString(key, value)
+                is Boolean -> editor.putBoolean(key, value)
+                is Int -> editor.putInt(key, value)
+                is Long -> editor.putLong(key, value)
+                is Float -> editor.putFloat(key, value)
+                is Set<*> -> editor.putStringSet(key, value.map { it as String }.toSet())
+                else -> error("Unsupported preference value")
+            }
+        }
+        check(editor.commit()) { "Could not save isolated source settings" }
+    }
+}
