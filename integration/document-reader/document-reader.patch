+++ b/core/archive/src/main/kotlin/mihon/core/archive/TextDocument.kt
@@ -0,0 +1,245 @@
+package mihon.core.archive
+
+import org.jsoup.Jsoup
+import org.jsoup.nodes.Element
+import org.jsoup.nodes.Node
+import org.jsoup.nodes.TextNode
+import org.jsoup.parser.Parser
+import java.io.ByteArrayOutputStream
+import java.io.Closeable
+import java.io.File
+import java.util.zip.ZipFile
+
+sealed interface DocumentBlock {
+    data class Text(val value: String, val heading: Boolean = false) : DocumentBlock
+    data class Image(val path: String, val description: String = "") : DocumentBlock
+}
+
+data class DocumentSection(val title: String, val key: String)
+
+class TextDocument(
+    private val file: File,
+    val format: DocumentFormat,
+    private val onClose: () -> Unit = {},
+) : Closeable {
+    private var closed = false
+    private val zip = if (format == DocumentFormat.EPUB || format == DocumentFormat.DOCX) ZipFile(file) else null
+    private var prepared: List<List<DocumentBlock>>? = null
+    var title: String = ""
+        private set
+    var author: String = ""
+        private set
+    val sections: List<DocumentSection>
+
+    init {
+        require(format.text)
+        try {
+            require(zip == null || zip.size() <= 20000) { "Too many archive entries" }
+            sections = when (format) {
+                DocumentFormat.EPUB -> epubSections()
+                DocumentFormat.DOCX -> {
+                    val relationships = xml("word/_rels/document.xml.rels", optional = true)
+                        ?.getElementsByTag("Relationship").orEmpty()
+                        .filter { !it.attr("TargetMode").equals("External", true) }
+                        .mapNotNull { node ->
+                            DocumentArchivePath.resolve("word/document.xml", node.attr("Target"))
+                                ?.let { node.attr("Id") to it }
+                        }.toMap()
+                    val body = checkNotNull(xml("word/document.xml"))
+                    val blocks = mutableListOf<DocumentBlock>()
+                    val buffer = StringBuilder()
+                    fun flush() {
+                        val value = buffer.toString().trim()
+                        if (value.isNotBlank()) blocks += DocumentBlock.Text(value)
+                        buffer.clear()
+                    }
+                    fun visit(node: Node) {
+                        if (node !is Element) return
+                        when (node.tagName().substringAfter(':')) {
+                            "t" -> buffer.append(node.wholeText())
+                            "tab" -> buffer.append('\t')
+                            "br", "cr" -> buffer.append('\n')
+                            "blip" -> {
+                                flush()
+                                relationships[node.attr("r:embed")]?.let { blocks += DocumentBlock.Image(it) }
+                            }
+                            else -> node.childNodes().forEach(::visit)
+                        }
+                        if (node.tagName().substringAfter(':') in setOf("p", "tr", "tc")) flush()
+                    }
+                    visit(body)
+                    flush()
+                    prepareSections(blocks)
+                }
+                DocumentFormat.TXT -> {
+                    require(file.length() <= DocumentLimits.MAX_TEXT_BYTES) { "Text document is too large" }
+                    val raw = file.readBytes()
+                    val value = when {
+                        raw.size >= 2 && raw[0] == 0xff.toByte() && raw[1] == 0xfe.toByte() -> raw.toString(
+                            Charsets.UTF_16LE,
+                        ).removePrefix("\uFEFF")
+                        raw.size >= 2 && raw[0] == 0xfe.toByte() && raw[1] == 0xff.toByte() -> raw.toString(
+                            Charsets.UTF_16BE,
+                        ).removePrefix("\uFEFF")
+                        else -> runCatching {
+                            Charsets.UTF_8.newDecoder().decode(java.nio.ByteBuffer.wrap(raw)).toString()
+                        }.getOrElse { raw.toString(charset("windows-1252")) }.removePrefix("\uFEFF")
+                    }
+                    require(!value.contains('\u0000')) { "File is not a supported text document" }
+                    prepareSections(
+                        value.replace("\r\n", "\n").split(Regex("\n\\s*\n"))
+                            .filter(String::isNotBlank).map { DocumentBlock.Text(it.trim()) },
+                    )
+                }
+                else -> error("Unsupported text document")
+            }
+            require(sections.isNotEmpty()) { "No readable sections in document" }
+        } catch (error: Throwable) {
+            zip?.close()
+            throw error
+        }
+    }
+
+    private fun prepareSections(blocks: List<DocumentBlock>): List<DocumentSection> {
+        val pages = mutableListOf<List<DocumentBlock>>()
+        var current = mutableListOf<DocumentBlock>()
+        var size = 0
+        boundedBlocks(blocks).forEach { block ->
+            if (size >= 12000 && current.isNotEmpty()) {
+                pages += current
+                current = mutableListOf()
+                size = 0
+            }
+            current += block
+            size += if (block is DocumentBlock.Text) block.value.length else 200
+        }
+        if (current.isNotEmpty()) pages += current
+        prepared = pages
+        return pages.mapIndexed { index, page ->
+            DocumentSection(
+                (page.filterIsInstance<DocumentBlock.Text>().firstOrNull()?.value ?: "${index + 1}")
+                    .take(80),
+                index.toString(),
+            )
+        }
+    }
+
+    private fun epubSections(): List<DocumentSection> {
+        val container = checkNotNull(xml("META-INF/container.xml"))
+        val packagePath = container.allElements.firstOrNull { it.tagName().substringAfter(':') == "rootfile" }
+            ?.attr("full-path")?.let { DocumentArchivePath.resolve("", it) } ?: error("EPUB package missing")
+        val packageDocument = checkNotNull(xml(packagePath))
+        title =
+            packageDocument.allElements.firstOrNull { it.tagName().substringAfter(':') == "title" }?.text().orEmpty()
+        author =
+            packageDocument.allElements.filter {
+                it.tagName().substringAfter(':') == "creator"
+            }.joinToString { it.text() }
+        val manifest = packageDocument.allElements.filter { it.tagName().substringAfter(':') == "item" }
+            .associateBy { it.attr("id") }
+        return packageDocument.allElements.filter { it.tagName().substringAfter(':') == "itemref" }
+            .mapNotNull { ref ->
+                val item = manifest[ref.attr("idref")] ?: return@mapNotNull null
+                if (item.attr("media-type") !in setOf("application/xhtml+xml", "text/html")) return@mapNotNull null
+                val path = DocumentArchivePath.resolve(packagePath, item.attr("href")) ?: return@mapNotNull null
+                if (zip?.getEntry(path) == null) return@mapNotNull null
+                DocumentSection(item.attr("id").ifBlank { path.substringAfterLast('/') }, path)
+            }
+    }
+
+    @Synchronized
+    fun readSection(index: Int): List<DocumentBlock> {
+        require(index in sections.indices)
+        prepared?.let { return it[index] }
+        val path = sections[index].key
+        val document = Jsoup.parse(readEntry(path, DocumentLimits.MAX_SECTION_BYTES).toString(Charsets.UTF_8))
+        document.select("script,style,iframe,object,embed,template").remove()
+        val result = mutableListOf<DocumentBlock>()
+        val buffer = StringBuilder()
+        var heading = false
+        fun flush() {
+            val value = buffer.toString().replace(Regex("[\\t \\x0B\\f\\r]+"), " ").trim()
+            if (value.isNotBlank()) result += DocumentBlock.Text(value, heading)
+            buffer.clear()
+        }
+        fun visit(node: Node) {
+            if (node is TextNode) {
+                buffer.append(node.wholeText)
+                return
+            }
+            if (node !is Element) return
+            val tag = node.tagName().substringAfter(':')
+            val paragraph =
+                tag in setOf("p", "div", "li", "blockquote", "pre", "tr", "h1", "h2", "h3", "h4", "h5", "h6")
+            if (paragraph) {
+                flush()
+                heading = tag.startsWith('h')
+            }
+            when (tag) {
+                "br" -> buffer.append('\n')
+                "td", "th" -> {
+                    buffer.append("  ")
+                    node.childNodes().forEach(::visit)
+                }
+                "img", "image" -> {
+                    flush()
+                    val reference = node.attr("src").ifBlank { node.attr("xlink:href") }
+                    DocumentArchivePath.resolve(path, reference)?.let { image ->
+                        if (zip?.getEntry(image) != null) result += DocumentBlock.Image(image, node.attr("alt"))
+                    }
+                }
+                else -> node.childNodes().forEach(::visit)
+            }
+            if (paragraph) {
+                flush()
+                heading = false
+            }
+        }
+        visit(document.body())
+        flush()
+        return boundedBlocks(result)
+    }
+
+    private fun boundedBlocks(blocks: List<DocumentBlock>): List<DocumentBlock> = blocks.flatMap { block ->
+        if (block is DocumentBlock.Text) {
+            DocumentTextChunks.split(block.value).map { DocumentBlock.Text(it, block.heading) }
+        } else {
+            listOf(block)
+        }
+    }
+
+    @Synchronized
+    fun image(path: String): ByteArray = readEntry(path, 12 * 1024 * 1024)
+
+    private fun xml(path: String, optional: Boolean = false): org.jsoup.nodes.Document? {
+        if (optional && zip?.getEntry(path) == null) return null
+        return Jsoup.parse(
+            readEntry(path, DocumentLimits.MAX_TEXT_BYTES).toString(Charsets.UTF_8),
+            "",
+            Parser.xmlParser(),
+        )
+    }
+
+    private fun readEntry(path: String, limit: Int): ByteArray {
+        val entry = zip?.getEntry(path) ?: error("Document entry missing: $path")
+        require(entry.size <= limit) { "Document section is too large" }
+        return checkNotNull(zip).getInputStream(entry).use { input ->
+            ByteArrayOutputStream().use { output ->
+                DocumentLimits.copy(input, output, limit.toLong())
+                output.toByteArray()
+            }
+        }
+    }
+
+    @Synchronized
+    override fun close() {
+        if (!closed) {
+            closed = true
+            try {
+                zip?.close()
+            } finally {
+                onClose()
+            }
+        }
+    }
+}
