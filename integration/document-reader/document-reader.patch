@@ -0,0 +1,25 @@
+package eu.kanade.presentation.more.settings.screen.about
+
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+
+class PolarisDedicationTriggerTest {
+    @Test fun `seven deliberate taps reveal the dedication`() {
+        val gesture = PolarisDedicationTrigger()
+        repeat(6) { assertFalse(gesture.tap(it * 100L)) }
+        assertTrue(gesture.tap(600))
+        assertFalse(gesture.tap(700))
+    }
+
+    @Test fun `distant taps cannot accumulate accidentally`() {
+        val gesture = PolarisDedicationTrigger()
+        repeat(20) { assertFalse(gesture.tap(it * 2000L)) }
+    }
+
+    @Test fun `clock reset starts a fresh sequence`() {
+        val gesture = PolarisDedicationTrigger()
+        repeat(6) { assertFalse(gesture.tap(1000L + it * 10L)) }
+        assertFalse(gesture.tap(1))
+    }
+}
diff --git a/app/src/test/java/eu/kanade/tachiyomi/data/backup/BackupInteropTest.kt b/app/src/test/java/eu/kanade/tachiyomi/data/backup/BackupInteropTest.kt
