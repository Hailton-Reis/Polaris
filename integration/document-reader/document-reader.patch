@@ -0,0 +1,37 @@
+package eu.kanade.domain.ui.model
+
+import org.junit.jupiter.api.Assertions.*
+import org.junit.jupiter.api.Test
+
+class LauncherIconSwitchTest {
+    @Test
+    fun `switch enables replacement before removing original`() {
+        val active = mutableSetOf(LauncherIcon.DEFAULT)
+        val calls = mutableListOf<Pair<LauncherIcon, Boolean>>()
+        val result =
+            LauncherIconSwitch.apply(LauncherIcon.ORBIT) { icon, enabled ->
+                calls += icon to enabled
+                if (enabled) active += icon else active -= icon
+                assertTrue(active.isNotEmpty())
+            }
+        assertTrue(result.isSuccess)
+        assertEquals(LauncherIcon.ORBIT to true, calls.first())
+        assertEquals(setOf(LauncherIcon.ORBIT), active)
+    }
+
+    @Test
+    fun `failed cleanup restores an accessible default launcher`() {
+        val active = mutableSetOf(LauncherIcon.AURORA)
+        var fail = true
+        val result =
+            LauncherIconSwitch.apply(LauncherIcon.ORBIT) { icon, enabled ->
+                if (fail && icon == LauncherIcon.AURORA && !enabled) {
+                    fail = false
+                    error("simulated platform failure")
+                }
+                if (enabled) active += icon else active -= icon
+            }
+        assertTrue(result.isFailure)
+        assertEquals(setOf(LauncherIcon.DEFAULT), active)
+    }
+}
