+import java.io.File
+
+/** Explicit local-input benchmark. No library access, chapter fetching, keys or external reports. */
+@RunWith(AndroidJUnit4::class)
+class ChapterBenchmarkTest {
+    @Test fun measurePreparedChapter() = runBlocking {
+        val instrumentation = InstrumentationRegistry.getInstrumentation()
+        val context = instrumentation.targetContext
+        val directory = File(context.getExternalFilesDir(null), "chapter-benchmark")
+        val request = File(directory, "request.json")
+        assumeTrue("Supply local originals and request.json to run this opt-in benchmark", request.isFile)
+        val configuration = JSONObject(request.readText())
+        val inputs = configuration.getJSONArray("pages")
+        val modes = configuration.optJSONArray("modes") ?: JSONArray(listOf("full", "strips"))
+        val selected = configuration.optString("selected_pages", "").split(',').mapNotNull(String::toIntOrNull).toSet()
+        val rows = JSONArray()
+        val resultFile = File(directory, "mlkit-results.json")
+        var errors = 0
+        for (modeIndex in 0 until modes.length()) {
+            val mode = modes.getString(modeIndex)
+            require(mode in listOf("full", "strips"))
+            val strips = mode == "strips"
+            val engine = MlKitOcrEngine(context, TextRecognizerLanguage.ENGLISH) { strips }
+            try {
+                for (index in 0 until inputs.length()) {
+                    val input = inputs.getJSONObject(index)
+                    val page = input.getInt("page")
+                    if (selected.isNotEmpty() && page !in selected) continue
+                    val filename = input.getString("file")
+                    require(File(filename).name == filename)
+                    val file = File(directory, filename)
+                    val row = JSONObject().put("page", page).put("mode", if (strips) "strips" else "full")
+                    try {
+                        val result = withTimeout(180_000) {
+                            engine.recognize(OcrImage(Uri.fromFile(file), file::inputStream))
+                        }
+                        row.put("status", "OK").put("width", result.width).put("height", result.height)
+                            .put("elapsed_ms", result.metrics?.totalTimeMs)
+                            .put("ocr_ms", result.metrics?.ocrTimeMs)
+                            .put("init_ms", result.metrics?.initializationTimeMs)
+                        val blocks = JSONArray()
+                        for (block in result.blocks) {
+                            blocks.put(
+                                JSONObject().put("text", block.text).put("x", block.x).put("y", block.y)
+                                    .put("width", block.width).put("height", block.height)
+                                    .put("symbol_width", block.symbolWidth).put("symbol_height", block.symbolHeight),
+                            )
+                        }
+                        row.put("lines", blocks)
+                    } catch (error: Exception) {
+                        errors++
+                        row.put("status", "ERROR").put("error", "${error.javaClass.simpleName}: ${error.message}")
+                    }
+                    rows.put(row)
+                    resultFile.writeText(
+                        JSONObject().put("runtime", "Production MlKitOcrEngine on Android")
+                            .put("rows", rows).toString(2),
+                    )
+                }
+            } finally {
+                engine.release()
+            }
+        }
+        File(directory, "ocr-done.txt").writeText("done")
+        if (configuration.optBoolean("translate", false)) {
+            val preparation = JSONObject()
+            val preparationStart = System.nanoTime()
+            val sdk = Translation.getClient(
+                TranslatorOptions.Builder().setSourceLanguage(TranslateLanguage.ENGLISH)
+                    .setTargetLanguage(TranslateLanguage.PORTUGUESE).build(),
+            )
+            try {
+                withTimeout(configuration.optLong("model_timeout_ms", 180_000)) {
+                    sdk.downloadModelIfNeeded(DownloadConditions.Builder().build()).await()
+                }
+                preparation.put("status", "READY")
+            } catch (error: Exception) {
+                preparation.put("status", "ERROR")
+                    .put("error", "${error.javaClass.simpleName}: ${error.message}")
+            } finally {
+                sdk.close()
+                preparation.put("elapsed_ms", (System.nanoTime() - preparationStart) / 1_000_000)
+                File(directory, "translation-preparation.json").writeText(preparation.toString(2))
+            }
+            if (preparation.getString("status") != "READY") {
+                File(directory, "done.txt").writeText("done; translation model unavailable")
+                assertTrue("All requested OCR cases must finish without SDK errors", errors == 0)
+                return@runBlocking
+            }
+            val preferences = context.getSharedPreferences("chapter_benchmark_only", Context.MODE_PRIVATE)
+            preferences.edit().clear().commit()
+            Injekt.importModule(object : InjektModule {
+                override fun InjektRegistrar.registerInjectables() {
+                    addSingleton<PreferenceStore>(AndroidPreferenceStore(context, preferences))
+                }
+            })
+            val translator = MLKitTranslator(TextRecognizerLanguage.ENGLISH, TextTranslatorLanguage.PORTUGUESE)
+            val translations = JSONArray()
+            try {
+                val prepared = File(directory, "translation-input.json")
+                if (prepared.isFile) {
+                    val items = JSONArray(prepared.readText())
+                    for (index in 0 until items.length()) {
+                        val item = items.getJSONObject(index)
+                        val block = TranslationBlock(
+                            text = item.getString("text"),
+                            width = 200f,
+                            height = 200f,
+                            x = 0f,
+                            y = 0f,
+                            symWidth = 10f,
+                            symHeight = 20f,
+                            angle = 0f,
+                        )
+                        val page = PageTranslation(mutableListOf(block), 200f, 200f)
+                        val start = System.nanoTime()
+                        val row = JSONObject().put("id", item.getString("id"))
+                        try {
+                            withTimeout(120_000) {
+                                translator.translate(
+                                    mutableMapOf("case" to page),
+                                    ComicTranslationContext("Polaris isolated chapter benchmark $index", "benchmark"),
+                                )
+                            }
+                            row.put("status", "OK").put("translation", block.translation)
+                        } catch (error: Exception) {
+                            row.put("status", "ERROR").put("error", "${error.javaClass.simpleName}: ${error.message}")
+                        }
+                        row.put("elapsed_ms", (System.nanoTime() - start) / 1_000_000)
+                        translations.put(row)
+                        File(directory, "translation-results.json").writeText(translations.toString(2))
+                        // An unavailable model is a preparation failure, not translation quality evidence.
+                        if (row.getString("status") == "ERROR") break
+                    }
+                }
+            } finally {
+                translator.close()
+                preferences.edit().clear().commit()
+            }
+        }
+        File(directory, "done.txt").writeText("done")
+        assertTrue("All requested OCR cases must finish without SDK errors", errors == 0)
+    }
+}
