+++ b/app/src/test/java/eu/kanade/tachiyomi/extension/preparation/PreparationPlanTest.kt
@@ -0,0 +1,193 @@
+package eu.kanade.tachiyomi.extension.preparation
+
+import eu.kanade.tachiyomi.extension.model.Extension
+import mihon.domain.extension.model.ExtensionStore
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+
+internal fun store(name: String = "one", key: String = "a".repeat(64)) =
+    ExtensionStore(
+        "https://example.org/$name/index.pb",
+        name,
+        name,
+        key,
+        ExtensionStore.Contact("https://example.org", null),
+        false,
+        null,
+    )
+
+internal fun extension(
+    pkg: String = "test.one",
+    repo: ExtensionStore = store(),
+    lang: String = "en",
+    ids: List<Long> = listOf(42L),
+    version: Long = 2,
+    nsfw: Boolean = false,
+) =
+    Extension.Available(
+        pkg,
+        pkg,
+        "1.0",
+        version,
+        1.4,
+        lang,
+        nsfw,
+        ids.map { Extension.Available.Source(it, "en", pkg, "https://example.org") },
+        "https://example.org/$pkg.apk",
+        "",
+        repo,
+    )
+
+class PreparationPlanTest {
+    private fun plan(
+        available: List<Extension.Available>,
+        repos: Set<RepositoryIdentity> = setOf(RepositoryIdentity.of(store())),
+        installed: Map<String, Long> = emptyMap(),
+        shared: Set<String> = emptySet(),
+        mode: PreparationSelection = PreparationSelection.LANGUAGES,
+        langs: Set<String> = setOf("en"),
+        sources: Set<Long> = emptySet(),
+        manual: Set<String> = emptySet(),
+        nsfw: Boolean = false,
+    ) =
+        PreparationPlanner.create(
+            available,
+            repos,
+            installed,
+            shared,
+            mode,
+            langs,
+            sources,
+            manual,
+            nsfw,
+        )
+
+    @Test
+    fun `restored source ids select exact sources without title matching or remapping`() {
+        val ids = setOf(Long.MAX_VALUE - 4, 99L)
+        val original = extension(ids = listOf(Long.MAX_VALUE - 4))
+        val result =
+            plan(
+                listOf(original, extension("other", ids = listOf(10))),
+                mode = PreparationSelection.LIBRARY,
+                sources = ids,
+            )
+        assertEquals(listOf(original), result.extensions)
+        assertEquals(setOf(99L), result.missingSourceIds)
+        assertEquals(setOf(Long.MAX_VALUE - 4, 99L), ids)
+    }
+
+    @Test
+    fun `matching a member language includes multilingual extensions`() {
+        assertEquals(1, plan(listOf(extension(lang = "all"))).extensions.size)
+        assertTrue(plan(listOf(extension(lang = "all")), langs = setOf("ja")).extensions.isEmpty())
+    }
+
+    @Test
+    fun `installed private versions are skipped and shared packages are never converted`() {
+        val available = listOf(extension("current"), extension("update"), extension("shared"))
+        val result =
+            plan(
+                available,
+                installed = mapOf("current" to 2L, "update" to 1L),
+                shared = setOf("shared"),
+            )
+        assertEquals(listOf("update"), result.extensions.map { it.pkgName })
+    }
+
+    @Test
+    fun `same package from two repositories requires repository choice`() {
+        val first = extension()
+        val other = extension(repo = store("two", "b".repeat(64)))
+        val both =
+            plan(
+                listOf(first, other),
+                repos =
+                setOf(RepositoryIdentity.of(first.store), RepositoryIdentity.of(other.store)),
+            )
+        assertEquals(setOf(first.pkgName), both.conflicts)
+        assertTrue(both.extensions.isEmpty())
+        assertEquals(listOf(first), plan(listOf(first, other)).extensions)
+    }
+
+    @Test
+    fun `conflicting download urls for the same version are not chosen arbitrarily`() {
+        val one = extension()
+        assertTrue(
+            plan(listOf(one, one.copy(apkUrl = "https://other.org/file.apk"))).extensions.isEmpty(),
+        )
+    }
+
+    @Test
+    fun `exact duplicate metadata is deduplicated and latest version from one repository wins`() {
+        val one = extension()
+        assertEquals(
+            listOf(one.copy(versionCode = 3)),
+            plan(listOf(one, one, one.copy(versionCode = 3))).extensions,
+        )
+    }
+
+    @Test
+    fun `manual selection and adult content require explicit choices`() {
+        val adult = extension(nsfw = true)
+        assertTrue(
+            plan(listOf(adult), mode = PreparationSelection.MANUAL, manual = setOf(adult.pkgName))
+                .extensions
+                .isEmpty(),
+        )
+        assertEquals(
+            listOf(adult),
+            plan(
+                listOf(adult),
+                mode = PreparationSelection.MANUAL,
+                manual = setOf(adult.pkgName),
+                nsfw = true,
+            )
+                .extensions,
+        )
+        assertTrue(
+            plan(listOf(extension()), mode = PreparationSelection.MANUAL).extensions.isEmpty(),
+        )
+    }
+
+    @Test
+    fun `restored repositories without a certificate and changed keys do not authorize preparation`() {
+        val invalid = extension(repo = store(key = "NO_SIGNING_KEY"))
+        assertTrue(
+            plan(listOf(invalid), repos = setOf(RepositoryIdentity.of(invalid.store)))
+                .extensions
+                .isEmpty(),
+        )
+        assertTrue(plan(listOf(extension(repo = store(key = "b".repeat(64))))).extensions.isEmpty())
+        assertFalse(RepositoryIdentity("http://example.org/index.pb", "a".repeat(64)).canVerify)
+    }
+
+    @Test
+    fun `a newer package cannot silently switch an installed source to another selected repository`() {
+        val original = extension()
+        val alternative = extension(repo = store("two", "b".repeat(64)), version = 3)
+        val result =
+            plan(
+                listOf(original, alternative),
+                repos =
+                setOf(
+                    RepositoryIdentity.of(original.store),
+                    RepositoryIdentity.of(alternative.store),
+                ),
+                installed = mapOf(original.pkgName to 2L),
+            )
+        assertTrue(result.extensions.isEmpty())
+        assertEquals(setOf(original.pkgName), result.conflicts)
+    }
+
+    @Test
+    fun `unsupported extension library versions are reported without attempting installation`() {
+        val incompatible = extension().copy(libVersion = 99.0)
+        val insecure = extension("insecure").copy(apkUrl = "http://example.org/file.apk")
+        val result = plan(listOf(incompatible, insecure))
+        assertTrue(result.extensions.isEmpty())
+        assertEquals(setOf(incompatible.pkgName, insecure.pkgName), result.unsupportedPackages)
+    }
+}
