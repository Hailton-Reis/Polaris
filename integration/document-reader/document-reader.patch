@@ -0,0 +1,121 @@
+package eu.kanade.tachiyomi.extension.sandbox
+
+import eu.kanade.tachiyomi.source.model.Filter
+import eu.kanade.tachiyomi.source.model.FilterList
+import kotlinx.serialization.json.*
+import org.junit.jupiter.api.Assertions.*
+import org.junit.jupiter.api.Test
+
+class SandboxFilterCodecTest {
+    private class Genres :
+        Filter.Group<Filter<*>>(
+            "Genres",
+            listOf(object : Filter.TriState("Action") {}, object : Filter.CheckBox("Color") {}),
+        )
+
+    private class Order : Filter.Select<String>("Order", arrayOf("Latest", "Oldest"))
+
+    private fun filters() =
+        FilterList(
+            Filter.Header("Options"),
+            object : Filter.Text("Author") {},
+            Order(),
+            Genres(),
+            object : Filter.Sort("Sort", arrayOf("Name", "Date")) {},
+            Filter.Separator(),
+        )
+
+    @Test
+    fun `nested selections are applied to original concrete worker classes`() {
+        val worker = filters()
+        val host = SandboxFilterCodec.host(SandboxFilterCodec.schema(worker))
+        (host[1] as Filter.Text).state = "Jane"
+        (host[2] as Filter.Select<*>).state = 1
+        val children = (host[3] as Filter.Group<*>).state
+        (children[0] as Filter.TriState).state = 2
+        (children[1] as Filter.CheckBox).state = true
+        (host[4] as Filter.Sort).state = Filter.Sort.Selection(1, false)
+        SandboxFilterCodec.apply(worker, SandboxFilterCodec.selection(host)!!)
+        assertEquals("Jane", (worker[1] as Filter.Text).state)
+        assertEquals(1, (worker[2] as Order).state)
+        assertEquals(2, ((worker[3] as Genres).state[0] as Filter.TriState).state)
+        assertTrue(((worker[3] as Genres).state[1] as Filter.CheckBox).state)
+        assertEquals(Filter.Sort.Selection(1, false), (worker[4] as Filter.Sort).state)
+        assertNotEquals(worker[2].javaClass, host[2].javaClass)
+    }
+
+    @Test
+    fun `invalid later state never partially mutates an earlier valid choice`() {
+        val worker = filters()
+        val host = SandboxFilterCodec.host(SandboxFilterCodec.schema(worker))
+        (host[1] as Filter.Text).state = "must not apply"
+        val selected = SandboxFilterCodec.selection(host)!!
+        val nodes = selected.getValue("values").jsonArray.toMutableList()
+        nodes[2] = JsonObject(nodes[2].jsonObject + ("state" to JsonPrimitive(99)))
+        val bad = JsonObject(selected + ("values" to JsonArray(nodes)))
+        assertThrows(IllegalArgumentException::class.java) { SandboxFilterCodec.apply(worker, bad) }
+        assertEquals("", (worker[1] as Filter.Text).state)
+    }
+
+    @Test
+    fun `stale schemas and swapped labels are rejected instead of silently ignoring filters`() {
+        val original = filters()
+        val host = SandboxFilterCodec.host(SandboxFilterCodec.schema(original))
+        val changed =
+            FilterList(
+                Filter.Header("Options"),
+                object : Filter.Text("Author") {},
+                object : Filter.Select<String>("Order", arrayOf("Newest", "Oldest")) {},
+                Genres(),
+                object : Filter.Sort("Sort", arrayOf("Name", "Date")) {},
+                Filter.Separator(),
+            )
+        assertThrows(IllegalArgumentException::class.java) {
+            SandboxFilterCodec.apply(changed, SandboxFilterCodec.selection(host)!!)
+        }
+    }
+
+    @Test
+    fun `oversized and deeply nested filter trees are refused`() {
+        assertThrows(IllegalArgumentException::class.java) {
+            SandboxFilterCodec.schema(FilterList((1..513).map { Filter.Header("x") }))
+        }
+        var child: Filter<*> = Filter.Header("x")
+        repeat(8) { child = object : Filter.Group<Filter<*>>("Nested", listOf(child)) {} }
+        assertThrows(IllegalArgumentException::class.java) {
+            SandboxFilterCodec.schema(FilterList(child))
+        }
+        assertThrows(IllegalArgumentException::class.java) {
+            SandboxFilterCodec.schema(FilterList(object : Filter.Text("Text", "x".repeat(4097)) {}))
+        }
+    }
+
+    @Test
+    fun `unrelated nonempty host lists cannot masquerade as source filters`() {
+        assertNull(SandboxFilterCodec.selection(FilterList()))
+        assertThrows(IllegalStateException::class.java) {
+            SandboxFilterCodec.selection(FilterList(object : Filter.Text("Fake") {}))
+        }
+    }
+
+    @Test
+    fun `quoted scalar and unknown payload fields are refused`() {
+        val worker = FilterList(object : Filter.CheckBox("Bool") {})
+        val host = SandboxFilterCodec.host(SandboxFilterCodec.schema(worker))
+        val selected = SandboxFilterCodec.selection(host)!!
+        val node = selected.getValue("values").jsonArray[0].jsonObject
+        for (bad in
+            listOf(
+                JsonObject(node + ("state" to JsonPrimitive("true"))),
+                JsonObject(node + ("class" to JsonPrimitive("some.HostClass"))),
+            )) {
+            assertThrows(IllegalArgumentException::class.java) {
+                SandboxFilterCodec.apply(
+                    worker,
+                    JsonObject(selected + ("values" to JsonArray(listOf(bad)))),
+                )
+            }
+        }
+        assertFalse((worker[0] as Filter.CheckBox).state)
+    }
+}
