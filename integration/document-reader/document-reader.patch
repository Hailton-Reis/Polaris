+
+/** Explicit source DTOs. Nothing can name a host file, database record or Kotlin class. */
+internal object SandboxSourceCodec {
+    fun manga(value: SManga): JsonObject = buildJsonObject {
+        put("url", value.url)
+        put("title", value.title)
+        value.author?.let { put("author", it) }
+        value.artist?.let { put("artist", it) }
+        value.description?.let { put("description", it) }
+        value.thumbnail_url?.let { put("thumbnail", it) }
+        value.genre?.let { put("genre", it) }
+        put("status", value.status)
+        put("initialized", value.initialized)
+        put("memo", JsonObject(value.memo.filterKeys { !it.startsWith("polaris.") }))
+    }
+
+    fun manga(value: JsonObject): SManga =
+        SManga.create().also {
+            it.url = value.getValue("url").jsonPrimitive.content
+            it.title = value["title"]?.jsonPrimitive?.content.orEmpty()
+            it.author = value["author"]?.jsonPrimitive?.content
+            it.artist = value["artist"]?.jsonPrimitive?.content
+            it.description = value["description"]?.jsonPrimitive?.content
+            it.genre = value["genre"]?.jsonPrimitive?.content
+            it.thumbnail_url = value["thumbnail"]?.jsonPrimitive?.content
+            it.status = value["status"]?.jsonPrimitive?.int ?: 0
+            it.initialized = value["initialized"]?.jsonPrimitive?.boolean ?: false
+            it.memo = value["memo"] as? JsonObject ?: JsonObject(emptyMap())
+        }
+
+    fun chapter(value: SChapter): JsonObject = buildJsonObject {
+        put("url", value.url)
+        put("name", value.name)
+        put("number", value.chapter_number.takeIf { it.isFinite() } ?: -1f)
+        value.scanlator?.let { put("scanlator", it) }
+        put("uploaded", value.date_upload)
+        put("memo", JsonObject(value.memo.filterKeys { !it.startsWith("polaris.") }))
+    }
+
+    fun chapter(value: JsonObject): SChapter =
+        SChapter.create().also {
+            it.url = value.getValue("url").jsonPrimitive.content
+            it.name = value["name"]?.jsonPrimitive?.content.orEmpty()
+            it.chapter_number = value["number"]?.jsonPrimitive?.float ?: -1f
+            it.scanlator = value["scanlator"]?.jsonPrimitive?.content
+            it.date_upload = value["uploaded"]?.jsonPrimitive?.long ?: 0L
+            it.memo = value["memo"] as? JsonObject ?: JsonObject(emptyMap())
+        }
+
+    fun page(value: Page): JsonObject = buildJsonObject {
+        put("index", value.index)
+        put("url", value.url)
+        value.imageUrl?.let { put("imageUrl", it) }
+    }
+
+    fun page(value: JsonObject): Page =
+        Page(
+            value["index"]?.jsonPrimitive?.int ?: 0,
+            value["url"]?.jsonPrimitive?.content.orEmpty(),
+            value["imageUrl"]?.jsonPrimitive?.content,
+        )
+}
