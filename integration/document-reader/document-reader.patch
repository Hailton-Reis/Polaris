@@ -0,0 +1,26 @@
+package eu.kanade.translation
+
+import eu.kanade.translation.recognizer.TextRecognizerLanguage
+import java.util.Locale
+
+/** Metadata routing only. Mixed/unknown sources still require the selected OCR input language. */
+object SourceTranslationLanguage {
+    fun resolve(code: String?): TextRecognizerLanguage? = when (
+        code?.lowercase(Locale.ROOT)?.replace('_', '-')?.substringBefore('-')
+    ) {
+        "en" -> TextRecognizerLanguage.ENGLISH
+        "ja" -> TextRecognizerLanguage.JAPANESE
+        "zh" -> TextRecognizerLanguage.CHINESE
+        "ko" -> TextRecognizerLanguage.KOREAN
+        else -> null
+    }
+
+    fun automatic(english: Boolean, asianBeta: Boolean, override: Boolean?, code: String?, target: String): Boolean {
+        if (target.isBlank()) return false
+        val language = resolve(code)
+        if (language?.name == target) return false
+        if (override != null) return override
+        if (language == null) return false
+        return if (language == TextRecognizerLanguage.ENGLISH) english else asianBeta
+    }
+}
