+import tachiyomi.i18n.at.ATMR as MR
+
+enum class LauncherIcon(
+    val component: String,
+    val title: StringResource,
+    val preview: Int,
+    val background: Long,
+) {
+    DEFAULT(
+        "PolarisDefault",
+        MR.strings.polaris_icon_default,
+        R.drawable.ic_polaris_monochrome,
+        0xFF15223D,
+    ),
+    AURORA(
+        "PolarisAurora",
+        MR.strings.polaris_icon_aurora,
+        R.drawable.ic_polaris_aurora,
+        0xFF103E39,
+    ),
+    ORBIT("PolarisOrbit", MR.strings.polaris_icon_orbit, R.drawable.ic_polaris_orbit, 0xFF302352),
+    CONSTELLATION(
+        "PolarisConstellation",
+        MR.strings.polaris_icon_constellation,
+        R.drawable.ic_polaris_constellation,
+        0xFF503714,
+    ),
+}
+
+/** Enabling a replacement precedes disabling the old entry on Android 8+. */
+internal object LauncherIconSwitch {
+    fun apply(choice: LauncherIcon, setEnabled: (LauncherIcon, Boolean) -> Unit): Result<Unit> =
+        runCatching {
+                setEnabled(choice, true)
+                LauncherIcon.entries.filter { it != choice }.forEach { setEnabled(it, false) }
+            }
+            .onFailure {
+                // MainActivity is never disabled: existing shortcuts, backup intents and app links
+                // survive.
+                runCatching { setEnabled(LauncherIcon.DEFAULT, true) }
+                LauncherIcon.entries
+                    .filter { it != LauncherIcon.DEFAULT }
+                    .forEach { entry -> runCatching { setEnabled(entry, false) } }
+            }
+}
