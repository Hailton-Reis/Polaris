+    fun resolve(blocks: List<TranslationBlock>, pageWidth: Float, pageHeight: Float): List<TranslationRegion> {
+        val regions = blocks.map { block ->
+            val layout = block.resolvedLayoutRegion(pageWidth, pageHeight)
+            // A colored caption with no measured container must stay inside the
+            // bounded eraser. This also protects previously saved geometry.
+            if (!block.balloonDetected && block.backgroundColor != null && block.dbnetCleanupMask == null) {
+                block.cleanupRegion?.clamped(pageWidth, pageHeight)?.let { intersection(layout, it) } ?: layout
+            } else {
+                layout
+            }
+        }.toMutableList()
+        val sources = blocks.map { it.sourceRegion().clamped(pageWidth, pageHeight) }
+        val order = regions.indices.sortedBy { regions[it].y }
+        val original = regions.toList()
+        for ((position, i) in order.withIndex()) {
+            for (next in position + 1 until order.size) {
+                val j = order[next]
+                if (original[j].y >= original[i].y + original[i].height) break
+                // Permission-clipped experimental masks keep their own geometry contract.
+                if (blocks[i].dbnetCleanupMask != null || blocks[j].dbnetCleanupMask != null) continue
+                val a = regions[i]
+                val b = regions[j]
+                if (a.overlapFraction(b) <= 0f) continue
+                val sa = sources[i]
+                val sb = sources[j]
+                val ax = sa.x + sa.width / 2f
+                val ay = sa.y + sa.height / 2f
+                val bx = sb.x + sb.width / 2f
+                val by = sb.y + sb.height / 2f
+                val gapY = maxOf(sb.y - sa.y - sa.height, sa.y - sb.y - sb.height)
+                val gapX = maxOf(sb.x - sa.x - sa.width, sa.x - sb.x - sb.width)
+                val vertical = when {
+                    gapY >= 0f -> true
+                    gapX >= 0f -> false
+                    else -> abs(ay - by) / minOf(sa.height, sb.height) >= abs(ax - bx) / minOf(sa.width, sb.width)
+                }
+                // Coincident detections cannot be assigned a meaningful reading
+                // order from geometry alone; leave them for OCR/grouping review.
+                if (if (vertical) abs(ay - by) < 1f else abs(ax - bx) < 1f) continue
+                val first = if (if (vertical) ay < by else ax < bx) i else j
+                val second = if (first == i) j else i
+                val fs = sources[first]
+                val ss = sources[second]
+                val f = regions[first]
+                val s = regions[second]
+                val sourceEnd = if (vertical) fs.y + fs.height else fs.x + fs.width
+                val sourceStart = if (vertical) ss.y else ss.x
+                val center = if (vertical) (ay + by) / 2f else (ax + bx) / 2f
+                val boundary = if (sourceEnd <= sourceStart) (sourceEnd + sourceStart) / 2f else center
+                val low = maxOf(if (vertical) f.y else f.x, if (vertical) s.y else s.x) + 1f
+                val high = minOf(
+                    if (vertical) f.y + f.height else f.x + f.width,
+                    if (vertical) s.y + s.height else s.x + s.width,
+                ) - 1f
+                if (low > high) continue
+                val split = boundary.coerceIn(low, high)
+                if (vertical) {
+                    regions[first] = f.copy(height = (split - f.y).coerceAtLeast(1f))
+                    val bottom = s.y + s.height
+                    regions[second] = s.copy(y = split, height = (bottom - split).coerceAtLeast(1f))
+                } else {
+                    regions[first] = f.copy(width = (split - f.x).coerceAtLeast(1f))
+                    val right = s.x + s.width
+                    regions[second] = s.copy(x = split, width = (right - split).coerceAtLeast(1f))
+                }
+            }
+        }
+        return regions
+    }
+
+    private fun intersection(a: TranslationRegion, b: TranslationRegion): TranslationRegion {
+        val left = maxOf(a.x, b.x)
+        val top = maxOf(a.y, b.y)
+        val right = minOf(a.x + a.width, b.x + b.width)
+        val bottom = minOf(a.y + a.height, b.y + b.height)
+        return if (right > left && bottom > top) TranslationRegion(left, top, right - left, bottom - top) else b
+    }
+}
