@@ -0,0 +1,202 @@
+package eu.kanade.tachiyomi.source.selection
+
+import eu.kanade.domain.source.service.SourcePreferences
+import eu.kanade.tachiyomi.source.Source
+import eu.kanade.tachiyomi.source.model.FilterList
+import eu.kanade.tachiyomi.source.model.MangasPage
+import eu.kanade.tachiyomi.source.model.SChapter
+import eu.kanade.tachiyomi.source.model.SManga
+import eu.kanade.tachiyomi.source.model.SMangaUpdate
+import eu.kanade.tachiyomi.source.online.HttpSource
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.test.runTest
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import tachiyomi.core.common.preference.InMemoryPreferenceStore
+import tachiyomi.domain.chapter.model.Chapter
+import tachiyomi.domain.chapter.model.ChapterOrigin
+import tachiyomi.domain.chapter.model.ChapterVersions
+import tachiyomi.domain.manga.model.Manga
+import tachiyomi.domain.manga.model.WorkSource
+import tachiyomi.domain.manga.model.WorkSources
+import tachiyomi.domain.source.model.StubSource
+import tachiyomi.domain.source.service.SourceManager
+
+class AutomaticSourceCatalogTest {
+    private class Provider(override val id: Long, val count: Int) : HttpSource() {
+        override val baseUrl = "https://example.invalid"
+        override val name = "Provider $id"
+        override val lang = "en"
+        override val supportsLatest = false
+        var fail = false
+        var delayMillis = 0L
+        var cancel = false
+        var searches = 0
+        var incomingUrls = emptyList<String>()
+        private fun info() = SManga.create().also {
+            it.url = "/work"
+            it.title = "The Star"
+            it.author = "Jane Doe"
+        }
+        override suspend fun getSearchManga(page: Int, query: String, filters: FilterList): MangasPage {
+            searches++
+            return MangasPage(listOf(info()), false)
+        }
+        override suspend fun getMangaUpdate(
+            manga: SManga,
+            chapters: List<SChapter>,
+            fetchDetails: Boolean,
+            fetchChapters: Boolean,
+        ): SMangaUpdate {
+            if (delayMillis > 0) delay(delayMillis)
+            if (cancel) throw CancellationException("parent cancelled")
+            if (fail) error("provider unavailable")
+            incomingUrls = chapters.map { it.url }
+            return SMangaUpdate(
+                info(),
+                if (!fetchChapters) {
+                    chapters
+                } else {
+                    (count downTo 1).map { n ->
+                        SChapter.create().also {
+                            it.url = "/chapter/$n"
+                            it.name = "Chapter $n"
+                            it.chapter_number = n.toFloat()
+                        }
+                    }
+                },
+            )
+        }
+    }
+    private class Manager(private val providers: List<Provider>) : SourceManager {
+        override val isInitialized = MutableStateFlow(true)
+        override val sources = MutableStateFlow<List<Source>>(providers)
+        override fun get(sourceKey: Long): Source? = providers.find { it.id == sourceKey }
+        override fun getOrStub(sourceKey: Long): Source = get(sourceKey) ?: error("missing")
+        override fun getAll(): List<Source> = providers
+        override fun getOnlineSources(): List<HttpSource> = providers
+        override fun getStubSources(): List<StubSource> = emptyList()
+    }
+    private fun preferences() = SourcePreferences(InMemoryPreferenceStore()).also {
+        it.enabledLanguages.set(setOf("en"))
+    }
+    private fun work() = Manga.create().copy(
+        id = 10,
+        source = 1,
+        url = "/work",
+        title = "The Star",
+        author = "Jane Doe",
+    )
+    private fun oldChapter() = Chapter.create().copy(
+        id = 5,
+        mangaId = 10,
+        url = "/chapter/1",
+        name = "Chapter 1",
+        chapterNumber = 1.0,
+        read = true,
+        lastPageRead = 4,
+    )
+
+    @Test fun `foreground discovery combines verified editions into a single logical sequence`() = runTest {
+        val primary = Provider(1, 2)
+        val alternative = Provider(2, 3)
+        val result = AutomaticSourceCatalog(Manager(listOf(primary, alternative)), preferences())
+            .fetch(primary, work(), listOf(oldChapter()), true, true, true)!!
+        assertEquals(5, result.chapters.size)
+        val chapters = result.chapters.mapIndexed { id, c ->
+            Chapter.create().copy(id = id.toLong(), url = c.url, name = c.name, memo = c.memo)
+        }
+        assertEquals(3, ChapterVersions.sequence(chapters, 1).size)
+        assertTrue(
+            result.chapters.filter {
+                ChapterOrigin.from(it.memo)?.sourceId == 2L
+            }.all { ChapterOrigin.isRouted(it.url) },
+        )
+        assertTrue(WorkSources.from(result.manga.memo).candidates.size == 2)
+    }
+
+    @Test fun `background refresh never searches all extensions`() = runTest {
+        val primary = Provider(1, 2)
+        val alternative = Provider(2, 3)
+        AutomaticSourceCatalog(Manager(listOf(primary, alternative)), preferences())
+            .fetch(primary, work(), listOf(oldChapter()), false, true, false)
+        assertEquals(0, alternative.searches)
+    }
+
+    @Test fun `failed original preserves rows and can refresh a previously confirmed alternative`() = runTest {
+        val primary = Provider(1, 2).also { it.fail = true }
+        val alternative = Provider(2, 3)
+        val binding = WorkSource(2, alternative.name, "en", "/work", "The Star", "Jane Doe")
+        val manga = work().copy(memo = WorkSources(candidates = listOf(binding)).attach(work().memo))
+        val result = AutomaticSourceCatalog(Manager(listOf(primary, alternative)), preferences())
+            .fetch(primary, manga, listOf(oldChapter()), false, true, false)!!
+        val retained = result.chapters.single { it.url == oldChapter().url }
+        assertFalse(ChapterOrigin.from(retained.memo)!!.available)
+        assertEquals(4, result.chapters.size)
+        assertEquals("The Star", result.manga.title)
+    }
+
+    @Test fun `pin restricts network refresh while keeping original stored chapters`() = runTest {
+        val primary = Provider(1, 2)
+        val alternative = Provider(2, 3)
+        val binding = WorkSource(2, alternative.name, "en", "/work", "The Star", "Jane Doe")
+        val manga = work().copy(memo = WorkSources(pinned = binding).attach(work().memo))
+        val result = AutomaticSourceCatalog(Manager(listOf(primary, alternative)), preferences())
+            .fetch(primary, manga, listOf(oldChapter()), false, true, true)!!
+        assertEquals(0, alternative.searches)
+        assertEquals(binding, WorkSources.from(result.manga.memo).pinned)
+        assertTrue(result.chapters.any { it.url == oldChapter().url })
+    }
+
+    @Test fun `parent cancellation is not converted into a successful partial refresh`() = runTest {
+        val primary = Provider(1, 2).also { it.cancel = true }
+        var cancelled = false
+        try {
+            AutomaticSourceCatalog(
+                Manager(listOf(primary)),
+                preferences(),
+            ).fetch(primary, work(), emptyList(), false, true, true)
+        } catch (
+            _: CancellationException,
+        ) {
+            cancelled = true
+        }
+        assertTrue(cancelled)
+    }
+
+    @Test
+    fun `individual timeout keeps stored editions without cancelling another provider`() = runTest {
+        val primary = Provider(1, 2).also { it.delayMillis = 40_000 }
+        val alternative = Provider(2, 3)
+        val binding = WorkSource(2, alternative.name, "en", "/work", "The Star", "Jane Doe")
+        val manga = work().copy(memo = WorkSources(candidates = listOf(binding)).attach(work().memo))
+        val result = AutomaticSourceCatalog(Manager(listOf(primary, alternative)), preferences())
+            .fetch(primary, manga, listOf(oldChapter()), false, true, false)!!
+        assertEquals(4, result.chapters.size)
+        assertFalse(ChapterOrigin.from(result.chapters.single { it.url == oldChapter().url }.memo)!!.available)
+    }
+
+    @Test
+    fun `bounded catalogs always retain the original provider`() = runTest {
+        val primary = Provider(1, 2)
+        val providers = listOf(primary) + (2L..6L).map { Provider(it, 4) }
+        val result = AutomaticSourceCatalog(Manager(providers), preferences())
+            .fetch(primary, work(), listOf(oldChapter()), true, true, true)!!
+        assertEquals(4, WorkSources.from(result.manga.memo).candidates.count { it.active })
+        assertTrue(result.chapters.any { ChapterOrigin.from(it.memo)?.sourceId == 1L })
+    }
+
+    @Test
+    fun `hidden providers are not queried during discovery`() = runTest {
+        val primary = Provider(1, 2)
+        val hidden = Provider(2, 3)
+        val prefs = preferences().also { it.disabledSources.set(setOf("2")) }
+        AutomaticSourceCatalog(Manager(listOf(primary, hidden)), prefs)
+            .fetch(primary, work(), listOf(oldChapter()), true, true, true)
+        assertEquals(0, hidden.searches)
+    }
+}
