@@ -0,0 +1,107 @@
+package eu.kanade.translation
+
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.async
+import kotlinx.coroutines.cancelAndJoin
+import kotlinx.coroutines.test.runTest
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.assertThrows
+import java.io.IOException
+
+class EnglishTranslationBootstrapTest {
+    @Test fun `existing resources can be verified offline without requesting a download`() = runTest {
+        val events = mutableListOf<String>()
+        val session = object : EnglishTranslationSession {
+            override suspend fun downloadRequiredModels() {
+                error("Must not download during local verification")
+            }
+            override suspend fun translateProbe(text: String): String {
+                events += text
+                return "Olá"
+            }
+            override fun close() {
+                events += "close"
+            }
+        }
+        EnglishTranslationBootstrap.verifyExisting { session }
+        assertEquals(listOf("Hello", "close"), events)
+    }
+
+    @Test fun `readiness waits for models and the SDK probe before closing the session`() = runTest {
+        val downloaded = CompletableDeferred<Unit>()
+        val events = mutableListOf<String>()
+        val session = object : EnglishTranslationSession {
+            override suspend fun downloadRequiredModels() {
+                events += "download"
+                downloaded.await()
+            }
+            override suspend fun translateProbe(text: String): String {
+                events += text
+                return "Olá"
+            }
+            override fun close() {
+                events += "close"
+            }
+        }
+        val work = async { EnglishTranslationBootstrap.prepare { session } }
+        testScheduler.runCurrent()
+        assertFalse(work.isCompleted)
+        assertEquals(listOf("download"), events)
+        downloaded.complete(Unit)
+        work.await()
+        assertEquals(listOf("download", "Hello", "close"), events)
+    }
+
+    @Test fun `failed downloads close resources without probing or claiming readiness`() = runTest {
+        val events = mutableListOf<String>()
+        val session = object : EnglishTranslationSession {
+            override suspend fun downloadRequiredModels() {
+                throw IOException("offline")
+            }
+            override suspend fun translateProbe(text: String): String {
+                events += "probe"
+                return "Olá"
+            }
+            override fun close() {
+                events += "close"
+            }
+        }
+        assertThrows<IOException> { EnglishTranslationBootstrap.prepare { session } }
+        assertEquals(listOf("close"), events)
+    }
+
+    @Test fun `an empty SDK probe cannot be marked ready`() = runTest {
+        var closed = false
+        val session = object : EnglishTranslationSession {
+            override suspend fun downloadRequiredModels() {}
+            override suspend fun translateProbe(text: String): String = ""
+            override fun close() {
+                closed = true
+            }
+        }
+        assertThrows<IllegalStateException> { EnglishTranslationBootstrap.prepare { session } }
+        assertEquals(true, closed)
+    }
+
+    @Test fun `cancellation releases the translator without running the probe`() = runTest {
+        val events = mutableListOf<String>()
+        val session = object : EnglishTranslationSession {
+            override suspend fun downloadRequiredModels() {
+                CompletableDeferred<Unit>().await()
+            }
+            override suspend fun translateProbe(text: String): String {
+                events += "probe"
+                return "Olá"
+            }
+            override fun close() {
+                events += "close"
+            }
+        }
+        val work = async { EnglishTranslationBootstrap.prepare { session } }
+        testScheduler.runCurrent()
+        work.cancelAndJoin()
+        assertEquals(listOf("close"), events)
+    }
+}
