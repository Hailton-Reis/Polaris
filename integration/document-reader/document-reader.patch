+
+class TranslationPageLayoutTest {
+    private fun block(x: Float, y: Float, width: Float = 100f, height: Float = 30f) = TranslationBlock(
+        text = "Source paragraph", translation = "Um parágrafo traduzido",
+        x = x, y = y, width = width, height = height, symWidth = 8f, symHeight = 18f, angle = 0f,
+        layoutRegion = TranslationRegion(x - 30, y - 30, width + 60, height + 60),
+        geometryVersion = CURRENT_TRANSLATION_GEOMETRY_VERSION,
+    )
+
+    @Test fun `saved dark caption cannot draw its translation outside the bounded eraser`() {
+        val caption = block(60f, 100f, 200f, 70f).copy(
+            backgroundColor = 0xff303044.toInt(),
+            cleanupRegion = TranslationRegion(50f, 90f, 220f, 90f),
+        )
+        val resolved = TranslationPageLayout.resolve(listOf(caption), 400f, 600f).single()
+        assertEquals(TranslationRegion(50f, 90f, 220f, 90f), resolved)
+        assertEquals(1f, resolved.overlapFraction(caption.cleanupRegion!!))
+    }
+
+    @Test fun `measured white balloon keeps its established larger writing area`() {
+        val white = block(100f, 100f).copy(
+            balloonDetected = true,
+            backgroundColor = -1,
+            cleanupRegion = TranslationRegion(95f, 95f, 110f, 40f),
+        )
+        assertEquals(white.layoutRegion, TranslationPageLayout.resolve(listOf(white), 400f, 600f).single())
+    }
+
+    @Test fun `stacked title fragments cannot share expanded vertical space`() {
+        val a = block(80f, 100f, 220f, 60f)
+        val b = block(100f, 170f, 180f, 30f)
+        val result = TranslationPageLayout.resolve(listOf(a, b), 400f, 600f)
+        assertEquals(0f, result[0].overlapFraction(result[1]))
+        assertTrue(result[0].y + result[0].height <= result[1].y)
+        assertTrue(result[0].overlapFraction(a.layoutRegion!!) > 0.99f)
+        assertTrue(result[1].overlapFraction(b.layoutRegion!!) > 0.99f)
+    }
+
+    @Test fun `adjacent columns reserve horizontal space without covering the other source`() {
+        val a = block(40f, 100f)
+        val b = block(150f, 100f)
+        val result = TranslationPageLayout.resolve(listOf(a, b), 400f, 600f)
+        assertEquals(0f, result[0].overlapFraction(result[1]))
+        assertTrue(result[0].x + result[0].width <= result[1].x)
+    }
+
+    @Test fun `mixed size OCR title boxes that overlap are partitioned by their source centers`() {
+        val a = block(60f, 200f, 270f, 120f)
+        val b = block(100f, 290f, 190f, 40f)
+        val result = TranslationPageLayout.resolve(listOf(a, b), 400f, 600f)
+        assertEquals(0f, result[0].overlapFraction(result[1]))
+        assertEquals("Source paragraph", a.text)
+        assertEquals("Um parágrafo traduzido", b.translation)
+    }
+
+    @Test fun `three fragments remain non overlapping after all pairwise allocations`() {
+        val blocks = listOf(block(70f, 100f), block(70f, 140f), block(70f, 180f))
+        val result = TranslationPageLayout.resolve(blocks, 400f, 600f)
+        for (i in result.indices) {
+            for (j in i + 1 until result.size) {
+                assertEquals(
+                    0f,
+                    result[i].overlapFraction(result[j]),
+                )
+            }
+        }
+    }
+
+    @Test fun `untranslated neighbor reserves original text instead of having another overlay placed over it`() {
+        val blocks = listOf(block(70f, 100f), block(70f, 145f).copy(translation = ""))
+        val result = TranslationPageLayout.resolve(blocks, 400f, 600f)
+        assertTrue(result[0].y + result[0].height <= blocks[1].y)
+        assertTrue(blocks[1].translation.isEmpty())
+    }
+
+    @Test fun `unrelated layouts and cleanup ownership remain unchanged`() {
+        val blocks = listOf(block(40f, 100f), block(230f, 300f))
+        val before = blocks.map { it.copy() }
+        assertEquals(blocks.map { it.layoutRegion }, TranslationPageLayout.resolve(blocks, 400f, 600f))
+        assertEquals(before, blocks)
+    }
+}
