@@ -0,0 +1,47 @@
+package eu.kanade.tachiyomi.util.system
+
+import android.content.ComponentName
+import android.content.Context
+import android.content.pm.PackageManager
+import eu.kanade.domain.ui.UiPreferences
+import eu.kanade.domain.ui.model.LauncherIcon
+import eu.kanade.domain.ui.model.LauncherIconSwitch
+
+object LauncherIconManager {
+    private val lock = Any()
+
+    fun component(context: Context, icon: LauncherIcon) =
+        ComponentName(context.packageName, "eu.kanade.tachiyomi.launcher.${icon.component}")
+
+    fun isEnabled(context: Context, icon: LauncherIcon): Boolean =
+        when (context.packageManager.getComponentEnabledSetting(component(context, icon))) {
+            PackageManager.COMPONENT_ENABLED_STATE_DEFAULT -> icon == LauncherIcon.DEFAULT
+            PackageManager.COMPONENT_ENABLED_STATE_ENABLED -> true
+            else -> false
+        }
+
+    fun change(context: Context, choice: LauncherIcon, preferences: UiPreferences): Result<Unit> =
+        synchronized(lock) {
+            val result =
+                LauncherIconSwitch.apply(choice) { entry, enabled ->
+                    if (isEnabled(context, entry) != enabled)
+                        context.packageManager.setComponentEnabledSetting(
+                            component(context, entry),
+                            if (enabled) PackageManager.COMPONENT_ENABLED_STATE_ENABLED
+                            else PackageManager.COMPONENT_ENABLED_STATE_DISABLED,
+                            PackageManager.DONT_KILL_APP,
+                        )
+                }
+            val active =
+                if (result.isSuccess) choice
+                else
+                    runCatching { LauncherIcon.entries.firstOrNull { isEnabled(context, it) } }
+                        .getOrNull() ?: LauncherIcon.DEFAULT
+            preferences.launcherIcon.set(active)
+            result
+        }
+
+    fun reconcile(context: Context, preferences: UiPreferences) {
+        change(context, preferences.launcherIcon.get(), preferences)
+    }
+}
diff --git a/app/src/main/java/eu/kanade/translation/AutomaticChapterLanguage.kt b/app/src/main/java/eu/kanade/translation/AutomaticChapterLanguage.kt
new file mode 100644
index 0000000..71d727a
--- /dev/null
+++ b/app/src/main/java/eu/kanade/translation/AutomaticChapterLanguage.kt
@@ -0,0 +1,45 @@
+package eu.kanade.translation
+
+import com.google.mlkit.nl.languageid.LanguageIdentification
+import com.google.mlkit.nl.languageid.LanguageIdentificationOptions
+import kotlinx.coroutines.tasks.await
+
+/**
+ * Examines OCR text across the chapter. Uncertain/non-English downloads keep their original images.
+ */
+internal object AutomaticChapterLanguage {
+    suspend fun isEnglish(blocks: List<String>): Boolean {
+        val sample = sample(blocks)
+        if (sample.count(Char::isLetter) < 80) return false
+        val identifier =
+            LanguageIdentification.getClient(
+                LanguageIdentificationOptions.Builder().setConfidenceThreshold(0.75f).build()
+            )
+        return try {
+            val languages = identifier.identifyPossibleLanguages(sample).await()
+            if (!accepted(languages.associate { it.languageTag to it.confidence })) return false
+            for (window in sample.chunked(800).filter { it.count(Char::isLetter) >= 80 }) {
+                val local = identifier.identifyPossibleLanguages(window).await()
+                if (local.any { it.languageTag !in setOf("en", "und") && it.confidence >= 0.85f })
+                    return false
+            }
+            true
+        } finally {
+            identifier.close()
+        }
+    }
+
+    internal fun accepted(confidences: Map<String, Float>): Boolean =
+        (confidences["en"] ?: 0f) >= 0.85f &&
+            confidences.filterKeys { it != "en" && it != "und" }.values.none { it >= 0.15f }
+
+    internal fun sample(blocks: List<String>): String {
+        val texts = blocks.filter { it.count(Char::isLetter) >= 4 }
+        if (texts.isEmpty()) return ""
+        val count = minOf(texts.size, 160)
+        // Distributed through the entire chapter, so a credits page doesn't decide the language.
+        return (0 until count)
+            .joinToString("\n") { i -> texts[(i.toLong() * texts.size / count).toInt()].take(200) }
+            .take(32_000)
+    }
+}
