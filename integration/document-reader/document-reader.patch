diff --git a/app/src/test/java/eu/kanade/domain/chapter/model/ChapterRoutingTest.kt b/app/src/test/java/eu/kanade/domain/chapter/model/ChapterRoutingTest.kt
new file mode 100644
index 0000000..f3d88b7
--- /dev/null
+++ b/app/src/test/java/eu/kanade/domain/chapter/model/ChapterRoutingTest.kt
@@ -0,0 +1,31 @@
+package eu.kanade.domain.chapter.model
+
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertNotEquals
+import org.junit.jupiter.api.Test
+import tachiyomi.domain.chapter.model.Chapter
+import tachiyomi.domain.chapter.model.ChapterOrigin
+
+class ChapterRoutingTest {
+    @Test fun `network request restores provider URL and memo without changing storage identity`() {
+        val memo = JsonObject(mapOf("provider-state" to JsonPrimitive("opaque")))
+        val origin = ChapterOrigin(-5, "Alternative", "en", "/work", "/chapter/1", sourceMemo = memo)
+        val stored = Chapter.create().copy(
+            url = ChapterOrigin.storedUrl(-5, "/chapter/1"),
+            name = "Chapter 1",
+            memo = origin.attach(memo),
+        )
+        assertEquals(stored.url, stored.toSChapter().url)
+        assertEquals("/chapter/1", stored.toRemoteSChapter().url)
+        assertEquals(memo, stored.toRemoteSChapter().memo)
+        assertNotEquals(stored.url, stored.toRemoteSChapter().url)
+    }
+
+    @Test fun `primary legacy chapter retains URL and provider metadata`() {
+        val chapter = Chapter.create().copy(url = "/chapter/1", name = "Chapter 1")
+        assertEquals(chapter.toSChapter().url, chapter.toRemoteSChapter().url)
+        assertEquals(chapter.memo, chapter.toRemoteSChapter().memo)
+    }
+}
diff --git a/app/src/test/java/eu/kanade/domain/ui/model/LauncherIconRewardsTest.kt b/app/src/test/java/eu/kanade/domain/ui/model/LauncherIconRewardsTest.kt
new file mode 100644
index 0000000..f3cddd0
--- /dev/null
+++ b/app/src/test/java/eu/kanade/domain/ui/model/LauncherIconRewardsTest.kt
@@ -0,0 +1,62 @@
+package eu.kanade.domain.ui.model
+
+import eu.kanade.tachiyomi.data.profile.ProfileProgress
+import kotlinx.serialization.json.Json
+import org.junit.jupiter.api.Assertions.*
+import org.junit.jupiter.api.Test
+
+class LauncherIconRewardsTest {
+    private fun choices(
+        xp: Long,
+        saved: Set<String> = emptySet(),
+        active: LauncherIcon = LauncherIcon.DEFAULT,
+    ) = LauncherIconRewards.unlocked(xp, saved, active)
+
+    @Test
+    fun `milestones unlock at ten fifty and one hundred read chapter points`() {
+        assertEquals(setOf(LauncherIcon.DEFAULT), choices(899))
+        assertEquals(setOf(LauncherIcon.DEFAULT, LauncherIcon.AURORA), choices(900))
+        assertFalse(LauncherIcon.ORBIT in choices(4499))
+        assertTrue(LauncherIcon.ORBIT in choices(4500))
+        assertFalse(LauncherIcon.CONSTELLATION in choices(8999))
+        assertEquals(LauncherIcon.entries.toSet(), choices(9000))
+    }
+
+    @Test
+    fun `earned choices remain available after restoring older progress and selecting costs no points`() {
+        val earned = choices(9000).mapTo(linkedSetOf()) { it.name }
+        for (icon in LauncherIcon.entries) assertEquals(
+            LauncherIcon.entries.toSet(),
+            choices(0, earned, icon),
+        )
+    }
+
+    @Test
+    fun `existing alternate icon is retained without granting all other rewards`() {
+        assertEquals(
+            setOf(LauncherIcon.DEFAULT, LauncherIcon.ORBIT),
+            choices(0, active = LauncherIcon.ORBIT),
+        )
+        assertEquals(setOf(LauncherIcon.DEFAULT), choices(-1, setOf("FUTURE_OPTION")))
+    }
+
+    @Test
+    fun `portable profile value is bounded and malformed data cannot remove original choice`() {
+        assertEquals(
+            900L,
+            LauncherIconRewards.xp(
+                Json.encodeToString(ProfileProgress.serializer(), ProfileProgress(900, 10))
+            ),
+        )
+        for (value in listOf("", "{}", "a".repeat(513), "not json")) assertEquals(
+            0L,
+            LauncherIconRewards.xp(value),
+        )
+        assertEquals(
+            0L,
+            LauncherIconRewards.xp(
+                Json.encodeToString(ProfileProgress.serializer(), ProfileProgress(-90, -1))
+            ),
+        )
+    }
+}
