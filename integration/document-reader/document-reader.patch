diff --git a/app/src/test/java/eu/kanade/translation/recognizer/OcrStripPlanTest.kt b/app/src/test/java/eu/kanade/translation/recognizer/OcrStripPlanTest.kt
new file mode 100644
index 0000000..5d21ecf
--- /dev/null
+++ b/app/src/test/java/eu/kanade/translation/recognizer/OcrStripPlanTest.kt
@@ -0,0 +1,140 @@
+package eu.kanade.translation.recognizer
+
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.float
+import kotlinx.serialization.json.int
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertThrows
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+
+class OcrStripPlanTest {
+    @Test
+    fun `regions cover entire tall pages with overlap and bounded decoded pixels`() {
+        for (width in listOf(400, 720, 1080, 2048, 4096)) {
+            for (height in listOf(12_500, 25_000, 50_000)) {
+                val strips = OcrStripPlan.create(width, height)
+                assertEquals(0, strips.first().top)
+                assertEquals(height, strips.last().bottom)
+                assertTrue(strips.all { width.toLong() * (it.bottom - it.top) <= OcrStripPlan.MAX_TILE_PIXELS })
+                strips.zipWithNext().forEach { (first, second) ->
+                    assertTrue(second.top > first.top)
+                    assertTrue(second.top < first.bottom)
+                    assertTrue(second.bottom > first.bottom)
+                }
+            }
+        }
+    }
+
+    @Test
+    fun `ordinary pages and unsupported very wide pages keep existing recognition path`() {
+        for ((width, height) in listOf(720 to 1280, 1080 to 1920, 4097 to 25_000)) {
+            assertTrue(OcrStripPlan.create(width, height).isEmpty())
+        }
+    }
+
+    @Test
+    fun `invalid or pathological dimensions fail before allocating pixels`() {
+        assertThrows(IllegalArgumentException::class.java) { OcrStripPlan.create(0, 1000) }
+        assertThrows(IllegalArgumentException::class.java) { OcrStripPlan.create(720, Int.MAX_VALUE) }
+    }
+
+    @Test
+    fun `overlap keeps complete last line instead of the edge fragment`() {
+        val fragment = line("Keep the last", y = 1800f, width = 150f, strip = 0, edge = 0f)
+        val complete = line("Keep the last line", y = 1800f, width = 200f, strip = 1, edge = 150f)
+        val result = OcrStripPlan.deduplicate(listOf(fragment, complete))
+        assertEquals(listOf("Keep the last line"), result.map { it.text })
+        assertEquals(1800f, result.single().y)
+    }
+
+    @Test
+    fun `identical words at different page positions are never globally deduplicated`() {
+        val result = OcrStripPlan.deduplicate(
+            listOf(line("Yes", 100f, strip = 0), line("Yes", 300f, strip = 1)),
+        )
+        assertEquals(listOf(100f, 300f), result.map { it.y })
+    }
+
+    @Test
+    fun `same-strip detections are preserved even when text and geometry match`() {
+        val source = line("Hello", 100f, strip = 0)
+        assertEquals(2, OcrStripPlan.deduplicate(listOf(source, source)).size)
+    }
+
+    @Test
+    fun `duplicate OCR variants prefer the region with more edge clearance`() {
+        val clipped = line("H1GH", 1700f, strip = 0, edge = 0f)
+        val centered = line("HIGH", 1700f, strip = 1, edge = 200f)
+        assertEquals(listOf("HIGH"), OcrStripPlan.deduplicate(listOf(clipped, centered)).map { it.text })
+    }
+
+    @Test
+    fun `adjacent columns and separate lines survive overlap reconciliation`() {
+        val first = line("No", 1800f, strip = 0)
+        val column = first.copy(strip = 1, block = first.block.copy(x = 400f))
+        val next = line("No", 1840f, strip = 1)
+        assertEquals(3, OcrStripPlan.deduplicate(listOf(first, column, next)).size)
+    }
+
+    @Test
+    fun `measured ML Kit overlap reproduces all benchmark lines in product reconciler`() {
+        assertMeasuredLines("mlkit")
+    }
+
+    @Test
+    fun `measured Paddle Small overlap reproduces all benchmark lines in product reconciler`() {
+        assertMeasuredLines("paddle_pipeline_small")
+    }
+
+    @Test
+    fun `measured Paddle Tiny geometry preserves overlap without enabling that model`() {
+        assertMeasuredLines("paddle_pipeline_tiny")
+    }
+
+    @Test
+    fun `benchmark dimensions use the same twelve original scale regions`() {
+        val strips = OcrStripPlan.create(720, 20_000)
+        assertEquals(12, strips.size)
+        assertEquals(2048, strips.first().bottom)
+        assertEquals(1664, strips[1].top)
+        assertEquals(20_000, strips.last().bottom)
+    }
+
+    private fun assertMeasuredLines(engine: String) {
+        val input = checkNotNull(javaClass.getResourceAsStream("/ocr-strips/$engine.json"))
+        val measured = input.bufferedReader().use { Json.parseToJsonElement(it.readText()).jsonObject }
+        val lines = measured.getValue("lines").jsonArray.map { value ->
+            val line = value.jsonObject
+            fun number(key: String) = line.getValue(key).jsonPrimitive.float
+            StripOcrLine(
+                OcrTextBlock(
+                    line.getValue("text").jsonPrimitive.content,
+                    number("x"),
+                    number("y"),
+                    number("width"),
+                    number("height"),
+                    10f,
+                    24f,
+                    0f,
+                ),
+                line.getValue("region").jsonPrimitive.int,
+                number("edge"),
+            )
+        }
+        val result = OcrStripPlan.deduplicate(lines)
+        val expected = measured.getValue("expected_lines").jsonArray.map { it.jsonPrimitive.content }
+        fun normalized(text: String) = text.lowercase().filterNot(Char::isWhitespace)
+        assertEquals(38, result.size)
+        assertEquals(expected.map(::normalized), result.map { normalized(it.text) })
+    }
+
+    private fun line(text: String, y: Float, width: Float = 100f, strip: Int, edge: Float = 40f) = StripOcrLine(
+        OcrTextBlock(text, 50f, y, width, 24f, 10f, 24f, 0f),
+        strip,
+        edge,
+    )
+}
diff --git a/app/src/test/java/eu/kanade/translation/translator/GeminiComicProtocolTest.kt b/app/src/test/java/eu/kanade/translation/translator/GeminiComicProtocolTest.kt
new file mode 100644
index 0000000..3dd195c
--- /dev/null
+++ b/app/src/test/java/eu/kanade/translation/translator/GeminiComicProtocolTest.kt
@@ -0,0 +1,85 @@
+package eu.kanade.translation.translator
+
+import eu.kanade.translation.model.PageTranslation
+import eu.kanade.translation.model.TranslationBlock
+import kotlinx.serialization.json.JsonPrimitive
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertThrows
+import org.junit.jupiter.api.Test
+
+class GeminiComicProtocolTest {
+    private fun response(text: String, reason: String = "STOP"): String =
+        """{"candidates":[{"finishReason":"$reason","content":{"parts":[""" +
+            """{"thought":true,"text":"private reasoning"},{"text":${JsonPrimitive(text)}}]}}]}"""
+
+    @Test
+    fun `accepts complete responses regardless of page key order and ignores thoughts`() {
+        val result = completeGeminiComicResponse(
+            response("""{"b":["Bom dia"],"a":["Olá","Até amanhã"]}"""),
+            linkedMapOf("a" to 2, "b" to 1),
+        )
+        assertEquals(listOf("a", "b"), result.keys.toList())
+        assertEquals(listOf("Olá", "Até amanhã"), result["a"])
+    }
+
+    @Test
+    fun `rejects missing extra null blank or unaligned phrases`() {
+        listOf(
+            """{"a":["Uma"]}""",
+            """{"a":["Uma","Duas"],"extra":[]}""",
+            """{"a":["Uma",null]}""",
+            """{"a":["Uma",""]}""",
+            """{"a":["Uma","NULL"]}""",
+            """{"a":["Uma",42]}""",
+        ).forEach { text ->
+            assertThrows(Exception::class.java) { completeGeminiComicResponse(response(text), mapOf("a" to 2)) }
+        }
+    }
+
+    @Test
+    fun `rejects truncated or blocked responses even if JSON appears complete`() {
+        listOf("MAX_TOKENS", "SAFETY", "RECITATION", "").forEach { reason ->
+            assertThrows(Exception::class.java) {
+                completeGeminiComicResponse(response("""{"a":["Olá"]}""", reason), mapOf("a" to 1))
+            }
+        }
+    }
+
+    @Test
+    fun `splits requests by phrase count while preserving original block identity`() {
+        val blocks = (0..34).map { block("line $it") }
+        val pages = linkedMapOf(
+            "a" to PageTranslation(blocks.take(20).toMutableList()),
+            "b" to PageTranslation(blocks.drop(20).toMutableList()),
+        )
+        val batches = geminiComicBatches(pages)
+        assertEquals(listOf(16, 16, 3), batches.map { it.size })
+        assertEquals(blocks, batches.flatten().map { it.block })
+        assertEquals(List(20) { "a" } + List(15) { "b" }, batches.flatten().map { it.pageKey })
+    }
+
+    @Test
+    fun `character budget separates long phrases without splitting a phrase`() {
+        val page = PageTranslation(mutableListOf(block("abc"), block("def"), block("x".repeat(12)), block("z")))
+        val batches = geminiComicBatches(mapOf("a" to page), maxCharacters = 5)
+        assertEquals(listOf(1, 1, 1, 1), batches.map { it.size })
+        assertEquals(page.blocks, batches.flatten().map { it.block })
+    }
+
+    @Test
+    fun `refuses a URL or credential as a model identifier`() {
+        assertThrows(IllegalArgumentException::class.java) { buildGeminiRestUrl("https://example.com/model") }
+        assertThrows(IllegalArgumentException::class.java) { buildGeminiRestUrl("gemini-x?key=secret") }
+    }
+
+    private fun block(text: String) = TranslationBlock(
+        text = text,
+        width = 100f,
+        height = 80f,
+        x = 0f,
+        y = 0f,
+        symHeight = 10f,
+        symWidth = 6f,
+        angle = 0f,
+    )
+}
