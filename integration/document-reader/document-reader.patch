@@ -0,0 +1,242 @@
+package eu.kanade.tachiyomi.extension.sandbox
+
+import android.content.Context
+import android.content.Intent
+import android.os.Bundle
+import android.webkit.PermissionRequest
+import android.webkit.WebChromeClient
+import android.webkit.WebResourceRequest
+import android.webkit.WebResourceResponse
+import android.webkit.WebView
+import android.webkit.WebViewClient
+import android.widget.Button
+import android.widget.LinearLayout
+import android.widget.TextView
+import android.widget.Toast
+import androidx.appcompat.app.AlertDialog
+import androidx.fragment.app.FragmentActivity
+import androidx.webkit.CookieManagerCompat
+import androidx.webkit.ProfileStore
+import androidx.webkit.WebStorageCompat
+import androidx.webkit.WebViewCompat
+import androidx.webkit.WebViewFeature
+import java.io.ByteArrayInputStream
+import java.util.UUID
+import tachiyomi.core.common.i18n.stringResource
+import tachiyomi.domain.source.service.SourceManager
+import tachiyomi.i18n.at.ATMR
+import uy.kohesive.injekt.injectLazy
+
+/**
+ * Explicit host browser, separate from extension execution and from the default WebView profile.
+ */
+internal class SandboxLoginActivity : FragmentActivity() {
+    private val sources: SourceManager by injectLazy()
+    private var web: WebView? = null
+    private var profileName: String? = null
+    private var profileAttached = false
+    private var bridge: BrowserCookieSession? = null
+    private val visited = linkedSetOf<String>()
+    private var saving = false
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        // Unsupported providers never fall back to the global browser or compatibility loader.
+        if (!supported()) {
+            message(ATMR.strings.sandbox_login_unavailable)
+            finish()
+            return
+        }
+        val source = sources.get(intent.getLongExtra(SOURCE, -1)) as? IsolatedHttpSource
+        if (source == null) {
+            finish()
+            return
+        }
+        val session =
+            runCatching { source.browserSession() }
+                .getOrElse {
+                    message(ATMR.strings.sandbox_login_unavailable)
+                    finish()
+                    return
+                }
+        bridge = session
+        AlertDialog.Builder(this)
+            .setTitle(stringResource(ATMR.strings.sandbox_login_title))
+            .setMessage(
+                stringResource(ATMR.strings.sandbox_login_confirm) + "\n\n" + session.origin.host
+            )
+            .setNegativeButton(android.R.string.cancel) { _, _ -> finish() }
+            .setOnCancelListener { finish() }
+            .setPositiveButton(android.R.string.ok) { _, _ -> open(session, source.name) }
+            .show()
+    }
+
+    @Suppress("SetJavaScriptEnabled")
+    private fun open(session: BrowserCookieSession, sourceName: String) {
+        try {
+            val store = ProfileStore.getInstance()
+            // Only profiles from interrupted logins, never ordinary browsing or another live login.
+            store.allProfileNames
+                .filter { it.startsWith(PREFIX) && it !in active }
+                .forEach { runCatching { store.deleteProfile(it) } }
+            val name = PREFIX + UUID.randomUUID().toString()
+            profileName = name
+            active += name
+            val browser = WebView(this)
+            web = browser
+            WebViewCompat.setProfile(browser, name) // Before settings, scripts or any navigation.
+            profileAttached = true
+            val manager = WebViewCompat.getProfile(browser).cookieManager
+            manager.setAcceptCookie(true)
+            manager.setAcceptThirdPartyCookies(browser, false)
+            val layout = LinearLayout(this).apply { orientation = LinearLayout.VERTICAL }
+            layout.addView(
+                TextView(this).apply {
+                    text = "$sourceName — ${session.origin.host}"
+                    setPadding(16, 16, 16, 16)
+                }
+            )
+            layout.addView(
+                Button(this).apply {
+                    text = stringResource(ATMR.strings.sandbox_login_done)
+                    setOnClickListener { save() }
+                }
+            )
+            layout.addView(browser, LinearLayout.LayoutParams(-1, 0, 1f))
+            setContentView(layout)
+            browser.settings.apply {
+                javaScriptEnabled = true
+                domStorageEnabled = true
+                allowFileAccess = false
+                allowContentAccess = false
+                @Suppress("DEPRECATION")
+                allowFileAccessFromFileURLs = false
+                @Suppress("DEPRECATION")
+                allowUniversalAccessFromFileURLs = false
+                mixedContentMode = android.webkit.WebSettings.MIXED_CONTENT_NEVER_ALLOW
+                setGeolocationEnabled(false)
+                setSupportMultipleWindows(false)
+                javaScriptCanOpenWindowsAutomatically = false
+                if (android.os.Build.VERSION.SDK_INT >= 26) safeBrowsingEnabled = true
+                saveFormData = false
+            }
+            // Service-worker traffic must not outlive an interactive login.
+            WebViewCompat.getProfile(browser)
+                .serviceWorkerController
+                .serviceWorkerWebSettings
+                .blockNetworkLoads = true
+            browser.webChromeClient =
+                object : WebChromeClient() {
+                    override fun onPermissionRequest(request: PermissionRequest) = request.deny()
+                }
+            browser.webViewClient =
+                object : WebViewClient() {
+                    override fun shouldOverrideUrlLoading(
+                        view: WebView,
+                        request: WebResourceRequest,
+                    ) = !session.accepts(request.url.toString())
+
+                    override fun shouldInterceptRequest(
+                        view: WebView,
+                        request: WebResourceRequest,
+                    ): WebResourceResponse? =
+                        if (session.accepts(request.url.toString())) null else blocked()
+
+                    override fun onPageFinished(view: WebView, url: String) {
+                        if (session.accepts(url) && visited.size < 31) visited += url
+                    }
+                }
+            val start =
+                session.origin.newBuilder().encodedPath("/").query(null).fragment(null).build()
+            visited += start.toString()
+            // Set-Cookie callbacks must finish before the first request, including HttpOnly
+            // cookies.
+            val cookies = session.seed(start)
+            fun seed(index: Int) {
+                if (isFinishing || isDestroyed) return
+                if (index == cookies.size) browser.loadUrl(start.toString())
+                else
+                    manager.setCookie(start.toString(), cookies[index].toString()) {
+                        seed(index + 1)
+                    }
+            }
+            seed(0)
+        } catch (_: Exception) {
+            message(ATMR.strings.sandbox_login_unavailable)
+            finish()
+        }
+    }
+
+    private fun save() {
+        if (saving) return
+        saving = true
+        val browser = web ?: return
+        browser.stopLoading()
+        try {
+            val manager = WebViewCompat.getProfile(browser).cookieManager
+            val snapshots = visited.associateWith { CookieManagerCompat.getCookieInfo(manager, it) }
+            requireNotNull(bridge).complete(snapshots)
+            finish()
+        } catch (_: Exception) {
+            saving = false
+            message(ATMR.strings.sandbox_login_failed)
+        }
+    }
+
+    private fun message(resource: dev.icerock.moko.resources.StringResource) {
+        Toast.makeText(this, stringResource(resource), Toast.LENGTH_LONG).show()
+    }
+
+    override fun onDestroy() {
+        web?.let { browser ->
+            // A failed setProfile must never clear the provider's default profile.
+            if (profileAttached)
+                runCatching {
+                    val profile = WebViewCompat.getProfile(browser)
+                    check(profile.name == profileName)
+                    browser.stopLoading()
+                    profile.cookieManager.removeAllCookies(null)
+                    WebStorageCompat.deleteBrowsingData(profile.webStorage) {}
+                }
+            runCatching {
+                browser.stopLoading()
+                (browser.parent as? android.view.ViewGroup)?.removeView(browser)
+                browser.destroy()
+            }
+        }
+        web = null
+        profileName?.let { name ->
+            active -= name
+            // Providers may defer actual deletion until the next process; stale cleanup retries.
+            runCatching { ProfileStore.getInstance().deleteProfile(name) }
+        }
+        super.onDestroy()
+    }
+
+    companion object {
+        private const val SOURCE = "polaris_source"
+        private const val PREFIX = "polaris_login_"
+        private val active = mutableSetOf<String>() // UI-thread only.
+
+        fun supported() =
+            runCatching {
+                    WebViewFeature.isFeatureSupported(WebViewFeature.MULTI_PROFILE) &&
+                        WebViewFeature.isFeatureSupported(WebViewFeature.GET_COOKIE_INFO) &&
+                        WebViewFeature.isFeatureSupported(WebViewFeature.DELETE_BROWSING_DATA)
+                }
+                .getOrDefault(false)
+
+        fun intent(context: Context, sourceId: Long) =
+            Intent(context, SandboxLoginActivity::class.java).putExtra(SOURCE, sourceId)
+
+        private fun blocked() =
+            WebResourceResponse(
+                "text/plain",
+                "utf-8",
+                403,
+                "Blocked",
+                emptyMap(),
+                ByteArrayInputStream(byteArrayOf()),
+            )
+    }
+}
diff --git a/app/src/main/java/eu/kanade/tachiyomi/extension/sandbox/SandboxNetworkPolicy.kt b/app/src/main/java/eu/kanade/tachiyomi/extension/sandbox/SandboxNetworkPolicy.kt
