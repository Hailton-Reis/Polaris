@@ -0,0 +1,105 @@
+package eu.kanade.translation.diagnostics
+
+import eu.kanade.tachiyomi.BuildConfig
+import eu.kanade.tachiyomi.ui.reader.model.ReaderPage
+import eu.kanade.translation.model.TranslationRecoveryPolicy
+import eu.kanade.translation.translator.TextTranslators
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonNull
+import kotlinx.serialization.json.buildJsonArray
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.encodeToJsonElement
+import kotlinx.serialization.json.put
+import tachiyomi.domain.translation.TranslationLlmProvider
+import tachiyomi.domain.translation.TranslationPreferences
+import uy.kohesive.injekt.Injekt
+import uy.kohesive.injekt.api.get
+import java.io.InputStream
+import java.security.MessageDigest
+
+/** In-memory debug bridge. Bound only while a reader is resumed; never starts a translation. */
+object ReaderCaptureSession {
+    data class Snapshot(
+        val chapterId: Long,
+        val pageIndex: Int,
+        val metadata: String,
+        val record: String,
+        val openSource: (() -> InputStream)?,
+    )
+
+    private data class Binding(val owner: Any, val snapshot: () -> Snapshot?)
+    private var binding: Binding? = null
+    private val json = Json { encodeDefaults = true }
+
+    fun bind(owner: Any, snapshot: () -> Snapshot?) {
+        if (BuildConfig.DEBUG) binding = Binding(owner, snapshot)
+    }
+
+    fun unbind(owner: Any) {
+        if (binding?.owner === owner) binding = null
+    }
+
+    fun snapshot(): Snapshot? = if (BuildConfig.DEBUG) binding?.snapshot?.invoke() else null
+
+    fun describe(page: ReaderPage, visible: Boolean, vertical: Boolean, canScrollForward: Boolean): Snapshot? {
+        val chapterId = page.chapter.chapter.id ?: return null
+        val preferences = Injekt.get<TranslationPreferences>()
+        val engine = TextTranslators.fromPref(preferences.translationEngine())
+        val model = if (engine == TextTranslators.GEMINI) {
+            preferences.llmModel(TranslationLlmProvider.GEMINI).get().trim().removePrefix("models/")
+                .takeIf { it.matches(Regex("gemini-[A-Za-z0-9._-]{1,100}")) } ?: "invalid-model"
+        } else {
+            null
+        }
+        val storedPage = page.translation?.let { json.encodeToJsonElement(it) } ?: JsonNull
+        val serialized = storedPage.toString()
+        val hash = MessageDigest.getInstance("SHA-256").digest(serialized.toByteArray())
+            .joinToString("") { "%02x".format(it) }
+        val metadata = buildJsonObject {
+            put("chapterId", chapterId)
+            put("pageIndex", page.index)
+            put("pageCount", page.chapter.pages?.size ?: 0)
+            put("vertical", vertical)
+            put("canScrollForward", canScrollForward)
+            put("translationsVisible", visible)
+            put("sourceReady", page.stream != null)
+            put("translationHash", hash)
+            put("translationBlocks", page.translation?.blocks?.count { it.translation.isNotBlank() } ?: 0)
+            put("configuredProvider", engine.name)
+            put("configuredMlKitLongPageStrips", preferences.longPageStrips().get())
+            model?.let { put("configuredModel", it) }
+            put(
+                "configuredOcrLanguage",
+                preferences.translateFromLanguage().get().takeIf {
+                    it in
+                        setOf("ENGLISH", "CHINESE", "JAPANESE", "KOREAN")
+                }
+                    ?: "unknown",
+            )
+            put("version", BuildConfig.VERSION_NAME)
+        }
+        val record = buildJsonObject {
+            put("status", metadata)
+            put("page", storedPage)
+            put(
+                "automaticPlacementEligible",
+                buildJsonArray {
+                    page.translation?.blocks?.forEach {
+                        add(
+                            kotlinx.serialization.json.JsonPrimitive(
+                                TranslationRecoveryPolicy.isTranslatable(it),
+                            ),
+                        )
+                    }
+                },
+            )
+            put(
+                "note",
+                "Saved OCR/translation and current settings; " +
+                    "settings do not prove which provider created older text. " +
+                    "No raw OCR rerun or API request is performed.",
+            )
+        }
+        return Snapshot(chapterId, page.index, metadata.toString(), record.toString(), page.stream)
+    }
+}
