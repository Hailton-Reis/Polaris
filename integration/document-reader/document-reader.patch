+import eu.kanade.translation.model.PageTranslation
+import eu.kanade.translation.model.TranslationPageEditor
+import mihon.core.archive.PdfPageReader
+
+internal class PdfPageLoader(
+    private val reader: PdfPageReader,
+    private val translations: Map<String, PageTranslation>,
+    private val editorFactory: (String) -> TranslationPageEditor?,
+) : PageLoader() {
+    override var isLocal = true
+
+    override suspend fun getPages(): List<ReaderPage> = (0 until reader.pageCount).map { index ->
+        val key = reader.pageKey(index)
+        ReaderPage(index).apply {
+            translation = translations[key]
+            translationEditor = editorFactory(key)
+            stream = { reader.openPage(index) }
+            status = Page.State.Ready
+        }
+    }
+
+    override fun recycle() {
+        super.recycle()
+        reader.close()
+    }
+}
