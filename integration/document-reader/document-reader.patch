+package eu.kanade.tachiyomi.polaris
+
+import android.content.Intent
+import android.graphics.Bitmap
+import androidx.test.core.app.ActivityScenario
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import androidx.test.platform.app.InstrumentationRegistry
+import java.io.File
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+
+@RunWith(AndroidJUnit4::class)
+class PersonalizationPreviewAndroidTest {
+    @Test
+    fun renderJourneyIconsAndThemesWithLargeText() {
+        val instrumentation = InstrumentationRegistry.getInstrumentation()
+        val context = instrumentation.targetContext
+        val samples =
+            listOf(
+                Triple("journey-north", "POLARIS_NORTH", false),
+                Triple("appearance-aurora-light", "POLARIS_AURORA", true),
+                Triple("journey-amber-large", "POLARIS_AMBER", false),
+                Triple("achievements-library", "POLARIS_AURORA", false),
+            )
+        val directory =
+            File(context.getExternalFilesDir(null), "polaris-audit-previews").apply { mkdirs() }
+        for ((name, theme, appearance) in samples) {
+            val intent =
+                Intent()
+                    .setClassName(
+                        context.packageName,
+                        "eu.kanade.tachiyomi.polaris.PolarisPersonalizationTestActivity",
+                    )
+                    .putExtra("theme", theme)
+                    .putExtra("appearance", appearance)
+                    .putExtra("achievements", name == "achievements-library")
+                    .putExtra("light", appearance)
+                    .putExtra("fontScale", if (name.endsWith("large")) 1.3f else 1f)
+            ActivityScenario.launch<android.app.Activity>(intent).use { scenario ->
+                scenario.onActivity { assertFalse(it.isFinishing) }
+                instrumentation.waitForIdleSync()
+                Thread.sleep(800)
+                val screenshot = instrumentation.uiAutomation.takeScreenshot()
+                assertNotNull(screenshot)
+                File(directory, "$name.png").outputStream().use {
+                    screenshot.compress(Bitmap.CompressFormat.PNG, 100, it)
+                }
+                screenshot.recycle()
+            }
+        }
+        assertEquals(4, directory.listFiles()!!.count { it.extension == "png" })
+    }
+}
