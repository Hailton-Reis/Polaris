+package eu.kanade.tachiyomi.source.selection
+
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.test.runTest
+import org.junit.jupiter.api.Assertions.*
+import org.junit.jupiter.api.Test
+import tachiyomi.domain.chapter.model.Chapter
+import tachiyomi.domain.chapter.model.ChapterOrigin
+
+class ChapterLoadFallbackTest {
+    private fun chapter(id: Long, provider: Long, name: String = "Chapter 1") =
+        Chapter.create()
+            .copy(
+                id = id,
+                mangaId = 5,
+                name = name,
+                url = "/chapter/$id",
+                memo =
+                    ChapterOrigin(provider, "Provider", "en", "/work", "/chapter/$id")
+                        .attach(Chapter.create().memo),
+            )
+
+    @Test
+    fun `fallback cannot switch chapter numbering or violate a fixed provider`() {
+        val original = chapter(1, 1)
+        val same = chapter(2, 2)
+        val next = chapter(3, 2, "Chapter 2")
+        val reset = chapter(4, 2, "Season 2 Chapter 1")
+        assertEquals(
+            listOf(same),
+            ChapterLoadFallback.candidates(
+                original,
+                listOf(original, same, next, reset),
+                1,
+                null,
+                setOf(1, 2),
+                emptySet(),
+                false,
+            ),
+        )
+        assertTrue(
+            ChapterLoadFallback.candidates(
+                    original,
+                    listOf(same),
+                    1,
+                    1,
+                    setOf(1, 2),
+                    emptySet(),
+                    false,
+                )
+                .isEmpty()
+        )
+    }
+
+    @Test
+    fun `downloaded-only mode never opens a replacement over the network`() {
+        val original = chapter(1, 1)
+        val downloaded = chapter(2, 2)
+        val online = chapter(3, 3)
+        assertEquals(
+            listOf(downloaded),
+            ChapterLoadFallback.candidates(
+                original,
+                listOf(downloaded, online),
+                1,
+                null,
+                setOf(1, 2, 3),
+                setOf(2),
+                true,
+            ),
+        )
+    }
+
+    @Test
+    fun `a failed page list tries an alternate and disposes only failed loaders`() = runTest {
+        val attempts = mutableListOf<Int>()
+        val discarded = mutableListOf<Int>()
+        val selected =
+            ChapterLoadFallback.load(
+                1,
+                { listOf(2, 3) },
+                {
+                    attempts += it
+                    if (it < 3) error("Unavailable")
+                },
+                { discarded += it },
+            )
+        assertEquals(3, selected)
+        assertEquals(listOf(1, 2, 3), attempts)
+        assertEquals(listOf(1, 2), discarded)
+    }
+
+    @Test
+    fun `cancellation never becomes a request to another provider`() = runTest {
+        var alternativesRequested = false
+        var cancelled = false
+        try {
+            ChapterLoadFallback.load(
+                1,
+                {
+                    alternativesRequested = true
+                    listOf(2)
+                },
+                { throw CancellationException() },
+                {},
+            )
+        } catch (_: CancellationException) {
+            cancelled = true
+        }
+        assertTrue(cancelled)
+        assertFalse(alternativesRequested)
+    }
+}
