+package tachiyomi.domain.manga.model
+
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.decodeFromJsonElement
+import kotlinx.serialization.json.encodeToJsonElement
+
+@Serializable
+data class WorkSource(
+    val sourceId: Long,
+    val name: String,
+    val language: String,
+    val url: String,
+    val title: String,
+    val author: String? = null,
+    val artist: String? = null,
+    val sourceMemo: JsonObject = JsonObject(emptyMap()),
+    val chapters: Int = 0,
+    val continuous: Int = 0,
+    val available: Boolean = true,
+    val active: Boolean = true,
+    val readability: String = "unverified",
+    val healthCheckedAt: Long = 0,
+) {
+    val key: String
+        get() = "$sourceId:$url"
+}
+
+/** Per-work preference; the default is automatic and no source links use local manga ids. */
+@Serializable
+data class WorkSources(
+    val pinned: WorkSource? = null,
+    val candidates: List<WorkSource> = emptyList(),
+    val checkedAt: Long = 0,
+    val installedFingerprint: String = "",
+    val identity: WorkIdentity? = null,
+) {
+    fun attach(memo: JsonObject): JsonObject =
+        JsonObject(memo + (KEY to json.encodeToJsonElement(this)))
+
+    companion object {
+        const val KEY = "polaris.work.sources.v1"
+        private val json = Json { ignoreUnknownKeys = true }
+
+        fun from(memo: JsonObject): WorkSources =
+            runCatching { json.decodeFromJsonElement<WorkSources>(memo.getValue(KEY)) }
+                .getOrDefault(WorkSources())
+    }
+}
