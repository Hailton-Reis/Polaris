+
+class LibraryWorkTest {
+    private fun manga(id: Long, source: Long = id) =
+        Manga.create()
+            .copy(
+                id = id,
+                source = source,
+                url = "/work/$source",
+                title = "The Star",
+                author = "Jane",
+                favorite = true,
+                notes = "personal $id",
+            )
+
+    private fun association(a: Manga, b: Manga) =
+        LibraryWork(
+            a.source,
+            a.url,
+            listOf(a, b).map {
+                LibraryEdition(
+                    it.source,
+                    it.url,
+                    it.title,
+                    it.author,
+                    it.artist,
+                    "Source ${it.source}",
+                    if (it.source == 1L) "pt-BR" else "en",
+                )
+            },
+        )
+
+    private fun chapter(
+        id: Long,
+        owner: Long,
+        n: Int,
+        read: Boolean = false,
+        bookmark: Boolean = false,
+    ) =
+        Chapter.create()
+            .copy(
+                id = id,
+                mangaId = owner,
+                url = "/chapter/$n",
+                name = "Chapter $n",
+                chapterNumber = n.toDouble(),
+                read = read,
+                bookmark = bookmark,
+            )
+
+    private fun setup(
+        a: Manga = manga(1),
+        b: Manga = manga(2),
+        left: List<Chapter> = listOf(chapter(11, 1, 1)),
+        right: List<Chapter> = listOf(chapter(21, 2, 1)),
+    ): Triple<GetLibraryWorkChapters, List<Manga>, ChapterRepository> {
+        val state = association(a, b)
+        val members = listOf(a, b).map { it.copy(memo = state.attach(it.memo)) }
+        val repo = mockk<MangaRepository>()
+        val works = mockk<LibraryWorkRepository>()
+        val chapters = mockk<ChapterRepository>()
+        members.forEach { m -> coEvery { repo.getMangaById(m.id) } returns m }
+        coEvery { works.favorites() } returns members
+        every { works.subscribeFavorites() } returns flowOf(members)
+        coEvery { chapters.getChapterByMangaId(1, any()) } returns left
+        coEvery { chapters.getChapterByMangaId(2, any()) } returns right
+        coEvery { chapters.getChapterByMangaIdAsFlow(1, any()) } returns flowOf(left)
+        coEvery { chapters.getChapterByMangaIdAsFlow(2, any()) } returns flowOf(right)
+        return Triple(GetLibraryWorkChapters(repo, chapters, works), members, chapters)
+    }
+
+    @Test
+    fun `native mutation query never includes chapters from another edition`() = runTest {
+        val (query, _, repository) = setup()
+        val access = GetChaptersByMangaId(repository, query)
+        assertEquals(listOf(11L, 21L), access.await(1).map { it.id })
+        assertEquals(listOf(11L), access.awaitNative(1).map { it.id })
+        assertEquals(listOf(21L), access.awaitNative(2).map { it.id })
+        assertTrue(access.awaitNative(1).none { ChapterStorage.KEY in it.memo })
+    }
+
+    @Test
+    fun `an explicit separate flag invalidates even reciprocal imported membership`() {
+        val a = manga(1)
+        val b = manga(2)
+        val state = association(a, b)
+        val root = a.copy(memo = state.attach(a.memo))
+        val other =
+            b.copy(
+                memo =
+                    JsonObject(state.attach(b.memo) + (LibraryWork.SEPARATE to JsonPrimitive(true)))
+            )
+        assertEquals(listOf(root), state.resolve(root, listOf(root, other)))
+    }
+
+    @Test
+    fun `numbering changes are revalidated and recover without changing association or progress`() =
+        runTest {
+            val (query, members, repo) = setup()
+            assertEquals(2, query.await(1).size)
+            coEvery { repo.getChapterByMangaId(2, false) } returns
+                listOf(chapter(21, 2, 1).copy(name = "Season 2 Chapter 1", lastPageRead = 17))
+            assertEquals(listOf(11L), query.await(1).map { it.id })
+            assertEquals(listOf(1L), query.members(1).map { it.id })
+            assertEquals(2L, query.rootId(2))
+            coEvery { repo.getChapterByMangaId(2, false) } returns
+                listOf(chapter(21, 2, 1).copy(lastPageRead = 17))
+            assertEquals(17L, query.await(1).last().lastPageRead)
+            assertEquals(1L, query.rootId(2))
+            assertTrue(members.all { LibraryWork.from(it.memo) != null })
+            coVerify(exactly = 0) { repo.updateAll(any()) }
+        }
+
+    @Test
+    fun `chapter flow revalidates numbering even when manga metadata and row counts stay equal`() =
+        runTest {
+            val (query, _, repo) = setup()
+            val left = MutableStateFlow(listOf(chapter(11, 1, 1)))
+            val right = MutableStateFlow(listOf(chapter(21, 2, 1)))
+            coEvery { repo.getChapterByMangaIdAsFlow(1, false) } returns left
+            coEvery { repo.getChapterByMangaIdAsFlow(2, false) } returns right
+            val emitted = mutableListOf<List<Chapter>>()
+            val job =
+                launch(UnconfinedTestDispatcher(testScheduler)) {
+                    query.subscribe(1).take(3).toList(emitted)
+                }
+            runCurrent()
+            right.value = listOf(chapter(21, 2, 1).copy(name = "Volume 2 Chapter 1"))
+            runCurrent()
+            right.value = listOf(chapter(21, 2, 1))
+            runCurrent()
+            job.join()
+            assertEquals(
+                listOf(listOf(11L, 21L), listOf(11L), listOf(11L, 21L)),
+                emitted.map { row -> row.map { it.id } },
+            )
+        }
+
+    @Test
+    fun `scanlator filtering does not invalidate numbering established by the full native edition`() =
+        runTest {
+            val (query, _, repo) = setup()
+            coEvery { repo.getChapterByMangaId(2, true) } returns emptyList()
+            val visible = query.snapshot(1, true)
+            assertEquals(2, visible.members.size)
+            assertEquals(listOf(11L), visible.chapters.map { it.id })
+        }
+
+    @Test
+    fun `library exposes both native records after incompatible renumbering with unchanged counts`() =
+        runTest {
+            val (query, members, chapterRepo) = setup()
+            coEvery { chapterRepo.getChapterByMangaId(2, false) } returns
+                listOf(chapter(21, 2, 1).copy(name = "Season 2 Chapter 1"))
+            val rows = members.map { LibraryManga(it, emptyList(), 1, 0, 0, 0, 0, 0) }
+            val mangas = mockk<MangaRepository>()
+            coEvery { mangas.getLibraryManga() } returns rows
+            assertEquals(listOf(1L, 2L), GetLibraryManga(mangas, query).await().map { it.id })
+        }
+
+    @Test
+    fun `confirmed catalogue aliases retain adjacent Portuguese and English complements during reads`() =
+        runTest {
+            val identity =
+                WorkIdentity(
+                    "mangadex:ade0306c-f4b6-4890-9edb-1ddf04df2039",
+                    listOf("A Estrela", "The Star"),
+                    listOf("Jane"),
+                    1,
+                )
+            fun identified(m: Manga) =
