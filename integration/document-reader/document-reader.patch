+package tachiyomi.domain.history.interactor
+
+import io.mockk.coEvery
+import io.mockk.mockk
+import kotlinx.coroutines.test.runTest
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Test
+import tachiyomi.domain.chapter.interactor.GetChaptersByMangaId
+import tachiyomi.domain.chapter.model.Chapter
+import tachiyomi.domain.history.repository.HistoryRepository
+import tachiyomi.domain.manga.interactor.GetManga
+import tachiyomi.domain.manga.model.Manga
+
+class GetNextChaptersTest {
+    private fun chapter(id: Long, number: Int, official: Boolean, read: Boolean = false) = Chapter.create().copy(
+        id = id,
+        mangaId = 10,
+        url = "/$id",
+        chapterNumber = number.toDouble(),
+        read = read,
+        name = "Chapter $number " + if (official) "Official" else "Unofficial",
+    )
+    private fun interactor(chapters: List<Chapter>): GetNextChapters {
+        val getChapters = mockk<GetChaptersByMangaId>()
+        val getManga = mockk<GetManga>()
+        coEvery { getChapters.await(10, true) } returns chapters
+        coEvery { getManga.await(10) } returns Manga.create().copy(
+            id = 10,
+            source = 1,
+            chapterFlags = Manga.CHAPTER_SORTING_NUMBER,
+        )
+        return GetNextChapters(getChapters, getManga, mockk<HistoryRepository>())
+    }
+
+    @Test fun `next unread excludes a group already read through another edition`() = runTest {
+        val next = interactor(listOf(chapter(1, 0, false, true), chapter(2, 0, true), chapter(3, 1, true)))
+        assertEquals(listOf(3L), next.await(10).map { it.id })
+    }
+
+    @Test fun `completed current chapter cannot restart the sequence at chapter one`() = runTest {
+        val next = interactor(listOf(chapter(1, 1, true), chapter(2, 2, true, true), chapter(3, 3, true)))
+        assertEquals(listOf(3L), next.await(10, 2, true).map { it.id })
+    }
+
+    @Test fun `partially read current edition remains the starting point`() = runTest {
+        val next =
+            interactor(listOf(chapter(1, 1, false).copy(lastPageRead = 5), chapter(2, 1, true), chapter(3, 2, true)))
+        assertEquals(listOf(1L, 3L), next.await(10, 1, true).map { it.id })
+    }
+
+    @Test fun `missing chapter does not silently jump to an unrelated beginning`() = runTest {
+        assertEquals(emptyList<Chapter>(), interactor(listOf(chapter(1, 1, true))).await(10, 999, true))
+    }
+}
