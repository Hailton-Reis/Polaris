index 0000000..12c5069
--- /dev/null
+++ b/app/src/main/java/eu/kanade/tachiyomi/extension/sandbox/ExtensionSandboxSession.kt
@@ -0,0 +1,291 @@
+package eu.kanade.tachiyomi.extension.sandbox
+
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+import android.content.ServiceConnection
+import android.os.IBinder
+import android.os.Parcel
+import android.os.ParcelFileDescriptor
+import java.io.File
+import java.util.concurrent.Executors
+import java.util.concurrent.SynchronousQueue
+import java.util.concurrent.ThreadPoolExecutor
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.TimeoutException
+import java.util.concurrent.atomic.AtomicBoolean
+import java.util.concurrent.atomic.AtomicReference
+import kotlinx.coroutines.*
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.serialization.json.*
+
+/** Bounded internal IPC client. Never falls back to loading an extension into the host process. */
+internal class ExtensionSandboxSession
+private constructor(
+    private val context: Context,
+    private val connection: ServiceConnection,
+    private val remote: IBinder,
+    private val death: CompletableDeferred<Unit>,
+    private val broker: SandboxHttpBroker,
+    val metadata: JsonObject,
+    private val callTimeoutMillis: Long,
+) {
+    suspend fun request(
+        source: Long,
+        operation: String,
+        arguments: JsonObject = JsonObject(emptyMap()),
+    ): JsonObject {
+        require(operation in ExtensionSandboxProtocol.operations)
+        val input =
+            JsonObject(
+                arguments +
+                    ("source" to JsonPrimitive(source)) +
+                    ("operation" to JsonPrimitive(operation))
+            )
+        return transact(remote, ExtensionSandboxProtocol.REQUEST, callTimeoutMillis, ::abort) {
+            parcel ->
+            val bytes = input.toString().toByteArray()
+            require(bytes.size <= ExtensionSandboxProtocol.MAX_INPUT)
+            parcel.writeByteArray(bytes)
+        }
+    }
+
+    private fun abort() {
+        broker.close()
+        runCatching { context.unbindService(connection) }
+    }
+
+    private suspend fun dispose() {
+        broker.close()
+        // Close is independent of a blocked operation's coroutine and never enables compatibility.
+        Thread(
+                {
+                    runCatching {
+                        val data = Parcel.obtain()
+                        val reply = Parcel.obtain()
+                        try {
+                            data.writeInterfaceToken(ExtensionSandboxProtocol.DESCRIPTOR)
+                            remote.transact(ExtensionSandboxProtocol.CLOSE, data, reply, 0)
+                        } finally {
+                            data.recycle()
+                            reply.recycle()
+                        }
+                    }
+                },
+                "polaris-sandbox-close",
+            )
+            .apply {
+                isDaemon = true
+                start()
+            }
+        runCatching { context.unbindService(connection) }
+        if (
+            withTimeoutOrNull(3_000) {
+                death.await()
+                true
+            } != true
+        )
+            pendingDeath = death
+    }
+
+    companion object {
+        private val lock = Mutex()
+        // A hostile worker must not pin unbounded host IO threads or control its own deadline.
+        private val rpcThreads =
+            ThreadPoolExecutor(
+                0,
+                2,
+                30,
+                TimeUnit.SECONDS,
+                SynchronousQueue(),
+                { action -> Thread(action, "polaris-sandbox-ipc").apply { isDaemon = true } },
+            )
+        private val deadlines =
+            Executors.newSingleThreadScheduledExecutor { action ->
+                Thread(action, "polaris-sandbox-deadline").apply { isDaemon = true }
+            }
+        private var pendingDeath: CompletableDeferred<Unit>? = null
+
+        suspend fun <T> withApk(
+            context: Context,
+            apk: File,
+            digest: String,
+            entryClasses: List<String>,
+            onViolation: (String) -> Unit = {},
+            callTimeoutMillis: Long = 30_000L,
+            action: suspend (ExtensionSandboxSession) -> T,
+        ): T =
+            lock.withLock {
+                pendingDeath?.let {
+                    withTimeout(5_000) { it.await() }
+                    pendingDeath = null
+                }
+                val ready = CompletableDeferred<IBinder>()
+                val death = CompletableDeferred<Unit>()
+                val connection =
+                    object : ServiceConnection {
+                        override fun onServiceConnected(name: ComponentName, service: IBinder) {
+                            service.linkToDeath({ death.complete(Unit) }, 0)
+                            ready.complete(service)
+                        }
+
+                        override fun onServiceDisconnected(name: ComponentName) {
+                            death.complete(Unit)
+                        }
+
+                        override fun onBindingDied(name: ComponentName) {
+                            death.complete(Unit)
+                            ready.completeExceptionally(
+                                IllegalStateException("Sandbox binding died")
+                            )
+                        }
+
+                        override fun onNullBinding(name: ComponentName) {
+                            death.complete(Unit)
+                            ready.completeExceptionally(
+                                IllegalStateException("Sandbox binding refused")
+                            )
+                        }
+                    }
+                check(
+                    context.bindService(
+                        Intent(context, ExtensionSandboxService::class.java),
+                        connection,
+                        Context.BIND_AUTO_CREATE,
+                    )
+                )
+                var session: ExtensionSandboxSession? = null
+                var broker: SandboxHttpBroker? = null
+                val abort = {
+                    broker?.close()
+                    runCatching { context.unbindService(connection) }
+                    Unit
+                }
+                try {
+                    val remote = withTimeout(10_000) { ready.await() }
+                    val identity = transact(remote, 4, callTimeoutMillis, abort) {}
+                    val uid = identity.getValue("uid").jsonPrimitive.int
+                    check(uid != android.os.Process.myUid() && uid % 100_000 in 90_000..99_999) {
+                        "Worker not isolated"
+                    }
+                    val activeBroker = SandboxHttpBroker(uid, onViolation)
+                    broker = activeBroker
+                    val metadata =
+                        ParcelFileDescriptor.open(apk, ParcelFileDescriptor.MODE_READ_ONLY).use {
+                            file ->
+                            transact(
+                                remote,
+                                ExtensionSandboxProtocol.OPEN,
+                                callTimeoutMillis,
+                                abort,
+                            ) {
+                                it.writeTypedObject(file, 0)
+                                it.writeString(digest)
+                                it.writeStringArray(entryClasses.toTypedArray())
+                                it.writeStrongBinder(activeBroker)
+                            }
+                        }
+                    check(metadata.getValue("uid").jsonPrimitive.int == uid)
+                    session =
+                        ExtensionSandboxSession(
+                            context,
+                            connection,
+                            remote,
+                            death,
+                            activeBroker,
+                            metadata,
+                            callTimeoutMillis,
+                        )
+                    action(session)
+                } finally {
+                    withContext(NonCancellable) {
+                        if (session != null) session.dispose()
+                        else {
+                            broker?.close()
+                            runCatching { context.unbindService(connection) }
+                            // A failed constructor is still untrusted; do not reuse its process.
+                            if (!death.isCompleted) pendingDeath = death
+                        }
+                    }
+                }
+            }
+
+        private suspend fun transact(
+            remote: IBinder,
+            code: Int,
+            timeoutMillis: Long,
+            abort: () -> Unit,
+            write: (Parcel) -> Unit,
+        ): JsonObject = suspendCancellableCoroutine { continuation ->
+            val finished = AtomicBoolean(false)
+            val pipe = AtomicReference<ParcelFileDescriptor?>(null)
+            val timeout =
+                deadlines.schedule(
+                    {
+                        if (finished.compareAndSet(false, true)) {
+                            runCatching { pipe.getAndSet(null)?.close() }
+                            runCatching(abort)
+                            continuation.resumeWith(
+                                Result.failure(TimeoutException("Sandbox call timed out"))
+                            )
+                        }
+                    },
+                    timeoutMillis,
+                    TimeUnit.MILLISECONDS,
+                )
+            continuation.invokeOnCancellation {
+                if (finished.compareAndSet(false, true)) {
+                    timeout.cancel(false)
+                    runCatching { pipe.getAndSet(null)?.close() }
+                    runCatching(abort)
+                }
+            }
+            try {
+                rpcThreads.execute {
+                    val result = runCatching {
+                        val input = Parcel.obtain()
+                        val output = Parcel.obtain()
+                        try {
+                            input.writeInterfaceToken(ExtensionSandboxProtocol.DESCRIPTOR)
+                            write(input)
+                            check(remote.transact(code, input, output, 0))
+                            output.readException()
+                            @Suppress("DEPRECATION")
+                            val descriptor =
+                                output.readTypedObject(ParcelFileDescriptor.CREATOR)
+                                    ?: error("Missing sandbox result")
+                            pipe.set(descriptor)
+                            check(!finished.get()) { "Sandbox call expired" }
+                            val bytes =
+                                ParcelFileDescriptor.AutoCloseInputStream(descriptor).use {
+                                    ExtensionSandboxProtocol.readBounded(
+                                        it,
+                                        ExtensionSandboxProtocol.MAX_OUTPUT,
+                                    )
+                                }
+                            ExtensionSandboxProtocol.parse(
+                                bytes,
+                                ExtensionSandboxProtocol.MAX_OUTPUT,
+                            )
+                        } finally {
+                            runCatching { pipe.getAndSet(null)?.close() }
+                            input.recycle()
+                            output.recycle()
+                        }
+                    }
+                    if (finished.compareAndSet(false, true)) {
+                        timeout.cancel(false)
+                        continuation.resumeWith(result)
+                    }
+                }
+            } catch (error: Exception) {
+                if (finished.compareAndSet(false, true)) {
+                    timeout.cancel(false)
+                    runCatching(abort)
+                    continuation.resumeWith(Result.failure(error))
+                }
+            }
+        }
+    }
+}
