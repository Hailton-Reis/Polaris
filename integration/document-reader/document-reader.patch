+    val sharedPackages: Set<String> = emptySet(),
+    val selection: PreparationSelection = PreparationSelection.LANGUAGES,
+    val languages: Set<String> = setOf("pt-BR", "pt", "en"),
+    val manualPackages: Set<String> = emptySet(),
