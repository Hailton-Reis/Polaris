new file mode 100644
index 0000000..af39e5a
--- /dev/null
+++ b/app/src/main/java/eu/kanade/tachiyomi/data/updater/PolarisUpdateIntegrity.kt
@@ -0,0 +1,24 @@
+package eu.kanade.tachiyomi.data.updater
+
+import java.io.File
+import java.io.IOException
+import java.security.MessageDigest
+
+object PolarisUpdateIntegrity {
+    fun verify(apk: File, expected: String) {
+        val digest = MessageDigest.getInstance("SHA-256")
+        apk.inputStream().use { stream ->
+            val buffer = ByteArray(32 * 1024)
+            while (true) {
+                val count = stream.read(buffer)
+                if (count < 0) break
+                digest.update(buffer, 0, count)
+            }
+        }
+        val actual = digest.digest().joinToString("") { "%02x".format(it) }
+        if (!actual.equals(expected, ignoreCase = true)) {
+            apk.delete()
+            throw IOException("Update checksum mismatch")
+        }
+    }
+}
diff --git a/app/src/main/java/eu/kanade/tachiyomi/data/updater/PolarisUpdatePreferences.kt b/app/src/main/java/eu/kanade/tachiyomi/data/updater/PolarisUpdatePreferences.kt
