@@ -0,0 +1,133 @@
+package eu.kanade.tachiyomi.extension.util
+
+import java.io.File
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import java.nio.file.Path
+import java.util.zip.ZipEntry
+import java.util.zip.ZipOutputStream
+import org.junit.jupiter.api.Assertions.*
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.io.TempDir
+
+class ExtensionSecurityAuditTest {
+    @TempDir lateinit var temporary: Path
+
+    private fun dex(owner: String, method: String): ByteArray {
+        val strings = listOf(owner, method)
+        val stringTable = 112
+        val types = stringTable + strings.size * 4
+        val methods = types + 4
+        val stringData = methods + 8
+        val data = ByteArray(stringData + strings.sumOf { it.length + 2 })
+        "dex\n035\u0000".toByteArray().copyInto(data)
+        val buffer = ByteBuffer.wrap(data).order(ByteOrder.LITTLE_ENDIAN)
+        buffer.putInt(32, data.size)
+        buffer.putInt(36, 112)
+        buffer.putInt(40, 0x12345678)
+        buffer.putInt(56, strings.size)
+        buffer.putInt(60, stringTable)
+        buffer.putInt(64, 1)
+        buffer.putInt(68, types)
+        buffer.putInt(88, 1)
+        buffer.putInt(92, methods)
+        buffer.putInt(types, 0)
+        buffer.putShort(methods, 0)
+        buffer.putInt(methods + 4, 1)
+        var offset = stringData
+        strings.forEachIndexed { index, value ->
+            buffer.putInt(stringTable + index * 4, offset)
+            data[offset++] = value.length.toByte()
+            value.toByteArray().copyInto(data, offset)
+            offset += value.length + 1
+        }
+        return data
+    }
+
+    private fun apk(vararg entries: Pair<String, ByteArray>): File {
+        val file = temporary.resolve("extension.apk").toFile()
+        ZipOutputStream(file.outputStream()).use { zip ->
+            entries.forEach { (name, bytes) ->
+                zip.putNextEntry(ZipEntry(name))
+                zip.write(bytes)
+                zip.closeEntry()
+            }
+        }
+        return file
+    }
+
+    @Test
+    fun `ordinary HTTP references are not labeled dangerous solely by method name`() {
+        assertTrue(
+            ExtensionSecurityAudit.inspectDex(dex("Lokhttp3/OkHttpClient;", "exec")).isEmpty()
+        )
+    }
+
+    @Test
+    fun `runtime execution and dynamically loaded code require quarantine`() {
+        for ((owner, method, risk) in
+            listOf(
+                Triple("Ljava/lang/Runtime;", "exec", "SHELL_EXECUTION"),
+                Triple("Ljava/lang/ProcessBuilder;", "start", "SHELL_EXECUTION"),
+                Triple("Ldalvik/system/DexClassLoader;", "<init>", "DYNAMIC_CODE"),
+                Triple("Landroid/content/ContentResolver;", "query", "SENSITIVE_PROVIDER"),
+                Triple("Landroid/telephony/SmsManager;", "sendTextMessage", "DEVICE_CONTROL"),
+                Triple("Lrikka/shizuku/Shizuku;", "getBinder", "DEVICE_CONTROL"),
+            )) assertEquals(setOf(risk), ExtensionSecurityAudit.inspectDex(dex(owner, method)))
+    }
+
+    @Test
+    fun `all dex files are inspected and native code and sensitive declarations are surfaced`() {
+        val file =
+            apk(
+                "classes.dex" to dex("Lokhttp3/OkHttpClient;", "newCall"),
+                "classes2.dex" to dex("Ljava/lang/Runtime;", "exec"),
+                "lib/arm64-v8a/libextra.so" to byteArrayOf(1),
+            )
+        val report =
+            ExtensionSecurityAudit.inspect(file, listOf("android.permission.READ_CONTACTS"))
+        assertEquals(
+            setOf("SHELL_EXECUTION", "NATIVE_CODE", "PRIVILEGED_PERMISSION"),
+            report.findings.toSet(),
+        )
+        assertTrue(ExtensionSecurityAudit.requiresQuarantine("test.extension", report, emptySet()))
+    }
+
+    @Test
+    fun `an approval binds package and exact bytes and does not authorize a changed update`() {
+        val file = apk("classes.dex" to dex("Ljava/lang/Runtime;", "exec"))
+        val first = ExtensionSecurityAudit.inspect(file, emptyList())
+        val approved = setOf(ExtensionSecurityAudit.approvalKey("test.extension", first)!!)
+        assertFalse(ExtensionSecurityAudit.requiresQuarantine("test.extension", first, approved))
+        assertTrue(ExtensionSecurityAudit.requiresQuarantine("other.extension", first, approved))
+        apk("classes.dex" to dex("Ljava/lang/Runtime;", "exec"), "extra" to byteArrayOf(42))
+        val changed = ExtensionSecurityAudit.inspect(file, emptyList())
+        assertNotEquals(first.sha256, changed.sha256)
+        assertTrue(ExtensionSecurityAudit.requiresQuarantine("test.extension", changed, approved))
+    }
+
+    @Test
+    fun `unreadable or out of bounds code fails closed and cannot be approved`() {
+        val malformed = dex("Ljava/lang/Runtime;", "exec")
+        ByteBuffer.wrap(malformed).order(ByteOrder.LITTLE_ENDIAN).putInt(92, Int.MAX_VALUE)
+        val report = ExtensionSecurityAudit.inspect(apk("classes.dex" to malformed), emptyList())
+        assertTrue("UNREADABLE_CODE" in report.findings)
+        assertNull(ExtensionSecurityAudit.approvalKey("test.extension", report))
+        assertTrue(
+            ExtensionSecurityAudit.requiresQuarantine(
+                "test.extension",
+                report,
+                setOf("test.extension:${report.sha256}"),
+            )
+        )
+    }
+
+    @Test
+    fun `a package without inspectable dex is not silently accepted`() {
+        assertEquals(
+            listOf("UNREADABLE_CODE"),
+            ExtensionSecurityAudit.inspect(apk("assets/readme" to byteArrayOf(1)), emptyList())
+                .findings,
+        )
+    }
+}
diff --git a/app/src/test/java/eu/kanade/tachiyomi/extension/util/PrivateExtensionFilesTest.kt b/app/src/test/java/eu/kanade/tachiyomi/extension/util/PrivateExtensionFilesTest.kt
