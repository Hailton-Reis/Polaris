+package eu.kanade.tachiyomi.extension.novel
+
+import java.nio.file.Path
+import org.junit.jupiter.api.Assertions.*
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.io.TempDir
+
+class NovelPluginPathsTest {
+    @TempDir lateinit var temporary: Path
+
+    @Test
+    fun `ordinary and Unicode identifiers remain inside the chosen directory`() {
+        for (id in listOf("en.example", "plugin-v2", "_plugin", "书库")) {
+            val file = NovelPluginPaths.file(temporary.toFile(), id, "js")
+            assertEquals(temporary.toFile().canonicalFile, file.parentFile)
+            assertEquals("$id.js", file.name)
+        }
+    }
+
+    @Test
+    fun `repository identifiers cannot escape or choose a different file type`() {
+        for (id in
+            listOf(
+                "../outside",
+                "..",
+                "",
+                "/absolute",
+                "a/b",
+                "a\\b",
+                "%2e%2e",
+                "a".repeat(161),
+                "a\u0000b",
+            )) {
+            assertThrows(IllegalArgumentException::class.java) {
+                NovelPluginPaths.file(temporary.toFile(), id, "js")
+            }
+        }
+        assertThrows(IllegalArgumentException::class.java) {
+            NovelPluginPaths.file(temporary.toFile(), "valid", "../xml")
+        }
+    }
+
+    @Test
+    fun `code downloads require HTTPS without embedded credentials`() {
+        NovelPluginPaths.requireHttps("https://example.invalid/plugin.js")
+        for (url in
+            listOf(
+                "http://example.invalid/plugin.js",
+                "file:///private/script.js",
+                "https:///missing-host",
+                "https://user:password@example.invalid/script.js",
+            )) {
+            assertThrows(IllegalArgumentException::class.java) {
+                NovelPluginPaths.requireHttps(url)
+            }
+        }
+    }
+}
