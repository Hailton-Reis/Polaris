@@ -0,0 +1,106 @@
+package eu.kanade.tachiyomi.data.updater
+
+import kotlinx.serialization.SerialName
+import kotlinx.serialization.Serializable
+import tachiyomi.domain.release.interactor.GetApplicationRelease
+import tachiyomi.domain.release.model.Release
+import java.io.IOException
+
+data class PolarisReleasePage(val releases: List<PolarisGithubRelease>, val hasNext: Boolean)
+
+@Serializable
+data class PolarisGithubAsset(
+    val name: String,
+    @SerialName("browser_download_url") val url: String,
+    val size: Long = 0,
+)
+
+@Serializable
+data class PolarisGithubRelease(
+    @SerialName("tag_name") val tag: String,
+    @SerialName("html_url") val url: String,
+    val body: String? = null,
+    val draft: Boolean = false,
+    val prerelease: Boolean = false,
+    val assets: List<PolarisGithubAsset> = emptyList(),
+)
+
+@Serializable
+data class PolarisUpdateArtifact(val abi: String, val file: String, val bytes: Long, val sha256: String)
+
+@Serializable
+data class PolarisUpdateManifest(
+    val version: String,
+    @SerialName("version_code") val versionCode: Long,
+    @SerialName("minimum_android_api") val minimumAndroidApi: Int,
+    @SerialName("application_id") val applicationId: String,
+    val artifacts: List<PolarisUpdateArtifact>,
+)
+
+/** Only published, compatible Polaris APKs with release metadata can become update prompts. */
+class PolarisUpdateClient(
+    private val fetchPage: suspend (page: Int) -> PolarisReleasePage,
+    private val fetchManifest: suspend (url: String) -> PolarisUpdateManifest,
+) {
+    suspend fun check(
+        currentVersion: String,
+        currentCode: Long,
+        applicationId: String,
+        supportedAbis: List<String>,
+        androidApi: Int,
+        experimental: Boolean,
+    ): GetApplicationRelease.Result {
+        val current = PolarisReleaseVersion.parse(currentVersion) ?: throw IOException("Invalid installed version")
+        val releases = mutableListOf<PolarisGithubRelease>()
+        var page = 1
+        while (true) {
+            val response = fetchPage(page)
+            releases += response.releases
+            if (!response.hasNext) break
+            if (page++ >= 10) throw IOException("Release pagination limit reached")
+        }
+        val candidates = releases.mapNotNull { release ->
+            val version = PolarisReleaseVersion.parse(release.tag) ?: return@mapNotNull null
+            if (release.draft || (!experimental && (release.prerelease || version.prerelease.isNotEmpty()))) {
+                return@mapNotNull null
+            }
+            if (version <= current || !release.url.startsWith("$POLARIS_REPOSITORY_URL/releases/tag/")) {
+                return@mapNotNull null
+            }
+            version to release
+        }.sortedByDescending { it.first }
+        var osTooOld = false
+        for ((version, release) in candidates) {
+            val metadata = release.assets.singleOrNull {
+                it.name == "manifest.json" && officialDownload(it.url)
+            } ?: continue
+            val manifest = fetchManifest(metadata.url)
+            if (PolarisReleaseVersion.parse(manifest.version) != version ||
+                manifest.versionCode <= currentCode || manifest.applicationId != applicationId
+            ) {
+                continue
+            }
+            val artifact = supportedAbis.firstNotNullOfOrNull { abi ->
+                manifest.artifacts.singleOrNull { it.abi == abi }
+            } ?: continue
+            if (!artifact.file.endsWith(".apk") || '/' in artifact.file || '\\' in artifact.file ||
+                !artifact.sha256.matches(Regex("[a-fA-F0-9]{64}")) || artifact.bytes <= 0
+            ) {
+                continue
+            }
+            val asset = release.assets.singleOrNull {
+                it.name == artifact.file && it.size == artifact.bytes && officialDownload(it.url)
+            } ?: continue
+            if (manifest.minimumAndroidApi > androidApi) {
+                osTooOld = true
+                continue
+            }
+            return GetApplicationRelease.Result.NewUpdate(
+                Release(release.tag, release.body.orEmpty(), release.url, asset.url, artifact.sha256.lowercase()),
+            )
+        }
+        return if (osTooOld) GetApplicationRelease.Result.OsTooOld else GetApplicationRelease.Result.NoNewUpdate
+    }
+
+    private fun officialDownload(url: String) = url.startsWith("$POLARIS_REPOSITORY_URL/releases/download/")
+}
