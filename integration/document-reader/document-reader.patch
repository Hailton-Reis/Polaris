@@ -0,0 +1,116 @@
+package eu.kanade.tachiyomi.source.selection
+
+import eu.kanade.tachiyomi.source.model.SManga
+import kotlinx.serialization.json.*
+import okhttp3.OkHttpClient
+import org.junit.jupiter.api.Assertions.*
+import org.junit.jupiter.api.Test
+
+class WorkIdentityResolverTest {
+    private val resolver = WorkIdentityResolver(OkHttpClient())
+
+    private fun work(title: String, author: String? = "DAUL") =
+        SManga.create().also {
+            it.url = "/ragnarok"
+            it.title = title
+            it.author = author
+        }
+
+    private fun record(id: String = "ade0306c-f4b6-4890-9edb-1ddf04df2039") = buildJsonObject {
+        put("id", id)
+        put("type", "manga")
+        putJsonObject("attributes") {
+            putJsonObject("title") { put("ko-ro", "Na Honjaman Level Up: Ragnarok") }
+            putJsonArray("altTitles") {
+                add(buildJsonObject { put("pt-br", "Upando Sozinho: Ragnarok") })
+                add(buildJsonObject { put("en", "Solo Leveling: Ragnarok") })
+                add(buildJsonObject { put("ko", "나 혼자만 레벨업 : 라그나로크") })
+            }
+        }
+        putJsonArray("relationships") {
+            add(
+                buildJsonObject {
+                    put("type", "author")
+                    putJsonObject("attributes") { put("name", "DAUL (다울)") }
+                }
+            )
+        }
+    }
+
+    @Test
+    fun `Portuguese English and Korean titles share a corroborated catalogue identity`() {
+        val identity =
+            resolver.select(work("Upando Sozinho Ragnarok"), JsonArray(listOf(record())))!!
+        assertTrue(
+            SourceMatching.sameWork(
+                work("Upando Sozinho Ragnarok"),
+                work("Solo Leveling: Ragnarok"),
+                identity,
+            )
+        )
+        assertTrue(
+            SourceMatching.sameWork(
+                work("Upando Sozinho Ragnarok"),
+                work("나 혼자만 레벨업 : 라그나로크", "다울"),
+                identity,
+            )
+        )
+        assertFalse(
+            SourceMatching.sameWork(
+                work("Upando Sozinho Ragnarok"),
+                work("Solo Leveling"),
+                identity,
+            )
+        )
+    }
+
+    @Test
+    fun `ambiguous records or conflicting creators do not become an alias bridge`() {
+        assertNull(
+            resolver.select(
+                work("Upando Sozinho Ragnarok"),
+                JsonArray(listOf(record(), record("00000000-0000-0000-0000-000000000001"))),
+            )
+        )
+        assertNull(
+            resolver.select(
+                work("Upando Sozinho Ragnarok", "Unrelated Person"),
+                JsonArray(listOf(record())),
+            )
+        )
+    }
+
+    @Test
+    fun `metadata can corroborate a library-only backup with a missing author`() {
+        val identity =
+            resolver.select(work("Upando Sozinho Ragnarok", null), JsonArray(listOf(record())))!!
+        assertTrue(
+            SourceMatching.sameWork(
+                work("Upando Sozinho Ragnarok", null),
+                work("Solo Leveling Ragnarok"),
+                identity,
+            )
+        )
+        assertFalse(
+            SourceMatching.sameWork(
+                work("Upando Sozinho Ragnarok", null),
+                work("Solo Leveling Ragnarok", null),
+                identity,
+            )
+        )
+    }
+
+    @Test
+    fun `small spelling variation requires creator agreement and keeps sequel qualifiers`() {
+        assertTrue(
+            SourceMatching.sameWork(work("Solo Leveling Ragnarok"), work("Solo Levelling Ragnarok"))
+        )
+        assertFalse(SourceMatching.sameWork(work("Solo Leveling Ragnarok"), work("Solo Leveling")))
+        assertFalse(
+            SourceMatching.sameWork(
+                work("Solo Leveling Ragnarok"),
+                work("Solo Levelling Ragnarok", "Other"),
+            )
+        )
+    }
+}
