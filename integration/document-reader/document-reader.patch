+                        is GetApplicationRelease.Result.NewUpdate -> navigator.push(
+                            NewUpdateScreen(
+                                versionName = result.release.version,
+                                changelogInfo = result.release.info,
+                                releaseLink = result.release.releaseLink,
+                                downloadLink = result.release.downloadLink,
+                                sha256 = result.release.sha256,
+                            ),
+                        )
+                        GetApplicationRelease.Result.NoNewUpdate -> context.toast(
+                            MR.strings.update_check_no_new_updates,
+                        )
+                        GetApplicationRelease.Result.OsTooOld -> context.toast(MR.strings.update_check_eol)
+                    }
+                } catch (cancelled: CancellationException) {
+                    throw cancelled
+                } catch (_: PolarisUpdateAccessException) {
+                    context.toast(ATMR.strings.polaris_updates_access_error)
+                } catch (_: Exception) {
+                    context.toast(ATMR.strings.polaris_updates_failed)
+                } finally {
+                    checking = false
+                }
+            }
+        }
+    }
+    return checking to check
+}
