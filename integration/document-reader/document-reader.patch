+
+@Composable
+fun WorkSourceDialog(
+    settings: WorkSources,
+    original: WorkSource,
+    onSelect: (WorkSource?) -> Unit,
+    onSearch: () -> Unit,
+    onDismissRequest: () -> Unit,
+) {
+    AlertDialog(
+        onDismissRequest = onDismissRequest,
+        title = { Text(stringResource(ATMR.strings.polaris_work_source_title)) },
+        text = {
+            Column(Modifier.verticalScroll(rememberScrollState())) {
+                Text(stringResource(ATMR.strings.polaris_work_source_description))
+                RadioItem(
+                    label = stringResource(ATMR.strings.polaris_work_source_automatic),
+                    selected = settings.pinned == null,
+                    onClick = { onSelect(null) },
+                )
+                (settings.candidates + listOf(original))
+                    .distinctBy { it.key }
+                    .forEach { choice ->
+                        RadioItem(
+                            label =
+                                choice.name +
+                                    " (" +
+                                    choice.language +
+                                    ") — " +
+                                    stringResource(
+                                        when {
+                                            !choice.available ->
+                                                ATMR.strings.source_health_unavailable
+                                            choice.readability == "sample_passed" ->
+                                                ATMR.strings.source_health_sample_passed
+                                            choice.readability == "sample_failed" ->
+                                                ATMR.strings.source_health_sample_failed
+                                            else -> ATMR.strings.source_health_unverified
+                                        }
+                                    ),
+                            selected = settings.pinned?.key == choice.key,
+                            onClick = { onSelect(choice) },
+                        )
+                    }
+            }
+        },
+        confirmButton = {
+            TextButton(onClick = onSearch, enabled = settings.pinned == null) {
+                Text(stringResource(ATMR.strings.polaris_work_source_search))
+            }
+        },
+        dismissButton = {
+            TextButton(onClick = onDismissRequest) {
+                Text(stringResource(ATMR.strings.polaris_dedication_close))
+            }
+        },
+    )
+}
