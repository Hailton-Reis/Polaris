+                                                }
+                                                if (matches.size != 1) {
+                                                    null
+                                                } else {
+                                                    val match = matches.single()
+                                                    val result =
+                                                        provider
+                                                            .getMangaUpdate(
+                                                                match,
+                                                                emptyList(),
+                                                                true,
+                                                                false,
+                                                            )
