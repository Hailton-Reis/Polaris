diff --git a/app/src/androidTest/java/eu/kanade/tachiyomi/extension/sandbox/AutomaticLanguageAndroidTest.kt b/app/src/androidTest/java/eu/kanade/tachiyomi/extension/sandbox/AutomaticLanguageAndroidTest.kt
new file mode 100644
index 0000000..eb7f576
--- /dev/null
+++ b/app/src/androidTest/java/eu/kanade/tachiyomi/extension/sandbox/AutomaticLanguageAndroidTest.kt
@@ -0,0 +1,25 @@
+package eu.kanade.tachiyomi.extension.sandbox
+
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import eu.kanade.translation.AutomaticChapterLanguage
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+
+@RunWith(AndroidJUnit4::class)
+class AutomaticLanguageAndroidTest {
+    @Test
+    fun bundledModelRecognizesEnglishAndLeavesPortugueseOrShortTextAlone() = runBlocking {
+        val english =
+            "I need to become stronger if I am going to protect my family. There is no other way to win this battle. We must leave this place before the monsters arrive."
+        val portuguese =
+            "Eu preciso ficar mais forte para proteger minha família. Não existe outra maneira de vencer esta batalha. Precisamos sair deste lugar antes que os monstros cheguem."
+        assertTrue(AutomaticChapterLanguage.isEnglish(List(10) { english }))
+        assertFalse(AutomaticChapterLanguage.isEnglish(List(10) { portuguese }))
+        assertFalse(AutomaticChapterLanguage.isEnglish(listOf("Yes.")))
+        assertFalse(
+            AutomaticChapterLanguage.isEnglish(List(5) { english } + List(5) { portuguese })
+        )
+    }
+}
diff --git a/app/src/androidTest/java/eu/kanade/tachiyomi/extension/sandbox/ExtensionSandboxAndroidTest.kt b/app/src/androidTest/java/eu/kanade/tachiyomi/extension/sandbox/ExtensionSandboxAndroidTest.kt
new file mode 100644
index 0000000..e5c1e2a
--- /dev/null
+++ b/app/src/androidTest/java/eu/kanade/tachiyomi/extension/sandbox/ExtensionSandboxAndroidTest.kt
@@ -0,0 +1,181 @@
+package eu.kanade.tachiyomi.extension.sandbox
+
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import androidx.test.platform.app.InstrumentationRegistry
+import java.io.File
+import java.security.MessageDigest
+import kotlinx.coroutines.runBlocking
+import kotlinx.serialization.json.*
+import org.junit.After
+import org.junit.Assert.*
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+
+/**
+ * Runs the actual internal service/proxy with compiled synthetic Source code, without the reader
+ * UI.
+ */
+@RunWith(AndroidJUnit4::class)
+class ExtensionSandboxAndroidTest {
+    private val instrumentation = InstrumentationRegistry.getInstrumentation()
+    private val context = instrumentation.targetContext
+    private lateinit var apk: File
+    private lateinit var digest: String
+    private lateinit var canary: File
+    private val fixture = listOf("polaris.sandbox.fixture.FixtureSource")
+
+    @Before
+    fun prepare() {
+        canary =
+            File(context.filesDir, "polaris-sandbox-canary").apply {
+                writeText("synthetic-host-canary")
+            }
+        apk = File.createTempFile("sandbox-fixture", ".apk", context.cacheDir)
+        instrumentation.context.assets.open("polaris-sandbox/fixture.apk").use { input ->
+            apk.outputStream().use(input::copyTo)
+        }
+        digest =
+            MessageDigest.getInstance("SHA-256").digest(apk.readBytes()).joinToString("") {
+                "%02x".format(it)
+            }
+    }
+
+    @After
+    fun cleanup() {
+        assertEquals("synthetic-host-canary", canary.readText())
+        canary.delete()
+        apk.delete()
+    }
+
+    @Test
+    fun actualSourceRunsAtDifferentUidWithNoHostCanaryAccess() = runBlocking {
+        ExtensionSandboxSession.withApk(context, apk, digest, fixture) { session ->
+            android.util.Log.i(
+                "PolarisSandboxProof",
+                "host_uid=${android.os.Process.myUid()} worker_uid=${session.metadata.getValue("uid").jsonPrimitive.int}",
+            )
+            assertNotEquals(
+                android.os.Process.myUid(),
+                session.metadata.getValue("uid").jsonPrimitive.int,
+            )
+            val source = session.metadata.getValue("sources").jsonArray.single().jsonObject
+            assertTrue(source.getValue("name").jsonPrimitive.content.contains("protected=true"))
+            assertTrue(source.getValue("name").jsonPrimitive.content.contains("identityOwn=true"))
+            val chapters =
+                session
+                    .request(
+                        735110,
+                        "update",
+                        buildJsonObject {
+                            put(
+                                "manga",
+                                buildJsonObject {
+                                    put("url", "/work")
+                                    put("title", "Fixture")
+                                },
+                            )
+                        },
+                    )
+                    .getValue("chapters")
+                    .jsonArray
+            assertEquals(2, chapters.size)
+            assertTrue(
+                chapters
+                    .first()
+                    .jsonObject
+                    .getValue("name")
+                    .jsonPrimitive
+                    .content
+                    .contains("uid=${session.metadata.getValue("uid").jsonPrimitive.int}")
+            )
+            val pages =
+                session
+                    .request(
+                        735110,
+                        "pages",
+                        buildJsonObject {
+                            put(
+                                "chapter",
+                                buildJsonObject {
+                                    put("url", "/chapter/1")
+                                    put("name", "Chapter 1")
+                                },
+                            )
