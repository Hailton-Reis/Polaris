+package tachiyomi.domain.chapter.model
+
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.decodeFromJsonElement
+import kotlinx.serialization.json.encodeToJsonElement
+import java.util.Base64
+
+/** Portable network origin. The chapter id, manga id and storage identity remain local and stable. */
+@Serializable
+data class ChapterOrigin(
+    val sourceId: Long,
+    val sourceName: String,
+    val language: String,
+    val mangaUrl: String,
+    val chapterUrl: String,
+    val rank: Int = 0,
+    val available: Boolean = true,
+    val sourceMemo: JsonObject = JsonObject(emptyMap()),
+) {
+    fun attach(memo: JsonObject): JsonObject = JsonObject(memo + (KEY to json.encodeToJsonElement(this)))
+
+    companion object {
+        const val KEY = "polaris.chapter.origin.v1"
+        const val URL_PREFIX = "polaris://source/"
+        private val json = Json { ignoreUnknownKeys = true }
+
+        fun from(memo: JsonObject): ChapterOrigin? = runCatching {
+            json.decodeFromJsonElement<ChapterOrigin>(memo.getValue(KEY)).takeIf {
+                it.chapterUrl.isNotBlank() && it.mangaUrl.isNotBlank() && it.rank >= 0
+            }
+        }.getOrNull()
+
+        fun storedUrl(sourceId: Long, chapterUrl: String): String {
+            require(chapterUrl.isNotBlank())
+            val encoded = Base64.getUrlEncoder().withoutPadding().encodeToString(chapterUrl.toByteArray(Charsets.UTF_8))
+            return "$URL_PREFIX$sourceId/$encoded"
+        }
+
+        fun isRouted(url: String?): Boolean = url?.startsWith(URL_PREFIX) == true
+    }
+}
diff --git a/domain/src/main/java/tachiyomi/domain/chapter/model/ChapterVersions.kt b/domain/src/main/java/tachiyomi/domain/chapter/model/ChapterVersions.kt
new file mode 100644
index 0000000..437a14e
--- /dev/null
+++ b/domain/src/main/java/tachiyomi/domain/chapter/model/ChapterVersions.kt
@@ -0,0 +1,153 @@
+package tachiyomi.domain.chapter.model
+
+import java.math.BigDecimal
+import java.text.Normalizer
+import java.util.Locale
+
+/** Identity is independent of edition labels; unknown entries never share a numeric sentinel. */
+object ChapterVersions {
+    private val number =
+        Regex("(?:^|\\b)(?:chapter|chap|ch|capitulo|cap|episode|episodio|ep)[ ._:#-]*(\\d+(?:[.,]\\d+)?)\\b")
+    private val bareNumber = Regex("^\\s*(\\d+(?:[.,]\\d+)?)(?:\\s|$|[():-])")
+    private val season = Regex("\\b(?:season|temporada|s)[ ._:#-]*(\\d+)\\b")
+    private val volume = Regex("\\b(?:volume|vol|v)[ ._:#-]*(\\d+)\\b")
+    private val part = Regex("\\b(?:part|parte)[ ._:#-]*([0-9]+|[a-z])\\b")
+    private val special =
+        Regex(
+            "\\b(prologue|prologo|epilogue|epilogo|extra|omake|special|especial|side story|sidestory|notice|announcement|aviso|author note)\\b",
+        )
+    private val editionTag =
+        Regex(
+            "(?i)\\s*(?:\\((?:unofficial|official|oficial|nao oficial)\\)|\\[(?:unofficial|official|oficial|nao oficial)\\])\\s*$",
+        )
+    private val bareEdition = Regex("(?i)\\s*(?:[-–—|]\\s*)?\\b(?:unofficial|official|oficial)\\s*$")
+
+    data class Key(
+        val number: String?,
+        val season: String?,
+        val volume: String?,
+        val part: String?,
+        val special: String?,
+        val unknown: String? = null,
+    ) {
+        fun portable(): String = listOf(number, season, volume, part, special, unknown).joinToString("|") {
+            it.orEmpty()
+        }
+    }
+
+    data class Group(val key: Key, val versions: List<Chapter>) {
+        val read: Boolean get() = versions.any { it.read }
+        val bookmarked: Boolean get() = versions.any { it.bookmark }
+
+        fun choose(
+            currentId: Long? = null,
+            downloadedIds: Set<Long> = emptySet(),
+            preferredGroup: String? = null,
+        ): Chapter = versions.sortedWith(
+            compareByDescending<Chapter> { it.id == currentId }
+                .thenByDescending { !preferredGroup.isNullOrBlank() && it.scanlator == preferredGroup }
+                .thenByDescending { it.lastPageRead > 0 && !it.read }
+                .thenByDescending { it.id in downloadedIds }
+                .thenByDescending { ChapterOrigin.from(it.memo)?.available != false }
+                .thenBy { ChapterOrigin.from(it.memo)?.rank ?: 0 }
+                .thenBy { editionRank(it) }
+                .thenBy { it.sourceOrder }
+                .thenBy { it.url }
+                .thenBy { it.id },
+        ).first()
+    }
+
+    fun key(chapter: Chapter): Key {
+        val title = normalize(chapter.name)
+        val labelNumber = number.find(title)?.groupValues?.get(1)
+            ?: bareNumber.find(title)?.groupValues?.get(1)
+        val recognized = chapter.chapterNumber.takeIf { it.isFinite() && it >= 0 }
+        val normalizedNumber = labelNumber?.let(::decimal) ?: recognized?.let { decimal(it.toString()) }
+        if (normalizedNumber == null) {
+            return Key(null, null, null, null, null, chapter.url.ifBlank { "unknown:${chapter.id}" })
+        }
+        val specialKind = special.find(title)?.value
+        val specialIdentity = specialKind?.let {
+            normalize(editionTag.replace(chapter.name, ""))
+                .replace(number, " ")
+                .replace(Regex("\\b\\d+(?:[.,]\\d+)?\\b"), " ")
+                .replace(Regex("\\s+"), " ").trim()
+        }
+        return Key(
+            normalizedNumber,
+            season.find(title)?.groupValues?.get(1),
+            volume.find(title)?.groupValues?.get(1),
+            part.find(title)?.groupValues?.get(1),
+            specialIdentity,
+        )
+    }
+
+    fun groups(chapters: List<Chapter>): List<Group> = chapters
+        .groupBy(::key).map { (key, versions) -> Group(key, versions) }
+
+    data class Selection(val group: Group, val chapter: Chapter)
+
+    fun sequence(
+        chapters: List<Chapter>,
+        rootSourceId: Long,
+        pinnedSourceId: Long? = null,
+        currentId: Long? = null,
+        downloadedIds: Set<Long> = emptySet(),
+    ): List<Selection> = groups(chapters).mapNotNull { group ->
+        val eligible = group.versions.filter { chapter ->
+            chapter.id == currentId || pinnedSourceId == null ||
+                (ChapterOrigin.from(chapter.memo)?.sourceId ?: rootSourceId) == pinnedSourceId
+        }
+        if (eligible.isEmpty()) {
+            null
+        } else {
+            Selection(
+                group,
+                group.copy(versions = eligible).choose(currentId, downloadedIds),
+            )
+        }
+    }
+
+    fun select(
+        chapters: List<Chapter>,
+        currentId: Long? = null,
+        downloadedIds: Set<Long> = emptySet(),
+    ): List<Chapter> =
+        groups(chapters).map { it.choose(currentId, downloadedIds) }
+
+    fun displayName(chapter: Chapter): String {
+        val bracketless = editionTag.replace(chapter.name, "").trim()
+        return if (number.containsMatchIn(normalize(bracketless)) ||
+            bareNumber.containsMatchIn(normalize(bracketless))
+        ) {
+            bareEdition.replace(bracketless, "").trim().trimEnd('-', '–', '—', '|').trim()
+        } else {
+            bracketless
+        }
+    }
+
+    fun normalize(value: String): String = Normalizer.normalize(value, Normalizer.Form.NFKD)
+        .lowercase(Locale.ROOT).replace(Regex("\\p{M}+"), "")
+        .replace(Regex("\\s+"), " ").trim()
+
+    private fun decimal(value: String): String? = runCatching {
+        BigDecimal(value.replace(',', '.')).stripTrailingZeros().let {
+            if (it.signum() ==
+                0
+            ) {
+                "0"
+            } else {
+                it.toPlainString()
+            }
+        }
+    }.getOrNull()
+
+    private fun editionRank(chapter: Chapter): Int {
+        val name = normalize(chapter.scanlator.orEmpty() + " " + chapter.name)
+        return when {
+            Regex("\\b(?:unofficial|nao oficial|fan translation)\\b").containsMatchIn(name) -> 2
+            Regex("\\b(?:official|oficial)\\b").containsMatchIn(name) -> 0
+            else -> 1
+        }
+    }
+}
