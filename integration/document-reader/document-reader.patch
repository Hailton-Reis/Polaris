+package eu.kanade.tachiyomi.data.track
+
+import io.mockk.every
+import io.mockk.mockk
+import org.junit.jupiter.api.Assertions.*
+import org.junit.jupiter.api.Test
+import tachiyomi.core.common.preference.InMemoryPreferenceStore
+import tachiyomi.core.common.preference.Preference
+import tachiyomi.core.common.preference.PreferenceStore
+
+class TrackerOAuthGateTest {
+    @Test
+    fun `unsolicited callbacks are rejected`() {
+        assertFalse(
+            TrackerOAuthGate(InMemoryPreferenceStore()).consume("mihon", "anilist-auth", "attacker")
+        )
+    }
+
+    @Test
+    fun `state is provider bound and accepted only once`() {
+        val gate = TrackerOAuthGate(InMemoryPreferenceStore()) { 1000 }
+        gate.begin("anilist-auth", "nonce")
+        assertFalse(gate.consume("mihon", "bangumi-auth", "nonce"))
+        assertFalse(gate.consume("mihon", "anilist-auth", "wrong"))
+        assertFalse(gate.consume("https", "anilist-auth", "nonce"))
+        assertTrue(gate.consume("mihon", "anilist-auth", "nonce"))
+        assertFalse(gate.consume("mihon", "anilist-auth", "nonce"))
+    }
+
+    @Test
+    fun `expired callbacks and clock rollback require a new login`() {
+        var now = 1000L
+        val gate = TrackerOAuthGate(InMemoryPreferenceStore()) { now }
+        gate.begin("myanimelist-auth", "nonce")
+        now = 601001L
+        assertFalse(gate.consume("mihon", "myanimelist-auth", "nonce"))
+        now = 999L
+        assertFalse(gate.consume("mihon", "myanimelist-auth", "nonce"))
+    }
+
+    @Test
+    fun `pending login survives recreation but is excluded from backups`() {
+        // The preview InMemoryPreferenceStore returns a fresh preference on each lookup.
+        // Share one preference here to model Android's persisted store across gate recreation.
+        val key = Preference.appStateKey("polaris_tracker_oauth_pending")
+        val pending = InMemoryPreferenceStore.InMemoryPreference(key, null, "")
+        val store = mockk<PreferenceStore>()
+        every { store.getString(key, any()) } returns pending
+        every { store.getAll() } answers { mapOf(key to pending.get()) }
+        TrackerOAuthGate(store) { 10 }.begin("mangabaka-auth", "server-state")
+        assertEquals(setOf(key), store.getAll().keys)
+        assertTrue(store.getAll().keys.all { Preference.isAppState(it) })
+        assertTrue(
+            TrackerOAuthGate(store) { 20 }.consume("mihon", "mangabaka-auth", "server-state")
+        )
+    }
+
+    @Test
+    fun `custom Hikka reference callbacks still require an explicit active flow`() {
+        val store = InMemoryPreferenceStore()
+        assertFalse(TrackerOAuthGate(store) { 5 }.consume("mihon", "hikka-auth", null))
+        val gate = TrackerOAuthGate(store) { 5 }
+        gate.begin("hikka-auth", null)
+        assertTrue(gate.consume("mihon", "hikka-auth", null))
+        assertFalse(gate.consume("mihon", "hikka-auth", null))
+    }
+}
