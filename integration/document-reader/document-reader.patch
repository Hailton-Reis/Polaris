@@ -0,0 +1,102 @@
+package eu.kanade.tachiyomi.polaris
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import eu.kanade.tachiyomi.ui.reader.setting.ReaderPreferences
+import eu.kanade.translation.diagnostics.ReaderCaptureSession
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+import uy.kohesive.injekt.Injekt
+import uy.kohesive.injekt.api.get
+import java.io.File
+import java.security.MessageDigest
+
+/** Debug builds only; Android's DUMP permission restricts this receiver to shell/privileged callers. */
+class TranslationCaptureReceiver : BroadcastReceiver() {
+    override fun onReceive(context: Context, intent: Intent) {
+        val pending = goAsync()
+        CoroutineScope(Dispatchers.Main).launch {
+            try {
+                val result = when (intent.getStringExtra("operation")) {
+                    "status" -> ReaderCaptureSession.snapshot()?.metadata
+                        ?: error("Open a chapter in the Polaris reader")
+                    "visibility" -> {
+                        require(intent.hasExtra("visible"))
+                        Injekt.get<ReaderPreferences>().showTranslations.set(intent.getBooleanExtra("visible", true))
+                        "{\"ok\":true}"
+                    }
+                    "clear" -> {
+                        val directory = directory(context, intent)
+                        withContext(Dispatchers.IO) { directory.deleteRecursively() }
+                        "{\"ok\":true}"
+                    }
+                    "export" -> {
+                        val snapshot = ReaderCaptureSession.snapshot() ?: error("Reader is not active")
+                        val directory = directory(context, intent)
+                        val result = withContext(Dispatchers.IO) {
+                            check(!directory.exists()) { "Capture token already exists" }
+                            check(directory.mkdirs())
+                            try {
+                                check(snapshot.record.toByteArray().size <= 512 * 1024) { "Page metadata is too large" }
+                                File(directory, "record.json").writeText(snapshot.record)
+                                val factory = snapshot.openSource ?: error("Wait for the original page to load")
+                                val source = File(directory, "source.bin")
+                                val digest = MessageDigest.getInstance("SHA-256")
+                                var bytes = 0L
+                                factory().use { input ->
+                                    source.outputStream().use { output ->
+                                        val buffer = ByteArray(32 * 1024)
+                                        while (true) {
+                                            val count = input.read(buffer)
+                                            if (count < 0) break
+                                            bytes += count
+                                            check(bytes <= 32L * 1024 * 1024) {
+                                                "Original page exceeds 32 MiB capture limit"
+                                            }
+                                            digest.update(buffer, 0, count)
+                                            output.write(buffer, 0, count)
+                                        }
+                                    }
+                                }
+                                check(bytes > 0)
+                                buildJsonObject {
+                                    put("chapterId", snapshot.chapterId)
+                                    put("pageIndex", snapshot.pageIndex)
+                                    put("sourceBytes", bytes)
+                                    put("sourceSha256", digest.digest().joinToString("") { "%02x".format(it) })
+                                    put("relativeDirectory", "cache/translation-capture/${directory.name}")
+                                    put("status", Json.parseToJsonElement(snapshot.metadata))
+                                }.toString()
+                            } catch (error: Exception) {
+                                directory.deleteRecursively()
+                                throw error
+                            }
+                        }
+                        result
+                    }
+                    else -> error("Unknown capture operation")
+                }
+                pending.resultCode = 0
+                pending.resultData = result
+            } catch (_: Exception) {
+                pending.resultCode = 1
+                pending.resultData =
+                    "{\"error\":\"Capture unavailable; open a loaded chapter in the diagnostic build\"}"
+            } finally {
+                pending.finish()
+            }
+        }
+    }
+
+    private fun directory(context: Context, intent: Intent): File {
+        val token = intent.getStringExtra("request_token").orEmpty()
+        require(token.matches(Regex("[a-f0-9]{32}")))
+        return File(context.cacheDir, "translation-capture/$token")
+    }
+}
