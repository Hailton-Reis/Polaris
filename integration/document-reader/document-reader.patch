+package eu.kanade.tachiyomi.data.backup.create
+
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+import java.util.UUID
+
+internal object BackupRetention {
+    data class Entry(val id: String, val name: String, val verified: Boolean)
+
+    fun filename(applicationId: String, now: Date = Date()): String {
+        val date = SimpleDateFormat("yyyy-MM-dd_HH-mm-ss-SSS", Locale.ENGLISH).format(now)
+        return "${applicationId}_${date}_${UUID.randomUUID().toString().replace("-", "")}.tachibk"
+    }
+
+    fun isManaged(applicationId: String, name: String): Boolean = Regex(
+        "${Regex.escape(applicationId)}_\\d{4}-\\d{2}-\\d{2}_\\d{2}-\\d{2}" +
+            "(?:-\\d{2}-\\d{3}_[a-f0-9]{32})?\\.tachibk",
+    ).matches(name)
+
+    /** Incomplete/unreadable copies never displace a known valid copy in the retention count. */
+    fun deletions(applicationId: String, currentId: String, entries: List<Entry>, maximum: Int = 4): List<String> {
+        require(maximum > 0)
+        require(entries.any { it.id == currentId && it.verified && isManaged(applicationId, it.name) })
+        return entries.distinctBy { it.id }
+            .filter { it.id != currentId && it.verified && isManaged(applicationId, it.name) }
+            .sortedByDescending { it.name }
+            .drop(maximum - 1)
+            .map { it.id }
+    }
+}
