+package eu.kanade.tachiyomi.extension.preparation
+
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.awaitCancellation
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.test.advanceTimeBy
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.runCurrent
+import kotlinx.coroutines.test.runTest
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Assertions.fail
+import org.junit.jupiter.api.Test
+
+class ExtensionPreparationQueueTest {
+    @Test
+    fun `completion is emitted once per explicit batch and includes trust failures`() = runTest {
+        val completed = mutableListOf<PreparationBatch>()
+        val queue =
+            ExtensionPreparationQueue(
+                this,
+                { true },
+                { ext, _ ->
+                    if (ext.pkgName == "ready") PreparationStatus.READY
+                    else PreparationStatus.NEEDS_TRUST
+                },
+                onComplete = { completed += it },
+            )
+        runCurrent()
+        assertTrue(completed.isEmpty())
+        assertFalse(queue.start(listOf(extension("ready")), false))
+        assertTrue(completed.isEmpty())
+        assertTrue(queue.start(listOf(extension("ready"), extension("blocked")), true))
+        advanceUntilIdle()
+        assertEquals(1, completed.size)
+        assertFalse(completed.single().running)
+        assertEquals(
+            listOf(PreparationStatus.READY, PreparationStatus.NEEDS_TRUST),
+            completed.single().entries.map { it.status },
+        )
+    }
+
+    @Test
+    fun `opening or restoring data never starts downloads and consent is mandatory`() = runTest {
+        var calls = 0
+        val queue =
+            ExtensionPreparationQueue(
+                this,
+                { true },
+                { _, _ ->
+                    calls++
+                    PreparationStatus.READY
+                },
+            )
+        runCurrent()
+        assertFalse(queue.start(listOf(extension()), consent = false))
+        assertEquals(0, calls)
+        assertFalse(queue.state.value.running)
+        assertTrue(queue.state.value.entries.isEmpty())
+    }
+
+    @Test
+    fun `at most two downloads run and each package is prepared once`() = runTest {
+        val gate = CompletableDeferred<Unit>()
+        var active = 0
+        var maximum = 0
+        val calls = mutableListOf<String>()
+        val queue =
+            ExtensionPreparationQueue(
+                this,
+                { true },
+                { ext, progress ->
+                    calls += ext.pkgName
+                    active++
+                    maximum = maxOf(maximum, active)
+                    progress(PreparationStatus.DOWNLOADING)
+                    gate.await()
+                    active--
+                    PreparationStatus.READY
+                },
+            )
+        assertTrue(queue.start((1..15).map { extension("pkg$it") }, true))
+        runCurrent()
+        assertEquals(2, calls.size)
+        assertFalse(queue.start(listOf(extension("replacement")), true))
+        gate.complete(Unit)
+        advanceUntilIdle()
+        assertEquals(2, maximum)
+        assertEquals(15, calls.distinct().size)
+        assertTrue(queue.state.value.entries.all { it.status == PreparationStatus.READY })
+        assertFalse(queue.state.value.running)
+    }
+
+    @Test
+    fun `cancelling before dispatch still finishes the queue`() = runTest {
+        val queue = ExtensionPreparationQueue(this, { true }, { _, _ -> fail("must not install") })
+        queue.start(listOf(extension()), true)
+        queue.cancel()
+        runCurrent()
+        assertFalse(queue.state.value.running)
+        assertEquals(PreparationStatus.CANCELLED, queue.state.value.entries.single().status)
+        queue.clear()
+        assertTrue(queue.state.value.entries.isEmpty())
+    }
+
+    @Test
+    fun `cancellation preserves completed items and does not start queued ones`() = runTest {
+        val calls = mutableListOf<String>()
+        val queue =
+            ExtensionPreparationQueue(
+                this,
+                { true },
+                { ext, _ ->
+                    calls += ext.pkgName
+                    if (ext.pkgName == "ready") PreparationStatus.READY else awaitCancellation()
+                },
+            )
+        queue.start(
+            listOf(extension("ready"), extension("slow1"), extension("slow2"), extension("queued")),
+            true,
+        )
+        runCurrent()
+        queue.cancel()
+        advanceUntilIdle()
+        assertEquals(PreparationStatus.READY, queue.state.value.entries.first().status)
+        assertTrue(
+            queue.state.value.entries.drop(1).all { it.status == PreparationStatus.CANCELLED }
+        )
+        assertFalse("queued" in calls)
+    }
+
+    @Test
+    fun `retry only repeats failed items and never grants trust`() = runTest {
+        val calls = mutableListOf<String>()
+        var failFirst = true
+        val queue =
+            ExtensionPreparationQueue(
+                this,
+                { true },
+                { ext, _ ->
+                    calls += ext.pkgName
+                    when (ext.pkgName) {
+                        "trust" -> PreparationStatus.NEEDS_TRUST
+                        "fail" ->
+                            if (failFirst) PreparationStatus.FAILED else PreparationStatus.READY
+                        else -> PreparationStatus.READY
+                    }
+                },
+            )
+        queue.start(listOf(extension("ok"), extension("trust"), extension("fail")), true)
+        advanceUntilIdle()
+        assertFalse(queue.retryFailures(false))
+        failFirst = false
+        assertTrue(queue.retryFailures(true))
+        advanceUntilIdle()
+        assertEquals(listOf("fail", "fail"), calls.filter { it == "fail" })
+        assertEquals(1, calls.count { it == "ok" })
+        assertEquals(1, calls.count { it == "trust" })
+        assertEquals(PreparationStatus.NEEDS_TRUST, queue.state.value.entries[1].status)
+    }
+
+    @Test
+    fun `repository changes are checked again before queued work and retries`() = runTest {
+        var authorized = true
+        val gate = CompletableDeferred<Unit>()
+        val calls = mutableListOf<String>()
+        val queue =
+            ExtensionPreparationQueue(
+                this,
+                { authorized },
+                { ext, _ ->
+                    calls += ext.pkgName
+                    gate.await()
+                    PreparationStatus.READY
+                },
+            )
+        queue.start((1..3).map { extension("pkg$it") }, true)
+        runCurrent()
+        authorized = false
+        gate.complete(Unit)
+        advanceUntilIdle()
+        assertEquals(2, calls.size)
+        assertEquals(PreparationStatus.FAILED, queue.state.value.entries.last().status)
+        queue.retryFailures(true)
+        advanceUntilIdle()
+        assertEquals(2, calls.size)
+    }
+
+    @Test
+    fun `a timed out item does not prevent other items from finishing`() = runTest {
+        val queue =
+            ExtensionPreparationQueue(
+                this,
+                { true },
+                { ext, _ ->
+                    if (ext.pkgName == "slow") delay(1000)
+                    PreparationStatus.READY
+                },
+                timeoutMillis = 100,
+            )
+        queue.start(listOf(extension("slow"), extension("ok")), true)
+        advanceTimeBy(101)
+        runCurrent()
+        assertEquals(
+            listOf(PreparationStatus.FAILED, PreparationStatus.READY),
+            queue.state.value.entries.map { it.status },
+        )
+        assertFalse(queue.state.value.running)
+    }
+
+    @Test
+    fun `duplicate packages invalid identities and insecure downloads are rejected before starting`() =
+        runTest {
+            val queue =
+                ExtensionPreparationQueue(this, { true }, { _, _ -> fail("must not install") })
+            assertFalse(queue.start(listOf(extension(), extension()), true))
+            assertFalse(queue.start(listOf(extension(repo = store(key = "NO_SIGNING_KEY"))), true))
+            assertFalse(
+                queue.start(listOf(extension().copy(apkUrl = "http://example.org/file.apk")), true)
+            )
+            assertTrue(queue.state.value.entries.isEmpty())
+        }
+
+    @Test
+    fun `one exception fails only its item and a new batch starts cleanly`() = runTest {
+        val queue =
+            ExtensionPreparationQueue(
+                this,
+                { true },
+                { ext, _ ->
+                    if (ext.pkgName == "bad") error("unavailable") else PreparationStatus.READY
+                },
+            )
+        queue.start(listOf(extension("bad"), extension("ok")), true)
+        advanceUntilIdle()
+        assertEquals(
+            listOf(PreparationStatus.FAILED, PreparationStatus.READY),
+            queue.state.value.entries.map { it.status },
+        )
+        assertTrue(queue.start(listOf(extension("new")), true))
+        advanceUntilIdle()
+        assertEquals(listOf("new"), queue.state.value.entries.map { it.extension.pkgName })
+    }
+}
