+        alternatives: suspend () -> List<T>,
+        fetch: suspend (T) -> Unit,
+        discard: (T) -> Unit,
+    ): T {
+        val firstError =
+            try {
+                fetch(requested)
+                return requested
+            } catch (cancelled: CancellationException) {
+                throw cancelled
+            } catch (error: Exception) {
+                discard(requested)
+                error
+            }
+        for (candidate in alternatives().take(3)) {
+            try {
+                fetch(candidate)
+                return candidate
+            } catch (cancelled: CancellationException) {
+                discard(candidate)
+                throw cancelled
+            } catch (_: Exception) {
+                discard(candidate)
+            }
+        }
+        throw firstError
+    }
+}
