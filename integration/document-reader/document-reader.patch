@@ -0,0 +1,64 @@
+package eu.kanade.tachiyomi.source.selection
+
+import kotlinx.coroutines.CancellationException
+import tachiyomi.domain.chapter.model.Chapter
+import tachiyomi.domain.chapter.model.ChapterOrigin
+import tachiyomi.domain.chapter.model.ChapterVersions
+
+/** Retry only corroborated editions of the SAME logical chapter; never silently change a pin. */
+internal object ChapterLoadFallback {
+    fun candidates(
+        requested: Chapter,
+        versions: List<Chapter>,
+        rootSource: Long,
+        pinnedSource: Long?,
+        onlineSourceIds: Set<Long>,
+        downloadedIds: Set<Long>,
+        downloadedOnly: Boolean,
+    ): List<Chapter> =
+        versions
+            .filter {
+                val sourceId = ChapterOrigin.from(it.memo)?.sourceId ?: rootSource
+                it.id != requested.id &&
+                    ChapterVersions.key(it) == ChapterVersions.key(requested) &&
+                    (pinnedSource == null || sourceId == pinnedSource) &&
+                    (it.id in downloadedIds || (!downloadedOnly && sourceId in onlineSourceIds))
+            }
+            .sortedWith(
+                compareByDescending<Chapter> { it.id in downloadedIds }
+                    .thenByDescending { ChapterOrigin.from(it.memo)?.available != false }
+                    .thenBy { ChapterOrigin.from(it.memo)?.rank ?: 0 }
+            )
+            .distinctBy { it.id }
+            .take(3)
+
+    suspend fun <T> load(
+        requested: T,
+        alternatives: suspend () -> List<T>,
+        fetch: suspend (T) -> Unit,
+        discard: (T) -> Unit,
+    ): T {
+        val firstError =
+            try {
+                fetch(requested)
+                return requested
+            } catch (cancelled: CancellationException) {
+                throw cancelled
+            } catch (error: Exception) {
+                discard(requested)
+                error
+            }
+        for (candidate in alternatives().take(3)) {
+            try {
+                fetch(candidate)
+                return candidate
+            } catch (cancelled: CancellationException) {
+                discard(candidate)
+                throw cancelled
+            } catch (_: Exception) {
+                discard(candidate)
+            }
+        }
+        throw firstError
+    }
+}
diff --git a/app/src/main/java/eu/kanade/tachiyomi/source/selection/SourceMatching.kt b/app/src/main/java/eu/kanade/tachiyomi/source/selection/SourceMatching.kt
