+++ b/app/src/main/java/eu/kanade/tachiyomi/source/selection/SourceMatching.kt
@@ -0,0 +1,127 @@
+package eu.kanade.tachiyomi.source.selection
+
+import eu.kanade.tachiyomi.source.model.SManga
+import tachiyomi.domain.chapter.model.Chapter
+import tachiyomi.domain.chapter.model.ChapterVersions
+import tachiyomi.domain.manga.model.WorkIdentity
+
+/** Similarity alone cannot join a remake, novel or unrelated work to a library entry. */
+internal object SourceMatching {
+    fun title(value: String): String =
+        ChapterVersions.normalize(value)
+            .replace(
+                Regex(
+                    "\\s*[\\[(](?:unofficial|official|oficial|manhwa|manhua|manga|webtoon)[\\])]\\s*$"
+                ),
+                "",
+            )
+            .replace(Regex("[^\\p{L}\\p{N}]+"), " ")
+            .trim()
+
+    fun compatibleNumbering(
+        reference: List<Chapter>,
+        candidate: List<Chapter>,
+        corroboratedIdentity: Boolean = false,
+    ): Boolean {
+        val a =
+            reference.map(ChapterVersions::key).filter { it.number != null && it.special == null }
+        val b =
+            candidate.map(ChapterVersions::key).filter { it.number != null && it.special == null }
+        // A library-only backup has no chapter numbering or progress to remap. Work identity is
+        // still independently corroborated by title and creator before a candidate reaches here.
+        if (reference.isEmpty()) return b.isNotEmpty()
+        if (a.isEmpty() || b.isEmpty()) return false
+        // Missing season/volume/part information cannot establish equivalent numbering.
+        fun schemes(keys: List<ChapterVersions.Key>) =
+            keys.map { Triple(it.season != null, it.volume != null, it.part != null) }.toSet()
+        if (schemes(a) != schemes(b)) return false
+        if (a.toSet().intersect(b.toSet()).isNotEmpty()) return true
+        if (!corroboratedIdentity) return false
+        val left =
+            a.mapNotNull {
+                it.number?.toBigDecimalOrNull()?.takeIf { n -> n.stripTrailingZeros().scale() <= 0 }
+            }
+        val right =
+            b.mapNotNull {
+                it.number?.toBigDecimalOrNull()?.takeIf { n -> n.stripTrailingZeros().scale() <= 0 }
+            }
+        if (left.isEmpty() || right.isEmpty()) return false
+        return left.max() + java.math.BigDecimal.ONE == right.min() ||
+            right.max() + java.math.BigDecimal.ONE == left.min()
+    }
+
+    internal fun people(vararg values: String?): Set<String> =
+        values
+            .filterNotNull()
+            .flatMap { it.split(Regex("[,;/&]|\\band\\b|\\be\\b")) }
+            .flatMap { person ->
+                listOf(person.replace(Regex("\\([^)]*\\)"), " ")) +
+                    Regex("\\(([^)]*)\\)").findAll(person).map { it.groupValues[1] }.toList()
+            }
+            .map(::title)
+            .filter {
+                it.length >= 2 &&
+                    it !in
+                        setOf(
+                            "unknown",
+                            "desconhecido",
+                            "not available",
+                            "n a",
+                            "n d",
+                            "未知",
+                            "暂无",
+                            "story",
+                            "art",
+                            "author",
+                            "artist",
+                            "adaptation",
+                            "roteiro",
+                            "ilustrador",
+                            "various",
+                            "varios",
+                        )
+            }
+            .toSet()
+
+    fun titleMatches(
+        reference: String,
+        candidate: String,
+        identity: WorkIdentity? = null,
+    ): Boolean {
+        val names =
+            (listOf(reference) + identity?.titles.orEmpty()).map(::title).filter { it.isNotBlank() }
+        val other = title(candidate)
+        if (other in names) return true
+        // Small spelling variation only. Translations require a corroborated catalogue alias.
+        return names.any { known ->
+            known.length >= 10 &&
+                other.length >= 10 &&
+                known.split(' ').size == other.split(' ').size &&
+                known.split(' ').zip(other.split(' ')).all { (a, b) ->
+                    a == b || (a.length >= 7 && b.length >= 7 && editDistance(a, b) <= 1)
+                }
+        }
+    }
+
+    private fun editDistance(a: String, b: String): Int {
+        if (kotlin.math.abs(a.length - b.length) > 1) return 2
+        var previous = IntArray(b.length + 1) { it }
+        for (i in a.indices) {
+            val next = IntArray(b.length + 1)
+            next[0] = i + 1
+            for (j in b.indices) next[j + 1] =
+                minOf(next[j] + 1, previous[j + 1] + 1, previous[j] + if (a[i] == b[j]) 0 else 1)
+            previous = next
+        }
+        return previous.last()
+    }
+
+    fun sameWork(reference: SManga, candidate: SManga, identity: WorkIdentity? = null): Boolean {
+        if (!titleMatches(reference.title, candidate.title, identity)) return false
+        val creators =
+            people(reference.author, reference.artist) +
+                identity?.creators.orEmpty().flatMap { people(it) }
+        val otherCreators = people(candidate.author, candidate.artist)
+        return creators.isNotEmpty() && creators.intersect(otherCreators).isNotEmpty()
+    }
+}
