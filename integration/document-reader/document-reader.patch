+class TextDocumentReaderActivity : ComponentActivity() {
+    private var document: TextDocument? = null
+    private var loaded by mutableStateOf<Loaded?>(null)
+    private var failed by mutableStateOf(false)
+    private var checkpoint: ChapterUpdate? = null
+    private val progressMutex = Mutex()
+
+    private data class Loaded(val manga: Manga, val chapter: Chapter, val document: TextDocument)
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        enableEdgeToEdge()
+        setContent {
+            TachiyomiTheme {
+                val value = loaded
+                if (value == null) {
+                    Scaffold { padding ->
+                        Box(Modifier.fillMaxSize().padding(padding), contentAlignment = Alignment.Center) {
+                            if (failed) {
+                                Column(horizontalAlignment = Alignment.CenterHorizontally) {
+                                    Text(stringResource(ATMR.strings.document_open_error))
+                                    TextButton(onClick = ::finish) { Text(stringResource(ATMR.strings.document_back)) }
+                                }
+                            } else {
+                                CircularProgressIndicator()
+                            }
+                        }
+                    }
+                } else {
+                    Reader(value)
+                }
+            }
+        }
+        lifecycleScope.launch {
+            var preparing: TextDocument? = null
+            try {
+                val result = withContext(Dispatchers.IO) {
+                    val manga = checkNotNull(Injekt.get<GetManga>().await(intent.getLongExtra("manga_id", -1)))
+                    val chapter = checkNotNull(Injekt.get<GetChapter>().await(intent.getLongExtra("chapter_id", -1)))
+                    require(chapter.mangaId == manga.id)
+                    val source =
+                        Injekt.get<SourceManager>().get(manga.source) as? LocalSource
+                            ?: error("Local document required")
+                    val format = source.getFormat(SChapter.create().apply { url = chapter.url })
+                    val file = when (format) {
+                        is tachiyomi.source.local.io.Format.Epub -> format.file
+                        is tachiyomi.source.local.io.Format.Text -> format.file
+                        else -> error("Unsupported text document")
+                    }
+                    val type = checkNotNull(DocumentFormat.fromName(file.name.orEmpty()))
+                    val lease = DocumentFiles.materialize(this@TextDocumentReaderActivity, file)
+                    val reader = try {
+                        TextDocument(lease.file, type, lease::close)
+                    } catch (
+                        error: Throwable,
+                    ) {
+                        lease.close()
+                        throw error
+                    }
+                    preparing = reader
+                    Loaded(manga, chapter, reader)
+                }
+                document = result.document
+                loaded = result
+                preparing = null
+            } catch (error: CancellationException) {
+                throw error
+            } catch (_: Exception) {
+                failed = true
+            } finally {
+                preparing?.close()
+            }
+        }
+    }
+
+    @Composable
+    private fun Reader(value: Loaded) {
+        val reader = value.document
+        val scope = rememberCoroutineScope()
+        val prefs = remember { getSharedPreferences("document_reader", Context.MODE_PRIVATE) }
+        val initial = remember { DocumentReadingPosition.from(value.chapter.memo) }
+        var section by remember { mutableStateOf(initial.section.coerceIn(reader.sections.indices)) }
+        var content by remember { mutableStateOf<List<DocumentBlock>>(emptyList()) }
+        var translated by remember { mutableStateOf<List<DocumentBlock>?>(null) }
+        var showTranslation by remember { mutableStateOf(false) }
+        var working by remember { mutableStateOf(false) }
+        var error by remember { mutableStateOf(false) }
+        var showContents by remember { mutableStateOf(false) }
+        var showFont by remember { mutableStateOf(false) }
+        var fontSize by remember { mutableStateOf(prefs.getFloat("font_size", 18f).coerceIn(12f, 32f)) }
+        var completed by remember { mutableStateOf(value.chapter.read) }
+        val list = rememberLazyListState()
+        val translationPreferences = remember { Injekt.get<TranslationPreferences>() }
+        val translator = remember { DocumentTextTranslator(this, translationPreferences, value.manga.title) }
+        val update = remember { Injekt.get<UpdateChapter>() }
+        val displayed = if (showTranslation) translated ?: content else content
+
+        LaunchedEffect(section) {
+            error = false
+            content = emptyList()
+            translated = null
+            showTranslation = false
+            try {
+                content = withContext(Dispatchers.IO) { reader.readSection(section) }
+                val saved = if (section == initial.section) initial else DocumentReadingPosition(section)
+                list.scrollToItem(saved.block.coerceIn(0, (content.size - 1).coerceAtLeast(0)), saved.offset)
+                Injekt.get<UpsertHistory>().await(HistoryUpdate(value.chapter.id, Date(), 0))
+            } catch (cancelled: CancellationException) {
+                throw cancelled
+            } catch (_: Exception) {
+                error = true
+            }
+        }
+
+        val boundSection = section
+        val boundContent = content
+        LaunchedEffect(boundSection, boundContent) {
+            if (content.isEmpty()) return@LaunchedEffect
+            snapshotFlow {
+                DocumentReadingPosition(boundSection, list.firstVisibleItemIndex, list.firstVisibleItemScrollOffset)
+            }
+                .distinctUntilChanged().onEach { position ->
+                    checkpoint = ChapterUpdate(value.chapter.id, memo = position.merge(value.chapter.memo))
+                }.debounce(350).collect {
+                    withContext(Dispatchers.IO) {
+                        checkpoint?.let { persistCheckpoint(it) }
+                    }
+                }
+        }
+
+        DisposableEffect(boundSection, boundContent) {
+            onDispose {
+                if (boundContent.isNotEmpty()) {
+                    val position =
+                        DocumentReadingPosition(
+                            boundSection,
+                            list.firstVisibleItemIndex,
+                            list.firstVisibleItemScrollOffset,
+                        )
+                    checkpoint = ChapterUpdate(value.chapter.id, memo = position.merge(value.chapter.memo))
+                    saveCheckpoint()
+                }
+            }
+        }
+
+        Scaffold(topBar = {
+            TopAppBar(title = { Text(value.manga.title, maxLines = 1) }, navigationIcon = {
+                IconButton(onClick = ::finish) {
+                    Icon(Icons.AutoMirrored.Outlined.ArrowBack, stringResource(ATMR.strings.document_back))
+                }
+            }, actions = {
+                IconButton(onClick = { showFont = true }) {
+                    Icon(Icons.Outlined.FormatSize, stringResource(ATMR.strings.document_font_size))
+                }
+            })
+        }) { padding ->
+            Column(Modifier.fillMaxSize().padding(padding)) {
+                Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
+                    TextButton(onClick = {
+                        showContents = true
+                    }) { Text(stringResource(ATMR.strings.document_contents)) }
+                    Text(
+                        stringResource(ATMR.strings.document_section, section + 1, reader.sections.size),
+                        Modifier.padding(12.dp),
+                    )
+                }
+                Row(
+                    Modifier.fillMaxWidth().padding(horizontal = 12.dp),
+                    horizontalArrangement = Arrangement.spacedBy(8.dp),
+                ) {
+                    OutlinedButton(onClick = { showTranslation = false }, enabled = !working) {
+                        Text(stringResource(ATMR.strings.document_original))
+                    }
+                    Button(onClick = {
+                        if (translated != null) {
+                            showTranslation = true
+                        } else {
+                            working = true
+                            val expectedSection = section
+                            scope.launch {
+                                try {
+                                    val result = translator.translate(content)
+                                    if (section == expectedSection) {
+                                        translated = result
+                                        showTranslation = true
+                                    }
+                                } catch (cancelled: CancellationException) {
+                                    throw cancelled
+                                } catch (_: Exception) {
+                                    error = true
+                                } finally {
+                                    working = false
+                                }
+                            }
+                        }
+                    }, enabled = !working && content.any { it is DocumentBlock.Text }) {
+                        Text(stringResource(ATMR.strings.document_translate))
+                    }
+                }
+                if (working) Text(stringResource(ATMR.strings.document_translating), Modifier.padding(12.dp))
+                if (error) {
+                    Text(
+                        stringResource(ATMR.strings.document_read_error),
+                        color = MaterialTheme.colorScheme.error,
+                        modifier = Modifier.padding(12.dp),
+                    )
+                }
+                LazyColumn(
+                    Modifier.weight(1f).fillMaxWidth(),
+                    state = list,
+                    verticalArrangement = Arrangement.spacedBy(12.dp),
+                ) {
+                    itemsIndexed(displayed) { _, block ->
+                        when (block) {
+                            is DocumentBlock.Text -> SelectionContainer {
+                                Text(
+                                    block.value,
+                                    Modifier.fillMaxWidth().padding(horizontal = 20.dp),
+                                    fontSize = (fontSize + if (block.heading) 3f else 0f).sp,
+                                    lineHeight = (fontSize * 1.6f).sp,
+                                    fontWeight = if (block.heading) FontWeight.SemiBold else FontWeight.Normal,
+                                )
+                            }
+                            is DocumentBlock.Image -> DocumentImage(reader, block)
+                        }
+                    }
+                }
+                HorizontalDivider()
+                Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
+                    TextButton(onClick = { section-- }, enabled = section > 0 && !working) {
+                        Text(stringResource(ATMR.strings.document_previous))
+                    }
+                    if (section < reader.sections.lastIndex) {
+                        TextButton(onClick = {
+                            section++
+                        }, enabled = !working) { Text(stringResource(ATMR.strings.document_next)) }
+                    } else {
+                        TextButton(onClick = {
+                            scope.launch {
+                                update.await(ChapterUpdate(value.chapter.id, read = true))
+                                completed = true
+                            }
+                        }, enabled = !completed && !working) {
+                            Text(
+                                stringResource(
+                                    if (completed) ATMR.strings.document_completed else ATMR.strings.document_complete,
+                                ),
+                            )
+                        }
+                    }
+                }
+            }
+        }
+        if (showContents) {
+            AlertDialog(
+                onDismissRequest = { showContents = false },
+                title = { Text(stringResource(ATMR.strings.document_contents)) },
+                text = {
+                    LazyColumn {
+                        itemsIndexed(reader.sections) { index, item ->
+                            TextButton(onClick = {
+                                section = index
+                                showContents = false
+                            }, enabled = !working) {
+                                Text("${index + 1}. ${item.title}")
+                            }
+                        }
+                    }
+                },
+                confirmButton = {
+                    TextButton(onClick = { showContents = false }) { Text(stringResource(ATMR.strings.document_back)) }
+                },
+            )
+        }
+        if (showFont) {
+            AlertDialog(
+                onDismissRequest = { showFont = false },
+                title = { Text(stringResource(ATMR.strings.document_font_size)) },
+                text = {
+                    Slider(
+                        value = fontSize,
+                        onValueChange = {
+                            fontSize = it
+                            prefs.edit().putFloat("font_size", it).apply()
+                        },
+                        valueRange =
+                        12f..32f,
+                    )
+                },
+                confirmButton = {
+                    TextButton(onClick = { showFont = false }) { Text(stringResource(ATMR.strings.document_back)) }
+                },
+            )
+        }
+    }
+
+    @Composable
+    private fun DocumentImage(reader: TextDocument, image: DocumentBlock.Image) {
+        val data by produceState<ByteArray?>(null, reader, image.path) {
+            value = withContext(Dispatchers.IO) { runCatching { reader.image(image.path) }.getOrNull() }
+        }
+        val context = LocalContext.current
+        data?.let { bytes ->
+            AsyncImage(
+                ImageRequest.Builder(context).data(bytes).size(1600).build(),
+                contentDescription = image.description,
+                modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp),
+            )
+        }
+    }
+
+    override fun onDestroy() {
+        super.onDestroy()
+        document?.close()
+        document = null
+    }
+
+    override fun onStop() {
+        saveCheckpoint()
+        super.onStop()
+    }
+
+    private fun saveCheckpoint() {
+        val value = checkpoint ?: return
+        lifecycleScope.launch(start = CoroutineStart.UNDISPATCHED) {
+            withContext(NonCancellable + Dispatchers.IO) { persistCheckpoint(value) }
+        }
+    }
+
+    private suspend fun persistCheckpoint(value: ChapterUpdate) = progressMutex.withLock {
+        if (checkpoint !== value) return@withLock
+        val current = Injekt.get<GetChapter>().await(value.id) ?: return@withLock
+        val position = DocumentReadingPosition.from(checkNotNull(value.memo))
+        Injekt.get<UpdateChapter>().await(value.copy(memo = position.merge(current.memo)))
+    }
+
+    companion object {
+        fun newIntent(
+            context: Context,
+            mangaId: Long,
+            chapterId: Long,
+        ) = Intent(context, TextDocumentReaderActivity::class.java)
+            .putExtra("manga_id", mangaId).putExtra("chapter_id", chapterId)
+    }
+}
