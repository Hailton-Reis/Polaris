--- /dev/null
+++ b/core/archive/src/main/kotlin/mihon/core/archive/DocumentCacheBudget.kt
@@ -0,0 +1,73 @@
+package mihon.core.archive
+
+import java.io.Closeable
+import java.io.File
+import java.nio.file.Files
+
+/** Only regenerable document caches. Imported originals and models are outside these directories. */
+object DocumentCacheBudget {
+    const val LIMIT_BYTES = 256L * 1024 * 1024
+    val directories = setOf("document-files", "pdf-pages", "document-translations")
+    private val pins = mutableMapOf<String, Int>()
+
+    class Lease internal constructor(val file: File, private val release: () -> Unit) : Closeable {
+        private var closed = false
+
+        @Synchronized override fun close() {
+            if (!closed) {
+                closed = true
+                release()
+            }
+        }
+    }
+
+    @Synchronized
+    fun acquire(root: File, target: File, prepare: () -> Unit): Lease {
+        require(
+            directories.any {
+                File(root, it).canonicalFile.toPath().let { base ->
+                    target.canonicalFile.toPath().startsWith(base)
+                }
+            },
+        )
+        prepare()
+        check(target.isFile)
+        target.setLastModified(System.currentTimeMillis())
+        val key = target.canonicalPath
+        pins[key] = (pins[key] ?: 0) + 1
+        trim(root)
+        return Lease(target) {
+            synchronized(this) {
+                val count = (pins[key] ?: 1) - 1
+                if (count <= 0) pins.remove(key) else pins[key] = count
+                trim(root)
+            }
+        }
+    }
+
+    @Synchronized
+    fun size(root: File): Long = files(root).sumOf { it.length() }
+
+    @Synchronized
+    fun trim(root: File, limit: Long = LIMIT_BYTES): Long {
+        require(limit >= 0)
+        val candidates = files(root).sortedBy { it.lastModified() }
+        var total = candidates.sumOf { it.length() }
+        var deleted = 0L
+        for (file in candidates) {
+            if (total <= limit) break
+            if (pins.containsKey(file.canonicalPath)) continue
+            val bytes = file.length()
+            if (file.delete()) {
+                total -= bytes
+                deleted += bytes
+            }
+        }
+        return deleted
+    }
+
+    private fun files(root: File): List<File> = directories.flatMap { name ->
+        File(root, name).walkTopDown().onEnter { !Files.isSymbolicLink(it.toPath()) }
+            .filter { it.isFile && !Files.isSymbolicLink(it.toPath()) }.toList()
+    }
+}
