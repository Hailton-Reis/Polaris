+package eu.kanade.tachiyomi.util.system
+
+import org.junit.jupiter.api.Assertions.*
+import org.junit.jupiter.api.Test
+
+class DeviceWorkloadPolicyTest {
+    @Test
+    fun `a 32 bit process is constrained even when Android does not mark the phone low RAM`() {
+        val policy = DeviceWorkloadPolicy.choose(false, false, 512)
+        assertEquals(1, policy.imageDecoders)
+        assertTrue(
+            policy.imageFetches <= 2 &&
+                policy.librarySources <= 2 &&
+                policy.imageCacheFraction <= 0.10
+        )
+    }
+
+    @Test
+    fun `low RAM or small process heap also limits a 64 bit device`() {
+        for (policy in
+            listOf(
+                DeviceWorkloadPolicy.choose(true, true, 512),
+                DeviceWorkloadPolicy.choose(true, false, 128),
+            )) {
+            assertEquals(1, policy.imageDecoders)
+            assertTrue(policy.imageCacheFraction <= 0.10)
+        }
+    }
+
+    @Test
+    fun `larger 64 bit devices keep concurrent image loading`() {
+        val normal = DeviceWorkloadPolicy.choose(true, false, 512)
+        val limited = DeviceWorkloadPolicy.choose(false, false, 512)
+        assertTrue(
+            normal.imageFetches > limited.imageFetches &&
+                normal.imageDecoders > limited.imageDecoders
+        )
+    }
+}
