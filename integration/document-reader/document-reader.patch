+package eu.kanade.tachiyomi.extension.preparation
+
+import app.cash.sqldelight.Query
+import app.cash.sqldelight.async.coroutines.awaitAsList
+import io.mockk.coEvery
+import io.mockk.coVerify
+import io.mockk.every
+import io.mockk.mockk
+import io.mockk.mockkStatic
+import io.mockk.unmockkStatic
+import kotlinx.coroutines.test.runTest
+import mihon.data.extension.repository.ExtensionStoreRepositoryImpl
+import mihon.data.extension.service.ExtensionStoreService
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import tachiyomi.data.Database
+import tachiyomi.data.Extension_store
+
+class RepositoryReviewTest {
+    @Test
+    fun `metadata changed after review is rejected without overwriting the stored repository`() =
+        runTest {
+            val service = mockk<ExtensionStoreService>()
+            val database = mockk<Database>(relaxed = true)
+            coEvery { service.fetch(store().indexUrl) } returns
+                Result.success(store(key = "b".repeat(64)))
+            assertTrue(
+                ExtensionStoreRepositoryImpl(service, database).insertVerified(store()).isFailure,
+            )
+            coVerify(exactly = 0) {
+                database.extension_storeQueries.upsert(
+                    any(),
+                    any(),
+                    any(),
+                    any(),
+                    any(),
+                    any(),
+                    any(),
+                    any(),
+                )
+            }
+        }
+
+    @Test
+    fun `reviewed metadata is inserted with its original certificate and identity`() = runTest {
+        val service = mockk<ExtensionStoreService>()
+        val database = mockk<Database>(relaxed = true)
+        coEvery { service.fetch(store().indexUrl) } returns Result.success(store())
+        assertTrue(
+            ExtensionStoreRepositoryImpl(service, database).insertVerified(store()).isSuccess,
+        )
+        coVerify(exactly = 1) {
+            database.extension_storeQueries.upsert(
+                store().indexUrl,
+                store().name,
+                store().badgeLabel,
+                store().signingKey,
+                store().contact.website,
+                null,
+                false,
+                null,
+            )
+        }
+    }
+
+    @Test
+    fun `network failures cannot register a repository`() = runTest {
+        val service = mockk<ExtensionStoreService>()
+        val database = mockk<Database>(relaxed = true)
+        coEvery { service.fetch(any()) } returns Result.failure(IllegalStateException("offline"))
+        assertFalse(
+            ExtensionStoreRepositoryImpl(service, database).insertVerified(store()).isSuccess,
+        )
+        coVerify(exactly = 0) {
+            database.extension_storeQueries.upsert(
+                any(),
+                any(),
+                any(),
+                any(),
+                any(),
+                any(),
+                any(),
+                any(),
+            )
+        }
+    }
+
+    @Test
+    fun `background refresh cannot silently replace a restored signing certificate`() = runTest {
+        mockkStatic("app.cash.sqldelight.async.coroutines.QueryExtensionsKt")
+        try {
+            val database = mockk<Database>(relaxed = true)
+            val queries = database.extension_storeQueries
+            val query = mockk<Query<Extension_store>>()
+            every { queries.getAll() } returns query
+            val original = store()
+            coEvery { query.awaitAsList() } returns
+                listOf(
+                    Extension_store(
+                        original.indexUrl,
+                        original.name,
+                        original.badgeLabel,
+                        original.signingKey,
+                        original.contact.website,
+                        null,
+                        false,
+                        null,
+                    ),
+                )
+            val service = mockk<ExtensionStoreService>()
+            coEvery { service.fetch(original.indexUrl) } returns
+                Result.success(original.copy(signingKey = "b".repeat(64)))
+            ExtensionStoreRepositoryImpl(service, database).refreshAll()
+            coVerify(exactly = 0) {
+                queries.upsert(any(), any(), any(), any(), any(), any(), any(), any())
+            }
+        } finally {
+            unmockkStatic("app.cash.sqldelight.async.coroutines.QueryExtensionsKt")
+        }
+    }
+}
