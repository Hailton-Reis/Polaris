@@ -0,0 +1,143 @@
+package eu.kanade.tachiyomi.data.backup
+
+import android.content.ContentResolver
+import android.content.Context
+import android.net.Uri
+import eu.kanade.tachiyomi.data.backup.models.Backup
+import eu.kanade.tachiyomi.data.backup.models.BooleanPreferenceValue
+import eu.kanade.tachiyomi.data.backup.models.FloatPreferenceValue
+import eu.kanade.tachiyomi.data.backup.models.IntPreferenceValue
+import eu.kanade.tachiyomi.data.backup.models.LongPreferenceValue
+import eu.kanade.tachiyomi.data.backup.models.StringPreferenceValue
+import eu.kanade.tachiyomi.data.backup.models.StringSetPreferenceValue
+import io.mockk.every
+import io.mockk.mockk
+import kotlinx.serialization.protobuf.ProtoBuf
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import java.io.ByteArrayInputStream
+import java.io.ByteArrayOutputStream
+import java.io.File
+import java.util.zip.GZIPOutputStream
+
+/** Real product decoder/serializers; synthetic archives emitted by separately compiled pinned upstream DTOs. */
+class BackupInteropTest {
+    private val codec = ProtoBuf
+
+    private fun imported(name: String, gzip: Boolean): Backup {
+        val extension = if (gzip) "tachibk" else "proto"
+        val bytes = checkNotNull(javaClass.getResourceAsStream("/backup-interop/$name.$extension")).use {
+            it.readBytes()
+        }
+        return decode(bytes)
+    }
+
+    private fun decode(bytes: ByteArray): Backup {
+        val context = mockk<Context>()
+        val resolver = mockk<ContentResolver>()
+        val uri = mockk<Uri>()
+        every { context.contentResolver } returns resolver
+        every { resolver.openInputStream(uri) } answers { ByteArrayInputStream(bytes) }
+        return BackupDecoder(context, codec).decode(uri)
+    }
+
+    private fun assertCommon(backup: Backup) {
+        val manga = backup.backupManga.single()
+        assertEquals(8787213233662904706L, manga.source)
+        assertEquals("/work", manga.url)
+        val mappedManga = manga.getMangaImpl()
+        assertEquals(8787213233662904706L, mappedManga.source)
+        assertEquals("/work", mappedManga.url)
+        assertTrue(mappedManga.favorite)
+        assertEquals("Obra de teste — ação", manga.title)
+        assertEquals("Artista", manga.artist)
+        assertEquals("Autor", manga.author)
+        assertEquals(listOf("Aventura"), manga.genre)
+        assertEquals(1700000000000L, manga.dateAdded)
+        assertTrue(manga.favorite)
+        assertEquals(13, manga.chapterFlags)
+        assertEquals(5, manga.viewer_flags)
+        assertEquals(listOf(7L), manga.categories)
+        val chapter = manga.chapters.single()
+        assertEquals("/work/ch-40", chapter.url)
+        assertEquals(40f, chapter.chapterNumber)
+        assertTrue(chapter.read)
+        assertTrue(chapter.bookmark)
+        assertEquals(17L, chapter.lastPageRead)
+        val mappedChapter = chapter.toChapterImpl()
+        assertEquals("/work/ch-40", mappedChapter.url)
+        assertEquals(17L, mappedChapter.lastPageRead.toLong())
+        assertTrue(mappedChapter.read)
+        assertTrue(mappedChapter.bookmark)
+        assertEquals(3L, chapter.sourceOrder)
+        assertEquals(12345L, manga.history.single().readDuration)
+        assertEquals(1700000000300L, manga.history.single().lastRead)
+        assertEquals(chapter.url, manga.history.single().url)
+        assertEquals(456L, manga.tracking.single().mediaId)
+        assertEquals(39.5f, manga.tracking.single().lastChapterRead)
+        assertEquals(7L, backup.backupCategories.single().order)
+        assertEquals("Favoritos", backup.backupCategories.single().name)
+        assertEquals(manga.source, backup.backupSources.single().sourceId)
+        assertEquals("Fonte ausente", backup.backupSources.single().name)
+        val preferences = backup.backupPreferences.associateBy { it.key }
+        assertEquals(42, (preferences.getValue("sample.int").value as IntPreferenceValue).value)
+        assertEquals(5000000000L, (preferences.getValue("sample.long").value as LongPreferenceValue).value)
+        assertEquals(1.25f, (preferences.getValue("sample.float").value as FloatPreferenceValue).value)
+        assertTrue((preferences.getValue("sample.bool").value as BooleanPreferenceValue).value)
+        assertEquals("ação", (preferences.getValue("sample.string").value as StringPreferenceValue).value)
+        assertEquals(setOf("pt", "en"), (preferences.getValue("sample.set").value as StringSetPreferenceValue).value)
+        val sourceSettings = backup.backupSourcePreferences.single()
+        assertEquals("source-${manga.source}", sourceSettings.sourceKey)
+        assertEquals("synthetic", (sourceSettings.prefs.single().value as StringPreferenceValue).value)
+    }
+
+    @Test fun `Tachiyomi 0153 gzip imports common fields without installed sources`() {
+        assertCommon(imported("tachiyomi", true))
+    }
+
+    @Test fun `Tachiyomi 0153 raw protobuf imports with empty repository defaults`() {
+        val backup = imported("tachiyomi", false)
+        assertCommon(backup)
+        assertTrue(backup.backupExtensionStores.isEmpty())
+        assertEquals(0L, backup.backupCategories.single().id)
+    }
+
+    @Test fun `Mihon pinned gzip imports common fields without installed sources`() {
+        assertCommon(imported("mihon", true))
+    }
+
+    @Test fun `Mihon pinned raw protobuf imports notes memo and repository signing identity`() {
+        val backup = imported("mihon", false)
+        assertCommon(backup)
+        assertEquals(23L, backup.backupCategories.single().id)
+        assertEquals("Nota preservada", backup.backupManga.single().notes)
+        assertTrue(backup.backupManga.single().initialized)
+        assertEquals("{\"sample\":true}", backup.backupManga.single().memo.decodeToString())
+        val store = backup.backupExtensionStores.single()
+        assertEquals("https://example.invalid/repo/index.pb", store.indexUrl)
+        assertEquals("a".repeat(64), store.signingKey)
+        assertEquals(false, store.isLegacy)
+    }
+
+    private fun roundTrip(name: String) {
+        val backup = imported(name, true)
+        val encoded = codec.encodeToByteArray(Backup.serializer(), backup)
+        val output = ByteArrayOutputStream()
+        GZIPOutputStream(output).use { it.write(encoded) }
+        assertCommon(decode(output.toByteArray()))
+        // Optional external reference-reader exchange. Default unit runs stay self-contained.
+        System.getProperty("polaris.backup.exchange")?.let { directory ->
+            File(directory).mkdirs()
+            File(directory, "$name-polaris.tachibk").writeBytes(output.toByteArray())
+        }
+    }
+
+    @Test fun `Polaris reexports imported Tachiyomi data using the real protobuf codec`() {
+        roundTrip("tachiyomi")
+    }
+
+    @Test fun `Polaris reexports imported Mihon data using the real protobuf codec`() {
+        roundTrip("mihon")
+    }
+}
