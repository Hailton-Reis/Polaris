@@ -0,0 +1,31 @@
+package eu.kanade.translation.presentation
+
+import androidx.compose.ui.text.font.FontFamily
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+
+class TranslationTypographyTest {
+    @Test fun `cedilla supplements preserve the actual text and style only the unsupported characters`() {
+        val source = "C Ç ç AÇÃO, coração."
+        val rendered = translationDisplayText(source, 20, FontFamily.SansSerif)
+        assertEquals(source, rendered.text)
+        assertEquals(source.count { it == 'Ç' || it == 'ç' }, rendered.spanStyles.size)
+        rendered.spanStyles.forEach { span ->
+            assertTrue(source.substring(span.start, span.end) in listOf("Ç", "ç"))
+            assertEquals(FontFamily.SansSerif, span.item.fontFamily)
+            assertEquals(22.5f, span.item.fontSize.value)
+        }
+    }
+
+    @Test fun `fonts with Portuguese glyphs do not receive supplementary spans`() {
+        val rendered = translationDisplayText("AÇÃO E PROTEÇÃO", 20, null)
+        assertTrue(rendered.spanStyles.isEmpty())
+        assertEquals("AÇÃO E PROTEÇÃO", rendered.text)
+    }
+
+    @Test fun `a normal phrase does not change fonts merely because a supplement is available`() {
+        val rendered = translationDisplayText("VAMOS CONTINUAR!", 20, FontFamily.SansSerif)
+        assertTrue(rendered.spanStyles.isEmpty())
+    }
+}
