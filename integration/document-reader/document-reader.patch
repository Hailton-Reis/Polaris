+    @Test
+    fun settingsUiUsesStockWidgetsAndPerformsChangesAsynchronously() =
+        runBlocking<Unit> {
+            val source = proxy()
+            SandboxSettingsTestActivity.fixtureSource = source
+            ActivityScenario.launch(SandboxSettingsTestActivity::class.java).use { scenario ->
+                fun ready(checked: Boolean): Boolean {
+                    val found = java.util.concurrent.atomic.AtomicBoolean(false)
+                    scenario.onActivity { activity ->
+                        val owner =
+                            activity.supportFragmentManager.fragments
+                                .filterIsInstance<PreferenceFragmentCompat>()
+                                .singleOrNull()
+                        val control =
+                            owner
+                                ?.listView
+                                ?.findViewById<android.widget.CompoundButton>(
+                                    androidx.preference.R.id.switchWidget
+                                )
+                        found.set(
+                            control != null &&
+                                control.isShown &&
+                                control.isEnabled &&
+                                control.width > 0 &&
+                                control.height > 0 &&
+                                control.isChecked == checked
+                        )
+                    }
+                    return found.get()
+                }
+                fun awaitState(checked: Boolean) {
+                    val deadline = System.currentTimeMillis() + 60000
+                    while (!ready(checked) && System.currentTimeMillis() < deadline) Thread.sleep(
+                        100
+                    )
+                    assertTrue(
+                        "The actual switch must be visible and show the stored state",
+                        ready(checked),
+                    )
+                }
+                fun capture(name: String) {
+                    instrumentation.waitForIdleSync()
+                    val image = requireNotNull(instrumentation.uiAutomation.takeScreenshot())
+                    try {
+                        val folder =
+                            File(
+                                    context.getExternalFilesDir(null),
+                                    "polaris-sandbox-settings-preview",
+                                )
