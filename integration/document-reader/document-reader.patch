+package eu.kanade.tachiyomi.data.download.model
+
+import eu.kanade.tachiyomi.source.online.HttpSource
+import io.mockk.every
+import io.mockk.mockk
+import org.junit.jupiter.api.Assertions.*
+import org.junit.jupiter.api.Test
+import tachiyomi.domain.chapter.model.Chapter
+import tachiyomi.domain.chapter.model.ChapterOrigin
+import tachiyomi.domain.manga.model.Manga
+import tachiyomi.domain.source.model.StubSource
+import tachiyomi.domain.source.service.SourceManager
+
+class DownloadOriginRouteTest {
+    @Test
+    fun `a missing old provider does not stop downloads from a recovered English edition`() {
+        val manager = mockk<SourceManager>()
+        val old = StubSource(1, "pt-BR", "Old source")
+        val english = mockk<HttpSource>()
+        every { manager.get(2) } returns english
+        every { manager.getOrStub(1) } returns old
+        val chapter =
+            Chapter.create()
+                .copy(
+                    memo =
+                        ChapterOrigin(2, "English", "en", "/work", "/chapter")
+                            .attach(Chapter.create().memo)
+                )
+        val download = Download.forChapter(Manga.create().copy(source = 1), chapter, manager)!!
+        assertSame(english, download.source)
+        assertSame(old, download.storageSource)
+        assertSame(chapter, download.chapter)
+    }
+
+    @Test
+    fun `a missing edition never sends its URL to an unrelated available root provider`() {
+        val manager = mockk<SourceManager>()
+        every { manager.get(2) } returns null
+        val chapter =
+            Chapter.create()
+                .copy(
+                    memo =
+                        ChapterOrigin(2, "English", "en", "/work", "/chapter")
+                            .attach(Chapter.create().memo)
+                )
+        assertNull(Download.forChapter(Manga.create().copy(source = 1), chapter, manager))
+    }
+}
