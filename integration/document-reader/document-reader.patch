+/** Legacy primary files keep their names; routed providers must never share a translation file. */
+internal object TranslationFileIdentity {
+    fun suffix(chapterUrl: String?): String = if (ChapterOrigin.isRouted(chapterUrl)) {
+        "_" + MessageDigest.getInstance("SHA-256").digest(chapterUrl!!.toByteArray(Charsets.UTF_8))
