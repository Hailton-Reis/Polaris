+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.withContext
+import mihon.core.archive.DocumentFormat
+import mihon.core.archive.DocumentLimits
+import mihon.core.archive.TextDocument
+import mihon.domain.manga.model.toDomainManga
+import okhttp3.HttpUrl.Companion.toHttpUrlOrNull
+import okhttp3.Request
+import org.json.JSONObject
+import tachiyomi.domain.manga.interactor.NetworkToLocalManga
+import tachiyomi.domain.manga.model.MangaUpdate
+import tachiyomi.domain.manga.repository.MangaRepository
+import tachiyomi.domain.storage.service.StorageManager
+import tachiyomi.source.local.LocalSource
+import uy.kohesive.injekt.Injekt
+import uy.kohesive.injekt.api.get
+import java.io.File
+import java.io.InputStream
+import java.util.UUID
+import java.util.zip.ZipFile
+import kotlin.coroutines.coroutineContext
+
+class DocumentImporter(private val context: Context) {
+    suspend fun fromUri(uri: Uri): Long = withContext(Dispatchers.IO) {
+        require(uri.scheme == "content") { "Select a document from the Android file picker" }
+        val name =
+            context.contentResolver.query(uri, arrayOf(OpenableColumns.DISPLAY_NAME), null, null, null)?.use { cursor ->
+                if (cursor.moveToFirst()) cursor.getString(0) else null
+            } ?: uri.lastPathSegment.orEmpty()
+        val type = checkNotNull(DocumentFormat.fromName(name)) { "Unsupported document format" }
+        checkNotNull(context.contentResolver.openInputStream(uri)).use { input ->
+            storeDocument(input, name, type, name.substringBeforeLast('.'))
+        }
+    }
+
+    suspend fun fromUrl(
+        value: String,
+        title: String? = null,
+        expected: DocumentFormat? = null,
+        author: String? = null,
+    ): Long = withContext(
+        Dispatchers.IO,
+    ) {
+        val url = value.trim().toHttpUrlOrNull() ?: error("Invalid document URL")
+        require(url.username.isEmpty() && url.password.isEmpty())
+        val client = Injekt.get<NetworkHelper>().client.newBuilder().callTimeout(
+            120,
+            java.util.concurrent.TimeUnit.SECONDS,
+        ).build()
+        client.newCall(
+            Request.Builder().url(url).header("User-Agent", "Polaris-DocumentReader/1.0").build(),
+        ).execute().use { response ->
+            check(response.isSuccessful) { "Document HTTP ${response.code}" }
+            val body = checkNotNull(response.body)
+            require(body.contentLength() <= DocumentLimits.MAX_FILE_BYTES) {
+                "Document exceeds the supported size limit"
+            }
+            val disposition = response.header("Content-Disposition").orEmpty()
+            val filename =
+                Regex("filename=\"?([^\";]+)", RegexOption.IGNORE_CASE).find(disposition)?.groupValues?.get(1)
+                    ?: response.request.url.pathSegments.lastOrNull().orEmpty()
+            val mime = body.contentType()?.toString()?.substringBefore(';')
+            val type =
+                expected ?: DocumentFormat.fromName(filename) ?: DocumentFormat.entries.firstOrNull { it.mime == mime }
+                    ?: error("Link does not identify a supported document")
+            body.byteStream().use { input ->
+                storeDocument(
+                    input,
+                    filename.ifBlank { "document.${type.extension}" },
+                    type,
+                    title ?: filename.substringBeforeLast('.'),
+                    author.orEmpty(),
+                )
+            }
+        }
+    }
+
+    private suspend fun storeDocument(
+        input: InputStream,
+        name: String,
+        format: DocumentFormat,
+        suggestedTitle: String,
+        suggestedAuthor: String = "",
+    ): Long {
+        val temporary = File(context.cacheDir, "import-${UUID.randomUUID()}.${format.extension}")
+        var title = suggestedTitle.take(180).ifBlank { name }
+        var author = suggestedAuthor.take(2000)
+        try {
+            temporary.outputStream().use { output ->
+                val buffer = ByteArray(32 * 1024)
+                var total = 0L
+                while (true) {
+                    coroutineContext.ensureActive()
+                    val count = input.read(buffer)
+                    if (count < 0) break
+                    total += count
+                    require(total <= DocumentLimits.MAX_FILE_BYTES) { "Document exceeds the supported size limit" }
+                    output.write(buffer, 0, count)
+                }
+                require(total > 0) { "Empty document" }
+            }
+            when (format) {
+                DocumentFormat.PDF -> {
+                    val header = ByteArray(5).also { bytes ->
+                        temporary.inputStream().use { java.io.DataInputStream(it).readFully(bytes) }
+                    }
+                    require(header.contentEquals("%PDF-".toByteArray())) { "Link did not return a PDF" }
+                }
+                DocumentFormat.EPUB, DocumentFormat.DOCX, DocumentFormat.TXT -> TextDocument(
+                    temporary,
+                    format,
+                ).use { doc ->
+                    if (doc.title.isNotBlank()) title = doc.title.take(180)
+                    if (doc.author.isNotBlank()) author = doc.author.take(2000)
+                    doc.readSection(0)
+                }
+                DocumentFormat.ZIP, DocumentFormat.CBZ -> ZipFile(temporary).use { require(it.size() > 0) }
+                else -> {
+                    val header = temporary.inputStream().use { input ->
+                        ByteArray(512).let { bytes ->
+                            val size = input.read(bytes)
+                            bytes.copyOf(size.coerceAtLeast(0))
+                        }
+                    }
+                    val valid = when (format) {
+                        DocumentFormat.CBR, DocumentFormat.RAR -> header.take(6).toByteArray()
+                            .contentEquals(byteArrayOf(0x52, 0x61, 0x72, 0x21, 0x1a, 0x07))
+                        DocumentFormat.CB7, DocumentFormat.SEVEN_ZIP -> header.take(6).toByteArray()
+                            .contentEquals(byteArrayOf(0x37, 0x7a, 0xbc.toByte(), 0xaf.toByte(), 0x27, 0x1c))
+                        DocumentFormat.CBT, DocumentFormat.TAR ->
+                            header.size >= 265 &&
+                                header.copyOfRange(257, 262).toString(Charsets.US_ASCII) == "ustar"
+                        else -> false
+                    }
+                    require(valid) { "Link did not return a supported archive" }
+                }
+            }
+            coroutineContext.ensureActive()
+            val base =
+                Injekt.get<StorageManager>().getLocalSourceDirectory()
+                    ?: error("Choose the app storage folder in Settings")
+            val id = UUID.randomUUID().toString().take(12)
+            val safeTitle = DiskUtil.buildValidFilename(title).take(100).ifBlank { "document" }
+            val folderName = "$safeTitle-$id"
+            val staging = checkNotNull(base.createDirectory(".import-$id"))
+            var published = false
+            try {
+                val target = checkNotNull(staging.createFile("document.${format.extension}"))
+                temporary.inputStream().use { source ->
+                    target.openOutputStream().use { output -> DocumentLimits.copy(source, output) }
+                }
+                val metadata = JSONObject().put("title", title).put("author", author).toString()
+                checkNotNull(staging.createFile("details.json")).openOutputStream().use {
+                    it.write(metadata.toByteArray())
+                }
+                coroutineContext.ensureActive()
+                check(staging.renameTo(folderName)) { "Cannot publish imported document" }
+                published = true
+                val manga = SManga.create().apply {
+                    this.title = title
+                    url = folderName
+                }.toDomainManga(LocalSource.ID)
+                val saved = Injekt.get<NetworkToLocalManga>()(manga)
+                check(
+                    Injekt.get<MangaRepository>().update(
+                        MangaUpdate(saved.id, favorite = true, dateAdded = System.currentTimeMillis()),
+                    ),
+                )
+                return saved.id
+            } finally {
+                if (!published) staging.delete()
+            }
+        } finally {
+            temporary.delete()
+        }
+    }
+}
