+import tachiyomi.domain.source.service.SourceManager
+
+class AutomaticSourceCatalogTest {
+    private class Provider(
+        override val id: Long,
+        val count: Int,
+        override val lang: String = "en",
+    ) : HttpSource() {
+        override val baseUrl = "https://example.invalid"
+        override val name = "Provider $id"
+        override val supportsLatest = false
+        var fail = false
+        var delayMillis = 0L
+        var cancel = false
+        var searches = 0
+        var incomingUrls = emptyList<String>()
+
+        private fun info() =
+            SManga.create().also {
+                it.url = "/work"
+                it.title = "The Star"
+                it.author = "Jane Doe"
+            }
+
+        override suspend fun getSearchManga(
+            page: Int,
+            query: String,
+            filters: FilterList,
+        ): MangasPage {
+            searches++
+            return MangasPage(listOf(info()), false)
+        }
+
+        override suspend fun getMangaUpdate(
+            manga: SManga,
+            chapters: List<SChapter>,
+            fetchDetails: Boolean,
+            fetchChapters: Boolean,
+        ): SMangaUpdate {
+            if (delayMillis > 0) delay(delayMillis)
+            if (cancel) throw CancellationException("parent cancelled")
+            if (fail) error("provider unavailable")
+            incomingUrls = chapters.map { it.url }
+            return SMangaUpdate(
+                info(),
+                if (!fetchChapters) {
+                    chapters
+                } else {
+                    (count downTo 1).map { n ->
+                        SChapter.create().also {
+                            it.url = "/chapter/$n"
+                            it.name = "Chapter $n"
+                            it.chapter_number = n.toFloat()
+                        }
+                    }
+                },
+            )
+        }
+    }
+
+    private class Manager(private val providers: List<Provider>) : SourceManager {
+        override val isInitialized = MutableStateFlow(true)
+        override val sources = MutableStateFlow<List<Source>>(providers)
+
+        override fun get(sourceKey: Long): Source? = providers.find { it.id == sourceKey }
+
+        override fun getOrStub(sourceKey: Long): Source = get(sourceKey) ?: error("missing")
+
+        override fun getAll(): List<Source> = providers
+
+        override fun getOnlineSources(): List<HttpSource> = providers
+
+        override fun getStubSources(): List<StubSource> = emptyList()
+    }
+
+    private fun catalog(manager: SourceManager, prefs: SourcePreferences) =
+        AutomaticSourceCatalog(manager, prefs) { _, _ -> true }
+
+    private fun preferences() =
+        SourcePreferences(InMemoryPreferenceStore()).also { it.enabledLanguages.set(setOf("en")) }
+
+    private fun work() =
+        Manga.create()
+            .copy(id = 10, source = 1, url = "/work", title = "The Star", author = "Jane Doe")
+
+    private fun oldChapter() =
+        Chapter.create()
+            .copy(
+                id = 5,
+                mangaId = 10,
+                url = "/chapter/1",
+                name = "Chapter 1",
+                chapterNumber = 1.0,
+                read = true,
+                lastPageRead = 4,
+            )
+
+    @Test
+    fun `foreground discovery combines verified editions into a single logical sequence`() =
+        runTest {
+            val primary = Provider(1, 2)
+            val alternative = Provider(2, 3)
+            val result =
+                catalog(Manager(listOf(primary, alternative)), preferences())
+                    .fetch(primary, work(), listOf(oldChapter()), true, true, true)!!
+            assertEquals(5, result.chapters.size)
+            val chapters =
+                result.chapters.mapIndexed { id, c ->
+                    Chapter.create()
+                        .copy(id = id.toLong(), url = c.url, name = c.name, memo = c.memo)
+                }
+            assertEquals(3, ChapterVersions.sequence(chapters, 1).size)
+            assertTrue(
+                result.chapters
+                    .filter { ChapterOrigin.from(it.memo)?.sourceId == 2L }
+                    .all { ChapterOrigin.isRouted(it.url) }
+            )
+            assertTrue(WorkSources.from(result.manga.memo).candidates.size == 2)
+        }
+
+    @Test
+    fun `background refresh never searches all extensions`() = runTest {
+        val primary = Provider(1, 2)
+        val alternative = Provider(2, 3)
+        catalog(Manager(listOf(primary, alternative)), preferences())
+            .fetch(primary, work(), listOf(oldChapter()), false, true, false)
+        assertEquals(0, alternative.searches)
+    }
+
+    @Test
+    fun `failed original preserves rows and can refresh a previously confirmed alternative`() =
+        runTest {
+            val primary = Provider(1, 2).also { it.fail = true }
+            val alternative = Provider(2, 3)
+            val binding = WorkSource(2, alternative.name, "en", "/work", "The Star", "Jane Doe")
+            val manga =
+                work().copy(memo = WorkSources(candidates = listOf(binding)).attach(work().memo))
+            val result =
+                catalog(Manager(listOf(primary, alternative)), preferences())
+                    .fetch(primary, manga, listOf(oldChapter()), false, true, false)!!
+            val retained = result.chapters.single { it.url == oldChapter().url }
+            assertFalse(ChapterOrigin.from(retained.memo)!!.available)
+            assertEquals(4, result.chapters.size)
+            assertEquals("The Star", result.manga.title)
+        }
+
+    @Test
+    fun `pin restricts network refresh while keeping original stored chapters`() = runTest {
+        val primary = Provider(1, 2)
+        val alternative = Provider(2, 3)
+        val binding = WorkSource(2, alternative.name, "en", "/work", "The Star", "Jane Doe")
+        val manga = work().copy(memo = WorkSources(pinned = binding).attach(work().memo))
+        val result =
+            catalog(Manager(listOf(primary, alternative)), preferences())
+                .fetch(primary, manga, listOf(oldChapter()), false, true, true)!!
+        assertEquals(0, alternative.searches)
+        assertEquals(binding, WorkSources.from(result.manga.memo).pinned)
+        assertTrue(result.chapters.any { it.url == oldChapter().url })
+    }
+
+    @Test
+    fun `parent cancellation is not converted into a successful partial refresh`() = runTest {
+        val primary = Provider(1, 2).also { it.cancel = true }
+        var cancelled = false
+        try {
+            catalog(Manager(listOf(primary)), preferences())
+                .fetch(primary, work(), emptyList(), false, true, true)
+        } catch (_: CancellationException) {
+            cancelled = true
+        }
+        assertTrue(cancelled)
+    }
+
+    @Test
+    fun `individual timeout keeps stored editions without cancelling another provider`() = runTest {
+        val primary = Provider(1, 2).also { it.delayMillis = 40_000 }
+        val alternative = Provider(2, 3)
+        val binding = WorkSource(2, alternative.name, "en", "/work", "The Star", "Jane Doe")
+        val manga =
+            work().copy(memo = WorkSources(candidates = listOf(binding)).attach(work().memo))
+        val result =
+            catalog(Manager(listOf(primary, alternative)), preferences())
+                .fetch(primary, manga, listOf(oldChapter()), false, true, false)!!
+        assertEquals(4, result.chapters.size)
+        assertFalse(
+            ChapterOrigin.from(result.chapters.single { it.url == oldChapter().url }.memo)!!
+                .available
+        )
+    }
+
+    @Test
+    fun `bounded catalogs always retain the original provider`() = runTest {
+        val primary = Provider(1, 2)
+        val providers = listOf(primary) + (2L..6L).map { Provider(it, 4) }
+        val result =
+            catalog(Manager(providers), preferences())
+                .fetch(primary, work(), listOf(oldChapter()), true, true, true)!!
+        assertEquals(4, WorkSources.from(result.manga.memo).candidates.count { it.active })
+        assertTrue(result.chapters.any { ChapterOrigin.from(it.memo)?.sourceId == 1L })
+    }
+
+    @Test
+    fun `hidden providers are not queried during discovery`() = runTest {
+        val primary = Provider(1, 2)
+        val hidden = Provider(2, 3)
+        val prefs = preferences().also { it.disabledSources.set(setOf("2")) }
+        catalog(Manager(listOf(primary, hidden)), prefs)
+            .fetch(primary, work(), listOf(oldChapter()), true, true, true)
+        assertEquals(0, hidden.searches)
+    }
+
+    @Test
+    fun `restored work with missing source and no previous alternatives can recover`() = runTest {
+        val replacement = Provider(2, 3)
+        val missing = StubSource(1, "", "Old source")
+        val result =
+            catalog(Manager(listOf(replacement)), preferences())
+                .fetch(missing, work(), listOf(oldChapter()), false, true, false)!!
+        assertTrue(result.chapters.any { ChapterOrigin.from(it.memo)?.sourceId == 2L })
+        assertTrue(result.chapters.any { it.url == oldChapter().url })
+        assertEquals("/work", result.manga.url)
+        assertEquals(1L, work().source)
+    }
+
+    @Test
+    fun `healthy Portuguese edition outranks larger English catalog`() = runTest {
+        val english = Provider(1, 20)
+        val portuguese = Provider(2, 3, "pt-BR")
+        val prefs = preferences().also { it.enabledLanguages.set(setOf("en", "pt-BR")) }
+        val result =
+            catalog(Manager(listOf(english, portuguese)), prefs)
+                .fetch(english, work(), listOf(oldChapter()), true, true, true)!!
+        val pt = result.chapters.first { ChapterOrigin.from(it.memo)?.sourceId == 2L }
+        val en = result.chapters.first { ChapterOrigin.from(it.memo)?.sourceId == 1L }
+        assertTrue(ChapterOrigin.from(pt.memo)!!.rank < ChapterOrigin.from(en.memo)!!.rank)
+        assertEquals(
+            20,
+            ChapterVersions.groups(
+                    result.chapters.map {
+                        Chapter.create().copy(url = it.url, name = it.name, memo = it.memo)
+                    }
+                )
+                .size,
+        )
+    }
+
+    @Test
+    fun `catalog with working images outranks Portuguese catalog whose images fail`() = runTest {
+        val english = Provider(1, 3)
+        val portuguese = Provider(2, 40, "pt-BR")
+        val prefs = preferences().also { it.enabledLanguages.set(setOf("en", "pt-BR")) }
+        val result =
+            AutomaticSourceCatalog(Manager(listOf(english, portuguese)), prefs) { provider, _ ->
+                    provider.id == 1L
+                }
+                .fetch(english, work(), listOf(oldChapter()), true, true, true)!!
+        val choices = WorkSources.from(result.manga.memo).candidates
+        assertEquals("sample_failed", choices.single { it.sourceId == 2L }.readability)
+        assertEquals("sample_passed", choices.single { it.sourceId == 1L }.readability)
+        assertEquals(
+            0,
+            ChapterOrigin.from(
+                    result.chapters.first { ChapterOrigin.from(it.memo)?.sourceId == 1L }.memo
+                )!!
+                .rank,
+        )
+    }
+
+    @Test
+    fun `explicit English pin prevents Portuguese search and health sampling`() = runTest {
+        val english = Provider(1, 3)
+        val portuguese = Provider(2, 40, "pt-BR")
+        val pin = WorkSource(1, english.name, "en", "/work", "The Star", "Jane Doe")
+        val manga = work().copy(memo = WorkSources(pinned = pin).attach(work().memo))
+        var probes = 0
+        val result =
+            AutomaticSourceCatalog(Manager(listOf(english, portuguese)), preferences()) { _, _ ->
+                    probes++
+                    true
+                }
+                .fetch(english, manga, listOf(oldChapter()), true, true, true)!!
+        assertEquals(0, probes)
+        assertEquals(0, portuguese.searches)
+        assertEquals(pin, WorkSources.from(result.manga.memo).pinned)
+    }
+
+    @Test
+    fun `first provider refresh never waits for a slow alternative or samples images`() = runTest {
+        val english = Provider(1, 3)
+        val slow = Provider(2, 40).also { it.delayMillis = 45_000 }
+        var probes = 0
+        val result =
+            AutomaticSourceCatalog(Manager(listOf(english, slow)), preferences()) { _, _ ->
+                    probes++
+                    true
+                }
+                .fetch(english, work(), listOf(oldChapter()), true, true, false)!!
+        assertEquals(3, result.chapters.size)
+        assertEquals(0, slow.searches)
+        assertEquals(0, probes)
+    }
+
+    @Test
+    fun `a remembered available provider does not prevent recovery when it now fails`() = runTest {
+        val old = Provider(1, 3).also { it.fail = true }
+        val replacement = Provider(2, 4)
+        val original =
+            WorkSource(1, old.name, "en", "/work", "The Star", "Jane Doe", available = true)
+        val manga =
+            work()
+                .copy(
+                    memo =
+                        WorkSources(
+                                candidates = listOf(original),
+                                checkedAt = System.currentTimeMillis(),
+                            )
+                            .attach(work().memo)
+                )
+        val result =
+            catalog(Manager(listOf(old, replacement)), preferences())
+                .fetch(old, manga, listOf(oldChapter()), false, true, false)!!
+        assertTrue(result.chapters.any { ChapterOrigin.from(it.memo)?.sourceId == 2L })
+    }
+
+    @Test
+    fun `installing a new enabled provider schedules discovery without waiting a day`() = runTest {
+        val original = Provider(1, 3)
+        val first = catalog(Manager(listOf(original)), preferences())
+        val result = first.fetch(original, work(), listOf(oldChapter()), false, true, true)!!
+        val refreshed = work().copy(memo = result.manga.memo)
+        assertFalse(first.needsDiscovery(refreshed))
+        val expanded = catalog(Manager(listOf(original, Provider(2, 4))), preferences())
+        assertTrue(expanded.needsDiscovery(refreshed))
+    }
+}
