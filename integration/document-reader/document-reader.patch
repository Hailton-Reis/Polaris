+                                        label = {
+                                            Text(stringResource(ATMR.strings.preparation_search))
+                                        },
+                                        modifier = Modifier.fillMaxWidth(),
+                                    )
+                                }
+                            }
+                        }
+                        if (state.selection == PreparationSelection.LANGUAGES) {
+                            items(
+                                state.available
+                                    .flatMap { it.sources.map { source -> source.lang } + it.lang }
+                                    .distinct()
+                                    .sorted(),
+                                key = { it },
+                            ) { language ->
