--- /dev/null
+++ b/app/src/main/java/eu/kanade/tachiyomi/source/selection/UnifiedWorkSearch.kt
@@ -0,0 +1,224 @@
+package eu.kanade.tachiyomi.source.selection
+
+import eu.kanade.domain.manga.model.toSManga
+import eu.kanade.tachiyomi.source.INovelSource
+import eu.kanade.tachiyomi.source.Source
+import eu.kanade.tachiyomi.source.model.SManga
+import eu.kanade.tachiyomi.source.online.HttpSource
+import kotlin.coroutines.coroutineContext
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitAll
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.sync.Semaphore
+import kotlinx.coroutines.sync.withPermit
+import kotlinx.coroutines.withTimeoutOrNull
+import kotlinx.serialization.json.JsonObject
+import mihon.domain.manga.model.toDomainManga
+import tachiyomi.domain.manga.model.WorkIdentity
+import tachiyomi.domain.manga.model.WorkSource
+import tachiyomi.domain.manga.model.WorkSources
+
+/** Per-query, bounded enrichment. Failed/ambiguous recognition leaves separate usable cards. */
+class UnifiedWorkSearch(private val resolveIdentity: suspend (SManga) -> WorkIdentity?) {
+    suspend fun refine(
+        query: String,
+        hits: List<WorkSearchHit>,
+        favorites: List<WorkSearchHit>,
+        sources: List<Source>,
+    ): List<WorkSearchGroup> = coroutineScope {
+        val providers =
+            sources
+                .filterIsInstance<HttpSource>()
+                .filter { it !is INovelSource }
+                .associateBy { it.id }
+        val savedIdentities =
+            favorites
+                .filter { it.isComic }
+                .mapNotNull { WorkSources.from(it.manga.memo).identity }
+                .distinctBy { it.catalogId }
+                .take(128)
+        val identity = safely {
+            withTimeoutOrNull(5_000) {
+                resolveIdentity(
+                    SManga.create().also {
+                        it.title = query.take(200)
+                        it.url = ""
+                    }
+                )
+            }
+        }
+        val identities = (savedIdentities + listOfNotNull(identity)).distinctBy { it.catalogId }
+        val allHits = hits.toMutableList()
+        // Retry a localized catalogue alias only on providers with no result. Never crawl pages.
+        val aliasProviders =
+            if (identity == null) emptyList()
+            else
+                sources
+                    .filter { it.id in providers && hits.none { hit -> hit.manga.source == it.id } }
+                    .sortedBy { if (it.lang.startsWith("pt")) 0 else 1 }
+                    .take(4)
+        val gate = Semaphore(2)
+        aliasProviders
+            .map { source ->
+                async {
+                    gate.withPermit {
+                        val aliases =
+                            identity!!
+                                .titles
+                                .filter { SourceMatching.title(it) != SourceMatching.title(query) }
+                                .distinctBy(SourceMatching::title)
+                                .take(2)
+                        for (alias in aliases) {
+                            val page =
+                                safely {
+                                    withTimeoutOrNull(5_000) {
+                                        source.getSearchManga(1, alias, source.getFilterList())
+                                    }
+                                } ?: continue
+                            val found =
+                                page.mangas
+                                    .filter { remote ->
+                                        identity.titles.any {
+                                            SourceMatching.title(it) ==
+                                                SourceMatching.title(remote.title)
+                                        }
+                                    }
+                                    .take(4)
+                            if (found.isNotEmpty())
+                                return@withPermit found.map { remote ->
+                                    WorkSearchHit(
+                                        remote.toDomainManga(source.id),
+                                        source.name,
+                                        source.lang,
+                                    )
+                                }
+                        }
+                        emptyList()
+                    }
+                }
+            }
+            .awaitAll()
+            .flatten()
+            .let(allHits::addAll)
+        val duplicateNames =
+            allHits
+                .groupBy { SourceMatching.title(it.manga.title) }
+                .filterValues { list -> list.map { it.manga.source }.distinct().size > 1 }
+                .keys
+        val aliases = identities.flatMap { it.titles }.map(SourceMatching::title).toSet()
+        val candidates =
+            allHits
+                .filter { hit ->
+                    hit.manga.source in providers &&
+                        SourceMatching.people(hit.manga.author, hit.manga.artist).isEmpty() &&
+                        (SourceMatching.title(hit.manga.title) in duplicateNames ||
+                            SourceMatching.title(hit.manga.title) in aliases)
+                }
+                .distinctBy { it.manga.source to it.manga.url }
+                .take(16)
+        val enriched =
+            candidates
+                .map { hit ->
+                    async {
+                        gate.withPermit {
+                            val details = safely {
+                                withTimeoutOrNull(5_000) {
+                                    providers
+                                        .getValue(hit.manga.source)
+                                        .getMangaUpdate(
+                                            hit.manga.toSManga().also { request ->
+                                                request.memo =
+                                                    JsonObject(
+                                                        request.memo.filterKeys {
+                                                            !it.startsWith("polaris.")
+                                                        }
+                                                    )
+                                            },
+                                            emptyList(),
+                                            true,
+                                            false,
+                                        )
+                                        .manga
+                                }
+                            }
+                            hit.manga.source to
+                                hit.manga.url to
+                                details
+                                    ?.takeIf { remote ->
+                                        val title =
+                                            runCatching { SourceMatching.title(remote.title) }
+                                                .getOrNull()
+                                        val original = SourceMatching.title(hit.manga.title)
+                                        val allowed =
+                                            identities
+                                                .filter {
+                                                    original in it.titles.map(SourceMatching::title)
+                                                }
+                                                .flatMap { it.titles }
+                                                .map(SourceMatching::title)
+                                        title == original || title in allowed
+                                    }
+                                    ?.let { remote ->
+                                        // A provider may return a different URL/title; keep the
+                                        // searched record's native identity.
+                                        hit.copy(
+                                            manga =
+                                                hit.manga.copy(
+                                                    author = remote.author,
+                                                    artist = remote.artist,
+                                                    thumbnailUrl =
+                                                        remote.thumbnail_url
+                                                            ?: hit.manga.thumbnailUrl,
+                                                )
+                                        )
+                                    }
+                        }
+                    }
+                }
+                .awaitAll()
+                .toMap()
+        coroutineContext.ensureActive()
+        WorkSearchGrouping.group(
+            allHits.map { enriched[it.manga.source to it.manga.url] ?: it },
+            favorites,
+            identities,
+        )
+    }
+
+    private suspend fun <T> safely(block: suspend () -> T): T? =
+        try {
+            block()
+        } catch (cancelled: CancellationException) {
+            throw cancelled
+        } catch (_: Exception) {
+            null
+        }
+
+    companion object {
+        /** A merge of memo fields only. Reading/history/categories/download rows never move. */
+        internal fun attach(memo: JsonObject, editions: List<WorkSearchHit>): JsonObject {
+            val old = WorkSources.from(memo)
+            if (old.pinned != null || editions.size < 2) return memo
+            val candidates =
+                editions.take(16).map { hit ->
+                    WorkSource(
+                        hit.manga.source,
+                        hit.name,
+                        hit.language,
+                        hit.manga.url,
+                        hit.manga.title,
+                        hit.manga.author,
+                        hit.manga.artist,
+                        sourceMemo =
+                            JsonObject(hit.manga.memo.filterKeys { !it.startsWith("polaris.") }),
+                        active = false,
+                    )
+                }
+            val combined = (old.candidates + candidates).distinctBy { it.key }
+            if (combined == old.candidates) return memo
+            return old.copy(candidates = combined, checkedAt = 0).attach(memo)
+        }
+    }
+}
diff --git a/app/src/main/java/eu/kanade/tachiyomi/source/selection/WorkIdentityResolver.kt b/app/src/main/java/eu/kanade/tachiyomi/source/selection/WorkIdentityResolver.kt
new file mode 100644
index 0000000..aaa0c39
--- /dev/null
+++ b/app/src/main/java/eu/kanade/tachiyomi/source/selection/WorkIdentityResolver.kt
@@ -0,0 +1,117 @@
+package eu.kanade.tachiyomi.source.selection
+
+import eu.kanade.tachiyomi.network.GET
+import eu.kanade.tachiyomi.network.awaitSuccess
+import eu.kanade.tachiyomi.source.model.SManga
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.withTimeoutOrNull
+import kotlinx.serialization.json.*
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okhttp3.OkHttpClient
+import tachiyomi.domain.manga.model.WorkIdentity
+
+/** Public catalogue metadata; no account, LLM or executable repository is downloaded here. */
+class WorkIdentityResolver(private val client: OkHttpClient) {
+    suspend fun resolve(reference: SManga): WorkIdentity? {
+        return try {
+            withTimeoutOrNull(5_000L) {
+                val direct =
+                    UUID.find(reference.url)?.value?.takeIf {
+                        // A random UUID from another provider is not a MangaDex identity.
+                        reference.memo["polaris.identity.mangadex"]?.jsonPrimitive?.content == it ||
+                            reference.url.startsWith("https://mangadex.org/title/")
+                    }
+                val url =
+                    if (direct != null)
+                        "https://api.mangadex.org/manga/$direct".toHttpUrl().newBuilder()
+                    else
+                        "https://api.mangadex.org/manga"
+                            .toHttpUrl()
+                            .newBuilder()
+                            .addQueryParameter("title", reference.title.take(200))
+                            .addQueryParameter("limit", "10")
+                url.addQueryParameter("includes[]", "author")
+                    .addQueryParameter("includes[]", "artist")
+                client.newCall(GET(url.build().toString())).awaitSuccess().use { response ->
+                    val source = response.body.source()
+                    source.request(MAX_BYTES + 1)
+                    check(source.buffer.size <= MAX_BYTES) { "Catalogue metadata too large" }
+                    val parsed = Json.parseToJsonElement(source.readUtf8()).jsonObject
+                    val data = parsed["data"] ?: return@use null
+                    select(reference, if (data is JsonArray) data else JsonArray(listOf(data)))
+                }
+            }
+        } catch (error: CancellationException) {
+            throw error
+        } catch (_: Exception) {
+            null
+        }
+    }
+
+    internal fun select(reference: SManga, records: JsonArray): WorkIdentity? {
+        val people = SourceMatching.people(reference.author, reference.artist)
+        val matches =
+            records.take(10).mapNotNull { record ->
+                val item = record.jsonObject
+                val attributes = item["attributes"]?.jsonObject ?: return@mapNotNull null
+                // MangaDex "manga" and its individual ID keep sequels and unrelated media separate.
+                if (item["type"]?.jsonPrimitive?.content != "manga") return@mapNotNull null
+                val alternate = attributes["altTitles"]?.jsonArray.orEmpty().map { it.jsonObject }
+                val preferred =
+                    listOf("en", "pt-br", "pt").flatMap { language ->
+                        alternate.mapNotNull { it[language] }
+                    }
+                val titles =
+                    (preferred +
+                            attributes["title"]?.jsonObject?.values.orEmpty() +
+                            alternate.flatMap { it.values })
+                        .mapNotNull {
+                            (it as? JsonPrimitive)?.content?.takeIf { n -> n.length in 2..300 }
+                        }
+                        .distinct()
+                        .take(32)
+                if (
+                    titles.none {
+                        SourceMatching.title(it) == SourceMatching.title(reference.title)
+                    }
+                )
+                    return@mapNotNull null
+                val creators =
+                    item["relationships"]
+                        ?.jsonArray
+                        .orEmpty()
+                        .filter {
+                            it.jsonObject["type"]?.jsonPrimitive?.content in
+                                listOf("author", "artist")
+                        }
+                        .mapNotNull {
+                            it.jsonObject["attributes"]
+                                ?.jsonObject
+                                ?.get("name")
+                                ?.jsonPrimitive
+                                ?.content
+                        }
+                if (
+                    creators.isEmpty() ||
+                        (people.isNotEmpty() &&
+                            creators.flatMap { SourceMatching.people(it) }.none { it in people })
+                )
+                    return@mapNotNull null
+                val id = item["id"]?.jsonPrimitive?.content ?: return@mapNotNull null
+                if (!UUID.matches(id)) return@mapNotNull null
+                WorkIdentity(
+                    "mangadex:$id",
+                    titles,
+                    creators.distinct(),
+                    System.currentTimeMillis(),
+                )
+            }
+        return matches.singleOrNull()
+    }
+
+    companion object {
+        private const val MAX_BYTES = 2 * 1024 * 1024L
+        private val UUID =
+            Regex("[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}")
