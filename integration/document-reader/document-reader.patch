+package eu.kanade.tachiyomi.ui.documents
+
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.intOrNull
+import kotlinx.serialization.json.jsonPrimitive
+
+data class DocumentReadingPosition(val section: Int = 0, val block: Int = 0, val offset: Int = 0) {
+    fun merge(memo: JsonObject): JsonObject = JsonObject(
+        memo + mapOf(
+            "polaris_document_section" to JsonPrimitive(section.coerceAtLeast(0)),
+            "polaris_document_block" to JsonPrimitive(block.coerceAtLeast(0)),
+            "polaris_document_offset" to JsonPrimitive(offset.coerceAtLeast(0)),
+        ),
+    )
+
+    companion object {
+        fun from(memo: JsonObject): DocumentReadingPosition {
+            fun number(key: String) =
+                runCatching { memo[key]?.jsonPrimitive?.intOrNull }.getOrNull()?.coerceAtLeast(0) ?: 0
+            return DocumentReadingPosition(
+                number("polaris_document_section"),
+                number("polaris_document_block"),
+                number("polaris_document_offset"),
+            )
+        }
+    }
+}
diff --git a/app/src/main/java/eu/kanade/tachiyomi/ui/documents/DocumentSearch.kt b/app/src/main/java/eu/kanade/tachiyomi/ui/documents/DocumentSearch.kt
new file mode 100644
index 0000000..ce6e322
--- /dev/null
+++ b/app/src/main/java/eu/kanade/tachiyomi/ui/documents/DocumentSearch.kt
@@ -0,0 +1,272 @@
+package eu.kanade.tachiyomi.ui.documents
+
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitAll
+import kotlinx.coroutines.supervisorScope
+import kotlinx.coroutines.withContext
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonArray
+import kotlinx.serialization.json.JsonElement
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.contentOrNull
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import mihon.core.archive.DocumentFormat
+import mihon.core.archive.DocumentLimits
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okhttp3.HttpUrl.Companion.toHttpUrlOrNull
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import java.io.ByteArrayOutputStream
+import java.util.concurrent.TimeUnit
+import kotlin.coroutines.cancellation.CancellationException
+
+enum class DocumentSearchField { ANY, TITLE, AUTHOR, DOI }
+enum class DocumentSearchKind { ARTICLES, BOOKS }
+data class RemoteDocument(val url: String, val format: DocumentFormat)
+data class DocumentSearchHit(
+    val id: String,
+    val title: String,
+    val authors: String,
+    val provider: String,
+    val doi: String?,
+    val landing: String?,
+    val documents: List<RemoteDocument>,
+)
+data class DocumentSearchBatch(val hits: List<DocumentSearchHit>, val errors: List<String>, val providers: List<String>)
+
+object DocumentSearchParsers {
+    private fun JsonElement?.text(): String = runCatching {
+        this?.jsonPrimitive?.contentOrNull?.take(2000)
+    }.getOrNull().orEmpty()
+    private fun JsonElement?.objects(): List<JsonObject> = (this as? JsonArray)?.mapNotNull {
+        it as? JsonObject
+    }.orEmpty()
+    private fun JsonElement?.texts(): List<String> = (this as? JsonArray)?.map { it.text() }.orEmpty()
+    private fun link(value: String): String? = value.toHttpUrlOrNull()?.takeIf {
+        it.username.isEmpty() && it.password.isEmpty()
+    }?.toString()
+
+    fun doi(query: String): String? {
+        val value = query.trim().replace(Regex("^(https?://(dx\\.)?doi\\.org/|doi:\\s*)", RegexOption.IGNORE_CASE), "")
+        return value.takeIf { Regex("10\\.\\d{4,9}/\\S+", RegexOption.IGNORE_CASE).matches(it) }
+    }
+
+    fun crossref(raw: String, single: Boolean): List<DocumentSearchHit> {
+        val message = Json.parseToJsonElement(raw).jsonObject["message"]?.jsonObject ?: return emptyList()
+        val items = if (single) listOf(message) else message["items"].objects().take(20)
+        return items.mapNotNull { item ->
+            val title = item["title"].texts().firstOrNull()?.takeIf(String::isNotBlank) ?: return@mapNotNull null
+            val doi = item["DOI"].text().takeIf(String::isNotBlank)
+            val files = item["link"].objects().mapNotNull { entry ->
+                val format = when (entry["content-type"].text().substringBefore(';')) {
+                    "application/pdf" -> DocumentFormat.PDF
+                    "application/epub+zip" -> DocumentFormat.EPUB
+                    "text/plain" -> DocumentFormat.TXT
+                    else -> return@mapNotNull null
+                }
+                link(entry["URL"].text())?.let { RemoteDocument(it, format) }
+            }.distinctBy { it.url }.take(3)
+            DocumentSearchHit(
+                "crossref:${doi ?: item["URL"].text()}:$title",
+                title,
+                item["author"].objects().take(12).joinToString {
+                    listOf(it["given"].text(), it["family"].text()).filter(String::isNotBlank).joinToString(" ")
+                },
+                "Crossref",
+                doi,
+                link(item["URL"].text()),
+                files,
+            )
+        }
+    }
+
+    fun europePmc(raw: String): List<DocumentSearchHit> {
+        val root = Json.parseToJsonElement(raw).jsonObject
+        return (root["resultList"] as? JsonObject)?.get("result").objects().take(20).mapNotNull { item ->
+            val title = item["title"].text().takeIf(String::isNotBlank) ?: return@mapNotNull null
+            val pmcid = item["pmcid"].text()
+            val doi = item["doi"].text().takeIf(String::isNotBlank)
+            val links = (item["fullTextUrlList"] as? JsonObject)?.get("fullTextUrl").objects()
+            val files = links.filter { it["documentStyle"].text().equals("pdf", true) }.mapNotNull { entry ->
+                link(entry["url"].text())?.let { RemoteDocument(it, DocumentFormat.PDF) }
+            }.toMutableList()
+            if (files.isEmpty() && pmcid.matches(Regex("PMC[0-9]+")) && item["isOpenAccess"].text() == "Y") {
+                files += RemoteDocument("https://europepmc.org/articles/$pmcid?pdf=render", DocumentFormat.PDF)
+            }
+            val landing = if (pmcid.matches(Regex("PMC[0-9]+"))) {
+                "https://europepmc.org/articles/$pmcid"
+            } else {
+                doi?.let { "https://doi.org/$it" }
+            }
+            DocumentSearchHit(
+                "europepmc:${item["source"].text()}:${item["id"].text()}",
+                title,
+                item["authorString"].text(),
+                "Europe PMC",
+                doi,
+                link(landing.orEmpty()),
+                files.distinctBy {
+                    it.url
+                }.take(3),
+            )
+        }
+    }
+
+    fun gutendex(raw: String): List<DocumentSearchHit> = Json.parseToJsonElement(
+        raw,
+    ).jsonObject["results"].objects().take(20).mapNotNull { item ->
+        val title = item["title"].text().takeIf(String::isNotBlank) ?: return@mapNotNull null
+        val id = item["id"].text()
+        val files = (item["formats"] as? JsonObject).orEmpty().mapNotNull { (mime, value) ->
+            val format = when (mime.substringBefore(';')) {
+                "application/epub+zip" -> DocumentFormat.EPUB
+                "application/pdf" -> DocumentFormat.PDF
+                "text/plain" -> DocumentFormat.TXT
+                else -> return@mapNotNull null
+            }
+            link(value.text())?.let { RemoteDocument(it, format) }
+        }.distinctBy { it.url }.take(3)
+        DocumentSearchHit(
+            "gutendex:$id",
+            title,
+            item["authors"].objects().take(12).joinToString { it["name"].text() },
+            "Project Gutenberg / Gutendex",
+            null,
+            id.toLongOrNull()?.let {
+                "https://www.gutenberg.org/ebooks/$it"
+            },
+            files,
+        )
+    }
+
+    fun openLibrary(raw: String): List<DocumentSearchHit> = Json.parseToJsonElement(
+        raw,
+    ).jsonObject["docs"].objects().take(20).mapNotNull { item ->
+        val title = item["title"].text().takeIf(String::isNotBlank) ?: return@mapNotNull null
+        val key = item["key"].text().takeIf { it.matches(Regex("/works/OL[0-9]+W")) } ?: return@mapNotNull null
+        DocumentSearchHit(
+            "openlibrary:$key",
+            title,
+            item["author_name"].texts().take(12).joinToString(),
+            "Open Library",
+            null,
+            "https://openlibrary.org$key",
+            emptyList(),
+        )
+    }
+}
+
+class DocumentSearch(client: OkHttpClient) {
+    private val client = client.newBuilder().callTimeout(25, TimeUnit.SECONDS).build()
+
+    suspend fun search(query: String, kind: DocumentSearchKind, field: DocumentSearchField): DocumentSearchBatch =
+        withContext(Dispatchers.IO) {
+            require(query.trim().length in 2..300)
+            val normalizedDoi = DocumentSearchParsers.doi(query)
+            require(field != DocumentSearchField.DOI || normalizedDoi != null) { "Invalid DOI" }
+            val providers = if (kind == DocumentSearchKind.BOOKS &&
+                field != DocumentSearchField.DOI
+            ) {
+                listOf("Gutendex", "Open Library")
+            } else {
+                listOf("Crossref", "Europe PMC")
+            }
+            val results = supervisorScope {
+                providers.map { provider ->
+                    async {
+                        try {
+                            val hits = when (provider) {
+                                "Open Library" -> {
+                                    val parameter = when (field) {
+                                        DocumentSearchField.TITLE -> "title"
+                                        DocumentSearchField.AUTHOR -> "author"
+                                        else -> "q"
+                                    }
+                                    val url = "https://openlibrary.org/search.json".toHttpUrl().newBuilder()
+                                        .addQueryParameter(parameter, query).addQueryParameter("limit", "20")
+                                        .addQueryParameter("fields", "key,title,author_name").build()
+                                    DocumentSearchParsers.openLibrary(fetch(url.toString()))
+                                }
+                                "Gutendex" -> {
+                                    val url = "https://gutendex.com/books/".toHttpUrl().newBuilder().addQueryParameter(
+                                        "search",
+                                        query,
+                                    ).build()
+                                    DocumentSearchParsers.gutendex(fetch(url.toString())).filter { hit ->
+                                        when (field) {
+                                            DocumentSearchField.TITLE -> fold(hit.title).contains(fold(query))
+                                            DocumentSearchField.AUTHOR -> fold(hit.authors).contains(fold(query))
+                                            else -> true
+                                        }
+                                    }
+                                }
+                                "Crossref" -> {
+                                    val single = normalizedDoi != null
+                                    val builder = "https://api.crossref.org/works".toHttpUrl().newBuilder()
+                                    if (single) {
+                                        builder.addPathSegment(checkNotNull(normalizedDoi))
+                                    } else {
+                                        val parameter = when (field) {
+                                            DocumentSearchField.TITLE -> "query.title"
+                                            DocumentSearchField.AUTHOR -> "query.author"
+                                            else -> "query.bibliographic"
+                                        }
+                                        builder.addQueryParameter(parameter, query).addQueryParameter("rows", "20")
+                                    }
+                                    DocumentSearchParsers.crossref(fetch(builder.build().toString()), single)
+                                }
+                                else -> {
+                                    val escaped = query.replace("\\", "\\\\").replace("\"", "\\\"")
+                                    val term = when {
+                                        normalizedDoi != null -> "DOI:\"$normalizedDoi\""
+                                        field == DocumentSearchField.TITLE -> "TITLE:\"$escaped\""
+                                        field == DocumentSearchField.AUTHOR -> "AUTH:\"$escaped\""
+                                        field == DocumentSearchField.DOI -> "DOI:\"$escaped\""
+                                        else -> query
+                                    }
+                                    val url = "https://www.ebi.ac.uk/europepmc/webservices/rest/search"
+                                        .toHttpUrl().newBuilder()
+                                        .addQueryParameter("query", term).addQueryParameter("format", "json")
+                                        .addQueryParameter(
+                                            "resultType",
+                                            "core",
+                                        ).addQueryParameter("pageSize", "20").build()
+                                    DocumentSearchParsers.europePmc(fetch(url.toString()))
+                                }
+                            }
+                            provider to Result.success(hits)
+                        } catch (cancelled: CancellationException) {
+                            throw cancelled
+                        } catch (error: Exception) {
+                            provider to Result.failure<List<DocumentSearchHit>>(error)
+                        }
+                    }
+                }.awaitAll()
+            }
+            DocumentSearchBatch(
+                results.flatMap { it.second.getOrDefault(emptyList()) }.distinctBy { it.id },
+                results.filter { it.second.isFailure }.map { it.first },
+                providers,
+            )
+        }
+
+    private fun fold(value: String): String = java.text.Normalizer.normalize(value, java.text.Normalizer.Form.NFD)
+        .replace(Regex("\\p{M}+"), "").lowercase(java.util.Locale.ROOT)
+
+    private fun fetch(url: String): String = client.newCall(
+        Request.Builder().url(url)
+            .header("User-Agent", "Polaris-DocumentReader/1.0").build(),
+    ).execute().use { response ->
+        check(response.isSuccessful) { "Search HTTP ${response.code}" }
+        val body = checkNotNull(response.body)
+        body.byteStream().use { input ->
+            ByteArrayOutputStream().use { output ->
+                DocumentLimits.copy(input, output, 4L * 1024 * 1024)
+                output.toString("UTF-8")
+            }
+        }
+    }
+}
