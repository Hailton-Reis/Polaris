+/** Retry only corroborated editions of the SAME logical chapter; never silently change a pin. */
+internal object ChapterLoadFallback {
+    fun candidates(
+        requested: Chapter,
+        versions: List<Chapter>,
+        rootSource: Long,
+        pinnedSource: Long?,
+        onlineSourceIds: Set<Long>,
+        downloadedIds: Set<Long>,
+        downloadedOnly: Boolean,
+    ): List<Chapter> =
+        versions
+            .filter {
+                val sourceId = ChapterOrigin.from(it.memo)?.sourceId ?: rootSource
+                it.id != requested.id &&
+                    ChapterVersions.key(it) == ChapterVersions.key(requested) &&
+                    (pinnedSource == null || sourceId == pinnedSource) &&
+                    (it.id in downloadedIds || (!downloadedOnly && sourceId in onlineSourceIds))
+            }
+            .sortedWith(
+                compareByDescending<Chapter> { it.id in downloadedIds }
+                    .thenByDescending { ChapterOrigin.from(it.memo)?.available != false }
+                    .thenBy { ChapterOrigin.from(it.memo)?.rank ?: 0 }
+            )
+            .distinctBy { it.id }
+            .take(3)
+
