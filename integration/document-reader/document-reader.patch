+package eu.kanade.tachiyomi.data.updater
+
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import tachiyomi.core.common.preference.InMemoryPreferenceStore
+
+class PolarisUpdatePreferencesTest {
+    @Test
+    fun `automatic checks default on while experimental releases require opt in`() {
+        val preferences = PolarisUpdatePreferences(InMemoryPreferenceStore())
+        assertTrue(preferences.automatic().get())
+        assertFalse(preferences.experimental().get())
+    }
+
+    @Test
+    fun `check intervals are independent by channel and handle clock rollback`() {
+        val preferences = PolarisUpdatePreferences(InMemoryPreferenceStore())
+        val now = 5 * 24 * 60 * 60 * 1000L
+        preferences.lastCheck(false).set(now)
+        assertFalse(preferences.isDue(false, now + 1000))
+        assertTrue(preferences.isDue(true, now + 1000))
+        assertTrue(preferences.isDue(false, now - 1))
+        assertTrue(preferences.isDue(false, now + 24 * 60 * 60 * 1000L))
+        preferences.resetChecks()
+        assertTrue(preferences.isDue(false, now + 1000))
+    }
+
+    @Test
+    fun `manual checks bypass disabled automation and the daily interval`() {
+        val preferences = PolarisUpdatePreferences(InMemoryPreferenceStore())
+        val now = 123_456L
+        preferences.lastCheck(false).set(now)
+        assertFalse(preferences.shouldCheck(false, false, now))
+        assertTrue(preferences.shouldCheck(true, false, now))
+        preferences.automatic().set(false)
+        assertFalse(preferences.shouldCheck(false, true, now))
+        assertTrue(preferences.shouldCheck(true, true, now))
+    }
+}
