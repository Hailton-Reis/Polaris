+                        context.stringResource(ATMR.strings.sandbox_settings_private)
+                    else node["summary"]?.jsonPrimitive?.content
+                widget.isVisible = node.getValue("visible").jsonPrimitive.boolean
+                widget.isEnabled = node.getValue("enabled").jsonPrimitive.boolean && kind != "info"
+                widget.isIconSpaceReserved = false
+                if (widget is DialogPreference) {
