@@ -0,0 +1,71 @@
+package eu.kanade.tachiyomi.ui.documents
+
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import mihon.core.archive.DocumentFormat
+import tachiyomi.domain.category.model.Category
+import tachiyomi.domain.category.repository.CategoryRepository
+import tachiyomi.domain.manga.repository.MangaRepository
+import java.text.Normalizer
+import java.util.Locale
+
+enum class DocumentKind(val categoryAliases: List<String>) {
+    MANGA(listOf("Mangás", "Manga")),
+    MANHWA(listOf("Manhwas", "Manhwa")),
+    COMICS(listOf("Quadrinhos", "Comics")),
+    BOOK(listOf("Livros", "Books")),
+    ARTICLE(listOf("Artigos", "Articles")),
+    DOCUMENT(listOf("Documentos", "Documents")),
+}
+
+data class DocumentImportOptions(
+    val kind: DocumentKind,
+    val kindCategoryName: String,
+    val includeFormatCategory: Boolean = true,
+    val formatCategoryPrefix: String,
+    val categoryIds: Set<Long> = emptySet(),
+    val newCategoryName: String = "",
+    val title: String = "",
+)
+
+/** Uses normal library categories, only for the document explicitly being added. */
+class DocumentOrganizer(
+    private val categories: CategoryRepository,
+    private val manga: MangaRepository,
+    private val initialFlags: () -> Long,
+) {
+    suspend fun assign(mangaId: Long, format: DocumentFormat, options: DocumentImportOptions) = lock.withLock {
+        var current = categories.getAll().filterNot { it.isSystemCategory }
+        require(options.categoryIds.all { id -> current.any { it.id == id } }) { "Category no longer exists" }
+        val selected = options.categoryIds.toMutableSet()
+
+        suspend fun resolve(name: String, aliases: List<String> = emptyList()): Long {
+            val cleanName = name.trim().replace(Regex("\\s+"), " ")
+            require(cleanName.isNotEmpty() && cleanName.length <= 80) { "Invalid category name" }
+            val accepted = (aliases + cleanName).map(::normalize).toSet()
+            current.firstOrNull { normalize(it.name) in accepted }?.let { return it.id }
+            categories.insert(Category(0, cleanName, (current.maxOfOrNull { it.order } ?: -1) + 1, initialFlags()))
+            current = categories.getAll().filterNot { it.isSystemCategory }
+            return checkNotNull(current.firstOrNull { normalize(it.name) == normalize(cleanName) }).id
+        }
+
+        selected += resolve(options.kindCategoryName, options.kind.categoryAliases)
+        if (options.includeFormatCategory) {
+            val extension = format.extension.uppercase(Locale.ROOT)
+            selected +=
+                resolve(
+                    "${options.formatCategoryPrefix}: $extension",
+                    listOf("Format: $extension", "Formato: $extension"),
+                )
+        }
+        if (options.newCategoryName.isNotBlank()) selected += resolve(options.newCategoryName)
+        // Unlike SetMangaCategories, this repository call propagates failure to the importer.
+        manga.setMangaCategories(mangaId, selected.toList())
+    }
+
+    companion object {
+        private val lock = Mutex()
+        private fun normalize(value: String): String = Normalizer.normalize(value.trim(), Normalizer.Form.NFD)
+            .replace(Regex("\\p{M}+"), "").replace(Regex("\\s+"), " ").lowercase(Locale.ROOT)
+    }
+}
