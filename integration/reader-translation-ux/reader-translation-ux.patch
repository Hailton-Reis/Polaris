new file mode 100644
index 0000000..b1b308c
--- /dev/null
+++ b/app/src/test/java/eu/kanade/translation/presentation/TranslationViewportScaleTest.kt
@@ -0,0 +1,27 @@
+package eu.kanade.translation.presentation
+
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Test
+
+class TranslationViewportScaleTest {
+    @Test
+    fun `same pixel space preserves reader zoom`() {
+        assertEquals(0.4f, TranslationViewportScale.resolve(0.4f, 1200, 1200f), 0.0001f)
+    }
+
+    @Test
+    fun `downsampled translation coordinates are mapped to source pixels exactly once`() {
+        val scale = TranslationViewportScale.resolve(0.25f, 2400, 1200f)
+        assertEquals(0.5f, scale, 0.0001f)
+        assertEquals(100f, 200f * scale, 0.0001f)
+        assertEquals(2f, TranslationViewportScale.resolve(1f, 2400, 1200f), 0.0001f)
+    }
+
+    @Test
+    fun `invalid page metadata does not introduce NaN or infinite scale`() {
+        assertEquals(1f, TranslationViewportScale.resolve(1f, 0, 1200f))
+        assertEquals(1f, TranslationViewportScale.resolve(1f, 1200, 0f))
+        assertEquals(1f, TranslationViewportScale.resolve(1f, 1200, Float.NaN))
+        assertEquals(0f, TranslationViewportScale.resolve(Float.NaN, 1200, 1200f))
+    }
+}
