diff --git a/app/src/test/java/eu/kanade/presentation/more/settings/screen/browse/discovery/RepositoryDiscoveryControllerTest.kt b/app/src/test/java/eu/kanade/presentation/more/settings/screen/browse/discovery/RepositoryDiscoveryControllerTest.kt
new file mode 100644
index 0000000..c9027c7
--- /dev/null
+++ b/app/src/test/java/eu/kanade/presentation/more/settings/screen/browse/discovery/RepositoryDiscoveryControllerTest.kt
@@ -0,0 +1,105 @@
+package eu.kanade.presentation.more.settings.screen.browse.discovery
+
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.flow
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.runCurrent
+import kotlinx.coroutines.test.runTest
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertNull
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+
+class RepositoryDiscoveryControllerTest {
+    @Test
+    fun `one direct add registers the chosen repository and ignores repeated clicks`() = runTest {
+        val installed = MutableStateFlow(emptySet<String>())
+        val gate = CompletableDeferred<Unit>()
+        val calls = mutableListOf<String>()
+        var refreshes = 0
+        val controller = RepositoryDiscoveryController({ installed }, { url ->
+            calls += url
+            gate.await()
+            installed.value = installed.value + url
+        }, { refreshes++ }, backgroundScope, StandardTestDispatcher(testScheduler))
+        runCurrent()
+        controller.add("nox")
+        controller.add("nox")
+        controller.add("keiyoushi")
+        runCurrent()
+        assertEquals(listOf(RepositoryCatalog.entries.first().indexUrl), calls)
+        assertEquals("nox", controller.state.value.pendingId)
+        gate.complete(Unit)
+        runCurrent()
+        assertNull(controller.state.value.pendingId)
+        assertNull(controller.state.value.error)
+        assertEquals(1, refreshes)
+        controller.add("nox")
+        runCurrent()
+        assertEquals(1, calls.size)
+    }
+
+    @Test
+    fun `registration failure permits retry without claiming success`() = runTest {
+        var fail = true
+        val controller = RepositoryDiscoveryController({ MutableStateFlow(emptySet<String>()) }, {
+            if (fail) error("network failed")
+        }, {}, backgroundScope, StandardTestDispatcher(testScheduler))
+        runCurrent()
+        controller.add("nox")
+        runCurrent()
+        assertEquals(DiscoveryError.ADD, controller.state.value.error)
+        assertTrue(controller.state.value.installedUrls.isEmpty())
+        assertNull(controller.state.value.pendingId)
+        fail = false
+        controller.add("nox")
+        runCurrent()
+        assertNull(controller.state.value.error)
+        assertTrue(controller.state.value.installedUrls.isNotEmpty())
+    }
+
+    @Test
+    fun `listing refresh failure retains a successfully registered repository`() = runTest {
+        var adds = 0
+        val controller = RepositoryDiscoveryController(
+            { MutableStateFlow(emptySet<String>()) },
+            { adds++ },
+            { error("refresh failed") },
+            backgroundScope,
+            StandardTestDispatcher(testScheduler),
+        )
+        runCurrent()
+        controller.add("keiyoushi")
+        runCurrent()
+        assertEquals(DiscoveryError.REFRESH, controller.state.value.error)
+        assertTrue(RepositoryCatalog.isAdded(RepositoryCatalog.entries.last(), controller.state.value.installedUrls))
+        controller.add("keiyoushi")
+        runCurrent()
+        assertEquals(1, adds)
+    }
+
+    @Test
+    fun `database read failure blocks additions and can be retried`() = runTest {
+        var fail = true
+        var adds = 0
+        val controller = RepositoryDiscoveryController({
+            flow {
+                if (fail) error("db unavailable")
+                emit(emptySet<String>())
+            }
+        }, { adds++ }, {}, backgroundScope, StandardTestDispatcher(testScheduler))
+        runCurrent()
+        assertEquals(DiscoveryError.LOAD, controller.state.value.error)
+        controller.add("nox")
+        runCurrent()
+        assertEquals(0, adds)
+        fail = false
+        controller.reload()
+        runCurrent()
+        assertTrue(controller.state.value.loaded)
+        controller.add("unknown-id")
+        runCurrent()
+        assertEquals(0, adds)
+    }
+}
