@@ -0,0 +1,74 @@
+package eu.kanade.presentation.more.settings.screen.browse.discovery
+
+import java.net.URI
+import java.text.Normalizer
+import java.util.Locale
+
+data class DiscoverableRepository(
+    val id: String,
+    val name: String,
+    val maintainer: String,
+    val indexUrl: String,
+    val tags: List<String>,
+)
+
+/** Bundled discovery only. Search terms are not sent to GitHub or repository servers. */
+object RepositoryCatalog {
+    val entries = listOf(
+        DiscoverableRepository(
+            "nox",
+            "Project Nox",
+            "Awerkori",
+            "https://raw.githubusercontent.com/Awerkori/extensoes/repo/index.pb",
+            listOf("PT-BR", "Português", "Brasil", "EN", "English", "Inglês", "mangá", "manhwa", "webtoon"),
+        ),
+        DiscoverableRepository(
+            "keiyoushi",
+            "Keiyoushi",
+            "Keiyoushi",
+            "https://raw.githubusercontent.com/keiyoushi/extensions/repo/index.pb",
+            listOf("PT-BR", "Português", "EN", "English", "Inglês", "multilíngue", "mangá", "manhwa", "webtoon"),
+        ),
+    )
+
+    fun search(query: String): List<DiscoverableRepository> {
+        val terms = normalized(query).split(' ').filter(String::isNotBlank)
+        return entries.filter { entry ->
+            val searchable = normalized(listOf(entry.name, entry.maintainer).plus(entry.tags).joinToString(" "))
+            terms.all(searchable::contains)
+        }
+    }
+
+    fun isAdded(entry: DiscoverableRepository, urls: Set<String>): Boolean {
+        val expected = repositoryKey(entry.indexUrl) ?: return false
+        return urls.any { repositoryKey(it) == expected }
+    }
+
+    /** Only normalize known static GitHub index aliases; branch names remain case-sensitive. */
+    fun repositoryKey(url: String): String? {
+        return runCatching {
+            val uri = URI(url.trim())
+            if (!uri.scheme.equals("https", true) || uri.userInfo != null ||
+                uri.rawQuery != null || uri.rawFragment != null || uri.port !in listOf(-1, 443)
+            ) {
+                return null
+            }
+            var host = uri.host?.lowercase(Locale.ROOT) ?: return null
+            var parts = uri.path.split('/').filter(String::isNotBlank)
+            if (host == "github.com" && parts.size >= 5 && parts[2] == "raw") {
+                host = "raw.githubusercontent.com"
+                parts = parts.take(2) + parts.drop(3)
+            }
+            if (host != "raw.githubusercontent.com" || parts.size < 3) return null
+            if (parts.last() in listOf("index.pb", "index.min.json", "repo.json")) parts = parts.dropLast(1)
+            parts = parts.mapIndexed { index, part -> if (index < 2) part.lowercase(Locale.ROOT) else part }
+            "$host/${parts.joinToString("/")}"
+        }.getOrNull()
+    }
+
+    private fun normalized(text: String): String = Normalizer.normalize(text, Normalizer.Form.NFKD)
+        .replace(Regex("\\p{M}+"), "")
+        .lowercase(Locale.ROOT)
+        .replace(Regex("[^\\p{L}\\p{N}]+"), " ")
+        .trim()
+}
