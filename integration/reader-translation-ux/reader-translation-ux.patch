+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+                item {
+                    Text(
+                        stringResource(ATMR.strings.repository_after_add),
+                        style = MaterialTheme.typography.bodySmall,
+                    )
+                }
+            }
+        }
+    }
+}
