+        val calls = mutableMapOf<Int, Int>()
+        val result = TranslationTextFit.select(6, 25) { size ->
+            calls[size] = calls.getOrDefault(size, 0) + 1
+            TranslationTextFit.Measurement(size <= 23, size <= 14 || size == 22)
+        }
+        assertEquals(22, result.fontSizeSp)
+        assertTrue(result.keepsWords)
