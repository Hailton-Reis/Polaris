+package eu.kanade.translation
+
+/** Source language is a routing hint, not a claim that OCR detected the chapter language. */
+object EnglishDownloadTranslationPolicy {
+    fun enabled(globalEnabled: Boolean, workOverride: Boolean?, sourceLanguage: String?, from: String, to: String): Boolean {
+        if (workOverride != null) return workOverride
+        val language = sourceLanguage?.lowercase(java.util.Locale.ROOT)?.replace('_', '-')
+        return globalEnabled && (language == "en" || language?.startsWith("en-") == true) &&
+            from == "ENGLISH" && to.isNotBlank() && to != "ENGLISH"
+    }
+}
