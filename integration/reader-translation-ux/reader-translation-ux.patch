@@ -0,0 +1,25 @@
+package eu.kanade.translation
+
+/** Explicit per-chapter requests survive restart and are consumed only after enqueue succeeds. */
+class PendingDownloadTranslations(
+    private val load: () -> Set<String>,
+    private val save: (Set<String>) -> Unit,
+) {
+    @Synchronized
+    fun request(chapterId: Long) = save(load() + chapterId.toString())
+
+    @Synchronized
+    fun cancel(chapterIds: Iterable<Long>) = save(load() - chapterIds.map(Long::toString).toSet())
+
+    @Synchronized
+    fun clear() = save(emptySet())
+
+    @Synchronized
+    fun complete(chapterId: Long, enqueue: () -> Unit): Boolean {
+        val key = chapterId.toString()
+        if (key !in load()) return false
+        enqueue()
+        save(load() - key)
+        return true
+    }
+}
