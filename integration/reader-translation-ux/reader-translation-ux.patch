--- /dev/null
+++ b/app/src/main/java/eu/kanade/translation/presentation/TranslationViewportTransform.kt
@@ -0,0 +1,28 @@
+package eu.kanade.translation.presentation
+
+/** One immutable snapshot: the image origin and scale must describe the same reader frame. */
+data class TranslationViewportTransform(
+    val scale: Float,
+    val offsetX: Float,
+    val offsetY: Float,
+) {
+    companion object {
+        fun resolve(
+            viewScale: Float,
+            sourceWidth: Int,
+            translationWidth: Float,
+            originX: Float,
+            originY: Float,
+        ): TranslationViewportTransform? {
+            if (!viewScale.isFinite() || viewScale <= 0f || sourceWidth <= 0 ||
+                !translationWidth.isFinite() || translationWidth <= 0f ||
+                !originX.isFinite() || !originY.isFinite()
+            ) {
+                return null
+            }
+            val scale = TranslationViewportScale.resolve(viewScale, sourceWidth, translationWidth)
+            if (!scale.isFinite() || scale <= 0f) return null
+            return TranslationViewportTransform(scale, originX, originY)
+        }
+    }
+}
