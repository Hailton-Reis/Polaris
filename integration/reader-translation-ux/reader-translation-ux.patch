@@ -53,6 +53,22 @@ class TranslationManager(
     private val sourceManager: SourceManager = Injekt.get(),
     private val translationPreferences: TranslationPreferences = Injekt.get(),
 ) {
+    val pendingDownloads = PendingDownloadTranslations(
+        load = { translationPreferences.pendingDownloadTranslations().get() },
+        save = { translationPreferences.pendingDownloadTranslations().set(it) },
+    )
+
+    fun completeRequestedDownload(manga: Manga, chapter: Chapter): Boolean =
+        pendingDownloads.complete(chapter.id) {
+            translateChapter(manga, chapter, TranslationRequestOrigin.USER_ACTION)
+        }
+
+    fun translateDownloadedChapter(manga: Manga, chapter: Chapter) {
+        if (!completeRequestedDownload(manga, chapter)) {
+            translateChapter(manga, chapter, TranslationRequestOrigin.DOWNLOAD_COMPLETION)
+        }
+    }
+
     private val translator = ChapterTranslator(context, provider)
     private val editorScope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
     private val translationFileMutex = Mutex()
