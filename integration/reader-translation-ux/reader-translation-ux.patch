@@ -0,0 +1,42 @@
+package eu.kanade.translation.presentation
+
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertNull
+import org.junit.jupiter.api.Test
+
+class TranslationViewportTransformTest {
+    @Test
+    fun `fitted portrait includes the black margin above the image once`() {
+        val transform = requireNotNull(TranslationViewportTransform.resolve(0.25f, 1440, 1440f, 0f, 120f))
+        assertEquals(100f, transform.offsetX + 400f * transform.scale, 0.001f)
+        assertEquals(270f, transform.offsetY + 600f * transform.scale, 0.001f)
+    }
+
+    @Test
+    fun `downsampled translation maps to the same displayed pixels as the source`() {
+        val transform = requireNotNull(TranslationViewportTransform.resolve(0.125f, 2880, 1440f, 16f, 120f))
+        assertEquals(116f, transform.offsetX + 400f * transform.scale, 0.001f)
+        assertEquals(270f, transform.offsetY + 600f * transform.scale, 0.001f)
+    }
+
+    @Test
+    fun `zoom and pan snapshot replaces both origin and scale without mutating the prior frame`() {
+        val fitted = requireNotNull(TranslationViewportTransform.resolve(0.25f, 1440, 1440f, 0f, 120f))
+        val zoomed = requireNotNull(TranslationViewportTransform.resolve(0.5f, 1440, 1440f, -150f, -200f))
+        assertEquals(50f, zoomed.offsetX + 400f * zoomed.scale, 0.001f)
+        assertEquals(100f, zoomed.offsetY + 600f * zoomed.scale, 0.001f)
+        assertEquals(120f, fitted.offsetY)
+        assertEquals(0.25f, fitted.scale)
+    }
+
+    @Test
+    fun `incomplete or invalid geometry has no drawable viewport`() {
+        assertNull(TranslationViewportTransform.resolve(0f, 1440, 1440f, 0f, 0f))
+        assertNull(TranslationViewportTransform.resolve(Float.NaN, 1440, 1440f, 0f, 0f))
+        assertNull(TranslationViewportTransform.resolve(1f, 0, 1440f, 0f, 0f))
+        assertNull(TranslationViewportTransform.resolve(1f, 1440, 0f, 0f, 0f))
+        assertNull(TranslationViewportTransform.resolve(1f, 1440, Float.POSITIVE_INFINITY, 0f, 0f))
+        assertNull(TranslationViewportTransform.resolve(1f, 1440, 1440f, Float.NaN, 0f))
+        assertNull(TranslationViewportTransform.resolve(1f, 1440, 1440f, 0f, Float.POSITIVE_INFINITY))
+    }
+}
