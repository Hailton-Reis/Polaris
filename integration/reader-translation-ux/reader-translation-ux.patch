--- /dev/null
+++ b/app/src/test/java/eu/kanade/translation/PendingDownloadTranslationsTest.kt
@@ -0,0 +1,55 @@
+package eu.kanade.translation
+
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertThrows
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+
+class PendingDownloadTranslationsTest {
+    private var stored = emptySet<String>()
+    private fun requests() = PendingDownloadTranslations({ stored }, { stored = it })
+
+    @Test
+    fun `explicit chapter request survives restart and does not select other chapters`() {
+        requests().request(42)
+        var enqueued = 0
+        assertFalse(requests().complete(43) { enqueued++ })
+        assertTrue(requests().complete(42) { enqueued++ })
+        assertEquals(1, enqueued)
+        assertTrue(stored.isEmpty())
+        assertFalse(requests().complete(42) { enqueued++ })
+    }
+
+    @Test
+    fun `enqueue failure preserves request for retry`() {
+        val requests = requests()
+        requests.request(42)
+        assertThrows(IllegalStateException::class.java) {
+            requests.complete(42) { error("queue unavailable") }
+        }
+        assertEquals(setOf("42"), stored)
+        assertTrue(requests.complete(42) {})
+    }
+
+    @Test
+    fun `cancellation prevents a later ordinary download from consuming the request`() {
+        val requests = requests()
+        requests.request(42)
+        requests.request(43)
+        requests.cancel(listOf(42))
+        assertFalse(requests.complete(42) { error("cancelled chapter enqueued") })
+        assertEquals(setOf("43"), stored)
+        requests.clear()
+        assertTrue(stored.isEmpty())
+    }
+
+    @Test
+    fun `duplicate clicks and simultaneous requests do not lose chapters`() {
+        val requests = requests()
+        val threads = (1L..20L).map { id -> Thread { repeat(5) { requests.request(id) } } }
+        threads.forEach(Thread::start)
+        threads.forEach(Thread::join)
+        assertEquals((1L..20L).map(Long::toString).toSet(), stored)
+    }
+}
