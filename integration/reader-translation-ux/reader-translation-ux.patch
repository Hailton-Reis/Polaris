@@ -0,0 +1,9 @@
+package eu.kanade.translation.presentation
+
+object TranslationViewportScale {
+    fun resolve(viewScale: Float, sourceWidth: Int, translationWidth: Float): Float {
+        if (!viewScale.isFinite() || viewScale <= 0f) return 0f
+        if (sourceWidth <= 0 || !translationWidth.isFinite() || translationWidth <= 0f) return viewScale
+        return (viewScale * sourceWidth / translationWidth).takeIf { it.isFinite() } ?: viewScale
+    }
+}
