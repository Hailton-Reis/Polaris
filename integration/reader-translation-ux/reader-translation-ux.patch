+package eu.kanade.presentation.more.settings.screen.browse.discovery
+
+import kotlinx.coroutines.CoroutineDispatcher
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.catch
+import kotlinx.coroutines.flow.collectLatest
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+import kotlin.coroutines.cancellation.CancellationException
+
+enum class DiscoveryError { LOAD, ADD, REFRESH }
+
+data class RepositoryDiscoveryState(
+    val loaded: Boolean = false,
+    val installedUrls: Set<String> = emptySet(),
+    val pendingId: String? = null,
+    val error: DiscoveryError? = null,
+)
+
+class RepositoryDiscoveryController(
+    private val observe: () -> Flow<Set<String>>,
+    private val addStore: suspend (String) -> Unit,
+    private val refresh: suspend () -> Unit,
+    private val scope: CoroutineScope,
+    private val dispatcher: CoroutineDispatcher,
+) {
+    private val mutableState = MutableStateFlow(RepositoryDiscoveryState())
+    val state = mutableState.asStateFlow()
+    private var storesJob: Job? = null
+
+    init {
+        reload()
+    }
+
+    fun reload() {
+        storesJob?.cancel()
+        mutableState.update { it.copy(loaded = false, error = null) }
+        storesJob = scope.launch(dispatcher) {
+            observe()
+                .catch { mutableState.update { it.copy(loaded = false, error = DiscoveryError.LOAD) } }
+                .collectLatest { urls -> mutableState.update { it.copy(loaded = true, installedUrls = urls) } }
+        }
+    }
+
+    fun add(id: String) {
+        val entry = RepositoryCatalog.entries.singleOrNull { it.id == id } ?: return
+        while (true) {
+            val snapshot = state.value
+            if (!snapshot.loaded || snapshot.pendingId != null ||
+                RepositoryCatalog.isAdded(entry, snapshot.installedUrls)
+            ) {
+                return
+            }
+            if (mutableState.compareAndSet(snapshot, snapshot.copy(pendingId = id, error = null))) break
+        }
+        scope.launch(dispatcher) {
+            var added = false
+            try {
+                addStore(entry.indexUrl)
+                added = true
+                mutableState.update { it.copy(installedUrls = it.installedUrls + entry.indexUrl) }
+                refresh()
+            } catch (error: CancellationException) {
+                throw error
+            } catch (_: Exception) {
+                mutableState.update { it.copy(error = if (added) DiscoveryError.REFRESH else DiscoveryError.ADD) }
+            } finally {
+                mutableState.update { it.copy(pendingId = null) }
+            }
+        }
+    }
+}
