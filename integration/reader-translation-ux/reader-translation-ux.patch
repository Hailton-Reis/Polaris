+package eu.kanade.presentation.more.settings.screen.browse.discovery
+
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+
+class RepositoryCatalogTest {
+    @Test
+    fun `empty search returns the initial catalog without registering anything`() {
+        assertEquals(RepositoryCatalog.entries, RepositoryCatalog.search("  "))
+        assertEquals(2, RepositoryCatalog.entries.size)
+        assertEquals(2, RepositoryCatalog.entries.map { it.id }.distinct().size)
+        assertTrue(RepositoryCatalog.entries.all { it.indexUrl.startsWith("https://") })
+    }
+
+    @Test
+    fun `search accepts accents case language and multiple terms`() {
+        assertEquals(listOf("nox"), RepositoryCatalog.search("AWERKORI português").map { it.id })
+        assertEquals(2, RepositoryCatalog.search("PT-BR inglês").size)
+        assertEquals(listOf("keiyoushi"), RepositoryCatalog.search("Keiyoushi").map { it.id })
+        assertTrue(RepositoryCatalog.search("unknown project").isEmpty())
+    }
+
+    @Test
+    fun `known legacy and redirected index URLs do not duplicate repositories`() {
+        val entry = RepositoryCatalog.entries.last()
+        assertTrue(RepositoryCatalog.isAdded(entry, setOf("https://github.com/keiyoushi/extensions/raw/repo/index.pb")))
+        assertTrue(
+            RepositoryCatalog.isAdded(
+                entry,
+                setOf("https://raw.githubusercontent.com/Keiyoushi/Extensions/repo/repo.json"),
+            ),
+        )
+        assertTrue(
+            RepositoryCatalog.isAdded(
+                entry,
+                setOf("https://raw.githubusercontent.com/keiyoushi/extensions/repo/index.min.json/"),
+            ),
+        )
+    }
+
+    @Test
+    fun `different branches hosts and unsafe URL forms are not conflated`() {
+        val entry = RepositoryCatalog.entries.last()
+        for (url in listOf(
+            "https://raw.githubusercontent.com/keiyoushi/extensions/other/index.pb",
+            "https://evil.example/keiyoushi/extensions/repo/index.pb",
+            "http://raw.githubusercontent.com/keiyoushi/extensions/repo/index.pb",
+            "https://user@raw.githubusercontent.com/keiyoushi/extensions/repo/index.pb",
+            "https://raw.githubusercontent.com/keiyoushi/extensions/repo/index.pb?token=abc",
+            "not a url",
+        )) {
+            assertFalse(RepositoryCatalog.isAdded(entry, setOf(url)), url)
+        }
