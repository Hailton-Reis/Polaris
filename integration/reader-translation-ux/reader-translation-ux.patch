+                                    DiscoveryError.ADD -> ATMR.strings.repository_add_error
+                                    DiscoveryError.REFRESH -> ATMR.strings.repository_refresh_error
+                                },
+                            ),
+                            color = MaterialTheme.colorScheme.error,
+                        )
+                        if (error == DiscoveryError.LOAD) {
+                            TextButton(onClick = model::reload) { Text(stringResource(ATMR.strings.repository_retry)) }
+                        }
+                    }
+                }
+                if (results.isEmpty()) {
+                    item { Text(stringResource(ATMR.strings.repository_no_results)) }
+                }
+                items(results, key = { it.id }) { entry ->
+                    val added = RepositoryCatalog.isAdded(entry, state.installedUrls)
+                    val pending = state.pendingId == entry.id
+                    ElevatedCard(modifier = Modifier.fillMaxWidth()) {
+                        Column(
+                            modifier = Modifier.padding(16.dp),
+                            verticalArrangement = Arrangement.spacedBy(8.dp),
+                        ) {
+                            Text(entry.name, style = MaterialTheme.typography.titleMedium)
+                            Text(stringResource(ATMR.strings.repository_maintainer, entry.maintainer))
+                            Text(entry.tags.take(6).joinToString(" · "), style = MaterialTheme.typography.bodySmall)
+                            Text(entry.indexUrl, style = MaterialTheme.typography.bodySmall)
+                            Text(
+                                stringResource(ATMR.strings.repository_last_checked),
+                                style = MaterialTheme.typography.bodySmall,
+                            )
+                            Row(
+                                modifier = Modifier.fillMaxWidth(),
+                                horizontalArrangement = Arrangement.End,
+                                verticalAlignment = Alignment.CenterVertically,
+                            ) {
+                                Button(
+                                    onClick = { model.add(entry.id) },
+                                    enabled = state.loaded && state.pendingId == null && !added,
