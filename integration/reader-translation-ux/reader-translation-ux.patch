+package eu.kanade.translation
+
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+
+class EnglishDownloadTranslationPolicyTest {
+    private fun enabled(lang: String?, global: Boolean = true, work: Boolean? = null,
+                        from: String = "ENGLISH", to: String = "PORTUGUESE") =
+        EnglishDownloadTranslationPolicy.enabled(global, work, lang, from, to)
+
+    @Test
+    fun `English source variants are eligible`() {
+        for (lang in listOf("en", "en-US", "en_GB", "EN")) assertTrue(enabled(lang))
+    }
+
+    @Test
+    fun `Portuguese and unknown sources are not guessed as English`() {
+        for (lang in listOf("pt", "pt-BR", "all", "", "enough", null)) assertFalse(enabled(lang))
+    }
+
+    @Test
+    fun `explicit work choices take priority`() {
+        assertFalse(enabled("en", work = false))
+        assertTrue(enabled("all", global = false, work = true))
+    }
+
+    @Test
+    fun `global off disables the English default`() {
+        assertFalse(enabled("en", global = false))
+    }
+
+    @Test
+    fun `configured source and target must permit English translation`() {
+        assertFalse(enabled("en", from = "JAPANESE"))
+        assertFalse(enabled("en", to = "ENGLISH"))
+        assertFalse(enabled("en", to = ""))
+    }
+}
